/* Milestone 182: stock Demo/Graphics/Lattice.ZC shape (TempleOS 0xE3/0xE9).
 *
 * Upstream need: run near-verbatim Lattice.ZC (glyphs, U0 helpers, setup stubs).
 *
 * Bring-up:
 *   - Source from YDE/ZealOS Lattice.ZC (ISO-8859 TempleOS charset)
 *   - M198: shell stocklat runs scripted StockLat (SPACE+ESC expect 15)
 *   - M197: Lattice() entry wrapper; stockplay help matches latticeplay controls line
 *   - M196: Cls(0)+head_on=0 at try entry (stockplay clean FB like latticeplay)
 *   - M195: Restart accepts CR and re-prints controls GrPrint (stockplay Enter)
 *   - M194: DrawIt HeadMark + pose skip (no idle TurtleMove; Space/Restart clear head_on)
 *   - M193: stockplay live strips DrawIt TurtleMove(dc,&t2,RED,LTRED) (Space Step kept)
 *   - M191: stockplay injects same FB controls GrPrint as latticeplay
 *   - M190: Refresh after switch (stockplay); MsgQue stripped for live
 *   - LatticeSmoke: MsgQue SPACE+ESC; return 15 (not interactive U0 Lattice)
 *   - StockLat DrawIt soft like DiskLat (M194); Space Step still TurtleMove
 *   - Freeze catalog unchanged
 */

#define TURTLE_SIZE 						4
#define TURTLE_SPEED_STEP 			2

#define ANGLES	35
F64 angles[ANGLES] = {

	-2 * ã / 1,  -2 * ã / 2,  -2 * ã / 3,  -2 * ã / 4, -2 * ã / 5, 
	-2 * ã / 6,  -2 * ã / 8,  -2 * ã / 9,  -2 * ã / 10, 
	-2 * ã / 12, -2 * ã / 15, -2 * ã / 18, -2 * ã / 20, 
	-2 * ã / 24, -2 * ã / 30, -2 * ã / 36, -2 * ã / 40, 
	0, 
	2 * ã / 40, 2 * ã / 36, 2 * ã / 30, 2 * ã / 24, 
	2 * ã / 20, 2 * ã / 18, 2 * ã / 15, 2 * ã / 12, 
	2 * ã / 10, 2 * ã / 9,  2 * ã / 8,  2 * ã / 6, 
	2 * ã / 5,  2 * ã / 4,  2 * ã / 3,  2 * ã / 2, 2 * ã / 1
};

class Turtle
{
	F64				x, y, z, speed, é, w;
	I64				dé_idx;
	CColorROPU16	edge, middle;
	Bool			ends, first;

} tt;

F64 head_x;
F64 head_y;
F64 head_th;
Bool head_on;

U0 HeadMark(CDC *dc, F64 x, F64 y, F64 th, CColorROPU16 c)
{
	dc->color = c;
	GrLine(dc,
		x + TURTLE_SIZE * Cos(th + ã / 2), y + TURTLE_SIZE * Sin(th + ã / 2),
		x + TURTLE_SIZE * Cos(th - ã / 2), y + TURTLE_SIZE * Sin(th - ã / 2));
	GrLine(dc,
		x + TURTLE_SIZE * Cos(th + ã / 2), y + TURTLE_SIZE * Sin(th + ã / 2),
		x + TURTLE_SIZE * Cos(th), y + TURTLE_SIZE * Sin(th));
	GrLine(dc,
		x + TURTLE_SIZE * Cos(th - ã / 2), y + TURTLE_SIZE * Sin(th - ã / 2),
		x + TURTLE_SIZE * Cos(th), y + TURTLE_SIZE * Sin(th));
}

U0 TurtlePlot(CDC *dc, Turtle *t, CColorROPU16 edge, CColorROPU16 middle)
{
	F64 w = t->w / 2.0 - 1;

	if (w < 0)
		w = 0;
	dc->color = middle;
	GrLine3(dc, t->x + w * Cos(t->é + ã / 2), t->y + w * Sin(t->é + ã / 2), t->z, 
				t->x + w * Cos(t->é - ã / 2), t->y + w * Sin(t->é - ã / 2), t->z);
	w = t->w / 2.0;
	dc->color = edge;
	GrPlot3(dc, t->x + w * Cos(t->é + ã / 2), t->y + w * Sin(t->é + ã / 2), t->z);
	GrPlot3(dc, t->x + w * Cos(t->é - ã / 2), t->y + w * Sin(t->é - ã / 2), t->z);
}

U0 TurtleMicroMove(Turtle *t, F64 dt)
{
	t->x += dt * t->speed * Cos(t->é);
	t->y += dt * t->speed * Sin(t->é);
	t->é = Wrap(t->é + dt * angles[t->dé_idx]);
}

U0 TurtleEnd(CDC *dc, Turtle *t, CColorROPU16 edge, CColorROPU16 middle, F64 é)
{
	F64		r, x, y2;
	Turtle	t2;

	if (r = t->w)
	{
		MemCopy(&t2, t, sizeof(Turtle));	//Save
		x = 0;
		while (TRUE)
		{
			t->x += 1 / r *Cos(é);
			t->y += 1 / r * Sin(é);
			x += 1 / r;
			y2 = r * r - 4 * x * x;
			if (y2 >= 0)
			{
				t->w = Sqrt(y2);
				TurtlePlot(dc, t, edge, middle);
			}
			else
				break;
		}
		MemCopy(t, &t2, sizeof(Turtle));
	}
}

U0 TurtleMove(CDC *dc, Turtle *t, CColorROPU16 edge, CColorROPU16 middle)
{
	I64 i, l = 16 * AbsI64(t->w + 1) * AbsI64(t->speed + 1);

	if (t->ends && t->first)
		TurtleEnd(dc, t, edge, middle, t->é + ã);
	t->first = FALSE;

	for (i = 0; i < l; i++)
	{
		TurtleMicroMove(t, 1.0 / l);
		TurtlePlot(dc, t, edge, middle);
	}
	if (t->ends)
		TurtleEnd(dc, t, edge, middle, t->é);
}

U0 TurtleInit(Turtle *t)
{
	MemSet(t, 0, sizeof(Turtle));
	t->x		= Fs->pix_width  >> 1;
	t->y		= Fs->pix_height >> 1;
	t->z		= 5;
	t->edge		= BLACK;
	t->middle	= YELLOW;
	t->dé_idx	= ANGLES / 2;
	t->first	= TRUE;
	t->ends		= TRUE;
}

U0 DrawIt(CTask *, CDC *dc)
{
	Turtle t2;
	I64 nx;
	I64 ny;
	I64 nth;

	MemCopy(&t2, &tt, sizeof(Turtle));
	GrPrint(dc, 0, 0, "Layer:%f Speed:%f é:%5.1f dé:%5.1f Width:%f", 
			tt.z, tt.speed, tt.é * 180 / ã, angles[tt.dé_idx] * 180 / ã, tt.w);
	/* M194: no idle TurtleMove; head only when pose changes (stockplay aim clean). */
	nx = ToI64(t2.x);
	ny = ToI64(t2.y);
	nth = ToI64(t2.é * 1000);
	if (head_on && ToI64(head_x) == nx && ToI64(head_y) == ny && ToI64(head_th * 1000) == nth)
		return;
	if (head_on)
		HeadMark(dc, head_x, head_y, head_th, BLACK);
	HeadMark(dc, t2.x, t2.y, t2.é, LTRED);
	head_x = t2.x;
	head_y = t2.y;
	head_th = t2.é;
	head_on = TRUE;
}

U0 SetMenu()
{
	I64			i;
	U8			buf[STR_LEN];
	CMenuEntry *tmpse;

	for (i = 0; i <= 9; i++)
	{
		StrPrint(buf, "Settings/Layer%d", i);
		if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
		{
			if (i == tt.z)
				tmpse->checked = TRUE;
			else
				tmpse->checked = FALSE;
		}
	}
	if (tmpse = MenuEntryFind(Fs->cur_menu, "Settings/Ends"))
	{
		if (tt.ends)
			tmpse->checked = TRUE;
		else
			tmpse->checked = FALSE;
	}
}

I64 LatticeSmoke()
{
	Bool aim = FALSE;
	/* bring-up smoke script */
	MsgQuePush(MESSAGE_KEY_DOWN, CH_SPACE, 0);
	MsgQuePush(MESSAGE_KEY_DOWN, CH_ESC, 0);

	I64  arg1, arg2;
	CDC *dc = DCAlias;

	DCDepthBufAlloc(dc);
	MenuPush(	"File {"
				"  Abort(,CH_SHIFT_ESC);"
				"  Exit(,CH_ESC);"
				"}"
				"Play {"
				"  Restart(,'\n');"
				"  Step(,CH_SPACE);"
				"  Accelerator(,,SC_CURSOR_UP);"
				"  Break(,,SC_CURSOR_DOWN);"
				"  Left(,,SC_CURSOR_LEFT);"
				"  Right(,,SC_CURSOR_RIGHT);"
				"}"
				"Settings {"
				"  Color(,'c');"
				"  Wider(,'+');"
				"  Narrower(,'-');"
				"  Ends(,'e');"
				"  Layer0(,'0');"
				"  Layer1(,'1');"
				"  Layer2(,'2');"
				"  Layer3(,'3');"
				"  Layer4(,'4');"
				"  Layer5(,'5');"
				"  Layer6(,'6');"
				"  Layer7(,'7');"
				"  Layer8(,'8');"
				"  Layer9(,'9');"
				"}"
				);
	SettingsPush; //See $LK,"SettingsPush",A="MN:SettingsPush"$
	AutoComplete;
	WinBorder;
	WinMax;
	DocCursor;
	DocClear;
	TurtleInit(&tt);
	SetMenu;
	Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_FOCUS_TASK_MENU - WIF_SELF_FOCUS - WIF_SELF_GRAB_SCROLL;
	Fs->draw_it		= &DrawIt;
	try
	{
		/* M196: clear FB like DiskLat before live/idle Refresh. */
		Cls(0);
		head_on = FALSE;
		while (TRUE)
		{
			switch (MessageGet(&arg1, &arg2, 1 << MESSAGE_KEY_DOWN  | 1 << MESSAGE_MS_L_DOWN|
											 1 << MESSAGE_MS_R_DOWN | 1 << MESSAGE_MS_R_UP | 1 << MESSAGE_MS_MOVE))
			{
				case MESSAGE_MS_L_DOWN:
					tt.first = TRUE;
					tt.x	 = arg1;
					tt.y	 = arg2;
					break;

				case MESSAGE_MS_R_DOWN:
					aim = TRUE;
					tt.é = Arg(arg1 - tt.x, arg2 - tt.y);
					break;

				case MESSAGE_MS_MOVE:
					if (aim)
						tt.é = Arg(arg1 - tt.x, arg2 - tt.y);
					break;

				case MESSAGE_MS_R_UP:
					tt.é = Arg(arg1 - tt.x, arg2 - tt.y);
					aim = FALSE;
					break;

				case MESSAGE_KEY_DOWN:
					switch (arg1)
					{
						case 0:
							switch (arg2.u8[0])
							{
								case SC_CURSOR_LEFT:
									if (tt.dé_idx)
										tt.dé_idx--;
									break;

								case SC_CURSOR_RIGHT:
									if (tt.dé_idx < ANGLES - 1)
										tt.dé_idx++;
									break;

								case SC_CURSOR_UP:
									tt.speed += TURTLE_SPEED_STEP;
									break;

								case SC_CURSOR_DOWN:
									if (tt.speed >= TURTLE_SPEED_STEP)
										tt.speed -= TURTLE_SPEED_STEP;
									break;
							}
							break;

						case '0'...'9':
							tt.z = arg1 - '0';
							SetMenu;
							break;

						case 'c':
							tt.middle = PopUpColor("Mid Color\n\n");
							tt.edge   = PopUpColor("Edge Color\n\n");
							break;

						case 'e':
							tt.ends = !tt.ends;
							break;

						case '+':
							tt.w++;
							break;

						case '-':
							if (tt.w)
								tt.w--;
							break;

						case '\r':
						case '\n':
							DCFill(dc);
							TurtleInit(&tt);
							head_on = FALSE;
							SetMenu;
							/* M195: Enter may be CR; restore cues (live also via DCFill chrome). */
							GrPrint(dc, 0, 16, "Esc=exit Enter=restart Space=step c=color +/-=w");
							GrPrint(dc, 0, 24, "L-click=place R-drag=aim e=ends");
							GrPrint(dc, 0, 32, "arrows=dé/speed 0-9=layer");
							break;

						case CH_ESC:
						case CH_SHIFT_ESC:
							goto lt_done;

						case CH_SPACE:
							TurtleMove(dc, &tt, tt.edge, tt.middle);
							/* M194: stroke covered old head - skip BLACK erase. */
							head_on = FALSE;
							break;
					}
			}
			/* M190: WinMgr-shaped paint (stock has no Refresh; bring-up needs it). */
			Refresh;
		}
lt_done:
		MessageGet(,, 1 << MESSAGE_KEY_UP);
	}
	catch
		PutExcept;
	SettingsPop;
	DCFill(dc);
	DCDel(dc);
	MenuPop;
	return 15;
}

/* M197: stock Demo/Graphics/Lattice.ZC entry name (bring-up keeps I64 expect). */
I64 Lattice()
{
	return LatticeSmoke();
}

return Lattice();
