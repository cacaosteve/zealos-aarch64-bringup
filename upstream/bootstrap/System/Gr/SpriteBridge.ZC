// ARM64 implementation of the upstream CDC-to-sprite conversion.
// Gr.HH keeps the concrete sprite-record classes private, so this bridge
// writes the stable ZealOS bitmap-record byte layout directly.
U8 *DC2Sprite(CDC *dc)
{
    U8 *sprite;
    I64 sprite_stride, copy_width, row;
    U8 bitmap_type;
    I32 zero;

    if (!dc || dc->dc_signature != DCS_SIGNATURE_VAL || !dc->body ||
            dc->width <= 0 || dc->width > I32_MAX - 7 || dc->height <= 0 ||
            dc->width_internal <= 0)
        return NULL;
    // Sprite bitmap rows are padded up to eight pixels. Copy each bounded
    // source row separately so a CDC with a wider stride does not shift the
    // next row; unavailable pixels retain the zero-filled sprite background.
    sprite_stride = (dc->width + 7) & ~7;
    copy_width = dc->width_internal;
    if (copy_width > sprite_stride)
        copy_width = sprite_stride;
    sprite = CAlloc(17 + sprite_stride * dc->height + 1);
    if (!sprite)
        return NULL;
    bitmap_type = 23; // SPT_BITMAP
    MemCopy(sprite, &bitmap_type, sizeof(U8));
    zero = 0;
    MemCopy(sprite + 1, &zero, sizeof(I32));
    MemCopy(sprite + 5, &zero, sizeof(I32));
    MemCopy(sprite + 9, &dc->width, sizeof(I32));
    MemCopy(sprite + 13, &dc->height, sizeof(I32));
    for (row = 0; row < dc->height; row++)
        MemCopy(sprite + 17 + row * sprite_stride,
                dc->body + row * dc->width_internal, copy_width);
    // CAlloc leaves the trailing SPT_END byte zeroed.
    return sprite;
}

I64 sprite_debug_type_mask_failures = 0;
I64 sprite_debug_type_mask_last_type = 0;
I64 sprite_debug_type_mask_last_size = 0;

I64 SpriteElemSize(U8 *p, I64 type)
{
    I64 size;
    I32 a, b, packed_a, packed_b, aligned_a, aligned_b;
    U8 ch;
    Bool aligned_header;

    // These sizes follow SpriteElemSize in upstream System/Gr/SpriteNew.ZC.
    // Read packed fields with MemCopy: several records are not naturally
    // aligned, and the guest compiler must not synthesize unaligned loads.
    if (type == SPT_COLOR)
        return 2;
    if (type == SPT_DITHER_COLOR)
        return 4;
    if (type == SPT_THICK)
        return 8;
    if (type == SPT_PLANAR_SYMMETRY)
        return 20;
    if (type == SPT_TRANSFORM_ON || type == SPT_TRANSFORM_OFF)
        return 1;
    if (type == SPT_SHIFT || type == SPT_PT ||
            type == SPT_FLOOD_FILL || type == SPT_FLOOD_FILL_NOT)
        return 12;
    if (type == SPT_LINE || type == SPT_RECT || type == SPT_ARROW)
        return 20;
    if (type == SPT_ROTATED_RECT)
        return 32;
    if (type == SPT_CIRCLE)
        return 16;
    if (type == SPT_ELLIPSE)
        return 32;
    if (type == SPT_POLYGON)
        return 40;
    if (type == SPT_POLYLINE || type == SPT_BSPLINE2 ||
            type == SPT_BSPLINE2_CLOSED || type == SPT_BSPLINE3 ||
            type == SPT_BSPLINE3_CLOSED) {
        MemCopy(&a, p + 4, sizeof(I32));
        if (a < 0 || a > 1048576)
            return -1;
        if (type == SPT_POLYLINE)
            return 8 + a * 8;
        return 8 + a * 12;
    }
    if (type == SPT_POLYPT) {
        MemCopy(&a, p + 4, sizeof(I32));
        if (a < 0 || a > 1048576)
            return -1;
        return 16 + (a * 3 + 7) / 8;
    }
    if (type == SPT_BITMAP) {
        MemCopy(&a, p + 9, sizeof(I32));
        MemCopy(&b, p + 13, sizeof(I32));
        if (a < 0 || a > I32_MAX - 7 || b < 0 || b > 1048576)
            return -1;
        return 17 + ((a + 7) & ~7) * b;
    }
    if (type == SPT_MESH || type == SPT_SHIFTABLE_MESH) {
        aligned_header = p[1] == 0 && p[2] == 0 && p[3] == 0;
        if (type == SPT_MESH) {
            // ZealOS writes the count fields immediately after the type byte.
            // Prefer that exact packed format. Retain the earlier ARM64
            // aligned record format when its packed candidate is invalid.
            MemCopy(&packed_a, p + 1, sizeof(I32));
            MemCopy(&packed_b, p + 5, sizeof(I32));
            MemCopy(&aligned_a, p + 4, sizeof(I32));
            MemCopy(&aligned_b, p + 8, sizeof(I32));
            if (packed_a >= 0 && packed_a <= 1048576 &&
                    packed_b >= 0 && packed_b <= 1048576) {
                a = packed_a;
                b = packed_b;
                size = sizeof(CSpriteMeshU8s);
            } else if (aligned_header && aligned_a >= 0 && aligned_a <= 1048576 &&
                    aligned_b >= 0 && aligned_b <= 1048576) {
                a = aligned_a;
                b = aligned_b;
                size = 12;
            } else
                return -1;
        } else {
            MemCopy(&packed_a, p + 13, sizeof(I32));
            MemCopy(&packed_b, p + 17, sizeof(I32));
            MemCopy(&aligned_a, p + 16, sizeof(I32));
            MemCopy(&aligned_b, p + 20, sizeof(I32));
            if (packed_a >= 0 && packed_a <= 1048576 &&
                    packed_b >= 0 && packed_b <= 1048576) {
                a = packed_a;
                b = packed_b;
                size = sizeof(CSpritePtMeshU8s);
            } else if (aligned_header && aligned_a >= 0 && aligned_a <= 1048576 &&
                    aligned_b >= 0 && aligned_b <= 1048576) {
                a = aligned_a;
                b = aligned_b;
                size = 24;
            } else
                return -1;
        }
        return size + a * 12 + b * 16;
    }
    if (type == SPT_TEXT || type == SPT_TEXT_BOX ||
            type == SPT_TEXT_DIAMOND) {
        size = 12;
        while (size < 1048588) {
            MemCopy(&ch, p + size, sizeof(U8));
            size++;
            if (!ch)
                return size;
        }
        return -1;
    }
    return -1;
}

I64 SpriteTypeMask(U8 *elems)
{
    I64 result = 0, records = 0, size, type;
    U8 *p = elems;
    U8 raw_type;

    if (!p)
        return 1 << SPT_TYPES_NUM;
    while (records < 65536) {
        records++;
        MemCopy(&raw_type, p, sizeof(U8));
        type = raw_type & SPG_TYPE_MASK;
        if (!type)
            return result;
        if (type >= SPT_TYPES_NUM)
        {
            sprite_debug_type_mask_failures++;
            sprite_debug_type_mask_last_type = type;
            sprite_debug_type_mask_last_size = -1;
            return 1 << SPT_TYPES_NUM;
        }
        size = SpriteElemSize(p, type);
        if (size < 1 || size > 16777216)
        {
            sprite_debug_type_mask_failures++;
            sprite_debug_type_mask_last_type = type;
            sprite_debug_type_mask_last_size = size;
            return 1 << SPT_TYPES_NUM;
        }
        result |= 1 << type;
        p += size;
    }
    return 1 << SPT_TYPES_NUM;
}

public CDocEntry *DocSprite(CDoc *doc=NULL, U8 *elems, U8 *format=NULL)
{//Attach a bounded sprite binary to a DolDoc entry for the original Apps.
    I64 size;
    U8 *markup;
    Bool unlock;
    CDocBin *bin;
    CDocEntry *entry;

    if (!elems)
        return NULL;
    if (!doc)
        doc = DocPut;
    if (!doc)
        return NULL;
    size = SpriteSize(elems);
    if (size < 1 || size > 480000)
        return NULL;
    unlock = DocLock(doc);
    bin = CAlloc(sizeof(CDocBin), doc->mem_task);
    if (!bin)
    {
        if (unlock)
            DocUnlock(doc);
        return NULL;
    }
    bin->data = MAlloc(size, doc->mem_task);
    if (!bin->data)
    {
        Free(bin);
        if (unlock)
            DocUnlock(doc);
        return NULL;
    }
    bin->size = size;
    MemCopy(bin->data, elems, size);
    bin->num = doc->cur_bin_num;
    bin->use_count = 1;
    QueueInsert(bin, doc->bin_head.last);
    if (format)
        markup = MStrPrint(format, doc->cur_bin_num++);
    else
        markup = MStrPrint("$$SP,\"\",BI=%d$$", doc->cur_bin_num++);
    entry = DocPutS(doc, markup);
    Free(markup);
    if (!entry)
    {
        QueueRemove(bin);
        Free(bin->data);
        Free(bin);
        if (unlock)
            DocUnlock(doc);
        return NULL;
    }
    entry->bin_data = bin;
    if (entry->de_flags & DOCEF_TAG && entry->tag && *entry->tag)
        bin->tag = StrNew(entry->tag, doc->mem_task);
    if (unlock)
        DocUnlock(doc);
    return entry;
}

I64 sprite_debug_doc_sprite_calls = 0;
I64 sprite_debug_doc_sprite_doc_is_put = 0;
I64 sprite_debug_doc_sprite_doc_is_display = 0;
I64 sprite_debug_doc_sprite_doc_window_is_current = 0;
I64 sprite_debug_doc_sprite_doc_flags = 0;
I64 sprite_debug_doc_sprite_entry_type = -1;
I64 sprite_debug_doc_sprite_has_bin = 0;
U8 *sprite_debug_doc_sprite_task_name = NULL;

public CDocEntry *Sprite(U8 *elems, U8 *format=NULL)
{//Append one sprite to the active graphical terminal document.
    CDoc *doc = DocPut;
    CDocEntry *entry;

    sprite_debug_doc_sprite_calls++;
    sprite_debug_doc_sprite_task_name = NULL;
    if (Fs)
        sprite_debug_doc_sprite_task_name = Fs->task_name;
    sprite_debug_doc_sprite_doc_is_put = doc && Fs && doc == Fs->put_doc;
    sprite_debug_doc_sprite_doc_is_display = doc && Fs && doc == Fs->display_doc;
    sprite_debug_doc_sprite_doc_window_is_current = doc && Fs && doc->win_task == Fs;
    sprite_debug_doc_sprite_doc_flags = 0;
    if (doc)
        sprite_debug_doc_sprite_doc_flags = doc->flags;
    if (!doc)
        return NULL;
    entry = DocSprite(doc, elems, format);
    sprite_debug_doc_sprite_entry_type = -1;
    if (entry)
        sprite_debug_doc_sprite_entry_type = entry->type;
    sprite_debug_doc_sprite_has_bin = entry && entry->bin_data;
    return entry;
}
