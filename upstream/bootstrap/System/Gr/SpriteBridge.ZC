// ARM64 implementation of the upstream CDC-to-sprite conversion.
// Gr.HH keeps the concrete sprite-record classes private, so this bridge
// writes the stable ZealOS bitmap-record byte layout directly.
U8 *DC2Sprite(CDC *dc)
{
    U8 *sprite;
    I64 sprite_stride, copy_width, row;
    U8 bitmap_type;
    I32 zero;

    if (!dc || dc->dc_signature != DCS_SIGNATURE_VAL || !dc->body ||
            dc->width <= 0 || dc->width > I32_MAX - 7 || dc->height <= 0 ||
            dc->width_internal <= 0)
        return NULL;
    // Sprite bitmap rows are padded up to eight pixels. Copy each bounded
    // source row separately so a CDC with a wider stride does not shift the
    // next row; unavailable pixels retain the zero-filled sprite background.
    sprite_stride = (dc->width + 7) & ~7;
    copy_width = dc->width_internal;
    if (copy_width > sprite_stride)
        copy_width = sprite_stride;
    sprite = CAlloc(17 + sprite_stride * dc->height + 1);
    if (!sprite)
        return NULL;
    bitmap_type = 23; // SPT_BITMAP
    MemCopy(sprite, &bitmap_type, sizeof(U8));
    zero = 0;
    MemCopy(sprite + 1, &zero, sizeof(I32));
    MemCopy(sprite + 5, &zero, sizeof(I32));
    MemCopy(sprite + 9, &dc->width, sizeof(I32));
    MemCopy(sprite + 13, &dc->height, sizeof(I32));
    for (row = 0; row < dc->height; row++)
        MemCopy(sprite + 17 + row * sprite_stride,
                dc->body + row * dc->width_internal, copy_width);
    // CAlloc leaves the trailing SPT_END byte zeroed.
    return sprite;
}

I64 sprite_debug_type_mask_failures = 0;
I64 sprite_debug_type_mask_last_type = 0;
I64 sprite_debug_type_mask_last_size = 0;

I64 SpriteElemSizeRaw(U8 *p, I64 type)
{
    I64 size;
    I32 a, b, packed_a, packed_b, aligned_a, aligned_b;
    U8 ch;
    Bool aligned_header;

    if (type < 0 || type >= SPT_TYPES_NUM)
        return -1;
    size = sprite_elem_base_sizes[type];

    // Use the pinned base-size table. Embedded sprite streams are tightly
    // packed: CSpritePtPt is 17 bytes and CSpriteNumU8s is 5 bytes, even when
    // their I32 fields start at unaligned addresses. Read those fields via
    // MemCopy so the guest compiler cannot synthesize unaligned loads.
    if (type == SPT_COLOR || type == SPT_DITHER_COLOR ||
            type == SPT_THICK || type == SPT_PLANAR_SYMMETRY)
        return size;
    if (type == SPT_TRANSFORM_ON || type == SPT_TRANSFORM_OFF)
        return size;
    if (type == SPT_SHIFT || type == SPT_PT ||
            type == SPT_FLOOD_FILL || type == SPT_FLOOD_FILL_NOT)
        return size;
    if (type == SPT_LINE || type == SPT_RECT || type == SPT_ARROW)
        return size;
    if (type == SPT_ROTATED_RECT)
        return size;
    if (type == SPT_CIRCLE)
        return size;
    if (type == SPT_ELLIPSE)
        return size;
    if (type == SPT_POLYGON)
        return size;
    if (type == SPT_POLYLINE || type == SPT_BSPLINE2 ||
            type == SPT_BSPLINE2_CLOSED || type == SPT_BSPLINE3 ||
            type == SPT_BSPLINE3_CLOSED) {
        MemCopy(&a, p + 1, sizeof(I32));
        if (a < 0 || a > 1048576)
            return -1;
        if (type == SPT_POLYLINE)
            return size + a * 8;
        return size + a * 12;
    }
    if (type == SPT_POLYPT) {
        MemCopy(&a, p + 1, sizeof(I32));
        if (a < 0 || a > 1048576)
            return -1;
        return size + (a * 3 + 7) / 8;
    }
    if (type == SPT_BITMAP) {
        MemCopy(&a, p + 9, sizeof(I32));
        MemCopy(&b, p + 13, sizeof(I32));
        if (a < 0 || a > I32_MAX - 7 || b < 0 || b > 1048576)
            return -1;
        return size + ((a + 7) & ~7) * b;
    }
    if (type == SPT_MESH || type == SPT_SHIFTABLE_MESH) {
        aligned_header = p[1] == 0 && p[2] == 0 && p[3] == 0;
        if (type == SPT_MESH) {
            // ZealOS writes the count fields immediately after the type byte.
            // Prefer that exact packed format. Retain the earlier ARM64
            // aligned record format when its packed candidate is invalid.
            MemCopy(&packed_a, p + 1, sizeof(I32));
            MemCopy(&packed_b, p + 5, sizeof(I32));
            MemCopy(&aligned_a, p + 4, sizeof(I32));
            MemCopy(&aligned_b, p + 8, sizeof(I32));
            if (packed_a >= 0 && packed_a <= 1048576 &&
                    packed_b >= 0 && packed_b <= 1048576) {
                a = packed_a;
                b = packed_b;
            size = sprite_elem_base_sizes[type];
            } else if (aligned_header && aligned_a >= 0 && aligned_a <= 1048576 &&
                    aligned_b >= 0 && aligned_b <= 1048576) {
                a = aligned_a;
                b = aligned_b;
                size = 12;
            } else
                return -1;
        } else {
            MemCopy(&packed_a, p + 13, sizeof(I32));
            MemCopy(&packed_b, p + 17, sizeof(I32));
            MemCopy(&aligned_a, p + 16, sizeof(I32));
            MemCopy(&aligned_b, p + 20, sizeof(I32));
            if (packed_a >= 0 && packed_a <= 1048576 &&
                    packed_b >= 0 && packed_b <= 1048576) {
                a = packed_a;
                b = packed_b;
            size = sprite_elem_base_sizes[type];
            } else if (aligned_header && aligned_a >= 0 && aligned_a <= 1048576 &&
                    aligned_b >= 0 && aligned_b <= 1048576) {
                a = aligned_a;
                b = aligned_b;
                size = 24;
            } else
                return -1;
        }
        return size + a * 12 + b * 16;
    }
    if (type == SPT_TEXT || type == SPT_TEXT_BOX ||
            type == SPT_TEXT_DIAMOND) {
        size = sprite_elem_base_sizes[type];
        while (size < 1048588) {
            MemCopy(&ch, p + size, sizeof(U8));
            size++;
            if (!ch)
                return size;
        }
        return -1;
    }
    return -1;
}

public I64 SpriteElemSize(CSprite *sprite)
{//Keep the upstream one-argument API for sprite documents and apps.
    if (!sprite)
        return -1;
    // A CSprite pointer addresses the queue header; the encoded element begins
    // at its zero-sized `start` marker. Keep raw-size parsing based at the
    // element bytes, as SpriteTypeMask does when it walks an embedded stream.
    return SpriteElemSizeRaw(sprite(U8 *) + offset(CSprite.start),
                             sprite->type & SPG_TYPE_MASK);
}

U8 *SpriteColor2Str(U8 *buf, CColorROPU32 color)
{//Provide the color description used by the stock sprite code viewer.
    *buf = 0;
    if (color.c0.rop & ROPBF_TWO_SIDED)
        CatPrint(buf, "TWO|");
    if (color.c0.rop & ROPBF_HALF_RANGE_COLOR)
        CatPrint(buf, "HALF|");
    if (0 <= color.c0.color < 16)
        CatPrint(buf, DefineSub(color.c0.color, "ST_COLORS"));
    else if (color.c0.color == TRANSPARENT)
        CatPrint(buf, "TRANSPARENT");
    else
        CatPrint(buf, "INVALID");
    if (color & ROPF_DITHER)
    {
        CatPrint(buf, "/");
        if (color.c1.rop & ROPBF_TWO_SIDED)
            CatPrint(buf, "TWO|");
        if (color.c1.rop & ROPBF_HALF_RANGE_COLOR)
            CatPrint(buf, "HALF|");
        if (0 <= color.c1.color < 16)
            CatPrint(buf, DefineSub(color.c1.color, "ST_COLORS"));
        else if (color.c1.color == TRANSPARENT)
            CatPrint(buf, "TRANSPARENT");
        else
            CatPrint(buf, "INVALID");
    }
    return buf;
}

public U8 *SpriteElem2Summary(CSprite *tmpg)
{//Match the upstream sprite-text demo while using the ARM64 sprite bridge.
    U8 buf[STR_LEN], buf2[STR_LEN];
    I32 *ptr;

    StrPrint(buf, "%Z", tmpg->type & SPG_TYPE_MASK,
             "ST_SPRITE_ELEM_TYPES");
    switch (tmpg->type & SPG_TYPE_MASK)
    {
        case SPT_COLOR:
            CatPrint(buf, " %s", SpriteColor2Str(buf2, tmpg->c.color));
            break;
        case SPT_DITHER_COLOR:
            CatPrint(buf, " %s", SpriteColor2Str(buf2,
                    ROPF_DITHER | tmpg->d.dither_color.u8[0] |
                    tmpg->d.dither_color.u8[1] << COLORROP_BITS));
            break;
        case SPT_PT:
        case SPT_FLOOD_FILL:
        case SPT_FLOOD_FILL_NOT:
        case SPT_SHIFT:
            CatPrint(buf, " (%d,%d)", tmpg->p.x1, tmpg->p.y1);
            break;
        case SPT_LINE:
        case SPT_ARROW:
        case SPT_PLANAR_SYMMETRY:
        case SPT_RECT:
        case SPT_ROTATED_RECT:
            CatPrint(buf, " (%d,%d),(%d,%d)", tmpg->pp.x1, tmpg->pp.y1,
                     tmpg->pp.x2, tmpg->pp.y2);
            break;
        case SPT_CIRCLE:
            CatPrint(buf, " (%d,%d):%dR", tmpg->pr.x1, tmpg->pr.y1,
                     tmpg->pr.radius);
            break;
        case SPT_THICK:
            CatPrint(buf, " %d", tmpg->t.thick);
            break;
        case SPT_TEXT:
        case SPT_TEXT_BOX:
        case SPT_TEXT_DIAMOND:
            CatPrint(buf, " %d,%d:%-16t$$Q", tmpg->ps.x1, tmpg->ps.y1,
                     tmpg->ps.st);
            break;
        case SPT_POLYLINE:
        case SPT_POLYPT:
            ptr = &tmpg->npu.x;
            CatPrint(buf, " %d (%d,%d)", tmpg->npu.num, ptr[0], ptr[1]);
            break;
        case SPT_ELLIPSE:
        case SPT_POLYGON:
        case SPT_BITMAP:
            CatPrint(buf, " (%d,%d):%dW,%dH", tmpg->pwhu.x1,
                     tmpg->pwhu.y1, tmpg->pwhu.width, tmpg->pwhu.height);
            break;
        case SPT_BSPLINE2:
        case SPT_BSPLINE3:
        case SPT_BSPLINE2_CLOSED:
        case SPT_BSPLINE3_CLOSED:
            CatPrint(buf, " %d", tmpg->nu.num);
            break;
        case SPT_MESH:
            CatPrint(buf, " %dV,%dT", tmpg->mu.vertex_count,
                     tmpg->mu.tri_count);
            break;
        case SPT_SHIFTABLE_MESH:
            CatPrint(buf, " %dV,%dT", tmpg->pmu.vertex_count,
                     tmpg->pmu.tri_count);
            break;
    }
    return StrNew(buf);
}

U0 SpriteElem2Code(CDoc *doc, CSprite *sprite)
{//Port the pinned SpriteCode.ZC source formatter to ARM64 sprite streams.
    U8 buf[STR_LEN], *packed;
    I32 *ptr;
    CD3I32 *point;
    I64 type = sprite->type & SPG_TYPE_MASK;
    I64 i, j, k, col, bit, value, width_internal;

    if (!doc)
        doc = DocPut;
    DocPrint(doc, "%Z", type, "ST_SPRITE_ELEM_CODES");
    switch (type)
    {
        case SPT_COLOR:
            DocPrint(doc, "{%s}", SpriteColor2Str(buf, sprite->c.color));
            break;
        case SPT_DITHER_COLOR:
            DocPrint(doc, "{%s}", SpriteColor2Str(buf,
                    ROPF_DITHER | sprite->d.dither_color.u8[0] |
                    sprite->d.dither_color.u8[1] << COLORROP_BITS));
            break;
        case SPT_TRANSFORM_ON:
            DocPrint(doc, "{ON}");
            break;
        case SPT_TRANSFORM_OFF:
            DocPrint(doc, "{OFF}");
            break;
        case SPT_THICK:
            DocPrint(doc, "{%d}", sprite->t.thick);
            break;
        case SPT_LINE:
        case SPT_ARROW:
        case SPT_PLANAR_SYMMETRY:
            DocPrint(doc, "{(%d,%d),(%d,%d)}", sprite->pp.x1,
                     sprite->pp.y1, sprite->pp.x2, sprite->pp.y2);
            break;
        case SPT_RECT:
            DocPrint(doc, "{(%d,%d):(%d,%d)}", sprite->pp.x1,
                     sprite->pp.y1, sprite->pp.x2 - sprite->pp.x1,
                     sprite->pp.y2 - sprite->pp.y1);
            break;
        case SPT_ROTATED_RECT:
            DocPrint(doc, "{(%d,%d):(%d,%d),%0.4f}", sprite->ppa.x1,
                     sprite->ppa.y1, sprite->ppa.x2 - sprite->ppa.x1,
                     sprite->ppa.y2 - sprite->ppa.y1,
                     180 / π * Wrap(sprite->ppa.angle));
            break;
        case SPT_CIRCLE:
            DocPrint(doc, "{(%d,%d):%d}", sprite->pr.x1, sprite->pr.y1,
                     sprite->pr.radius);
            break;
        case SPT_ELLIPSE:
            DocPrint(doc, "{(%d,%d):(%d,%d),%0.4f}", sprite->pwha.x1,
                     sprite->pwha.y1, sprite->pwha.width, sprite->pwha.height,
                     180 / π * Wrap(sprite->pwha.angle));
            break;
        case SPT_POLYGON:
            DocPrint(doc, "{%d,(%d,%d):(%d,%d),%0.4f}",
                     sprite->pwhas.sides, sprite->pwhas.x1,
                     sprite->pwhas.y1, sprite->pwhas.width,
                     sprite->pwhas.height,
                     180 / π * Wrap(sprite->pwhas.angle));
            break;
        case SPT_PT:
        case SPT_SHIFT:
        case SPT_FLOOD_FILL:
            DocPrint(doc, "{(%d,%d)}", sprite->p.x1, sprite->p.y1);
            break;
        case SPT_FLOOD_FILL_NOT:
            DocPrint(doc, "{(%d,%d),TRUE}", sprite->p.x1, sprite->p.y1);
            break;
        case SPT_TEXT:
        case SPT_TEXT_BOX:
        case SPT_TEXT_DIAMOND:
            DocPrint(doc, "{(%d,%d),\"%Q\"}", sprite->ps.x1,
                     sprite->ps.y1, sprite->ps.st);
            break;
        case SPT_POLYLINE:
            ptr = &sprite->nu.u;
            DocPrint(doc, "{");
            for (i = 0; i < sprite->nu.num; i++, ptr += 2)
            {
                DocPrint(doc, "(%d,%d)", ptr[0], ptr[1]);
                if (i + 1 < sprite->nu.num)
                    DocPrint(doc, ",");
                if ((i & 3) == 3 && i + 1 < sprite->nu.num)
                    DocPrint(doc, "\n");
            }
            DocPrint(doc, "}");
            break;
        case SPT_BSPLINE2:
        case SPT_BSPLINE3:
        case SPT_BSPLINE2_CLOSED:
        case SPT_BSPLINE3_CLOSED:
            ptr = &sprite->nu.u;
            DocPrint(doc, "{");
            for (i = 0; i < sprite->nu.num; i++, ptr += 3)
            {
                DocPrint(doc, "(%d,%d,%d)", ptr[0], ptr[1], ptr[2]);
                if (i + 1 < sprite->nu.num)
                    DocPrint(doc, ",");
                if ((i & 3) == 3 && i + 1 < sprite->nu.num)
                    DocPrint(doc, "\n");
            }
            if (type == SPT_BSPLINE2 || type == SPT_BSPLINE3)
                DocPrint(doc, ",FALSE}");
            else
                DocPrint(doc, ",TRUE}");
            break;
        case SPT_POLYPT:
            DocPrint(doc, "{(%d,%d),", sprite->npu.x, sprite->npu.y);
            packed = &sprite->npu.u;
            col = 16;
            for (i = 0; i < sprite->npu.num; i++)
            {
                bit = i * 3;
                value = packed[bit >> 3] >> (bit & 7);
                if ((bit & 7) > 5)
                    value |= packed[(bit >> 3) + 1] << (8 - (bit & 7));
                DocPrint(doc, "%d", value & 7);
                if (++col >= 64 && i + 1 < sprite->npu.num)
                {
                    DocPrint(doc, "\n");
                    col = 0;
                }
            }
            DocPrint(doc, "}");
            break;
        case SPT_BITMAP:
            DocPrint(doc, "{(%d,%d):(%d,%d),\n", sprite->pwhu.x1,
                     sprite->pwhu.y1, sprite->pwhu.width,
                     sprite->pwhu.height);
            width_internal = (sprite->pwhu.width + 7) & ~7;
            if (width_internal < 80)
                k = width_internal;
            else
                k = 64;
            packed = &sprite->pwhu.u;
            col = 0;
            for (j = 0; j < sprite->pwhu.height; j++)
                for (i = 0; i < width_internal; i++, packed++)
                {
                    if (i >= sprite->pwhu.width)
                        DocPrint(doc, "_");
                    else if (*packed < 16)
                        DocPrint(doc, "%X", *packed);
                    else
                        DocPrint(doc, " ");
                    if (++col >= k &&
                            (i + 1 < width_internal ||
                             j + 1 < sprite->pwhu.height))
                    {
                        DocPrint(doc, "\n");
                        col = 0;
                    }
                }
            DocPrint(doc, "}");
            break;
        case SPT_MESH:
            DocPrint(doc, "{FALSE,");
            point = &sprite->mu.u;
            col = 0;
            for (i = 0; i < sprite->mu.vertex_count; i++, point++)
            {
                DocPrint(doc, "(%d,%d,%d)", point->x, point->y, point->z);
                if (i + 1 < sprite->mu.vertex_count)
                    DocPrint(doc, ",");
                if (++col == 4)
                {
                    DocPrint(doc, "\t//%d\n", i);
                    col = 0;
                }
            }
            DocPrint(doc, ":/* %d triangles */", sprite->mu.tri_count);
            DocPrint(doc, "}");
            break;
        case SPT_SHIFTABLE_MESH:
            DocPrint(doc, "{TRUE,(%d,%d,%d):", sprite->pmu.x,
                     sprite->pmu.y, sprite->pmu.z);
            point = &sprite->pmu.u;
            col = 1;
            for (i = 0; i < sprite->pmu.vertex_count; i++, point++)
            {
                DocPrint(doc, "(%d,%d,%d)", point->x, point->y, point->z);
                if (i + 1 < sprite->pmu.vertex_count)
                    DocPrint(doc, ",");
                if (++col == 4)
                {
                    DocPrint(doc, "\t//%d\n", i);
                    col = 0;
                }
            }
            DocPrint(doc, ":/* %d triangles */", sprite->pmu.tri_count);
            DocPrint(doc, "}");
            break;
        default:
            DocPrint(doc, "{/* unknown sprite element %d */}", type);
            break;
    }
    DocPrint(doc, ";\n");
}

public U0 Sprite2Code(CDoc *doc=NULL, U8 *elems)
{//Render the embedded sprite stream as editable source code.
    CSprite *sprite = elems - offset(CSprite.start);

    if (!doc)
        doc = DocPut;
    while (sprite->type & SPG_TYPE_MASK)
    {
        SpriteElem2Code(doc, sprite);
        sprite(U8 *) += SpriteElemSize(sprite);
    }
}

I64 SpriteTypeMask(U8 *elems)
{
    I64 result = 0, records = 0, size, type;
    U8 *p = elems;
    U8 raw_type;

    if (!p)
        return 1 << SPT_TYPES_NUM;
    while (records < 65536) {
        records++;
        MemCopy(&raw_type, p, sizeof(U8));
        type = raw_type & SPG_TYPE_MASK;
        if (!type)
            return result;
        if (type >= SPT_TYPES_NUM)
        {
            sprite_debug_type_mask_failures++;
            sprite_debug_type_mask_last_type = type;
            sprite_debug_type_mask_last_size = -1;
            return 1 << SPT_TYPES_NUM;
        }
        size = SpriteElemSizeRaw(p, type);
        if (size < 1 || size > 16777216)
        {
            sprite_debug_type_mask_failures++;
            sprite_debug_type_mask_last_type = type;
            sprite_debug_type_mask_last_size = size;
            return 1 << SPT_TYPES_NUM;
        }
        result |= 1 << type;
        p += size;
    }
    return 1 << SPT_TYPES_NUM;
}

public CDocEntry *DocSprite(CDoc *doc=NULL, U8 *elems, U8 *format=NULL)
{//Attach a bounded sprite binary to a DolDoc entry for the original Apps.
    I64 size;
    U8 *markup;
    Bool unlock;
    CDocBin *bin;
    CDocEntry *entry;

    if (!elems)
        return NULL;
    if (!doc)
        doc = DocPut;
    if (!doc)
        return NULL;
    size = SpriteSize(elems);
    if (size < 1 || size > 480000)
        return NULL;
    unlock = DocLock(doc);
    bin = CAlloc(sizeof(CDocBin), doc->mem_task);
    if (!bin)
    {
        if (unlock)
            DocUnlock(doc);
        return NULL;
    }
    bin->data = MAlloc(size, doc->mem_task);
    if (!bin->data)
    {
        Free(bin);
        if (unlock)
            DocUnlock(doc);
        return NULL;
    }
    bin->size = size;
    MemCopy(bin->data, elems, size);
    bin->num = doc->cur_bin_num;
    bin->use_count = 1;
    QueueInsert(bin, doc->bin_head.last);
    if (format)
        markup = MStrPrint(format, doc->cur_bin_num++);
    else
        markup = MStrPrint("$$SP,\"\",BI=%d$$", doc->cur_bin_num++);
    entry = DocPutS(doc, markup);
    Free(markup);
    if (!entry)
    {
        QueueRemove(bin);
        Free(bin->data);
        Free(bin);
        if (unlock)
            DocUnlock(doc);
        return NULL;
    }
    entry->bin_data = bin;
    if (entry->de_flags & DOCEF_TAG && entry->tag && *entry->tag)
        bin->tag = StrNew(entry->tag, doc->mem_task);
    if (unlock)
        DocUnlock(doc);
    return entry;
}

I64 sprite_debug_doc_sprite_calls = 0;
I64 sprite_debug_doc_sprite_doc_is_put = 0;
I64 sprite_debug_doc_sprite_doc_is_display = 0;
I64 sprite_debug_doc_sprite_doc_window_is_current = 0;
I64 sprite_debug_doc_sprite_doc_flags = 0;
I64 sprite_debug_doc_sprite_entry_type = -1;
I64 sprite_debug_doc_sprite_has_bin = 0;
U8 *sprite_debug_doc_sprite_task_name = NULL;

public CDocEntry *Sprite(U8 *elems, U8 *format=NULL)
{//Append one sprite to the active graphical terminal document.
    CDoc *doc = DocPut;
    CDocEntry *entry;

    sprite_debug_doc_sprite_calls++;
    sprite_debug_doc_sprite_task_name = NULL;
    if (Fs)
        sprite_debug_doc_sprite_task_name = Fs->task_name;
    sprite_debug_doc_sprite_doc_is_put = doc && Fs && doc == Fs->put_doc;
    sprite_debug_doc_sprite_doc_is_display = doc && Fs && doc == Fs->display_doc;
    sprite_debug_doc_sprite_doc_window_is_current = doc && Fs && doc->win_task == Fs;
    sprite_debug_doc_sprite_doc_flags = 0;
    if (doc)
        sprite_debug_doc_sprite_doc_flags = doc->flags;
    if (!doc)
        return NULL;
    entry = DocSprite(doc, elems, format);
    sprite_debug_doc_sprite_entry_type = -1;
    if (entry)
        sprite_debug_doc_sprite_entry_type = entry->type;
    sprite_debug_doc_sprite_has_bin = entry && entry->bin_data;
    return entry;
}

Bool SpritePolyReflect0(CDC *dc, I64 *x, I64 *y, I64 *z)
{//Reflect into the half-space nearest the CDC symmetry origin.
    F64 nx, ny, nz, distance, rx, ry, rz, original_distance2,
            reflected_distance2;

    if (!dc || !x || !y || !z)
        return FALSE;
    nx = ToF64(dc->sym.snx) / 65536.0;
    ny = ToF64(dc->sym.sny) / 65536.0;
    nz = ToF64(dc->sym.snz) / 65536.0;
    distance = (ToF64(*x - dc->sym.sx) * nx +
            ToF64(*y - dc->sym.sy) * ny +
            ToF64(*z - dc->sym.sz) * nz) * 2.0;
    rx = ToF64(*x) - distance * nx;
    ry = ToF64(*y) - distance * ny;
    rz = ToF64(*z) - distance * nz;
    original_distance2 = ToF64(*x - dc->sym.sx) * (*x - dc->sym.sx) +
            ToF64(*y - dc->sym.sy) * (*y - dc->sym.sy) +
            ToF64(*z - dc->sym.sz) * (*z - dc->sym.sz);
    reflected_distance2 = Sqr(rx - dc->sym.sx) + Sqr(ry - dc->sym.sy) +
            Sqr(rz - dc->sym.sz);
    if (reflected_distance2 < original_distance2)
    {
        if (rx < I32_MIN || rx > I32_MAX || ry < I32_MIN || ry > I32_MAX ||
                rz < I32_MIN || rz > I32_MAX)
            return FALSE;
        *x = ToI64(rx);
        *y = ToI64(ry);
        *z = ToI64(rz);
    }
    return TRUE;
}

public I64 GrFillPoly3(CDC *dc=gr.dc, I64 vertex_count, CD3I32 *vertices)
{//Fill a bounded 3D polygon as a fan of upstream depth-tested triangles.
    CD3I32 points[64];
    I64 px[3], py[3], pz[3], mx[3], my[3], mz[3];
    I64 i, j, total_work = 0, work;
    I64 x, y, z, old_z;
    I32 base_color;
    CColorROPU32 old_color;
    Bool transform_enabled, symmetry_enabled, just_mirror, mirror_ok;

    if (!dc || !vertices || vertex_count < 3 || vertex_count > 64 ||
            dc->width <= 0 || dc->height <= 0)
        return 0;
    transform_enabled = dc->flags & DCF_TRANSFORMATION;
    symmetry_enabled = dc->flags & DCF_SYMMETRY;
    just_mirror = dc->flags & DCF_JUST_MIRROR;
    old_color = dc->color;
    old_z = dc->db_z;
    base_color = dc->color.c0.color;
    for (i = 0; i < vertex_count; i++)
    {
        x = vertices[i].x;
        y = vertices[i].y;
        z = vertices[i].z;
        if (!SpriteTransformXYZ0(dc, transform_enabled, &x, &y, &z) ||
                x < I32_MIN || x > I32_MAX || y < I32_MIN ||
                y > I32_MAX || z < I32_MIN || z > I32_MAX)
            return 0;
        points[i].x = x;
        points[i].y = y;
        points[i].z = z;
    }

    // Preflight all fan triangles before changing the framebuffer, so invalid
    // or pathological geometry cannot leave a partially drawn polygon.
    for (i = 1; i < vertex_count - 1; i++)
    {
        px[0] = points[0].x; py[0] = points[0].y; pz[0] = points[0].z;
        px[1] = points[i].x; py[1] = points[i].y; pz[1] = points[i].z;
        px[2] = points[i + 1].x; py[2] = points[i + 1].y;
        pz[2] = points[i + 1].z;
        work = SpriteTriangleWork0(dc, px, py);
        if (work < 0 || work > 480000 - total_work)
            return 0;
        total_work += work;
        if (symmetry_enabled)
        {
            for (j = 0; j < 3; j++)
            {
                x = px[j]; y = py[j]; z = pz[j];
                if (!SpritePolyReflect0(dc, &x, &y, &z))
                    return 0;
                mx[j] = x; my[j] = y; mz[j] = z;
            }
            work = SpriteTriangleWork0(dc, mx, my);
            if (work < 0 || work > 480000 - total_work)
                return 0;
            total_work += work;
        }
    }

    for (i = 1; i < vertex_count - 1; i++)
    {
        px[0] = points[0].x; py[0] = points[0].y; pz[0] = points[0].z;
        px[1] = points[i].x; py[1] = points[i].y; pz[1] = points[i].z;
        px[2] = points[i + 1].x; py[2] = points[i + 1].y;
        pz[2] = points[i + 1].z;
        mirror_ok = symmetry_enabled;
        if (mirror_ok)
        {
            for (j = 0; j < 3; j++)
            {
                x = px[j]; y = py[j]; z = pz[j];
                if (!SpritePolyReflect0(dc, &x, &y, &z))
                    return 0;
                mx[j] = x; my[j] = y; mz[j] = z;
            }
            if (!just_mirror)
            {
                if (dc->lighting)
                    (*dc->lighting)(dc, &points[0], &points[i + 1],
                            &points[i], base_color);
                SpriteFillTriangle0(dc, mx, my, mz);
            }
        }
        if (!just_mirror)
        {
            dc->color = old_color;
            if (dc->lighting)
                (*dc->lighting)(dc, &points[0], &points[i],
                        &points[i + 1], base_color);
            SpriteFillTriangle0(dc, px, py, pz);
        }
        else if (symmetry_enabled)
        {
            dc->color = old_color;
            if (dc->lighting)
                (*dc->lighting)(dc, &points[0], &points[i + 1],
                        &points[i], base_color);
            SpriteFillTriangle0(dc, mx, my, mz);
        }
    }
    dc->color = old_color;
    dc->db_z = old_z;
    return total_work;
}
