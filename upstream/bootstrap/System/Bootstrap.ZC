// Bootstrap API surface, not a replacement for the full KernelA/KernelB.
// Primitive aliases are local scaffolding; upstream QuickSort is unchanged.
#define U8 U8i
#define I8 I8i
#define U16 U16i
#define I16 I16i
#define U32 U32i
#define I32 I32i
#define U64 U64i
#define I64 I64i
#define Bool U8i
#define NULL 0
#define TRUE 1
#define FALSE 0
extern U8 *MAlloc(I64 size, I64 mem_task=NULL);
extern U0 Free(U8 *ptr);
extern I64 MSize(U8 *ptr);
extern I64 MSize2(U8 *ptr);
extern U8 *MemCopy(U8 *dst,U8 *src,I64 count);
extern U8 *MemSet(U8 *dst,I64 byte,I64 count);
extern I64 SwapI64(I64 *a,I64 *b);
extern U0 Puts(U8 *text);
// Temporary cooperative task bridge. These are not ZealOS Spawn/Yield APIs.
extern I64 ZcTaskSpawn(I64 (*entry)());
extern I64 ZcTaskYield();
extern I64 ZcTaskRun();
extern I64 ZcTaskResult(I64 task_num);
// Direct text-cell output for the freestanding framebuffer bridge. These
// names must exist before native host symbols are bound during zc_init.
extern I64 ZcFbTextSpan(I64 x, I64 y, I64 len, I64 attr, U8 *data,
                        I64 mode, I64 left_right, I64 top_bottom,
                        U32 *text_base, I64 stride);
extern I64 ZcFbTextCellsDrawn();
extern I64 ZcFbTextPixel(I64 x, I64 y);
extern I64 ZcFbScreenWidth();
extern I64 ZcFbScreenHeight();
extern Bool ZcFbGraphPlot(I64 x, I64 y, U32 color,
                         I64 left, I64 top, I64 right, I64 bottom);
extern Bool ZcFbGraphRect(I64 x, I64 y, I64 width, I64 height, U32 color,
                         I64 left, I64 top, I64 right, I64 bottom);
extern I64 ZcFbGraphText(I64 x, I64 y, U32 color,
                        I64 left, I64 top, I64 right, I64 bottom, U8 *text);
extern Bool ZcFbGraphLine(I64 x0, I64 y0, I64 x1, I64 y1, U32 color,
                         I64 step, I64 start,
                         I64 left, I64 top, I64 right, I64 bottom);
extern Bool ZcFbTextChar(I64 x, I64 y, U32 cell, Bool allow_border,
                         I64 left_right, I64 top_bottom,
                         U32 *text_base, I64 stride);
extern I64 ZcFbTextFill(I64 x, I64 y, I64 len, U32 attr,
                        I64 left_right, I64 top_bottom,
                        U32 *text_base, I64 stride);
extern I64 ZcFbTextRect(I64 left, I64 right, I64 top, I64 bottom, U32 cell,
                        U32 *text_base, I64 stride);
extern I64 ZcFbTextFlush(U32 *text_base, I64 stride, I64 rows);
extern I64 ZcFbTextFlushRect(U32 *text_base, I64 stride, I64 left, I64 right,
                             I64 top, I64 bottom);
extern I64 ZcFbTaskTextCompose(I64 task, U32 *text_base, I64 stride);
extern I64 ZcFbShellTextCompose(U32 *text_base, I64 stride);
// Temporary ARM64 bootstrap binding for the table initialized by upstream KMain.
extern F64 *pow10_I64;
