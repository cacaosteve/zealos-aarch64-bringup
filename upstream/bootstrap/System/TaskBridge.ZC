extern Bool CtrlDispatchWheel(CTask *task, I64 delta);
extern Bool WinHorz(I64 left, I64 right, CTask *task = NULL);
extern Bool WinVert(I64 top, I64 bottom, CTask *task = NULL);
// ARM64 exception pads are private to each cooperative guest task. The
// compiler emits AIWNIOS_SetJmp(ZcTryEnter()) for guest try/catch. These
// names intentionally avoid ZealOS's native SysTry(start_label, skip_label).
extern U8 *ZcTryEnter();
extern U0 ZcTryLeave();
extern U0 ZcTryCatchEnd();
extern I64 AIWNIOS_SetJmp(U8 *pad);
extern U0 throw(I64 ch=0, Bool no_log=FALSE);
