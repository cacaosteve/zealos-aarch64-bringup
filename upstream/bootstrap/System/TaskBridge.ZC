I64 StrCompare(U8 *s1, U8 *s2)
{
    I64 i = 0;

    if (!s1)
        s1 = "";
    if (!s2)
        s2 = "";
    while (s1[i] && s1[i] == s2[i])
        i++;
    return s1[i] - s2[i];
}
// DocNew.ZC owns the real DocLock/DocUnlock; stubs break the DocBin↔DocNew
// load cycle until both modules are present.
Bool DocLock(CDoc *doc)
{
    if (!doc)
        return FALSE;
    if (!Bt(&doc->locked_flags, DOClf_LOCKED) || doc->owning_task != Fs)
    {
        while (LBts(&doc->locked_flags, DOClf_LOCKED))
            Yield;
        if (doc->owning_task != Fs)
            LBEqual(&doc->flags, DOCf_BREAK_UNLOCKED, BreakLock(Fs));
        doc->owning_task = Fs;
        return TRUE;
    }
    return FALSE;
}
Bool DocUnlock(CDoc *doc)
{
    Bool unlock_break;

    if (!doc)
        return FALSE;
    if (Bt(&doc->locked_flags, DOClf_LOCKED) && doc->owning_task == Fs)
    {
        doc->owning_task = NULL;
        unlock_break = Bt(&doc->flags, DOCf_BREAK_UNLOCKED);
        LBtr(&doc->locked_flags, DOClf_LOCKED);
        if (unlock_break)
            BreakUnlock(Fs);
        return TRUE;
    }
    return FALSE;
}
// StrA helpers used by DocBinPtrReset before Kernel/StrA.ZC loads.
I64 StrOcc(U8 *src, I64 ch)
{
    I64 i = 0;

    if (!src)
        return 0;
    while (*src)
        if (*src++ == ch)
            i++;
    return i;
}
U8 *StrLastOcc(U8 *src, U8 *marker)
{
    I64 ch;
    U8 *res = NULL;

    if (!src || !marker)
        return NULL;
    while (ch = *src++)
        if (StrOcc(marker, ch))
            res = src - 1;
    return res;
}
U8 *StrLastRemove(U8 *src, U8 *marker, U8 *dst=NULL)
{
    U8 *ptr;

    if (!src)
        return dst;
    if (ptr = StrLastOcc(src, marker))
    {
        if (dst)
            StrCopy(dst, ptr + 1);
        *ptr = 0;
    }
    else
    {
        if (dst)
            StrCopy(dst, src);
        *src = 0;
    }
    return dst;
}
// Bounded Str2I64 for DocBin tag/num suffixes; full StrScan.ZC comes later.
I64 Str2I64(U8 *st, I64 radix=10, U8 **_end_ptr=NULL)
{
    Bool neg = FALSE;
    I64 ch, res = 0, digit;

    if (!st || radix < 2 || radix > 36)
    {
        if (_end_ptr)
            *_end_ptr = st;
        return 0;
    }
    while (*st == ' ' || *st == '\t')
        st++;
    if (*st == '+' || *st == '-')
        neg = *st++ == '-';
    if (*st == '0')
    {
        st++;
        ch = *st;
        if (ch == 'x' || ch == 'X')
        {
            radix = 16;
            st++;
        }
        else if (ch == 'b' || ch == 'B')
        {
            radix = 2;
            st++;
        }
        else if (ch == 'o' || ch == 'O')
        {
            radix = 8;
            st++;
        }
        else if (ch == 'd' || ch == 'D')
        {
            radix = 10;
            st++;
        }
        else
            st--;
    }
    while (ch = *st)
    {
        if ('0' <= ch <= '9')
            digit = ch - '0';
        else if ('A' <= ch <= 'Z')
            digit = ch - 'A' + 10;
        else if ('a' <= ch <= 'z')
            digit = ch - 'a' + 10;
        else
            break;
        if (digit >= radix)
            break;
        res = res * radix + digit;
        st++;
    }
    if (_end_ptr)
        *_end_ptr = st;
    if (neg)
        return -res;
    return res;
}
