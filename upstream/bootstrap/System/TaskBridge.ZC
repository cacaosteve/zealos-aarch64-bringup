U0 TextLenAttrStr(CTask *task, I64 x, I64 y, I64 len, U32 *str)
{
    if (!task || !str || len <= 0)
        return;
    ZcFbTextSpan(task->win_left + x + (task->scroll_x >> 3),
                 task->win_top + y + (task->scroll_y >> 3), len, 0,
                 str, 1, task->win_left | task->win_right << 16,
                 task->win_top | task->win_bottom << 16);
}
Bool TextLenAttr(CTask *task, I64 x, I64 y, I64 len, I64 attr)
{//Direct framebuffer equivalent for empty attributed cells (e.g. line-tail fill).
    if (!task || len <= 0)
        return FALSE;
    return ZcFbTextFill(task->win_left + x + (task->scroll_x >> 3),
                        task->win_top + y + (task->scroll_y >> 3), len, attr,
                        task->win_left | task->win_right << 16,
                        task->win_top | task->win_bottom << 16) >= 0;
}
U0 TextBorder(CTask *task, I64 x1, I64 x2, I64 y1, I64 y2, U8 color, Bool solid)
{//CP437 border glyphs match text.border_chars initialized by upstream KMain.
    I64 i, attr, tl, tr, bl, br, horz, vert;
    if (!task)
        task = Fs;
    if (!task || x1 > x2 || y1 > y2 || x1 < -1 || y1 < -1 ||
        x2 > 4096 || y2 > 4096 || x2 - x1 > 4096 || y2 - y1 > 4096)
        return;
    attr = color << 8;
    if (solid)
    {
        tl = 0xc9; tr = 0xbb; bl = 0xc8; br = 0xbc;
        horz = 0xcd; vert = 0xba;
    }
    else
    {
        tl = 0xda; tr = 0xbf; bl = 0xc0; br = 0xd9;
        horz = 0xc4; vert = 0xb3;
    }
    TextChar(task, TRUE, x1 - 1, y1 - 1, tl | attr);
    TextChar(task, TRUE, x2 + 1, y1 - 1, tr | attr);
    TextChar(task, TRUE, x1 - 1, y2 + 1, bl | attr);
    TextChar(task, TRUE, x2 + 1, y2 + 1, br | attr);
    for (i = x1; i <= x2; i++)
    {
        TextChar(task, TRUE, i, y1 - 1, horz | attr);
        TextChar(task, TRUE, i, y2 + 1, horz | attr);
    }
    for (i = y1; i <= y2; i++)
    {
        TextChar(task, TRUE, x1 - 1, i, vert | attr);
        TextChar(task, TRUE, x2 + 1, i, vert | attr);
    }
}
U0 TextRect(I64 left, I64 right, I64 top, I64 bottom, I64 cell)
{//Update the shared bounded text-cell plane and present the clipped rectangle.
    if (left > right || top > bottom)
        return;
    ZcFbTextRect(left, right, top, bottom, cell);
}
Bool bootstrap_batch_redraw = FALSE;
U0 GrUpdateTaskWin(CTask *task)
{//Single-task bootstrap redraw: border, cell clear, DolDoc, then plane flush.
    if (!task || !TaskValidate(task))
        return;
    if (!(task->display_flags & (1 << DISPLAYf_NO_BORDER)))
        TextBorder(Fs, task->win_left, task->win_right,
                   task->win_top, task->win_bottom,
                   task->border_attr, task == sys_focus_task);
    TextRect(task->win_left, task->win_right,
             task->win_top, task->win_bottom, task->text_attr << 8);
    if (!(task->win_inhibit & (1 << WIf_SELF_DOC)))
        DocUpdateTaskDocs(task);
    if (!bootstrap_batch_redraw)
        ZcFbTextFlush();
}
U0 GrUpdateTasks()
{//Bounded one-CPU window-ring refresh, drawn in ZealOS task/z order.
    CTask *root, *task;
    I64 visited = 0;

    root = sys_winmgr_task;
    if (!root)
        root = sys_task;
    if (!root || !TaskValidate(root))
        return;

    TextRect(0, TEXT_COLS - 1, 0, TEXT_ROWS - 1, 0x0800);
    bootstrap_batch_redraw = TRUE;
    task = root;
    do
    {
        if (!TaskValidate(task))
            break;
        if (task->display_flags & (1 << DISPLAYf_SHOW))
            GrUpdateTaskWin(task);
        task = task->next_task;
        visited++;
    }
    while (task && task != root && visited < 64);
    bootstrap_batch_redraw = FALSE;
    ZcFbTextFlush();
}
