// One framebuffer is shared by this bootstrap shell, so cross-window DC aliasing is identity.
// The bootstrap framebuffer is 800x600; keep this storage independent of the
// text-plane constants declared below so the forward CDC stub can use it.
U8 bootstrap_graphics_pixels[800 * 600];
CDC bootstrap_graphics_dc;
bootstrap_graphics_dc.body = bootstrap_graphics_pixels;
bootstrap_graphics_dc.width = 800;
bootstrap_graphics_dc.width_internal = 800;
bootstrap_graphics_dc.height = 600;
CDC *DCAlias(CDC *dc, CTask *task=NULL)
{
    if (!task)
        task = Fs;
    if (!dc)
        dc = &bootstrap_graphics_dc;
    dc->width = ZcFbScreenWidth();
    dc->width_internal = dc->width & ~7;
    dc->height = ZcFbScreenHeight();
    dc->flags = DCF_SCREEN_BITMAP;
    dc->win_task = task;
    dc->dc_signature = DCS_SIGNATURE_VAL;
    dc->color.c0.color = WHITE;
    dc->color.c0.rop = ROPB_MONO;
    dc->depth_buf = NULL;
    return dc;
}
