// ARM64 bootstrap bindings for the single-CPU, cooperative subset of the
// signatures in pinned Kernel/KTask.ZC and Kernel/Sched.ZC. The original
// x86 assembly scheduler and task startup are not loaded here.
// Pinned Message.ZC spells the x86 interrupt-mask instruction without a
// semicolon. Preserve its queue critical section through the IF bit mapping.
// RFlagsGet/Set expose only that bit on ARM64, not the full x86 flags word.
#define CLI RFlagsSet(RFlagsGet & ~(1 << 9));
// The x86 PUSHFD/POPFD pairs in pinned modules only need IF preservation
// in this single-CPU bridge. Saving state across a task switch is rejected.
#define PUSHFD RFlagsPush();
#define POPFD RFlagsPop();
// Job.ZC spins with PAUSE while a job-control lock is held. On this
// single-CPU cooperative bridge the lock is only contended by the same
// task, so a spin hint is enough; do not Yield under CLI.
#define PAUSE ;
extern U0 RFlagsPush();
extern U0 RFlagsPop();
extern I64 ZcFbTextSpan(I64 x, I64 y, I64 len, I64 attr, U8 *data,
                        I64 mode, I64 left_right, I64 top_bottom);
extern I64 ZcFbTextCellsDrawn();
// Poll the current virtio/UART key reader and queue its events for the focus
// task. PS/2 mouse polling is outside this bridge.
extern U0 KbdMouseHandler(Bool poll_kbd, Bool poll_mouse);
extern I64 KbdMessagesQueue();
// ARM64 exception pads are private to each cooperative guest task. The
// compiler emits AIWNIOS_SetJmp(SysTry()) for HolyC try/catch.
extern U8 *SysTry();
extern U0 SysUntry();
extern U0 EndCatch();
extern I64 AIWNIOS_SetJmp(U8 *pad);
extern U0 throw(I64 ch=0, Bool no_log=FALSE);
// The initial ExePrint bridge accepts the source-job form used by pinned
// InputFilterTask and Job.ZC: ExePrint("%s", source). Other formats remain
// compiler-runtime work.
extern I64 ExePrint(U8 *format, U8 *source);
// Aiwnios lowers bare string statements to Print(format, argc, argv).
// The bridge renders a bounded text subset until ZealOS StrPrintJoin/Doc
// output is available. Styling markers used by CharGet are stripped.
extern U0 Print(U8 *format, ...);
// KeyDev.ZC normally routes PutKey through a chain of output devices.
// Until that chain is loaded, the bridge sends printable ASCII to its text
// output and honors the task's DISPLAYf_SILENT flag.
extern U0 PutKey(I64 ch=0, I64 sc=0);
// KMisc.ZC defines IsRaw from DISPLAYf_NOT_RAW. Boot into the current
// text/Doc-style console mode and retain this flag across child tasks.
Bool IsRaw()
{
    return !(Fs->display_flags & (1 << DISPLAYf_NOT_RAW));
}
// KMisc.ZC Raw toggles BLACK & WHITE direct-screen mode. LFBFlush is a no-op
// on this bridge and is defined later; the flag alone switches PutKey/PutS off
// the KDRaw handlers.
Bool Raw(Bool val)
{
    return !LBEqual(&Fs->display_flags, DISPLAYf_NOT_RAW, !val);
}
// The raw-cursor cadence in Message.ZC divides TSCGet by this frequency.
// The bridge fills it from the ARM generic timer's CNTFRQ_EL0.
extern CCountsGlobals counts;
// No ZealOS debugger task or PS/2 polling loop is present in this build.
Bool IsDebugMode()
{
    return FALSE;
}
