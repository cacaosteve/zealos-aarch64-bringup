// SerialDev/Message.ZC key API over queued messages. Without explicit focus,
// device input belongs to the task scanning its queue. KernelB.HH's
// sys_focus_task redirects it to a live focused task, including a parked child.
// Raw-cursor display is not bound yet.
extern Bool KeyScan(I64 *_ch=NULL, I64 *_scan_code=NULL, Bool echo=FALSE);
extern I64 KeyGet(I64 *_scan_code=NULL, Bool echo=FALSE,
                  Bool raw_cursor=FALSE);
// Before DolDoc takes over fp_getstr2, pinned KDebug.SysGetStr2 reads a
// 512-byte line with StrNGet(..., FALSE) and returns a heap copy. Keep the
// same input ownership contract on the current task's heap.
U8 *BootstrapGetStr2(I64 flags=0)
{
    U8 buf[512], erase[4] = {CH_BACKSPACE, ' ', CH_BACKSPACE, 0}, *result;
    I64 ch, used = 0;

    while (TRUE)
    {
        // KeyGet marks this task as awaiting input and yields. The native
        // scheduler pumps virtio/UART bytes into its message queue there.
        ch = KeyGet(, FALSE, FALSE);
        if (ch == '\n' || ch == '\r')
        {
            Puts("\n");
            break;
        }
        else if (ch == CH_BACKSPACE)
        {
            if (used)
            {
                used--;
                Puts(erase);
            }
        }
        else if (ch >= 32 && ch < 127 && used < 511)
        {
            buf[used++] = ch;
            PutKey(ch);
        }
    }
    buf[used] = 0;
    result = MAlloc(used + 1);
    MemCopy(result, buf, used + 1);
    return result;
}
U8 *(*fp_getstr2)(I64 flags=0) = &BootstrapGetStr2;
// These string primitives are needed by StrGet/StrNGet in Message.ZC until
// their original kernel implementation is loaded.
I64 BootstrapStrLen(U8 *source)
{
    I64 length = 0;
    while (source[length])
        length++;
    return length;
}
U8 *StrNew(U8 *source, CTask *mem_task=NULL)
{
    I64 bytes = 1;
    if (source)
        bytes = BootstrapStrLen(source) + 1;
    U8 *result = MAlloc(bytes, mem_task);
    if (source)
        MemCopy(result, source, bytes);
    else
        *result = 0;
    return result;
}
U0 StrCopy(U8 *dest, U8 *source)
{
    MemCopy(dest, source, BootstrapStrLen(source) + 1);
}
// Pinned Job.ZC allocates jobs on the System heap. Until Mem/MAllocFree.ZC
// loads, map those helpers onto the current task heap used by MAlloc.
U8 *CAlloc(I64 size, CTask *mem_task=NULL)
{
    U8 *result = MAlloc(size, mem_task);
    if (result)
        MemSet(result, 0, size);
    return result;
}
U8 *SysCAlloc(I64 size)
{
    return CAlloc(size);
}
U8 *SysStrNew(U8 *buf)
{
    return StrNew(buf);
}
U8 *MAllocIdent(U8 *src, CTask *mem_task=NULL)
{
    I64 size;
    U8 *result;

    if (!src)
        return NULL;
    size = MSize(src);
    result = MAlloc(size, mem_task);
    MemCopy(result, src, size);
    return result;
}
U8 *SysMAllocIdent(U8 *src)
{
    return MAllocIdent(src);
}
// Job.ZC's TaskMessage may record macros when SEMA_RECORD_MACRO is set.
// Recording is absent here; keep empty placeholders so the unchanged source
// type-checks. sys_semas itself is host-bound to a zeroed array.
CTask *sys_macro_task = NULL;
CJob sys_macro_head;
U0 BootstrapJobGlbls()
{
    QueueInit(&sys_macro_head);
}
