Bool IsPixCovered0(CTask *task, I64 x, I64 y)
{//Match GrAsm.ZC's cell z-buffer comparison; coordinates are pixel units.
    I64 cell_x = x / 8, cell_y = y / 8;
    if (!task || x < 0 || y < 0 || cell_x >= TEXT_COLS || cell_y >= TEXT_ROWS)
        return FALSE;
    return task->win_z_num < gr.win_z_buf[cell_y * TEXT_COLS + cell_x];
}
