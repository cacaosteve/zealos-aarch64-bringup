// DolDoc StdOut document. Until DocDblBuf.ZC loads, report no put_doc.
CDoc *DocPut(CTask *task=NULL)
{
    CDoc *res;

    if (!task)
        task = Fs;
    if (Bt(&task->task_flags, TASKf_INPUT_FILTER_TASK))
        task = task->parent_task;
    if ((res = task->put_doc) && res->doc_signature == DOC_SIGNATURE_VAL)
        return res;
    return NULL;
}
// DocNew.ZC DocLock uses these around exclusive doc ownership. Pending breaks
// are not delivered until a debugger/Ctrl-Alt-C path exists.
Bool BreakLock(CTask *task=NULL)
{
    if (!task)
        task = Fs;
    return !LBts(&task->task_flags, TASKf_BREAK_LOCKED);
}
Bool BreakUnlock(CTask *task=NULL)
{
    Bool res;

    if (!task)
        task = Fs;
    res = LBtr(&task->task_flags, TASKf_BREAK_LOCKED);
    LBtr(&task->task_flags, TASKf_PENDING_BREAK);
    return res;
}
// MakeDoc.ZC owns the real doldoc tables; zeroed defaults let DocNew compile.
// DHT_* hash types live in MakeDoc.ZC on ZealOS; expose them for DocInit.
#define DHT_DOC_CMD 		1
#define DHT_DOC_FLAG		2
#define DHT_COLOR 			4
class CDolDocGlobals
{
    CHashTable	*hash;
    I64			 default_de_flags			[DOCT_TYPES_NUM],
                 type_flags_nontag_invis	[(DOCT_TYPES_NUM + 63) / 64],
                 type_flags_form 			[(DOCT_TYPES_NUM + 63) / 64],
                 type_flags_data 			[(DOCT_TYPES_NUM + 63) / 64],
                 type_flags_chk_dup			[(DOCT_TYPES_NUM + 63) / 64],
                 clean_scan_codes			[4];
    I32			 default_type_flags			[DOCT_TYPES_NUM];
} doldoc;
// Aiwnios Hash* match ZealOS CHash/CHashTable; bound after TaskBridge loads.
extern CHashTable *HashTableNew(I64 size, CTask *mem_task=NULL);
extern CHash *HashFind(U8 *needle_str, CHashTable *haystack_table,
                       I64 mask, I64 instance=1);
extern U0 HashAdd(CHash *tmph, CHashTable *table);
I64 HashTypeNum(CHash *tmph)
{//Hash type index used by upstream DocHighlight's color table.
    if (tmph)
        return Bsf(tmph->type & HTG_TYPE_MASK);
    return -1;
}
U0 UndefinedDefine(U8 *dname)
{
    Print(ST_ERR_ST "Undefined Define: '%s'.\n", dname);
    throw('UndefDef');
}
CHashDefineStr *DefineLoad(U8 *dname, U8 *st, I64 caller_num=1)
{
    CHashDefineStr *tmph;

    if (caller_num) {}
    /* Avoid sizeof(CHashDefineStr): Aiwnios class sz can be garbage. */
    tmph = CAlloc(0x80);
    tmph->type = HTT_DEFINE_STR;
    tmph->str = StrNew(dname);
    tmph->data = StrNew(st);
    tmph->count = -1;
    tmph->src_link = StrNew("AD:");
    HashAdd(tmph, Fs->hash_table);
    return tmph;
}
CHashDefineStr *DefineListLoad(U8 *dname, U8 *list)
{
    I64 count = 0, nbytes;
    U8 *ptr, **idx;
    CHashDefineStr *tmph = CAlloc(0x80);

    tmph->type = HTT_DEFINE_STR;
    tmph->str = StrNew(dname);
    tmph->src_link = StrNew("AD:");
    ptr = list;
    while (*ptr)
    {
        if (*ptr != '@')
            count++;
        while (*ptr++);
    }
    nbytes = ptr - list;
    nbytes++;
    if (nbytes <= 0 || nbytes > 0x100000)
    {
        Print("DefineListLoad bad nbytes\n");
        return NULL;
    }
    tmph->data = MAlloc(nbytes);
    MemCopy(tmph->data, list, nbytes);
    tmph->count = count;
    idx = tmph->sub_idx = MAlloc(count * 8);
    ptr = list;
    while (*ptr)
    {
        if (*ptr != '@')
            *idx++ = ptr;
        while (*ptr++);
    }
    HashAdd(tmph, Fs->hash_table);
    return tmph;
}
U8 *Define(U8 *dname)
{
    CHashDefineStr *tmph;

    if (tmph = HashFind(dname, Fs->hash_table, HTT_DEFINE_STR))
        return tmph->data;
    else if (dname)
        UndefinedDefine(dname);
    else
        return NULL;
}
U8 *DefineSub(I64 sub, U8 *dname)
{
    CHashDefineStr *tmph;

    if (tmph = HashFind(dname, Fs->hash_table, HTT_DEFINE_STR))
    {
        if (0 <= sub < tmph->count)
            return tmph->sub_idx[sub];
        else
            return NULL;
    }
    else if (dname)
        UndefinedDefine(dname);
    else
        return NULL;
}
I64 DefineCount(U8 *dname)
{
    CHashDefineStr *tmph;

    if (tmph = HashFind(dname, Fs->hash_table, HTT_DEFINE_STR))
        return tmph->count;
    else if (dname)
        UndefinedDefine(dname);
    else
        return -1;
}
I64 ListMatch(U8 *needle, U8 *haystack_list, I64 flags=0)
{//-2 ambiguous, -1 not found. DocPlain RT= via DefineMatch.
    I64 sub = 0, res = -1;
    U8 *ptr;
    Bool exact_match = FALSE;

    if (!haystack_list)
        return -1;
    while (*haystack_list)
    {
        if (*haystack_list == '@')
        {
            sub--;
            haystack_list++;
        }
        ptr = needle;
        if (flags & LMF_IGNORE_CASE)
            while (*ptr && ToUpper(*ptr) == ToUpper(*haystack_list))
            {
                ptr++;
                haystack_list++;
            }
        else
            while (*ptr && *ptr == *haystack_list)
            {
                ptr++;
                haystack_list++;
            }
        if (!*ptr)
        {
            if (!*haystack_list)
                return sub;
            else if (res != -1)
            {
                if (!exact_match)
                    res = -2;
            }
            else if (!(flags & LMF_EXACT))
                res = sub;
        }
        while (*haystack_list)
            haystack_list++;
        haystack_list++;
        sub++;
    }
    return res;
}
I64 DefineMatch(U8 *needle, U8 *haystack_list_dname, I64 flags=0)
{
    return ListMatch(needle, Define(haystack_list_dname), flags);
}
I64 HashListAdd(U8 *list, I64 type, CHashTable *table)
{
    I64 i = 0;
    CHashGeneric *tmph;

    if (list)
    {
        while (*list)
        {
            if (*list == '@')
                list++;
            else
                i++;
            /* Avoid sizeof(CHashGeneric): Aiwnios class sz can be garbage. */
            tmph = CAlloc(0x40);
            tmph->user_data0 = i - 1;
            tmph->str = StrNew(list);
            tmph->type = type;
            HashAdd(tmph, table);
            while (*list++);
        }
    }
    return i;
}
I64 HashDefineListAdd(U8 *dname, I64 type, CHashTable *table)
{
    CHashDefineStr *tmph;

    if (tmph = HashFind(dname, Fs->hash_table, HTT_DEFINE_STR))
        return HashListAdd(tmph->data, type, table);
    else
        return 0;
}
I64 BootstrapDefinesLoad()
{//ST_COLORS for DocInit; ST_RAW_TYPES for DocPlain RT= tags.
    DefineListLoad("ST_COLORS",
                   "BLACK\0BLUE\0GREEN\0CYAN\0"
                   "RED\0PURPLE\0BROWN\0LTGRAY\0DKGRAY\0LTBLUE\0LTGREEN\0"
                   "LTCYAN\0LTRED\0LTPURPLE\0YELLOW\0WHITE\0");
    DefineListLoad("ST_RAW_TYPES",
                   " \0 \0I0\0U0\0I8\0U8\0I16\0U16\0I32\0U32\0I64\0U64\0"
                   "F32\0UF32\0F64\0UF64\0");
    return 0;
}
// Minimal CompCtrl/Lex so DocInit can parse default flag strings. Full
// Compiler/Lex.ZC remains later work.
CCompCtrl *CompCtrlNew(U8 *buf=NULL, I64 flags=0, U8 *filename=NULL)
{
    /* Aiwnios sizeof(CCompCtrl) is not trustworthy yet (class sz garbage);
     * 64KiB covers the KernelA layout and our Lex stub fields. */
    CCompCtrl *cc = CAlloc(0x10000);

    QueueInit(cc);
    cc->flags = flags;
    cc->htc.hash_mask = HTG_TYPE_MASK - HTT_IMPORT_SYS_SYM;
    cc->htc.define_hash_table = cc->htc.hash_table_list =
        cc->htc.global_hash_table = cc->htc.local_hash_table = Fs->hash_table;
    cc->cur_buf_ptr = buf;
    if (filename) {}
    return cc;
}
U0 CompCtrlDel(CCompCtrl *cc)
{
    if (!cc)
        return;
    Free(cc->cur_str);
    Free(cc);
}
I64 Lex(CCompCtrl *cc)
{//Tokenize idents, strings, ints, and punctuation for DocInit/DocPlain.
    U8 *ptr, buf[STR_LEN];
    I64 i, ch, n;

    if (!cc)
        return 0;
    Free(cc->cur_str);
    cc->cur_str = NULL;
    ptr = cc->cur_buf_ptr;
    if (!ptr)
        return cc->token = TK_EOF;
    while (*ptr == CH_SPACE || *ptr == '\t' || *ptr == '\r' || *ptr == '\n')
        ptr++;
    cc->cur_buf_ptr = ptr;
    if (!*ptr)
        return cc->token = TK_EOF;
    ch = *ptr;
    if (ch == '+' || ch == '-' || ch == ';' || ch == ',' || ch == '=' ||
        ch == '(' || ch == ')')
    {
        cc->cur_buf_ptr = ptr + 1;
        return cc->token = ch;
    }
    if (ch == '"')
    {
        ptr++;
        i = 0;
        while (*ptr && *ptr != '"')
        {
            if (*ptr == '\\' && ptr[1])
                ptr++;
            if (i < STR_LEN - 1)
                buf[i++] = *ptr;
            ptr++;
        }
        if (*ptr == '"')
            ptr++;
        buf[i] = 0;
        cc->cur_buf_ptr = ptr;
        cc->cur_str = StrNew(buf);
        cc->cur_str_len = i + 1;
        return cc->token = TK_STR;
    }
    if ('0' <= ch <= '9')
    {
        n = 0;
        while ('0' <= *ptr <= '9')
        {
            n = n * 10 + *ptr - '0';
            ptr++;
        }
        cc->cur_buf_ptr = ptr;
        cc->cur_i64 = n;
        return cc->token = TK_I64;
    }
    if ('A' <= ch <= 'Z' || 'a' <= ch <= 'z' || ch == '_')
    {
        i = 0;
        while ('A' <= *ptr <= 'Z' || 'a' <= *ptr <= 'z' ||
               '0' <= *ptr <= '9' || *ptr == '_')
        {
            if (i < STR_LEN - 1)
                buf[i++] = *ptr;
            ptr++;
        }
        buf[i] = 0;
        cc->cur_buf_ptr = ptr;
        cc->cur_str = StrNew(buf);
        cc->cur_str_len = i + 1;
        return cc->token = TK_IDENT;
    }
    cc->cur_buf_ptr = ptr + 1;
    return cc->token = ch;
}
U8 *LexExtStr(CCompCtrl *cc, I64 *_size=NULL, Bool lex_next=TRUE)
{//Combine adjacent TK_STR tokens; DocPlain tag args.
    U8 *st;
    I64 len;

    if (!cc || cc->token != TK_STR)
    {
        if (_size)
            *_size = 0;
        return NULL;
    }
    st = cc->cur_str;
    len = cc->cur_str_len;
    cc->cur_str = NULL;
    if (lex_next)
        Lex(cc);
    while (cc->token == TK_STR)
    {
        st = MStrPrint("%s%s", st, cc->cur_str);
        Free(cc->cur_str);
        cc->cur_str = NULL;
        Lex(cc);
        len = BootstrapStrLen(st) + 1;
    }
    if (_size)
        *_size = len;
    return st;
}
I64 LexExpressionI64(CCompCtrl *cc)
{//Stub: decimal I64, doldoc color name, or define; full ParseExp later.
    I64 res = 0, neg = 1;
    U8 *name;
    CHashGeneric *tmph;

    if (!cc)
        return 0;
    if (cc->token == '-')
    {
        neg = -1;
        Lex(cc);
    }
    else if (cc->token == '+')
        Lex(cc);
    if (cc->token == TK_I64)
    {
        res = cc->cur_i64;
        Lex(cc);
    }
    else if (cc->token == TK_IDENT)
    {
        name = cc->cur_str;
        if (name && doldoc.hash &&
            (tmph = HashFind(name, doldoc.hash, DHT_COLOR)))
            res = tmph->user_data0;
        else if (name && HashFind(name, Fs->hash_table, HTT_DEFINE_STR))
            res = 0;
        Lex(cc);
    }
    return res * neg;
}
I64 LexExpression(CCompCtrl *cc)
{
    return LexExpressionI64(cc);
}
I64 ParseDocFlagSingle(CCompCtrl *cc, I64 *_de_flags, U32 *_type, Bool turn_on)
{//DocPlain subset used by DocInit default-flag parse.
    I64 res = -1;
    CHashGeneric *tmph;

    if (cc->token == TK_IDENT &&
        (tmph = HashFind(cc->cur_str, doldoc.hash, DHT_DOC_FLAG)))
    {
        res = tmph->user_data0;
        if (res < 64)
        {
            BEqual(_de_flags, res, turn_on);
            switch (res)
            {
                case DOCEf_BLINK:
                case DOCEf_INVERT:
                case DOCEf_UNDERLINE:
                case DOCEf_SEL:
                    BEqual(_type, res, turn_on);
                    break;
            }
        }
        Lex(cc);
    }
    return res;
}
I64 ParseDocFlags(CCompCtrl *cc, I64 *_de_flags, U32 *_type)
{
    I64 res = -1;
    Bool turn_on;

    while (TRUE)
    {
        if (cc->token == '+')
            turn_on = TRUE;
        else if (cc->token == '-')
            turn_on = FALSE;
        else
            break;
        Lex(cc);
        res = ParseDocFlagSingle(cc, _de_flags, _type, turn_on);
    }
    return res;
}
