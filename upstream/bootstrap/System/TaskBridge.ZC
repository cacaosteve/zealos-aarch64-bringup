    0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF,
    0, 0, 0, 0, 0, 0, 0, 0
};
// Layout-only alias; real StrA will supply its own displayability bitmap.
U32 *char_bmp_displayable = char_bmp_printable;
// StrA / DocGet / DocRecalc helpers used by DocPutS before those modules load.
U8 *StrUtil(U8 *_src, I64 flags)
{
    U8 *src = _src, *dst = _src;
    I64 ch;

    if (!_src)
        return NULL;
    if (flags & SUF_REM_LEADING)
        while (*src == ' ' || *src == '\t')
            src++;
    while (ch = *src++)
    {
        if (ch == ' ' || ch == '\t')
        {
            if (!(flags & SUF_REM_SPACES))
                *dst++ = ch;
        }
        else if (!(flags & SUF_REM_CTRL_CHARS) || ch >= CH_SPACE)
            *dst++ = ch;
    }
    *dst = 0;
    return _src;
}
CDocEntry *ParseDollarCmd(CDoc *doc, U8 *st)
{
    CDocEntry *doc_e;
    U8 *q, *tag = NULL;
    I64 type = DOCT_ERROR, len = 0;

    // Lightweight stand-in until DocPlain uses doldoc.hash. Recognize
    // the DocBorderNew cmds and a trailing ,"tag" so TX entries get real tags.
    if (!doc)
        return NULL;
    if (st)
    {
        if (st[0] == 'T' && st[1] == 'X')
            type = DOCT_TEXT;
        else if (st[0] == 'C' && st[1] == 'M')
            type = DOCT_CURSOR_MOVEMENT;
        else if (st[0] == 'D' && st[1] == 'A')
            type = DOCT_DATA;
        else if (st[0] == 'F' && st[1] == 'G')
            type = DOCT_FOREGROUND;
        else if (st[0] == 'B' && st[1] == 'G')
            type = DOCT_BACKGROUND;
        else if (st[0] == 'F' && st[1] == 'D')
            type = DOCT_DEFAULT_FOREGROUND;
        else if (st[0] == 'B' && st[1] == 'D')
            type = DOCT_DEFAULT_BACKGROUND;
        q = st;
        while (*q && !(*q == ',' && q[1] == '"'))
            q++;
        if (*q == ',' && q[1] == '"')
        {
            q += 2;
            tag = q;
            while (*q && *q != '"')
                q++;
            len = q - tag;
        }
    }
    doc_e = CAlloc(sizeof(CDocEntry), doc->mem_task);
    doc_e->type = type | doc->settings_head.default_text_attr << 8;
    if (type == DOCT_TEXT && tag && len >= 0)
    {
        doc_e->tag = MAlloc(len + 1, doc->mem_task);
        if (len)
            MemCopy(doc_e->tag, tag, len);
        doc_e->tag[len] = 0;
        doc_e->max_col = len;
    }
    return doc_e;
}
U8 *DocScanLine(CDoc *doc, CDocEntry *doc_e, I64 *cur_col=NULL,
                CDocEntry **_do_e_end=NULL)
{
    if (doc) {}
    if (doc_e) {}
    if (cur_col) {}
    if (_do_e_end)
        *_do_e_end = NULL;
    return NULL;
}
Bool DocRecalc(CDoc *doc, I64 recalc_flags=0)
{
    if (doc) {}
    if (recalc_flags) {}
    return FALSE;
}
U0 Busy(I64 us)
{
    if (us) {}
}
// Minimal text/CPU stand-ins referenced by Ctrl-Alt hooks in KeyDevInit.
// Gs() is host-bound to bootstrap_gs; CCPU layout only needs idle_task here.
class CBootstrapTextGlbls
{
    U8 *font;
    U8 *aux_font;
    Bool is_fb_busy;
    I64 raw_col;
    U32 *fb_alias;
    I64 buffer_size;
};
CBootstrapTextGlbls text;
CTask *sys_winmgr_task = NULL;
// Doc recalculation may load after the task bridge. The host thunk resolves
// the guest function at call time and safely skips it until it is defined.
Bool TextChar(CTask *task, Bool allow_border=FALSE, I64 x=0, I64 y=0, I64 d=0)
{//Single-cell framebuffer path; border mode permits the adjacent outer row/column.
    if (!task)
        return FALSE;
    return ZcFbTextChar(task->win_left + x + (task->scroll_x >> 3),
                        task->win_top + y + (task->scroll_y >> 3), d,
                        allow_border,
                        task->win_left | task->win_right << 16,
                        task->win_top | task->win_bottom << 16,
                        gr.text_base, TEXT_COLS);
}
Bool TextLenStr(CTask *task, I64 x, I64 y, I64 len, I64 attr, U8 *str)
{
    if (!task || !str || len <= 0)
        return FALSE;
    return ZcFbTextSpan(task->win_left + x + (task->scroll_x >> 3),
                        task->win_top + y + (task->scroll_y >> 3), len, attr, str, 0,
                        task->win_left | task->win_right << 16,
                        task->win_top | task->win_bottom << 16,
                        gr.text_base, TEXT_COLS) > 0;
}
U0 StrPrint(U8 *dst, U8 *format, ...)
{
    if (dst)
        dst[0] = 0;
}
Bool TextLenAttrStr(CTask *task, I64 x, I64 y, I64 len, U32 *str)
{
    if (!task || !str || len <= 0)
        return FALSE;
    return ZcFbTextSpan(task->win_left + x + (task->scroll_x >> 3),
                        task->win_top + y + (task->scroll_y >> 3), len, 0,
                        str, 1, task->win_left | task->win_right << 16,
                        task->win_top | task->win_bottom << 16,
                        gr.text_base, TEXT_COLS) > 0;
}
Bool TextLenAttr(CTask *task, I64 x, I64 y, I64 len, I64 attr)
{//Direct framebuffer equivalent for empty attributed cells (e.g. line-tail fill).
    if (!task || len <= 0)
        return FALSE;
    return ZcFbTextFill(task->win_left + x + (task->scroll_x >> 3),
                        task->win_top + y + (task->scroll_y >> 3), len, attr,
                        task->win_left | task->win_right << 16,
                        task->win_top | task->win_bottom << 16,
                        gr.text_base, TEXT_COLS) >= 0;
}
U0 TextBorder(CTask *task, I64 x1, I64 x2, I64 y1, I64 y2, U8 color, Bool solid)
{//CP437 border glyphs match text.border_chars initialized by upstream KMain.
    I64 i, attr, tl, tr, bl, br, horz, vert;
    if (!task)
        task = Fs;
    if (!task || x1 > x2 || y1 > y2 || x1 < -1 || y1 < -1 ||
        x2 > 4096 || y2 > 4096 || x2 - x1 > 4096 || y2 - y1 > 4096)
        return;
    attr = color << 8;
    if (solid)
    {
        tl = 0xc9; tr = 0xbb; bl = 0xc8; br = 0xbc;
        horz = 0xcd; vert = 0xba;
    }
    else
    {
        tl = 0xda; tr = 0xbf; bl = 0xc0; br = 0xd9;
        horz = 0xc4; vert = 0xb3;
    }
    TextChar(task, TRUE, x1 - 1, y1 - 1, tl | attr);
    TextChar(task, TRUE, x2 + 1, y1 - 1, tr | attr);
    TextChar(task, TRUE, x1 - 1, y2 + 1, bl | attr);
    TextChar(task, TRUE, x2 + 1, y2 + 1, br | attr);
    for (i = x1; i <= x2; i++)
    {
        TextChar(task, TRUE, i, y1 - 1, horz | attr);
        TextChar(task, TRUE, i, y2 + 1, horz | attr);
    }
    for (i = y1; i <= y2; i++)
    {
        TextChar(task, TRUE, x1 - 1, i, vert | attr);
        TextChar(task, TRUE, x2 + 1, i, vert | attr);
    }
}
U0 TextRect(I64 left, I64 right, I64 top, I64 bottom, I64 cell)
{//Update gr.text_base and present the clipped rectangle through the ARM64 host.
    if (left > right || top > bottom)
        return;
    ZcFbTextRect(left, right, top, bottom, cell, gr.text_base, TEXT_COLS);
}
extern U0 BootstrapCtrlsUpdate(CTask *task);
U0 WinDerivedValsUpdate(CTask *task)
{
    if (!task)
        task = Fs;
    if (!task)
        return;
    task->win_width = task->win_right - task->win_left + 1;
    task->win_height = task->win_bottom - task->win_top + 1;
    task->pix_left = FONT_WIDTH * task->win_left;
    task->pix_right = FONT_WIDTH * (task->win_right + 1) - 1;
    task->pix_width = task->pix_right - task->pix_left + 1;
    task->pix_top = FONT_HEIGHT * task->win_top;
    task->pix_bottom = FONT_HEIGHT * (task->win_bottom + 1) - 1;
    task->pix_height = task->pix_bottom - task->pix_top + 1;
}
Bool GrPlot(CDC *dc=gr.dc, I64 x=0, I64 y=0)
{
    CTask *task;
    I64 left, top, right, bottom;
    if (!dc)
        return FALSE;
    task = dc->win_task;
    if ((dc->flags & DCF_SCREEN_BITMAP) && !(dc->flags & DCF_ON_TOP))
    {
        if (!task)
            return FALSE;
        WinDerivedValsUpdate(task);
        left = task->pix_left;
        top = task->pix_top;
        right = task->pix_right;
        bottom = task->pix_bottom;
        x += left + task->scroll_x;
        y += top + task->scroll_y;
    }
    else
    {
        left = top = 0;
        right = dc->width - 1;
        bottom = dc->height - 1;
    }
    return ZcFbGraphPlot(x, y, dc->color.c0 & 0xff,
                         left, top, right, bottom);
}
Bool GrRect(CDC *dc=gr.dc, I64 x=0, I64 y=0, I64 width=0, I64 height=0)
{
    CTask *task;
    I64 left, top, right, bottom;
    if (!dc || width <= 0 || height <= 0)
        return FALSE;
    task = dc->win_task;
    if ((dc->flags & DCF_SCREEN_BITMAP) && !(dc->flags & DCF_ON_TOP))
    {
        if (!task)
            return FALSE;
        WinDerivedValsUpdate(task);
        left = task->pix_left;
        top = task->pix_top;
        right = task->pix_right;
        bottom = task->pix_bottom;
        x += left + task->scroll_x;
        y += top + task->scroll_y;
    }
    else
    {
        left = top = 0;
        right = dc->width - 1;
        bottom = dc->height - 1;
    }
    return ZcFbGraphRect(x, y, width, height, dc->color.c0 & 0xff,
                         left, top, right, bottom);
}
U0 GrPrint(CDC *dc=gr.dc, I64 x=0, I64 y=0, U8 *format, ...)
{
    CTask *task;
    U8 *text;
    I64 left, top, right, bottom;
    if (!dc || !format || !(dc->flags & DCF_SCREEN_BITMAP))
        return;
    task = dc->win_task;
    if (dc->flags & DCF_ON_TOP)
    {
        left = top = 0;
        right = dc->width - 1;
        bottom = dc->height - 1;
    }
    else
    {
        if (!task)
            return;
        WinDerivedValsUpdate(task);
        left = task->pix_left;
        top = task->pix_top;
        right = task->pix_right;
        bottom = task->pix_bottom;
        x += left + task->scroll_x;
        y += top + task->scroll_y;
    }
    text = StrPrintJoin(NULL, format, argc, argv);
    if (text)
    {
        ZcFbGraphText(x, y, dc->color.c0 & 0xff,
                      left, top, right, bottom, text);
        Free(text);
    }
}
Bool GrLine(CDC *dc=gr.dc, I64 x1=0, I64 y1=0, I64 x2=0, I64 y2=0,
            I64 step=1, I64 start=0)
{
    CTask *task;
    I64 left, top, right, bottom;
    if (!dc || step < 1 || start < 0)
        return FALSE;
    task = dc->win_task;
    if ((dc->flags & DCF_SCREEN_BITMAP) && !(dc->flags & DCF_ON_TOP))
    {
        if (!task)
            return FALSE;
        WinDerivedValsUpdate(task);
        left = task->pix_left;
        top = task->pix_top;
        right = task->pix_right;
        bottom = task->pix_bottom;
        x1 += left + task->scroll_x;
        x2 += left + task->scroll_x;
        y1 += top + task->scroll_y;
        y2 += top + task->scroll_y;
    }
    else
    {
        left = top = 0;
        right = dc->width - 1;
        bottom = dc->height - 1;
    }
    return ZcFbGraphLine(x1, y1, x2, y2, dc->color.c0 & 0xff,
                         step, start, left, top, right, bottom);
}
#define WIN_SCROLL_SIZE 8
#define WIN_SCROLL_BORDER_BONUS 4
public CCtrl *CtrlFindUnique(CTask *task, I64 type)
{//Return the first control of a type in a task's circular list.
    CCtrl *head, *ctrl;
    I64 visited = 0;
    if (!task || !(ctrl = task->next_ctrl))
        return NULL;
    head = &task->next_ctrl;
    while (ctrl && ctrl != head && visited++ < 64)
    {
        if (ctrl->type == type)
            return ctrl;
        ctrl = ctrl->next;
    }
    return NULL;
}
Bool CtrlInsideRect(CCtrl *ctrl, I64 x, I64 y)
{//Test screen coordinates against a control's derived bounds.
    if (!ctrl)
        return FALSE;
    return x >= ctrl->screen_left && x <= ctrl->screen_right &&
           y >= ctrl->screen_top && y <= ctrl->screen_bottom;
}
public Bool CtrlInside(CCtrl *ctrl, I64 x, I64 y)
{
    if (!ctrl || !(ctrl->flags & CTRLF_SHOW))
        return FALSE;
    if (ctrl->inside_ctrl)
        return ctrl->inside_ctrl(ctrl, x, y);
    return CtrlInsideRect(ctrl, x, y);
}
public Bool BootstrapWinCtrlsAllowed(CTask *task)
{//Match WinMgr's SELF_CTRLS and FOCUS_TASK_CTRLS gates.
    if (!task || !TaskValidate(task) ||
        (task->win_inhibit & (1 << WIf_SELF_CTRLS)))
        return FALSE;
    if (TaskValidate(sys_focus_task) &&
        (sys_focus_task->win_inhibit & (1 << WIf_FOCUS_TASK_CTRLS)))
        return FALSE;
    return TRUE;
}
public Bool CtrlDispatchLeftClick(CTask *task, I64 screen_x, I64 screen_y,
                                  Bool down)
{//Dispatch one left-button edge using WinMgr's screen-to-task coordinates.
    CCtrl *head, *ctrl, *target = NULL;
    I64 left, top, visited = 0;
    if (!BootstrapWinCtrlsAllowed(task) || !(ctrl = task->next_ctrl))
        return FALSE;
    head = &task->next_ctrl;
    if (down)
    {
        // Captured controls continue receiving held-button samples after
        // the thumb moves away from the original hit rectangle.
        while (ctrl && ctrl != head && visited++ < 64)
        {
            if (ctrl->left_click &&
                (ctrl->flags & CTRLF_CAPTURE_LEFT_MS) &&
                (ctrl->flags & CTRLF_CLICKED))
            {
                target = ctrl;
                break;
            }
            ctrl = ctrl->next;
        }
        ctrl = task->next_ctrl;
        visited = 0;
    }
    while (ctrl && ctrl != head && visited++ < 64)
    {
        if (!target && ctrl->left_click &&
            ((!down && (ctrl->flags & CTRLF_CLICKED)) ||
             CtrlInside(ctrl, screen_x, screen_y)))
        {
            target = ctrl;
            break;
        }
        ctrl = ctrl->next;
    }
    if (!target)
        return FALSE;
    left = gr.pan_text_x + task->pix_left;
    top = gr.pan_text_y + task->pix_top;
    if (target->flags & CTRLF_BORDER)
    {
        left -= FONT_WIDTH;
        top -= FONT_HEIGHT;
    }
    target->left_click(target, screen_x - left, screen_y - top, down);
    return TRUE;
}
public Bool CtrlDispatchRightClick(CTask *task, I64 screen_x, I64 screen_y,
                                   Bool down)
{//Dispatch one right-button sample using WinMgr's screen-to-task coordinates.
    CCtrl *head, *ctrl, *target = NULL;
    I64 left, top, visited = 0;
    if (!BootstrapWinCtrlsAllowed(task) || !(ctrl = task->next_ctrl))
        return FALSE;
    head = &task->next_ctrl;
    if (down)
    {
        // A captured control continues tracking after the pointer leaves it.
        while (ctrl && ctrl != head && visited++ < 64)
        {
            if (ctrl->right_click &&
                (ctrl->flags & CTRLF_CAPTURE_RIGHT_MS) &&
                (ctrl->flags & CTRLF_CLICKED))
            {
                target = ctrl;
                break;
            }
            ctrl = ctrl->next;
        }
        ctrl = task->next_ctrl;
        visited = 0;
    }
    while (ctrl && ctrl != head && visited++ < 64)
    {
        if (!target && ctrl->right_click &&
            ((!down && (ctrl->flags & CTRLF_CLICKED)) ||
             CtrlInside(ctrl, screen_x, screen_y)))
        {
            target = ctrl;
            break;
        }
        ctrl = ctrl->next;
    }
    if (!target)
        return FALSE;
    left = gr.pan_text_x + task->pix_left;
    top = gr.pan_text_y + task->pix_top;
    if (target->flags & CTRLF_BORDER)
    {
        left -= FONT_WIDTH;
        top -= FONT_HEIGHT;
    }
    target->right_click(target, screen_x - left, screen_y - top, down);
    return TRUE;
}
I64 bootstrap_mouse_last_buttons = 0;
Bool bootstrap_mouse_sampled = FALSE;
I64 bootstrap_mouse_last_x = -1;
I64 bootstrap_mouse_last_y = -1;
#define BOOTSTRAP_DRAG_MOVE 1
#define BOOTSTRAP_DRAG_LEFT 2
#define BOOTSTRAP_DRAG_RIGHT 3
#define BOOTSTRAP_DRAG_BOTTOM 4
#define BOOTSTRAP_DRAG_BOTTOM_RIGHT 5
#define BOOTSTRAP_TITLE_MENU 1
#define BOOTSTRAP_TITLE_CLOSE 2
CTask *bootstrap_mouse_drag_task = NULL;
I64 bootstrap_mouse_drag_kind = 0;
I64 bootstrap_mouse_drag_start_x = 0, bootstrap_mouse_drag_start_y = 0;
I64 bootstrap_mouse_drag_left = 0, bootstrap_mouse_drag_right = 0;
I64 bootstrap_mouse_drag_top = 0, bootstrap_mouse_drag_bottom = 0;
CTask *bootstrap_title_button_task = NULL;
I64 bootstrap_title_button_kind = 0;
CTask *bootstrap_doc_mouse_task = NULL;
I64 bootstrap_doc_mouse_button = 0;
I64 bootstrap_left_click_deadline_ns = 0;
I64 bootstrap_left_click_x = 0, bootstrap_left_click_y = 0;
Bool bootstrap_left_click_double = FALSE;
Bool bootstrap_left_click_down_sent = FALSE;
I64 bootstrap_left_click_result = 0;
I64 bootstrap_right_click_deadline_ns = 0;
I64 bootstrap_right_click_x = 0, bootstrap_right_click_y = 0;
Bool bootstrap_right_click_double = FALSE;
Bool bootstrap_right_click_down_sent = FALSE;
I64 bootstrap_right_click_result = 0;
#define BOOTSTRAP_MOUSE_CLICK_PENDING 0
#define BOOTSTRAP_MOUSE_CLICK_SINGLE 1
#define BOOTSTRAP_MOUSE_CLICK_DOUBLE 2
#define BOOTSTRAP_MOUSE_DBL_TIME_NS 175000000

U0 BootstrapWinQueueMouseButton(CTask *task, I64 message_code,
                                I64 screen_x, I64 screen_y)
{//Queue one ordinary mouse transition with upstream client-area coordinates.
    if (!TaskValidate(task))
        return;
    TaskMessage(task, NULL, message_code,
        screen_x - gr.pan_text_x - task->pix_left - task->scroll_x,
        screen_y - gr.pan_text_y - task->pix_top - task->scroll_y, 0);
}
U0 BootstrapWinMouseClickTimer(CTask *task, I64 now_ns, I64 buttons,
                                I64 screen_x, I64 screen_y)
{//Release delayed single clicks or synthesize double-click messages.
    I64 code, event_x, event_y;
    if (!TaskValidate(task))
        return;
    if (bootstrap_left_click_deadline_ns &&
        now_ns > bootstrap_left_click_deadline_ns)
    {
        code = MESSAGE_MS_L_DOWN;
        if (!bootstrap_left_click_down_sent)
        {
            if (bootstrap_left_click_double)
            {
                code = MESSAGE_MS_L_D_DOWN;
                event_x = screen_x;
                event_y = screen_y;
            }
            else
            {
                event_x = bootstrap_left_click_x;
                event_y = bootstrap_left_click_y;
            }
            BootstrapWinQueueMouseButton(task, code, event_x, event_y);
            bootstrap_left_click_down_sent = TRUE;
        }
        if (!(buttons & 1))
        {
            code = MESSAGE_MS_L_UP;
            if (bootstrap_left_click_double)
                code = MESSAGE_MS_L_D_UP;
            BootstrapWinQueueMouseButton(task, code, screen_x, screen_y);
            if (bootstrap_left_click_double)
                bootstrap_left_click_result = BOOTSTRAP_MOUSE_CLICK_DOUBLE;
            else
                bootstrap_left_click_result = BOOTSTRAP_MOUSE_CLICK_SINGLE;
            bootstrap_left_click_deadline_ns = 0;
            bootstrap_left_click_double = FALSE;
            bootstrap_left_click_down_sent = FALSE;
        }
    }
    if (bootstrap_right_click_deadline_ns &&
        now_ns > bootstrap_right_click_deadline_ns)
    {
        if (!bootstrap_right_click_down_sent)
        {
            code = MESSAGE_MS_R_DOWN;
            event_x = bootstrap_right_click_x;
            event_y = bootstrap_right_click_y;
            if (bootstrap_right_click_double)
            {
                code = MESSAGE_MS_R_D_DOWN;
                event_x = screen_x;
                event_y = screen_y;
            }
            BootstrapWinQueueMouseButton(task, code, event_x, event_y);
            bootstrap_right_click_down_sent = TRUE;
        }
        if (!(buttons & 2))
        {
            code = MESSAGE_MS_R_UP;
            if (bootstrap_right_click_double)
                code = MESSAGE_MS_R_D_UP;
            BootstrapWinQueueMouseButton(task, code, screen_x, screen_y);
            if (bootstrap_right_click_double)
                bootstrap_right_click_result = BOOTSTRAP_MOUSE_CLICK_DOUBLE;
            else
                bootstrap_right_click_result = BOOTSTRAP_MOUSE_CLICK_SINGLE;
            bootstrap_right_click_deadline_ns = 0;
            bootstrap_right_click_double = FALSE;
            bootstrap_right_click_down_sent = FALSE;
        }
    }
}
U0 BootstrapWinMouseClickInput(CTask *task, I64 button, Bool down,
                                I64 screen_x, I64 screen_y, I64 now_ns)
{//Delay ordinary clicks unless this task requests immediate single-click mode.
    I64 inhibit;
    I64 *deadline, *saved_x, *saved_y;
    Bool *is_double, *down_sent;
    if (!TaskValidate(task))
        return;
    if (button == 1)
    {
        inhibit = WIf_FOCUS_TASK_MS_L_D;
        deadline = &bootstrap_left_click_deadline_ns;
        saved_x = &bootstrap_left_click_x;
        saved_y = &bootstrap_left_click_y;
        is_double = &bootstrap_left_click_double;
        down_sent = &bootstrap_left_click_down_sent;
    }
    else
    {
        inhibit = WIf_FOCUS_TASK_MS_R_D;
        deadline = &bootstrap_right_click_deadline_ns;
        saved_x = &bootstrap_right_click_x;
        saved_y = &bootstrap_right_click_y;
        is_double = &bootstrap_right_click_double;
        down_sent = &bootstrap_right_click_down_sent;
    }
    if (!*deadline && Bt(&task->win_inhibit, inhibit))
    {
        if (button == 1)
        {
            if (down)
                BootstrapWinQueueMouseButton(task, MESSAGE_MS_L_DOWN,
                                             screen_x, screen_y);
            else
                BootstrapWinQueueMouseButton(task, MESSAGE_MS_L_UP,
                                             screen_x, screen_y);
            if (down)
                bootstrap_left_click_result = BOOTSTRAP_MOUSE_CLICK_PENDING;
            else
                bootstrap_left_click_result = BOOTSTRAP_MOUSE_CLICK_SINGLE;
        }
        else
        {
            if (down)
                BootstrapWinQueueMouseButton(task, MESSAGE_MS_R_DOWN,
                                             screen_x, screen_y);
            else
                BootstrapWinQueueMouseButton(task, MESSAGE_MS_R_UP,
                                             screen_x, screen_y);
            if (down)
                bootstrap_right_click_result = BOOTSTRAP_MOUSE_CLICK_PENDING;
            else
                bootstrap_right_click_result = BOOTSTRAP_MOUSE_CLICK_SINGLE;
        }
        return;
    }
    if (!down)
        return;
    if (!*deadline)
    {
        *deadline = now_ns + BOOTSTRAP_MOUSE_DBL_TIME_NS;
        *saved_x = screen_x;
        *saved_y = screen_y;
        *is_double = FALSE;
        *down_sent = FALSE;
        if (button == 1)
            bootstrap_left_click_result = BOOTSTRAP_MOUSE_CLICK_PENDING;
        else
            bootstrap_right_click_result = BOOTSTRAP_MOUSE_CLICK_PENDING;
    }
    else
    {
        *deadline = now_ns;
        *saved_x = screen_x;
        *saved_y = screen_y;
        *is_double = TRUE;
        *down_sent = FALSE;
        if (button == 1)
            bootstrap_left_click_result = BOOTSTRAP_MOUSE_CLICK_PENDING;
        else
            bootstrap_right_click_result = BOOTSTRAP_MOUSE_CLICK_PENDING;
    }
}
U0 BootstrapWinRaise(CTask *task, CTask *root)
{//Move one live task to the top of the shared scheduler/window ring.
    CTask *previous, *next, *tail;
    if (!task || !root || !TaskValidate(task) || !TaskValidate(root))
        return;
    PUSHFD
    CLI
    if (task != root)
    {
        previous = task->last_task;
        next = task->next_task;
        if (!previous || !next || previous->next_task != task ||
            next->last_task != task)
        {
            POPFD
            return;
        }
        if (task != root->last_task)
        {
            previous->next_task = next;
            next->last_task = previous;
            tail = root->last_task;
            if (tail && tail->next_task == root)
            {
                task->last_task = tail;
                task->next_task = root;
                tail->next_task = task;
                root->last_task = task;
            }
            else
            {
                // Restore the original position if the ring head was invalid.
                task->last_task = previous;
                task->next_task = next;
                previous->next_task = task;
                next->last_task = task;
            }
        }
    }
    if (!(task->win_inhibit & (1 << WIf_SELF_FOCUS)))
        sys_focus_task = task;
    POPFD
}
public CTask *BootstrapWinClickFocus(I64 screen_x, I64 screen_y)
{//Focus and raise the topmost shown window under one screen-pixel point.
    CTask *root, *task, *target = NULL;
    CCtrl *head, *ctrl;
    I64 visited = 0, left, top, right, bottom, ctrl_visited;
    root = sys_winmgr_task;
    if (!root)
        root = sys_task;
    if (!root || !TaskValidate(root))
        return NULL;
    task = root;
    do
    {
        if (!TaskValidate(task))
            break;
        if (task->display_flags & (1 << DISPLAYf_SHOW))
        {
            left = gr.pan_text_x + task->pix_left;
            top = gr.pan_text_y + task->pix_top;
            right = gr.pan_text_x + task->pix_right;
            bottom = gr.pan_text_y + task->pix_bottom;
            if (!(task->display_flags & (1 << DISPLAYf_NO_BORDER)))
            {
                left -= FONT_WIDTH;
                right += FONT_WIDTH;
                top -= FONT_HEIGHT;
                bottom += FONT_HEIGHT;
            }
            if (screen_x >= left && screen_x <= right &&
                screen_y >= top && screen_y <= bottom)
                target = task; // Later ring entries are visually on top.
            // Scrollbars and other controls can live just outside the task's
            // client rectangle. Treat their visible hit boxes as part of the
            // owning window so a click does not fall through to its parent.
            head = &task->next_ctrl;
            ctrl = task->next_ctrl;
            ctrl_visited = 0;
            while (ctrl && ctrl != head && ctrl_visited++ < 64)
            {
                if ((ctrl->flags & CTRLF_SHOW) && CtrlInside(ctrl, screen_x,
                                                             screen_y))
                    target = task;
                ctrl = ctrl->next;
            }
        }
        task = task->next_task;
        visited++;
    }
    while (task && task != root && visited < BOOTSTRAP_WIN_MAX);
    if (target)
    {
        BootstrapWinRaise(target, root);
        return target;
    }
    return NULL;
}
Bool BootstrapWinMouseAllowed(CTask *task, CTask *focus_task,
                              I64 self_inhibit, I64 focus_inhibit)
{//Match WinMgr's per-button self and focused-task mouse gates.
    if (!task || !TaskValidate(task) ||
        (task->win_inhibit & (1 << self_inhibit)))
        return FALSE;
    if (TaskValidate(focus_task) &&
        (focus_task->win_inhibit & (1 << focus_inhibit)))
        return FALSE;
    return TRUE;
}
public CDoc *BootstrapWinCursorPosSet(CTask *task, I64 mouse_x, I64 mouse_y,
                                      Bool set_cursor=TRUE)
{//ARM64 bridge for WinMgr's DolDoc mouse-to-cursor mapping.
    CDoc *doc, *locked_doc;
    Bool unlock;
    I64 x0, y0;
    CTask *root;
    if (!task)
        task = Fs;
    if (!TaskValidate(task) || mouse_x < gr.pan_text_x + task->pix_left ||
        mouse_x > gr.pan_text_x + task->pix_right ||
        mouse_y < gr.pan_text_y + task->pix_top ||
        mouse_y > gr.pan_text_y + task->pix_bottom)
        return NULL;
    doc = DocDisplay(task);
    if (doc && (doc->flags & DOCF_DONT_SHOW))
        doc = NULL;
    else if (doc && set_cursor)
    {
        locked_doc = doc;
        unlock = DocLock(locked_doc);
        if (locked_doc->doc_signature != DOC_SIGNATURE_VAL)
            doc = NULL;
        else
        {
            x0 = locked_doc->line_start_col;
            y0 = locked_doc->top_line_num;
            DocRecalc(locked_doc, RECALCF_HAS_CURSOR);
            locked_doc->x = (mouse_x - gr.pan_text_x - task->pix_left -
                             task->scroll_x) / FONT_WIDTH + x0;
            locked_doc->y = (mouse_y - gr.pan_text_y - task->pix_top -
                             task->scroll_y) / FONT_HEIGHT + y0;
            DocRecalc(locked_doc, RECALCt_FIND_CURSOR);
            task->scroll_x = 0;
            task->scroll_y = 0;
            task->scroll_z = 0;
        }
        if (unlock)
            DocUnlock(locked_doc);
    }
    root = sys_winmgr_task;
    if (!root)
        root = sys_task;
    BootstrapWinRaise(task, root);
    return doc;
}
U0 BootstrapDocMousePress(CDoc *doc)
{//Show the upstream solid border on the entry pressed by the left button.
    Bool unlock;
    CDocEntry *entry;
    if (!doc || doc->doc_signature != DOC_SIGNATURE_VAL)
        return;
    unlock = DocLock(doc);
    if (doc->doc_signature == DOC_SIGNATURE_VAL)
    {
        entry = doc->cur_entry;
        if (entry && entry != doc && (entry->de_flags & DOCEF_HAS_BORDER))
            entry->de_flags |= DOCEF_SOLID_BORDER;
    }
    if (unlock)
        DocUnlock(doc);
}
I64 BootstrapDocMouseReleaseKey(CDoc *doc, I64 button)
{//Return the key WinMgr sends for a single click on the current DocEntry.
    Bool unlock;
    CDocEntry *entry;
    I64 key = 0;
    if (!doc || doc->doc_signature != DOC_SIGNATURE_VAL)
        return 0;
    unlock = DocLock(doc);
    if (doc->doc_signature == DOC_SIGNATURE_VAL)
    {
        entry = doc->cur_entry;
        if (entry && entry != doc)
        {
            if (button == 0 || button == 1)
            {
                if (entry->de_flags & DOCEF_HAS_BORDER)
                    entry->de_flags &= ~DOCEF_SOLID_BORDER;
                if (button == 1 && entry->de_flags &
                    (DOCEF_TREE | DOCEF_LIST | DOCEF_LINK |
                    DOCEF_CHECK_COLLAPSABLE | DOCEF_LEFT_CB |
                    DOCEF_LEFT_MACRO | DOCEF_LEFT_EXP))
                    key = CH_SPACE;
            }
            else if (button == 2 &&
                (entry->de_flags & (DOCEF_LINK | DOCEF_RIGHT_CB |
                                    DOCEF_RIGHT_MACRO | DOCEF_RIGHT_EXP)))
                key = '\n';
        }
    }
    if (unlock)
        DocUnlock(doc);
    return key;
}
I64 BootstrapDocMouseDoubleReleaseKey(I64 button)
{//Match WinMgr's Escape actions after a completed double-click on a DolDoc.
    if (button == 1)
        return CH_ESC;
    if (button == 2)
        return CH_SHIFT_ESC;
    return 0;
}
Bool BootstrapWinBorderAllowed(CTask *task)
{//Match WinMgr's self-border and focused-task border inhibit gates.
    if (!task || !TaskValidate(task) ||
        (task->win_inhibit & (1 << WIf_SELF_BORDER)))
        return FALSE;
    if (TaskValidate(sys_focus_task) &&
        (sys_focus_task->win_inhibit & (1 << WIf_FOCUS_TASK_BORDER)))
        return FALSE;
    return TRUE;
}
I64 BootstrapWinTitleButtonKind(CTask *task, I64 cell_x, I64 cell_y)
{//Classify the upstream task-menu and close bands on a bordered title row.
    if (!BootstrapWinBorderAllowed(task) ||
        !(task->display_flags & (1 << DISPLAYf_SHOW)) ||
        (task->display_flags & (1 << DISPLAYf_NO_BORDER)) ||
        cell_y != task->win_top - 1)
        return 0;
    if (cell_x >= task->win_left && cell_x < task->win_left + 4)
        return BOOTSTRAP_TITLE_MENU;
    if (cell_x >= task->win_right - 2 && cell_x <= task->win_right)
        return BOOTSTRAP_TITLE_CLOSE;
    return 0;
}
public Bool BootstrapWinTitleButtonActivate(CTask *task, I64 kind)
{//Match pinned WinMgr.ZC's title-row key and close actions.
    if (!BootstrapWinBorderAllowed(task))
        return FALSE;
    if (kind == BOOTSTRAP_TITLE_MENU)
        TaskMessage(task, NULL, MESSAGE_KEY_DOWN, CH_CTRLM,
                    0x43200000432, 0);
    else if (kind == BOOTSTRAP_TITLE_CLOSE)
    {
        if (DocPut(task))
            TaskMessage(task, NULL, MESSAGE_KEY_DOWN, CH_SHIFT_ESC, 0, 0);
        else
            Kill(task, FALSE);
    }
    else
        return FALSE;
    return TRUE;
}
public Bool BootstrapWinTitleButtonBegin(CTask *task, I64 screen_x,
                                          I64 screen_y)
{//Capture a task-menu or close press until its matching release.
    I64 cell_x, cell_y, kind;
    if (!task || !TaskValidate(task))
        return FALSE;
    cell_x = (screen_x - gr.pan_text_x) / FONT_WIDTH;
    cell_y = (screen_y - gr.pan_text_y) / FONT_HEIGHT;
    kind = BootstrapWinTitleButtonKind(task, cell_x, cell_y);
    if (!kind)
        return FALSE;
    bootstrap_title_button_task = task;
    bootstrap_title_button_kind = kind;
    return TRUE;
}
public Bool BootstrapWinTitleButtonEnd(I64 screen_x, I64 screen_y)
{//Activate only if release remains in the pressed title-button band.
    CTask *task = bootstrap_title_button_task;
    I64 kind = bootstrap_title_button_kind;
    I64 cell_x, cell_y;
    bootstrap_title_button_task = NULL;
    bootstrap_title_button_kind = 0;
    if (!task || !TaskValidate(task) || !kind)
        return FALSE;
    cell_x = (screen_x - gr.pan_text_x) / FONT_WIDTH;
    cell_y = (screen_y - gr.pan_text_y) / FONT_HEIGHT;
    if (BootstrapWinTitleButtonKind(task, cell_x, cell_y) != kind)
        return FALSE;
    return BootstrapWinTitleButtonActivate(task, kind);
}
I64 BootstrapWinDragKind(CTask *task, I64 cell_x, I64 cell_y)
{//Classify upstream WinMgr title and resize-border hit zones.
    if (!BootstrapWinBorderAllowed(task) ||
        !(task->display_flags & (1 << DISPLAYf_SHOW)) ||
        (task->display_flags & (1 << DISPLAYf_NO_BORDER)))
        return 0;
    if (cell_y == task->win_top - 1 &&
        task->win_left - 1 <= cell_x && cell_x <= task->win_right + 1)
    {
        // Keep the upstream task-menu/close bands out of move capture.
        if (task->win_left + 4 <= cell_x && cell_x <= task->win_right - 2)
            return BOOTSTRAP_DRAG_MOVE;
        return 0;
    }
    if (cell_x == task->win_right + 1 && cell_y == task->win_bottom + 1)
        return BOOTSTRAP_DRAG_BOTTOM_RIGHT;
    if (cell_x == task->win_left - 1 &&
        task->win_top <= cell_y && cell_y <= task->win_bottom)
        return BOOTSTRAP_DRAG_LEFT;
    if (cell_x == task->win_right + 1 &&
        task->win_top <= cell_y && cell_y <= task->win_bottom)
        return BOOTSTRAP_DRAG_RIGHT;
    if (cell_y == task->win_bottom + 1 &&
        task->win_left <= cell_x && cell_x <= task->win_right)
        return BOOTSTRAP_DRAG_BOTTOM;
    return 0;
}
public Bool BootstrapWinDragBegin(CTask *task, I64 screen_x, I64 screen_y)
{//Capture a title-bar move or visible resize edge on left-button press.
    I64 cell_x, cell_y, kind;
    if (!task || !TaskValidate(task))
        return FALSE;
    cell_x = (screen_x - gr.pan_text_x) / FONT_WIDTH;
    cell_y = (screen_y - gr.pan_text_y) / FONT_HEIGHT;
    kind = BootstrapWinDragKind(task, cell_x, cell_y);
    if (!kind)
        return FALSE;
    bootstrap_mouse_drag_task = task;
    bootstrap_mouse_drag_kind = kind;
    bootstrap_mouse_drag_start_x = cell_x;
    bootstrap_mouse_drag_start_y = cell_y;
    bootstrap_mouse_drag_left = task->win_left;
    bootstrap_mouse_drag_right = task->win_right;
    bootstrap_mouse_drag_top = task->win_top;
    bootstrap_mouse_drag_bottom = task->win_bottom;
    return TRUE;
}
public Bool BootstrapWinDragUpdate(I64 screen_x, I64 screen_y)
{//Apply one held-button sample using the drag's original window geometry.
    CTask *task = bootstrap_mouse_drag_task;
    I64 cell_x, cell_y, dx, dy, left, right, top, bottom, width, height;
    if (!task || !TaskValidate(task) || !bootstrap_mouse_drag_kind)
    {
        bootstrap_mouse_drag_task = NULL;
        bootstrap_mouse_drag_kind = 0;
        return FALSE;
    }
    cell_x = (screen_x - gr.pan_text_x) / FONT_WIDTH;
    cell_y = (screen_y - gr.pan_text_y) / FONT_HEIGHT;
    dx = cell_x - bootstrap_mouse_drag_start_x;
    dy = cell_y - bootstrap_mouse_drag_start_y;
    left = bootstrap_mouse_drag_left;
    right = bootstrap_mouse_drag_right;
    top = bootstrap_mouse_drag_top;
    bottom = bootstrap_mouse_drag_bottom;
    width = right - left + 1;
    height = bottom - top + 1;
    if (bootstrap_mouse_drag_kind == BOOTSTRAP_DRAG_MOVE)
    {
        left += dx;
        top += dy;
        right = left + width - 1;
        bottom = top + height - 1;
    }
    else if (bootstrap_mouse_drag_kind == BOOTSTRAP_DRAG_LEFT)
    {
        // Upstream WinMgr moves the left frame horizontally without changing
        // the window width.
        left += dx;
        right = left + width - 1;
    }
    else if (bootstrap_mouse_drag_kind == BOOTSTRAP_DRAG_RIGHT ||
             bootstrap_mouse_drag_kind == BOOTSTRAP_DRAG_BOTTOM_RIGHT)
    {
        right += dx;
        if (right < left) right = left;
    }
    if (bootstrap_mouse_drag_kind == BOOTSTRAP_DRAG_BOTTOM ||
        bootstrap_mouse_drag_kind == BOOTSTRAP_DRAG_BOTTOM_RIGHT)
    {
        bottom += dy;
        if (bottom < top) bottom = top;
    }
    else if (bootstrap_mouse_drag_kind == BOOTSTRAP_DRAG_LEFT)
    {
        top = bootstrap_mouse_drag_top;
        bottom = bootstrap_mouse_drag_bottom;
    }
    else if (bootstrap_mouse_drag_kind == BOOTSTRAP_DRAG_RIGHT)
    {
        top = bootstrap_mouse_drag_top;
        bottom = bootstrap_mouse_drag_bottom;
    }
    WinHorz(left, right, task);
    WinVert(top, bottom, task);
    return TRUE;
}
public U0 BootstrapWinDragEnd()
{//Release the captured window after button-up.
    bootstrap_mouse_drag_task = NULL;
    bootstrap_mouse_drag_kind = 0;
}
public Bool BootstrapCtrlInputSampleAt(CTask *task, I64 sample, I64 now_ns)
{//Feed one packed absolute tablet sample into the focused task's controls.
    CDoc *doc;
    CTask *mouse_focus_before;
    I64 x = sample & 0xffff;
    I64 y = (sample >> 16) & 0xffff;
    I64 buttons = (sample >> 32) & 0xff;
    I64 wheel = (sample >> 40) & 0xff;
    Bool handled = FALSE;
    if (wheel & 0x80)
        wheel -= 0x100;
    if (sample < 0 || !task || !TaskValidate(task))
        return FALSE;
    if (!bootstrap_mouse_sampled)
    {
        bootstrap_mouse_last_buttons = buttons;
        bootstrap_mouse_last_x = x;
        bootstrap_mouse_last_y = y;
        bootstrap_mouse_sampled = TRUE;
        if (wheel)
            return CtrlDispatchWheel(task, wheel);
        return FALSE;
    }
    BootstrapWinMouseClickTimer(sys_focus_task, now_ns, buttons, x, y);
    if (x != bootstrap_mouse_last_x || y != bootstrap_mouse_last_y)
    {
        CTask *mouse_task = sys_focus_task;
        if (TaskValidate(mouse_task))
            TaskMessage(mouse_task, NULL, MESSAGE_MS_MOVE,
                x - gr.pan_text_x - mouse_task->pix_left -
                    mouse_task->scroll_x,
                y - gr.pan_text_y - mouse_task->pix_top -
                    mouse_task->scroll_y, 0);
        bootstrap_mouse_last_x = x;
        bootstrap_mouse_last_y = y;
    }
    if (!(buttons & 1) && (bootstrap_mouse_last_buttons & 1))
        BootstrapWinMouseClickInput(sys_focus_task, 1, FALSE, x, y, now_ns);
    if (!(buttons & 2) && (bootstrap_mouse_last_buttons & 2))
        BootstrapWinMouseClickInput(sys_focus_task, 2, FALSE, x, y, now_ns);
    if (wheel)
        handled |= CtrlDispatchWheel(task, wheel);
    if ((buttons & 1) && !(bootstrap_mouse_last_buttons & 1))
    {
        CTask *mouse_focus_before = sys_focus_task;
        CTask *clicked = BootstrapWinClickFocus(x, y);
        if (clicked)
        {
            task = clicked;
            BootstrapWinMouseClickInput(sys_focus_task, 1, TRUE, x, y, now_ns);
            // Visible controls can extend into the window border. Give an
            // actual control hit priority over frame resizing in that area.
            if (CtrlDispatchLeftClick(clicked, x, y, TRUE))
            {
                bootstrap_mouse_last_buttons = buttons;
                return TRUE;
            }
            if (BootstrapWinTitleButtonBegin(clicked, x, y))
            {
                bootstrap_mouse_last_buttons = buttons;
                return TRUE;
            }
            if (BootstrapWinDragBegin(clicked, x, y))
            {
                bootstrap_mouse_last_buttons = buttons;
                return BootstrapWinDragUpdate(x, y);
            }
            if (BootstrapWinMouseAllowed(clicked, mouse_focus_before,
                                         WIf_SELF_MS_L,
                                         WIf_FOCUS_TASK_MS_L) &&
                (doc = BootstrapWinCursorPosSet(clicked, x, y, TRUE)))
            {
                BootstrapDocMousePress(doc);
                bootstrap_doc_mouse_task = clicked;
                bootstrap_doc_mouse_button = 1;
                bootstrap_mouse_last_buttons = buttons;
                return TRUE;
            }
        }
        else
            BootstrapWinMouseClickInput(sys_focus_task, 1, TRUE, x, y, now_ns);
    }
    if (bootstrap_mouse_drag_task)
    {
        if (buttons & 1)
            handled = BootstrapWinDragUpdate(x, y);
        else
        {
            BootstrapWinDragEnd();
            handled = TRUE;
        }
        bootstrap_mouse_last_buttons = buttons;
        return handled;
    }
    if (bootstrap_title_button_task)
    {
        if (buttons & 1)
            handled = TRUE;
        else
            handled = BootstrapWinTitleButtonEnd(x, y);
        bootstrap_mouse_last_buttons = buttons;
        return handled;
    }
    if (bootstrap_doc_mouse_task)
    {
        I64 button = bootstrap_doc_mouse_button;
        if (buttons & button)
        {
            bootstrap_mouse_last_buttons = buttons;
            return TRUE;
        }
        if (button == 1 && bootstrap_left_click_deadline_ns)
        {
            bootstrap_mouse_last_buttons = buttons;
            return TRUE;
        }
        if (button == 2 && bootstrap_right_click_deadline_ns)
        {
            bootstrap_mouse_last_buttons = buttons;
            return TRUE;
        }
        task = bootstrap_doc_mouse_task;
        bootstrap_doc_mouse_task = NULL;
        bootstrap_doc_mouse_button = 0;
        if (TaskValidate(task))
        {
            I64 self_mouse_inhibit, focus_mouse_inhibit, click_result;
            if (button == 1)
            {
                self_mouse_inhibit = WIf_SELF_MS_L;
                focus_mouse_inhibit = WIf_FOCUS_TASK_MS_L;
                click_result = bootstrap_left_click_result;
                bootstrap_left_click_result = BOOTSTRAP_MOUSE_CLICK_PENDING;
            }
            else
            {
                self_mouse_inhibit = WIf_SELF_MS_R;
                focus_mouse_inhibit = WIf_FOCUS_TASK_MS_R;
                click_result = bootstrap_right_click_result;
                bootstrap_right_click_result = BOOTSTRAP_MOUSE_CLICK_PENDING;
            }
            doc = BootstrapWinCursorPosSet(task, x, y, FALSE);
            if (doc && BootstrapWinMouseAllowed(task, sys_focus_task,
                self_mouse_inhibit, focus_mouse_inhibit))
            {
                I64 key;
                if (click_result == BOOTSTRAP_MOUSE_CLICK_DOUBLE)
                {
                    BootstrapDocMouseReleaseKey(doc, 0);
                    key = BootstrapDocMouseDoubleReleaseKey(button);
                }
                else
                    key = BootstrapDocMouseReleaseKey(doc, button);
                if (key)
                    TaskMessage(task, NULL, MESSAGE_KEY_DOWN, key, 0, 0);
            }
            else if (button == 1)
                BootstrapDocMouseReleaseKey(DocDisplay(task), 0);
        }
        bootstrap_mouse_last_buttons = buttons;
        return TRUE;
    }
    if ((buttons & 2) && !(bootstrap_mouse_last_buttons & 2))
    {
        mouse_focus_before = sys_focus_task;
        BootstrapWinMouseClickInput(sys_focus_task, 2, TRUE, x, y, now_ns);
        if (CtrlDispatchRightClick(task, x, y, TRUE))
        {
            bootstrap_mouse_last_buttons = buttons;
            return TRUE;
        }
        if (BootstrapWinMouseAllowed(task, mouse_focus_before,
                                     WIf_SELF_MS_R,
                                     WIf_FOCUS_TASK_MS_R) &&
            (doc = BootstrapWinCursorPosSet(task, x, y, TRUE)))
        {
            bootstrap_doc_mouse_task = task;
            bootstrap_doc_mouse_button = 2;
            bootstrap_mouse_last_buttons = buttons;
            return TRUE;
        }
        bootstrap_mouse_last_buttons = buttons;
        return FALSE;
    }
    if (buttons & 2)
        handled |= CtrlDispatchRightClick(task, x, y, TRUE);
    else if (bootstrap_mouse_last_buttons & 2)
        handled |= CtrlDispatchRightClick(task, x, y, FALSE);
    if (buttons & 1)
        handled |= CtrlDispatchLeftClick(task, x, y, TRUE);
    else if (bootstrap_mouse_last_buttons & 1)
        handled |= CtrlDispatchLeftClick(task, x, y, FALSE);
    bootstrap_mouse_last_buttons = buttons;
    return handled;
}
public Bool BootstrapCtrlInputSample(CTask *task, I64 sample)
{//Use the ARM generic timer as the monotonic input clock.
    return BootstrapCtrlInputSampleAt(task, sample, ZcMonotonicNs());
}
U0 BootstrapCtrlInputPoll()
{//Poll UTM's absolute tablet and route left-button samples to the focused task.
    CTask *task;
    task = Fs;
    if (TaskValidate(sys_focus_task))
        task = sys_focus_task;
    BootstrapCtrlInputSample(task, ZcTabletSample());
}
public Bool CtrlDispatchWheel(CTask *task, I64 delta)
{//WinMgr routes wheel changes to the focused task's first wheel control.
    CCtrl *head, *ctrl;
    I64 visited = 0;
    if (!BootstrapWinCtrlsAllowed(task) || !(ctrl = task->next_ctrl))
        return FALSE;
    head = &task->next_ctrl;
    while (ctrl && ctrl != head && visited++ < 64)
    {
        if ((ctrl->flags & CTRLF_SHOW) && ctrl->wheel_chg)
        {
            ctrl->wheel_chg(ctrl, delta);
            return TRUE;
        }
        ctrl = ctrl->next;
    }
    return FALSE;
}
U0 WinDerivedScrollValsUpdate(CCtrl *ctrl)
{
    CWinScroll *scroll;
    I64 range, low_color;
    if (!ctrl || !ctrl->win_task || !(scroll = ctrl->state))
        return;
    if (scroll->max < scroll->min)
        scroll->max = scroll->min;
    if (scroll->pos < scroll->min)
        scroll->pos = scroll->min;
    if (scroll->pos > scroll->max)
        scroll->pos = scroll->max;
    low_color = ctrl->win_task->border_attr & 0x0f;
    scroll->color = low_color | (low_color ^ 0x0f) << 4;
    range = scroll->max - scroll->min;
    if (!range)
        range = 1;
    if (ctrl->type == CTRLT_WIN_HSCROLL)
    {
        ctrl->left = gr.pan_text_x + FONT_WIDTH - WIN_SCROLL_BORDER_BONUS +
                     (scroll->pos - scroll->min) * ctrl->win_task->pix_width / range;
        ctrl->right = ctrl->left + WIN_SCROLL_SIZE - 1;
        ctrl->top = gr.pan_text_y + FONT_HEIGHT + ctrl->win_task->pix_height;
        ctrl->bottom = ctrl->top + WIN_SCROLL_SIZE - 1;
    }
    else if (ctrl->type == CTRLT_WIN_VSCROLL)
    {
        ctrl->left = gr.pan_text_x + FONT_WIDTH + ctrl->win_task->pix_width;
        ctrl->right = ctrl->left + WIN_SCROLL_SIZE - 1;
        ctrl->top = gr.pan_text_y + FONT_HEIGHT - WIN_SCROLL_BORDER_BONUS +
                    (scroll->pos - scroll->min) * ctrl->win_task->pix_height / range;
        ctrl->bottom = ctrl->top + WIN_SCROLL_SIZE - 1;
    }
}
U0 BootstrapCtrlsUpdate(CTask *task)
{
    CCtrl *ctrl;
    I64 visited = 0;
    if (!task || !(ctrl = task->next_ctrl))
        return;
    while (ctrl && ctrl != &task->next_ctrl && visited++ < 64)
    {
        if (ctrl->update_derived_vals)
            ctrl->update_derived_vals(ctrl);
        if (ctrl->flags & CTRLF_BORDER)
        {
            ctrl->screen_left = gr.pan_text_x + task->pix_left + ctrl->left - FONT_WIDTH;
            ctrl->screen_right = gr.pan_text_x + task->pix_left + ctrl->right - FONT_WIDTH;
            ctrl->screen_top = gr.pan_text_y + task->pix_top + ctrl->top - FONT_HEIGHT;
            ctrl->screen_bottom = gr.pan_text_y + task->pix_top + ctrl->bottom - FONT_HEIGHT;
        }
        else
        {
            ctrl->screen_left = gr.pan_text_x + task->pix_left + ctrl->left;
            ctrl->screen_right = gr.pan_text_x + task->pix_left + ctrl->right;
            ctrl->screen_top = gr.pan_text_y + task->pix_top + ctrl->top;
            ctrl->screen_bottom = gr.pan_text_y + task->pix_top + ctrl->bottom;
        }
        ctrl = ctrl->next;
    }
}
U0 DrawWinScroll(CDC *dc, CCtrl *ctrl)
{
    CWinScroll *scroll;
    I64 base, shade, swap;
    if (!dc || !ctrl || !(scroll = ctrl->state))
        return;
    base = scroll->color & 0x0f;
    shade = (scroll->color >> 4) & 0x0f;
    if (ctrl->flags & CTRLF_CLICKED)
    {
        swap = base;
        base = shade;
        shade = swap;
    }
    dc->color.c0.color = base;
    dc->color.c0.rop = ROPB_MONO;
    GrRect(dc, ctrl->left, ctrl->top,
           ctrl->right - ctrl->left + 1, ctrl->bottom - ctrl->top + 1);
    dc->color.c0.color = shade;
    GrRect(dc, ctrl->left + 2, ctrl->top + 2,
           ctrl->right - ctrl->left - 3, ctrl->bottom - ctrl->top - 3);
}
U0 LeftClickHWinScroll(CCtrl *ctrl, I64 x, I64 y, Bool down)
{
    CWinScroll *scroll;
    I64 range;
    if (!ctrl || !(scroll = ctrl->state) || !ctrl->win_task)
        return;
    range = ctrl->win_task->pix_width + 2 * WIN_SCROLL_BORDER_BONUS - WIN_SCROLL_SIZE;
    if (range < 1)
        range = 1;
    scroll->flags |= 1 << WSSf_SET_TO_POS;
    scroll->pos = ((x - (FONT_WIDTH - WIN_SCROLL_BORDER_BONUS)) *
                   (scroll->max - scroll->min + 1) + range / 2) / range + scroll->min;
    if (down)
        ctrl->flags |= CTRLF_CLICKED;
    else
        ctrl->flags &= ~CTRLF_CLICKED;
    WinDerivedScrollValsUpdate(ctrl);
}
U0 LeftClickVWinScroll(CCtrl *ctrl, I64 x, I64 y, Bool down)
{
    CWinScroll *scroll;
    I64 range;
    if (!ctrl || !(scroll = ctrl->state) || !ctrl->win_task)
        return;
    range = ctrl->win_task->pix_height + 2 * WIN_SCROLL_BORDER_BONUS - WIN_SCROLL_SIZE;
    if (range < 1)
        range = 1;
    scroll->flags |= 1 << WSSf_SET_TO_POS;
    scroll->pos = ((y - (FONT_HEIGHT - WIN_SCROLL_BORDER_BONUS)) *
                   (scroll->max - scroll->min + 1) + range / 2) / range + scroll->min;
    if (down)
        ctrl->flags |= CTRLF_CLICKED;
    else
        ctrl->flags &= ~CTRLF_CLICKED;
    WinDerivedScrollValsUpdate(ctrl);
}
U0 WheelChangeWinScroll(CCtrl *ctrl, I64 delta)
{
    CWinScroll *scroll;
    if (!ctrl || !(scroll = ctrl->state))
        return;
    scroll->flags |= 1 << WSSf_SET_TO_POS;
    scroll->pos += delta;
    WinDerivedScrollValsUpdate(ctrl);
}
U0 WinScrollsInit(CTask *task=NULL)
{
    CCtrl *ctrl;
    if (!task)
        task = Fs;
    if (!task)
        return;
    if (!task->next_ctrl && !task->last_ctrl)
        task->next_ctrl = task->last_ctrl = &task->next_ctrl;
    else if (!task->next_ctrl || !task->last_ctrl)
        return;
    if (!CtrlFindUnique(task, CTRLT_WIN_HSCROLL))
    {
        ctrl = CAlloc(sizeof(CCtrl), task);
        if (!ctrl)
            return;
        ctrl->win_task = task;
        ctrl->flags = CTRLF_SHOW | CTRLF_BORDER | CTRLF_CAPTURE_LEFT_MS;
        ctrl->type = CTRLT_WIN_HSCROLL;
        ctrl->state = &task->horz_scroll;
        ctrl->update_derived_vals = &WinDerivedScrollValsUpdate;
        ctrl->draw_it = &DrawWinScroll;
        ctrl->left_click = &LeftClickHWinScroll;
        QueueInsert(ctrl, task->last_ctrl);
    }
    if (!CtrlFindUnique(task, CTRLT_WIN_VSCROLL))
    {
        ctrl = CAlloc(sizeof(CCtrl), task);
        if (!ctrl)
            return;
        ctrl->win_task = task;
        ctrl->flags = CTRLF_SHOW | CTRLF_BORDER | CTRLF_CAPTURE_LEFT_MS;
        ctrl->type = CTRLT_WIN_VSCROLL;
        ctrl->state = &task->vert_scroll;
        ctrl->update_derived_vals = &WinDerivedScrollValsUpdate;
        ctrl->draw_it = &DrawWinScroll;
        ctrl->left_click = &LeftClickVWinScroll;
        ctrl->wheel_chg = &WheelChangeWinScroll;
        QueueInsert(ctrl, task->last_ctrl);
    }
    WinDerivedValsUpdate(task);
    BootstrapCtrlsUpdate(task);
}
U0 GrDrawTaskCallback(CTask *task)
{
    CDC *dc;
    if (!task || !TaskValidate(task) || !task->draw_it)
        return;
    dc = DCAlias(gr.dc2, task);
    task->draw_it(task, dc);
    DCDel(dc);
}
U0 DrawCtrls(CTask *task)
{//Run visible per-task control draw callbacks in list order.
    CCtrl *head, *ctrl;
    CDC *dc;
    I64 saved_scroll_x, saved_scroll_y, saved_left, saved_right;
    I64 saved_top, saved_bottom, visited = 0;
    Bool border;

    if (!task || !TaskValidate(task))
        return;
    head = &task->next_ctrl;
    ctrl = task->next_ctrl;
    if (!ctrl || ctrl == head)
        return;

    // Upstream controls are fixed to the window while document text scrolls.
    saved_scroll_x = task->scroll_x;
    saved_scroll_y = task->scroll_y;
    task->scroll_x = task->scroll_y = 0;
    dc = DCAlias(gr.dc2, task);
    do
    {
        if (!ctrl || visited++ >= 64)
            break;
        if ((ctrl->flags & CTRLF_SHOW) && ctrl->draw_it)
        {
            border = ctrl->flags & CTRLF_BORDER;
            if (!border || !(task->display_flags & (1 << DISPLAYf_NO_BORDER)))
            {
                if (border)
                {
                    saved_left = task->win_left;
                    saved_right = task->win_right;
                    saved_top = task->win_top;
                    saved_bottom = task->win_bottom;
                    task->win_left--;
                    task->win_right++;
                    task->win_top--;
                    task->win_bottom++;
                    WinDerivedValsUpdate(task);
                }
                ctrl->draw_it(dc, ctrl);
                if (border)
                {
                    task->win_left = saved_left;
                    task->win_right = saved_right;
                    task->win_top = saved_top;
                    task->win_bottom = saved_bottom;
                    WinDerivedValsUpdate(task);
                }
            }
        }
        ctrl = ctrl->next;
    }
    while (ctrl != head);
    DCDel(dc);
    task->scroll_x = saved_scroll_x;
    task->scroll_y = saved_scroll_y;
}
U0 GrUpdateTaskWin(CTask *task)
{//Redraw one window's text and graphics as one z-ordered layer.
    if (!task || !TaskValidate(task))
        return;
    if (!(task->display_flags & (1 << DISPLAYf_NO_BORDER)))
        TextBorder(Fs, task->win_left, task->win_right,
                   task->win_top, task->win_bottom,
                   task->border_attr, task == sys_focus_task);
    TextRect(task->win_left, task->win_right,
             task->win_top, task->win_bottom, task->text_attr << 8);
    if (!(task->win_inhibit & (1 << WIf_SELF_DOC)))
        ZcDocUpdateTaskDocs(task);
    ZcFbTaskTextCompose(task, gr.text_base, TEXT_COLS);
    ZcFbTextFlushRect(gr.text_base, TEXT_COLS, task->win_left,
                      task->win_right, task->win_top, task->win_bottom);
    GrDrawTaskCallback(task);
    if (TaskValidate(task))
        DrawCtrls(task);
}
extern U0 WinZBufUpdate();
extern Bool BootstrapWinIsUncovered(CTask *task);
I64 bootstrap_winmgr_ticks = 0;
U0 BootstrapGrUpdateTasks()
{//Bounded one-CPU window-ring refresh, drawn in ZealOS task/z order.
    CTask *root, *task;
    CGrGlobals *active_gr;
    I64 visited = 0;

    root = sys_winmgr_task;
    // A stale manager pointer can survive while the bootstrap root task is
    // valid. Fall back on validation failure as well as NULL, or the whole
    // frame (including its final CDC overlay) is silently skipped.
    if (!TaskValidate(root))
        root = sys_task;
    if (!root || !TaskValidate(root))
        return;

    BootstrapCtrlInputPoll();

    TextRect(0, TEXT_COLS - 1, 0, TEXT_ROWS - 1, 0x0800);
    ZcFbShellTextCompose(gr.text_base, TEXT_COLS);
    ZcFbTextFlush(gr.text_base, TEXT_COLS, TEXT_ROWS);
    WinZBufUpdate();
    task = root;
    do
    {
        if (!TaskValidate(task))
            break;
        if ((task->display_flags & (1 << DISPLAYf_SHOW)) &&
            BootstrapWinIsUncovered(task))
            GrUpdateTaskWin(task);
        task = task->next_task;
        visited++;
    }
    while (task && task != root && visited < 64);
    // Match GrUpdateScreen's final overlay stage: run after the window draw
    // callbacks with DCF_ON_TOP and screen-space coordinates. The bootstrap
    // and later source modules each define non-extern `gr` storage, so resolve
    // the newest source global from the active task's hash table.
    active_gr = ZcActiveGrGlobals();
    if (!active_gr)
        active_gr = &gr;
    if (active_gr->fp_final_screen_update)
    {
        CDC *dc = DCAlias(&bootstrap_graphics_dc, NULL);
        dc->flags |= DCF_ON_TOP;
        (*active_gr->fp_final_screen_update)(dc);
    }
}
public U0 BootstrapWinMgrTick()
{//One host-idle frame: route tablet clicks and redraw the task ring.
    bootstrap_winmgr_ticks++;
    BootstrapGrUpdateTasks();
}
Bool WinHorz(I64 left, I64 right, CTask *task=NULL)
{
    I64 d = right - left;
    if (!task)
        task = Fs;
    if (!TaskValidate(task))
        return FALSE;
    if (d < 0)
        d = 0;
    if (left >= TEXT_COLS)
    {
        left = TEXT_COLS - 1;
        right = left + d;
    }
    if (right < 0)
    {
        right = 0;
        left = right - d;
    }
    if (left > right)
    {
        if (left > 0)
            right = left;
        else
            left = right;
    }
    PUSHFD
    CLI
    if (task->win_left != left || task->win_right != right)
    {
        task->win_left = left;
        task->win_right = right;
        WinDerivedValsUpdate(task);
        BootstrapCtrlsUpdate(task);
        POPFD
        return TRUE;
    }
    POPFD
    return FALSE;
}
Bool WinVert(I64 top, I64 bottom, CTask *task=NULL)
{
    I64 d = bottom - top;
    if (!task)
        task = Fs;
    if (!TaskValidate(task))
        return FALSE;
    if (d < 0)
        d = 0;
    if (top >= TEXT_ROWS)
    {
        top = TEXT_ROWS - 1;
        bottom = top + d;
    }
    if (bottom <= 0)
    {
        bottom = 1;
        top = bottom - d;
    }
    if (top > bottom)
    {
        if (top >= 0)
            bottom = top;
        else
            top = bottom;
    }
    PUSHFD
    CLI
    if (task->win_top != top || task->win_bottom != bottom)
    {
        task->win_top = top;
        task->win_bottom = bottom;
        WinDerivedValsUpdate(task);
        BootstrapCtrlsUpdate(task);
        POPFD
        return TRUE;
    }
    POPFD
    return FALSE;
}
U0 WinScrollNull(CTask *task, CD3I64 *s)
{
    if (!task || !s)
        return;
    s->x = task->scroll_x;
    s->y = task->scroll_y;
    s->z = task->scroll_z;
    task->scroll_x = 0;
    task->scroll_y = 0;
    task->scroll_z = 0;
}
U0 WinScrollRestore(CTask *task, CD3I64 *s)
{
    if (!task || !s)
        return;
    task->scroll_x = s->x;
    task->scroll_y = s->y;
    task->scroll_z = s->z;
}
