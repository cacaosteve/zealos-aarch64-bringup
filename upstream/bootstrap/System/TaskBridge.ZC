// DolDoc StdOut document. Until DocDblBuf.ZC loads, report no put_doc.
CDoc *DocPut(CTask *task=NULL)
{
    CDoc *res;

    if (!task)
        task = Fs;
    if (Bt(&task->task_flags, TASKf_INPUT_FILTER_TASK))
        task = task->parent_task;
    if ((res = task->put_doc) && res->doc_signature == DOC_SIGNATURE_VAL)
        return res;
    return NULL;
}
// DocNew.ZC DocLock uses these around exclusive doc ownership. Pending breaks
// are not delivered until a debugger/Ctrl-Alt-C path exists.
Bool BreakLock(CTask *task=NULL)
{
    if (!task)
        task = Fs;
    return !LBts(&task->task_flags, TASKf_BREAK_LOCKED);
}
Bool BreakUnlock(CTask *task=NULL)
{
    Bool res;

    if (!task)
        task = Fs;
    res = LBtr(&task->task_flags, TASKf_BREAK_LOCKED);
    LBtr(&task->task_flags, TASKf_PENDING_BREAK);
    return res;
}
// MakeDoc.ZC owns the real doldoc tables; zeroed defaults let DocNew compile.
class CDolDocGlobals
{
    CHashTable	*hash;
    I64			 default_de_flags			[DOCT_TYPES_NUM],
                 type_flags_nontag_invis	[(DOCT_TYPES_NUM + 63) / 64],
                 type_flags_form 			[(DOCT_TYPES_NUM + 63) / 64],
                 type_flags_data 			[(DOCT_TYPES_NUM + 63) / 64],
                 type_flags_chk_dup			[(DOCT_TYPES_NUM + 63) / 64],
                 clean_scan_codes			[4];
    I32			 default_type_flags			[DOCT_TYPES_NUM];
} doldoc;
