U0 WinScrollNull(CTask *task, CD3I64 *s)
{
    if (!task || !s)
        return;
    s->x = task->scroll_x;
    s->y = task->scroll_y;
    s->z = task->scroll_z;
    task->scroll_x = 0;
    task->scroll_y = 0;
    task->scroll_z = 0;
}
U0 WinScrollRestore(CTask *task, CD3I64 *s)
{
    if (!task || !s)
        return;
    task->scroll_x = s->x;
    task->scroll_y = s->y;
    task->scroll_z = s->z;
}
