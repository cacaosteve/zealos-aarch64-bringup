// DocRecalcLib.ZC owns DocTop; stub cursor home without FormFwd/Recalc.
U0 DocTop(CDoc *doc=NULL)
{
    if (!doc && !(doc = DocPut))
        return;
    doc->cur_entry = doc->head.next;
    doc->cur_col = doc->cur_entry->min_col;
    doc->x = 0;
    doc->y = 0;
    doc->line_start_col = 0;
    doc->top_line_num = 0;
}
