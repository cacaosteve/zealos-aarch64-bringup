U8 *FileExtDot(U8 *src)
{
    U8 *ptr;

    if (!src)
        return NULL;
    ptr = src + BootstrapStrLen(src);
    while (ptr > src)
    {
        ptr--;
        if (*ptr == '.')
            return ptr;
        if (*ptr == '/' || *ptr == ':')
            break;
    }
    return NULL;
}
U0 WinZBufUpdate()
{//Build the ARM64 cell z-buffer and bitmap of windows with visible cells.
    CTask *root, *task;
    I64 visited = 0, z_count = 0, left, right, top, bottom, x, y, index, i;
    U16 old_z, z;

    MemSet(gr.win_z_buf, 0, TEXT_COLS * TEXT_ROWS * sizeof(U16));
    MemSet(gr.win_uncovered_bitmap, 0,
           (BOOTSTRAP_WIN_MAX + 15) / 16 * sizeof(U16));
    MemSet(bootstrap_win_uncovered_cells, 0,
           BOOTSTRAP_WIN_MAX * sizeof(U32));
    gr.highest_uncovered = 0;

    root = sys_winmgr_task;
    if (!root)
        root = sys_task;
    if (!root || !TaskValidate(root))
        return;
    task = root;
    do
    {
        if (!TaskValidate(task))
            break;
        task->win_z_num = 0;
        if ((task->display_flags & (1 << DISPLAYf_SHOW)) &&
            z_count < BOOTSTRAP_WIN_MAX)
        {
            z = ++z_count;
            task->win_z_num = z;
            left = task->win_left;
            right = task->win_right;
            top = task->win_top;
            bottom = task->win_bottom;
            if (left < 0) left = 0;
            if (top < 0) top = 0;
            if (right >= TEXT_COLS) right = TEXT_COLS - 1;
            if (bottom >= TEXT_ROWS) bottom = TEXT_ROWS - 1;
            for (y = top; y <= bottom; y++)
            {
                for (x = left; x <= right; x++)
                {
                    index = y * TEXT_COLS + x;
                    old_z = gr.win_z_buf[index];
                    if (old_z && old_z <= BOOTSTRAP_WIN_MAX &&
                        bootstrap_win_uncovered_cells[old_z - 1])
                        bootstrap_win_uncovered_cells[old_z - 1]--;
                    gr.win_z_buf[index] = z;
                    bootstrap_win_uncovered_cells[z - 1]++;
                }
            }
        }
        task = task->next_task;
        visited++;
    }
    while (task && task != root && visited < BOOTSTRAP_WIN_MAX);

    for (i = 0; i < z_count; i++)
    {
        if (bootstrap_win_uncovered_cells[i])
        {
            gr.win_uncovered_bitmap[i / 16] |= 1 << (i % 16);
            gr.highest_uncovered = i + 1;
        }
    }
}
Bool BootstrapWinIsUncovered(CTask *task)
{
    I64 z;
    if (!task || !(z = task->win_z_num) || z > BOOTSTRAP_WIN_MAX)
        return FALSE;
    return gr.win_uncovered_bitmap[(z - 1) / 16] & (1 << ((z - 1) % 16));
}
