U8 *FileExtDot(U8 *src)
{
    U8 *ptr;

    if (!src)
        return NULL;
    ptr = src + BootstrapStrLen(src);
    while (ptr > src)
    {
        ptr--;
        if (*ptr == '.')
            return ptr;
        if (*ptr == '/' || *ptr == ':')
            break;
    }
    return NULL;
}
