// The full kernel's SystemTask sets these run-level flags during startup.
I64 sys_run_level;
I64 MenuEntryWidth(CMenuEntry *entry)
{
    I64 width;
    CMenuEntry *sub;
    if (!entry)
        return 1;
    width = StrLen(entry->name);
    sub = entry->sub;
    while (sub)
    {
        I64 sub_width = StrLen(sub->name);
        if (sub_width > width)
            width = sub_width;
        sub = sub->next;
    }
    return width + 1;
}
