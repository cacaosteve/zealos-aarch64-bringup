// StrA / DocGet / DocRecalc helpers used by DocPutS before those modules load.
U8 *StrUtil(U8 *_src, I64 flags)
{
    U8 *src = _src, *dst = _src;
    I64 ch;

    if (!_src)
        return NULL;
    if (flags & SUF_REM_LEADING)
        while (*src == ' ' || *src == '\t')
            src++;
    while (ch = *src++)
    {
        if (ch == ' ' || ch == '\t')
        {
            if (!(flags & SUF_REM_SPACES))
                *dst++ = ch;
        }
        else if (!(flags & SUF_REM_CTRL_CHARS) || ch >= CH_SPACE)
            *dst++ = ch;
    }
    *dst = 0;
    return _src;
}
CDocEntry *ParseDollarCmd(CDoc *doc, U8 *st)
{
    CDocEntry *doc_e;

    // Until DocPlain/DocInit load, invent a full-sized ERROR entry so DocPrint
    // dollar cmds (DocBorderNew) can set tag_cb/user_data without smashing.
    if (!doc)
        return NULL;
    if (st) {}
    doc_e = CAlloc(sizeof(CDocEntry), doc->mem_task);
    doc_e->type = DOCT_ERROR | doc->settings_head.default_text_attr << 8;
    return doc_e;
}
