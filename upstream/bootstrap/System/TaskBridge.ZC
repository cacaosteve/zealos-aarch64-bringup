// task. PS/2 mouse polling is outside this bridge.
extern U0 KbdMouseHandler(Bool poll_kbd, Bool poll_mouse);
// Packed tablet sample: x[15:0], y[31:16], buttons[39:32], wheel s8[47:40].
extern I64 ZcTabletSample();
extern I64 ZcMonotonicNs();
extern F64 Exp(F64 x);
// Bootstrap subset of upstream MathODE.ZC; the unchanged full ODE module is
// pinned but currently triggers a compiler/runtime fault while loading.
F64 LowPass1(F64 a, F64 y0, F64 y, F64 dt=1.0)
{
    F64 decay = Exp(-a * dt);
    return y0 * decay + y * (1.0 - decay);
}
