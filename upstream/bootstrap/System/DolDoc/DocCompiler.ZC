// Character input for Aiwnios from real DolDoc entries. The initial three
// fields are the private native reader ABI; CCompCtrl retains its own layout.
class CArmDocInput
{
    CDoc *doc;
    CDocEntry *entry;
    I64 line;
    U8 *text, *owned;
    Bool first;
    Bool owns_doc;
};
extern U0 ZcUserDocAttach(CCompCtrl *cc, CArmDocInput *input,
    I64 (*reader)(CArmDocInput *input, Bool in_quotes, U8 **binary_data,
        I64 *binary_size),
    U0 (*deleter)(CArmDocInput *input), U8 *filename);

// Private markers consumed by Aiwnios' ARM64 lexer. Binary payload bytes and
// size travel through output parameters, never through the character stream.
#define ARM_DOC_TOKEN_INS_BIN      0x7FFFFF01
#define ARM_DOC_TOKEN_INS_BIN_SIZE 0x7FFFFF02

U0 ArmDocInputDel(CArmDocInput *input)
{
    Free(input->owned);
    if (input->owns_doc)
        DocDel(input->doc);
    Free(input);
}

CArmDocInput *ArmDocIncludeNew(U8 *filename, U8 *text, I64 size)
{//Same DocLoad and dollar policy as upstream LexDocRead/LexAttachDoc.
    CArmDocInput *input = CAlloc(sizeof(CArmDocInput));
    input->doc = DocNew(filename);
    input->owns_doc = TRUE;
    input->doc->flags |= DOCF_DBL_DOLLARS;
    DocLoad(input->doc, text, size);
    input->entry = input->doc->head.next;
    input->line = 1;
    input->first = TRUE;
    return input;
}
I64 ArmDocInputChar(CArmDocInput *input, Bool in_quotes,
    U8 **binary_data, I64 *binary_size)
{//LexCharGet's document traversal and LexDollar quote policy.
    CDocEntry *entry;
    U8 *plain;
    I64 ch;
    *binary_data = NULL;
    *binary_size = 0;
    while (TRUE)
    {
reader_start:
        if (input->text)
        {
            if (ch = *input->text++) return ch;
            input->text = NULL;
            Free(input->owned);
            input->owned = NULL;
            input->entry = input->entry->next;
        }
        entry = input->entry;
        if (entry == input->doc) return 0;
        input->line = entry->y + 1;
        // LexAttachDoc starts at the first source-code entry, rather than
        // interpreting a tree heading preceding its code as a string.
        if (input->first)
        {
            if (entry->type_u8 != DOCT_TEXT && entry->type_u8 != DOCT_TAB &&
                entry->type_u8 != DOCT_INS_BIN && entry->type_u8 != DOCT_INS_BIN_SIZE)
            {
                input->entry = entry->next;
                goto reader_start;
            }
            input->first = FALSE;
        }
        switch (entry->type_u8)
        {
            case DOCT_TEXT:
                if (!(entry->de_flags & ~(DOCEF_TAG | DOCEF_DEFINE | DOCEF_TAG_CB |
                    DOCG_BL_IV_UL | DOCEF_WORD_WRAP | DOCEF_HIGHLIGHT |
                    DOCEF_SKIP | DOCEF_FILTER_SKIP)) || !in_quotes)
                {
                    input->text = entry->tag;
                    goto reader_start;
                }
                break;
            case DOCT_NEW_LINE:
                input->entry = entry->next;
                return '\n';
            case DOCT_TAB:
                input->entry = entry->next;
                return '\t';
            case DOCT_MARKER:
            case DOCT_CURSOR:
                input->entry = entry->next;
                goto reader_start;
            case DOCT_INS_BIN:
                if (!entry->bin_data ||
                    (!entry->bin_data->data && entry->bin_data->size))
                {
                    Print("ARM64 compiler found an inline DolDoc binary token without data.\n");
                    throw('Compiler');
                }
                *binary_data = entry->bin_data->data;
                *binary_size = entry->bin_data->size;
                input->entry = entry->next;
                return ARM_DOC_TOKEN_INS_BIN;
            case DOCT_INS_BIN_SIZE:
                if (!entry->bin_data)
                {
                    Print("ARM64 compiler found an inline DolDoc binary size token without data.\n");
                    throw('Compiler');
                }
                *binary_size = entry->bin_data->size;
                input->entry = entry->next;
                return ARM_DOC_TOKEN_INS_BIN_SIZE;
            case DOCT_SHIFTED_Y:
                if (!in_quotes)
                {
                    input->entry = entry->next;
                    if (entry->attr < 0)
                        return TK_SUPERSCRIPT;
                    else if (entry->attr > 0)
                        return TK_SUBSCRIPT;
                    else
                        return TK_NORMALSCRIPT;
                }
                break;
        }
        if (in_quotes)
        {
            plain = Doc2PlainText(input->doc, entry);
            input->owned = MStrPrint("$$%$$Q$$", plain);
            Free(plain);
            input->text = input->owned;
        }
        else
            input->entry = entry->next;
    }
    return 0;
}
U0 ArmLexAttachDoc(CCompCtrl *cc, CDoc *doc)
{
    CArmDocInput *input = CAlloc(sizeof(CArmDocInput));
    input->doc = doc;
    input->entry = doc->head.next;
    input->line = 1;
    input->first = TRUE;
    ZcUserDocAttach(cc, input, &ArmDocInputChar, &ArmDocInputDel, doc->filename.name);
}
