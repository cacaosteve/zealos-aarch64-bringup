// Minimal document-backed terminal used by the ARM64 graphical bootstrap.
// The serial shell remains available independently through UART.
CTask *bootstrap_gui_terminal_task;
CTask *bootstrap_gui_terminal_home_second;
I64 bootstrap_gui_terminal_redraws = 0;
I64 bootstrap_gui_terminal_key_events = 0;
I64 bootstrap_gui_terminal_last_key_char = 0;
I64 bootstrap_gui_terminal_last_scan = 0;
I64 bootstrap_gui_terminal_editor_active = 0;
I64 bootstrap_gui_terminal_editor_raw = -1;
Bool bootstrap_gui_terminal_devices_ready = FALSE;
Bool bootstrap_gui_terminal_home_started = FALSE;
U8 bootstrap_gui_terminal_last_command[256];
I64 bootstrap_gui_terminal_input_len;
I64 bootstrap_gui_terminal_last_edit_result;
U0 (*bootstrap_gui_terminal_final_update)(CDC *dc);
#define GUI_PAINT_MAX_POINTS 8192
Bool bootstrap_gui_paint_active = FALSE;
I64 bootstrap_gui_paint_count;
I64 bootstrap_gui_paint_last_x, bootstrap_gui_paint_last_y;
Bool bootstrap_gui_paint_have_last = FALSE;
I32 bootstrap_gui_paint_x[GUI_PAINT_MAX_POINTS];
I32 bootstrap_gui_paint_y[GUI_PAINT_MAX_POINTS];
extern U8 *ZcGuiShellExec(U8 *line);
extern I64 ZcSourceEditorOverlayRender();
extern CDoc *DocRead(U8 *name=NULL, I64 flags=0);
extern U0 BootstrapGuiTerminalDocBottom(CDoc *doc=NULL);
extern U0 DocDel(CDoc *doc);
extern I64 ExeDoc(CDoc *doc, I64 ccf_flags=0);
extern U0 GrScaleZoom(F64 scale);
extern CMouseStateGlobals *ZcActiveMouseGlobals();
extern I64 BootstrapGuiTerminalZoomPanChecks();
extern Bool BootstrapWinPixelVisible(CTask *task, I64 x, I64 y);
extern Bool GrPlot(CDC *dc, I64 x, I64 y);
// Task slots can be reused. Match both address and generation before reading
// a terminal's history; the fixed registry owns no task-heap allocations.
class CBootstrapTerminalState
{
    CTask *task;
    I64 task_num;
    U8 history[256];
    I64 history_len;
};
CBootstrapTerminalState bootstrap_terminal_states[8];

CBootstrapTerminalState *BootstrapGuiTerminalState(CTask *task)
{
    I64 i;
    CBootstrapTerminalState *state;
    for (i = 0; i < 8; i++)
    {
        state = &bootstrap_terminal_states[i];
        if (state->task == task && TaskValidate(task) &&
            state->task_num == task->task_num)
            return state;
    }
    return NULL;
}

CBootstrapTerminalState *BootstrapGuiTerminalRegister()
{
    I64 i;
    CBootstrapTerminalState *state = BootstrapGuiTerminalState(Fs);
    if (state)
        return state;
    for (i = 0; i < 8; i++)
    {
        state = &bootstrap_terminal_states[i];
        if (!TaskValidate(state->task) || state->task_num != state->task->task_num)
        {
            MemSet(state, 0, sizeof(CBootstrapTerminalState));
            state->task = Fs;
            state->task_num = Fs->task_num;
            return state;
        }
    }
    throw('TermSlot');
    return NULL;
}
extern I64 ZcFbTextPixel(I64 x, I64 y);

#define GUI_MENU_ACTION_TAG 0x475549

U0 BootstrapGuiTerminalPrintOutput(U8 *output, CTask *terminal)
{//Keep each DocPrint below the runtime formatter limit for long command output.
    CDoc *doc;
    I64 i = 0;
    I64 n;
    U8 chunk[1024];

    if (!output)
        return;
    // Output may arrive while another task is compiling a DolDoc source file.
    // Always update the terminal document explicitly so cursor recalculation
    // cannot mutate the document that the compiler is currently reading.
    if (!TaskValidate(terminal) || !(doc = terminal->put_doc))
        return;
    BootstrapGuiTerminalDocBottom(doc);
    while (output[i])
    {
        for (n = 0; n < 1023 && output[i]; n++, i++)
            chunk[n] = output[i];
        chunk[n] = 0;
        DocPrint(doc, "%s", chunk);
    }
}

I64 BootstrapGuiTerminalBufferSet(U8 *command, I64 *command_len,
                                  U8 *value, I64 value_len)
{
    I64 i;

    if (!command || !command_len || value_len < 0 || value_len > 255)
        return 0;
    if (value_len && !value)
        return 0;
    for (i = 0; i < value_len; i++)
        command[i] = value[i];
    command[value_len] = 0;
    *command_len = value_len;
    return 0x2a;
}

U0 BootstrapGuiTerminalDocBottom(CDoc *doc=NULL)
{//Place shell output/input at the document sentinel, even after a mouse click.
    if (!doc && !(doc = Fs->put_doc))
        return;
    DocRecalc(doc, RECALCt_TO_SCREEN | RECALCF_HAS_CURSOR);
    doc->cur_entry = doc;
    doc->cur_col = 0;
}

I64 BootstrapGuiTerminalHistorySave(U8 *history, I64 *history_len,
                                   U8 *command, I64 command_len)
{
    if (!command_len)
        return 0x2a;
    return BootstrapGuiTerminalBufferSet(history, history_len,
                                         command, command_len);
}

I64 BootstrapGuiTerminalHistoryRecall(U8 *command, I64 *command_len,
                                      U8 *history, I64 history_len)
{
    if (!history_len)
        return 0;
    return BootstrapGuiTerminalBufferSet(command, command_len,
                                         history, history_len);
}

I64 BootstrapGuiTerminalCommandKey(U8 *command, I64 *command_len,
                                   I64 *command_pos, I64 ch, I64 scan)
{
    I64 i;
    I64 code = scan.u8[0];

    if (!command || !command_len || !command_pos ||
        *command_len < 0 || *command_len > 255 ||
        *command_pos < 0 || *command_pos > *command_len)
        return 0;
    if (!ch)
    {
        if (code == SC_CURSOR_LEFT)
        {
            if (*command_pos)
                (*command_pos)--;
            else
                return 2;
            return 1;
        }
        if (code == SC_CURSOR_RIGHT)
        {
            if (*command_pos < *command_len)
                (*command_pos)++;
            else
                return 2;
            return 1;
        }
        if (code == SC_HOME)
        {
            if (*command_pos)
                *command_pos = 0;
            else
                return 2;
            return 1;
        }
        if (code == SC_END)
        {
            if (*command_pos < *command_len)
                *command_pos = *command_len;
            else
                return 2;
            return 1;
        }
        if (code == SC_DELETE)
        {
            if (*command_pos >= *command_len)
                return 2;
            for (i = *command_pos; i < *command_len; i++)
                command[i] = command[i + 1];
            (*command_len)--;
            return 1;
        }
        return 0;
    }
    if (ch == 8 || ch == 127)
    {
        if (!*command_pos)
            return 2;
        for (i = *command_pos - 1; i < *command_len; i++)
            command[i] = command[i + 1];
        (*command_len)--;
        (*command_pos)--;
        return 1;
    }
    if (ch >= 32 && ch < 127)
    {
        if (*command_len >= 255)
            return 2;
        for (i = *command_len; i >= *command_pos; i--)
            command[i + 1] = command[i];
        command[*command_pos] = ch;
        (*command_len)++;
        (*command_pos)++;
        return 1;
    }
    return 0;
}

Bool BootstrapGuiTerminalComplete(U8 *command, I64 *command_len,
                                  I64 *command_pos, I64 scan)
{//Route upstream Ctrl+F1..F12 autocomplete into the bootstrap line buffer.
    I64 i, code = scan.u8[0], n;
    U8 *word;

    if (!(scan & SCF_CTRL))
        return FALSE;
    if (SC_F1 <= code <= SC_F10)
        n = code - SC_F1 + 1;
    else if (code == SC_F11)
        n = 11;
    else if (code == SC_F12)
        n = 12;
    else
        return FALSE;

    if (AutoComplete(ON) && n <= ac.num_fillins &&
        ac.fillin_matches[n - 1] &&
        (word = ac.fillin_matches[n - 1]->str) &&
        StrLen(word) > ac.partial_len)
    {
        // Keep the command buffer and document caret in lockstep. The
        // upstream ACFillIn uses In(), which writes only to DolDoc and would
        // leave this bootstrap shell's separate command buffer stale.
        BootstrapGuiTerminalDocBottom(DocPut);
        for (i = *command_len; i > *command_pos; i--)
            DocPutKey(DocPut, 0, SC_CURSOR_LEFT);
        for (i = ac.partial_len; word[i]; i++)
            if (BootstrapGuiTerminalCommandKey(command, command_len,
                                               command_pos, word[i], 0) == 1)
                DocPutKey(DocPut, word[i], 0);
            else
                break;
    }
    return TRUE;
}

CMenuEntry *BootstrapGuiTerminalMenuEntry(CTask *task, U8 *name, I64 action)
{
    CMenuEntry *entry = CAlloc(sizeof(CMenuEntry), task);
    StrCopy(entry->name, name);
    entry->message_code = MESSAGE_KEY_UP;
    entry->arg1 = action;
    entry->arg2 = GUI_MENU_ACTION_TAG;
    return entry;
}

CMenuEntry *BootstrapGuiTerminalMenuRoot(CMenu *menu, U8 *name)
{
    CMenuEntry *root;
    if (!menu || !name)
        return NULL;
    root = menu->sub;
    while (root)
    {
        if (!StrCompare(root->name, name))
            return root;
        root = root->next;
    }
    return NULL;
}

U0 BootstrapGuiTerminalMenuAppendRoot(CMenu *menu, CMenu *extra)
{//MenuNew input is capped at STR_LEN, so assemble the desktop bar from short pieces.
    CMenuEntry *tail;
    if (!menu || !extra || !extra->sub)
        throw('Menu');
    tail = &menu->sub;
    while (tail->next)
        tail = tail->next;
    tail->next = extra->sub;
    extra->sub = NULL;
    Free(extra);
}

Bool BootstrapGuiTerminalMenuBindLeaf(CMenuEntry *root, U8 *source_name,
                                      U8 *display_name, I64 action)
{
    CMenuEntry *entry;
    if (!root || !source_name || !display_name || action < 1 || action > 21)
        return FALSE;
    entry = root->sub;
    while (entry)
    {
        if (!StrCompare(entry->name, source_name))
        {
            if (entry->sub)
                return FALSE;
            StrCopy(entry->name, display_name);
            entry->message_code = MESSAGE_KEY_UP;
            entry->arg1 = action;
            entry->arg2 = GUI_MENU_ACTION_TAG;
            return TRUE;
        }
        entry = entry->next;
    }
    return FALSE;
}

Bool BootstrapGuiTerminalMenuActionValid(CMenu *menu, U8 *root_name,
                                         U8 *entry_name, I64 action)
{
    CMenuEntry *root = BootstrapGuiTerminalMenuRoot(menu, root_name);
    CMenuEntry *entry;
    if (!root || !entry_name)
        return FALSE;
    entry = root->sub;
    while (entry)
    {
        if (!StrCompare(entry->name, entry_name))
            return entry->message_code == MESSAGE_KEY_UP &&
                    entry->arg1 == action &&
                    entry->arg2 == GUI_MENU_ACTION_TAG;
        entry = entry->next;
    }
    return FALSE;
}

U0 BootstrapGuiTerminalMenuInstall()
{
    CMenu *menu = MenuNew("File { Files(); Disk(); }");
    BootstrapGuiTerminalMenuAppendRoot(menu, MenuNew("Windows { Demo(); TileHorz(); TileVert(); TileGrid(); }"));
    BootstrapGuiTerminalMenuAppendRoot(menu, MenuNew("Apps { LatticePlay(); StockPlay(); PaintDemo(); NetOfDots(); Lines(); }"));
    BootstrapGuiTerminalMenuAppendRoot(menu, MenuNew("View { ViewAngles(); ZoomIn(); ZoomOut(); ResetView(); PanLeft(); PanRight(); PanUp(); PanDown(); }"));
    BootstrapGuiTerminalMenuAppendRoot(menu, MenuNew("OS { Help(); Status(); }"));
    CMenuEntry *file = BootstrapGuiTerminalMenuRoot(menu, "File");
    CMenuEntry *windows = BootstrapGuiTerminalMenuRoot(menu, "Windows");
    CMenuEntry *apps = BootstrapGuiTerminalMenuRoot(menu, "Apps");
    CMenuEntry *view = BootstrapGuiTerminalMenuRoot(menu, "View");
    CMenuEntry *os = BootstrapGuiTerminalMenuRoot(menu, "OS");

    if (!file || !windows || !apps || !view || !os)
        throw('Menu');
    if (!BootstrapGuiTerminalMenuBindLeaf(file, "Files", "Files", 3) ||
        !BootstrapGuiTerminalMenuBindLeaf(file, "Disk", "Disk", 4) ||
        !BootstrapGuiTerminalMenuBindLeaf(windows, "Demo", "Window Demo", 5) ||
        !BootstrapGuiTerminalMenuBindLeaf(windows, "TileHorz", "Tile Windows Horizontally", 6) ||
        !BootstrapGuiTerminalMenuBindLeaf(windows, "TileVert", "Tile Windows Vertically", 7) ||
        !BootstrapGuiTerminalMenuBindLeaf(windows, "TileGrid", "Tile Windows as Grid", 8) ||
        !BootstrapGuiTerminalMenuBindLeaf(apps, "LatticePlay", "Lattice Play", 9) ||
        !BootstrapGuiTerminalMenuBindLeaf(apps, "StockPlay", "Stock Play", 10) ||
        !BootstrapGuiTerminalMenuBindLeaf(apps, "PaintDemo", "Paint Demo", 19) ||
        !BootstrapGuiTerminalMenuBindLeaf(apps, "NetOfDots", "Net of Dots", 20) ||
        !BootstrapGuiTerminalMenuBindLeaf(apps, "Lines", "Lines", 21) ||
        !BootstrapGuiTerminalMenuBindLeaf(view, "ViewAngles", "View Angles", 11) ||
        !BootstrapGuiTerminalMenuBindLeaf(view, "ZoomIn", "Zoom In", 12) ||
        !BootstrapGuiTerminalMenuBindLeaf(view, "ZoomOut", "Zoom Out", 13) ||
        !BootstrapGuiTerminalMenuBindLeaf(view, "ResetView", "Reset View", 14) ||
        !BootstrapGuiTerminalMenuBindLeaf(view, "PanLeft", "Pan Left", 15) ||
        !BootstrapGuiTerminalMenuBindLeaf(view, "PanRight", "Pan Right", 16) ||
        !BootstrapGuiTerminalMenuBindLeaf(view, "PanUp", "Pan Up", 17) ||
        !BootstrapGuiTerminalMenuBindLeaf(view, "PanDown", "Pan Down", 18) ||
        !BootstrapGuiTerminalMenuBindLeaf(os, "Help", "Help", 1) ||
        !BootstrapGuiTerminalMenuBindLeaf(os, "Status", "Status", 2))
        throw('Menu');
    menu->attr = BLUE << 4 + YELLOW;
    menu->next = Fs->cur_menu;
    Fs->cur_menu = menu;
}

U8 *BootstrapGuiTerminalZoomPanAction(I64 action)
{//Expose the source zoom viewport controls when edge recentering is insufficient.
    CGrGlobals *active_gr = ZcActiveGrGlobals();
    I64 max_x, max_y;

    if (!active_gr)
        active_gr = &gr;
    if (action == 12)
    {
        if (active_gr->screen_zoom < GR_SCREEN_ZOOM_MAX)
            GrScaleZoom(2.0);
        return "Zoom increased";
    }
    if (action == 13)
    {
        if (active_gr->screen_zoom > 1)
            GrScaleZoom(0.5);
        return "Zoom decreased";
    }
    if (action == 14)
    {
        while (active_gr->screen_zoom > 1)
            GrScaleZoom(0.5);
        active_gr->sx = active_gr->sy = 0;
        return "View reset";
    }
    if (action < 15 || action > 18)
        return NULL;

    max_x = GR_WIDTH - GR_WIDTH / MaxI64(1, active_gr->screen_zoom);
    max_y = GR_HEIGHT - GR_HEIGHT / MaxI64(1, active_gr->screen_zoom);
    if (action == 15)
        active_gr->sx -= 40;
    else if (action == 16)
        active_gr->sx += 40;
    else if (action == 17)
        active_gr->sy -= 40;
    else
        active_gr->sy += 40;
    active_gr->sx = ClampI64(active_gr->sx, 0, max_x);
    active_gr->sy = ClampI64(active_gr->sy, 0, max_y);
    return "View panned";
}

Bool BootstrapGuiTerminalPaintStop()
{//Clear the retained overlay so the next composed frame removes every stroke.
    if (!bootstrap_gui_paint_active)
        return FALSE;
    bootstrap_gui_paint_active = FALSE;
    bootstrap_gui_paint_count = 0;
    bootstrap_gui_paint_have_last = FALSE;
    return TRUE;
}

Bool BootstrapGuiTerminalPaintEscape(U8 *command, I64 *command_len,
                                     I64 *command_pos, Bool *overflow)
{//Consume Escape in Paint Demo and discard both the drawing and typed input.
    if (!BootstrapGuiTerminalPaintStop())
        return FALSE;
    if (command)
        command[0] = 0;
    if (command_len)
        *command_len = 0;
    if (command_pos)
        *command_pos = 0;
    if (overflow)
        *overflow = FALSE;
    return TRUE;
}

U8 *BootstrapGuiTerminalMenuSource(I64 action)
{//Run programs through the normal User command loop, outside the input reader.
    if (action == 20)
        return "#include \"/Demo/Graphics/NetOfDots\"";
    if (action == 21)
        return "#include \"/Demo/Graphics/Lines\"";
    return NULL;
}

U8 *BootstrapGuiTerminalMenuAction(I64 action)
{
    if (action == 1)
        return ZcGuiShellExec("help");
    if (action == 2)
        return ZcGuiShellExec("zstatus");
    if (action == 3)
        return FileMgr();
    if (action == 4)
        return ZcGuiShellExec("zvol");
    if (action == 6)
        WinTileHorz;
    if (action == 7)
        WinTileVert;
    if (action == 8)
        WinTileGrid;
    if (action == 9)
        return ZcGuiShellExec("latticeplay");
    if (action == 10)
        return ZcGuiShellExec("stockplay");
    if (action == 11)
    {
        if (CtrlFindUnique(Fs, CTRLT_VIEWING_ANGLES))
        {
            ViewAnglesDel(Fs);
            return "View-angle control hidden";
        }
        if (!ViewAnglesNew(Fs))
            return "View-angle control could not be created";
        return "View-angle control shown: click an X, Y, or Z track";
    }
    if (12 <= action <= 18)
        return BootstrapGuiTerminalZoomPanAction(action);
    if (action == 19)
    {
        if (bootstrap_gui_paint_active)
        {
            BootstrapGuiTerminalPaintStop;
            return "Paint Demo stopped";
        }
        bootstrap_gui_paint_active = TRUE;
        bootstrap_gui_paint_count = 0;
        bootstrap_gui_paint_have_last = FALSE;
        return "Paint Demo: hold and drag in this window; Esc clears";
    }
    return NULL;
}

U0 BootstrapGuiTerminalPaintAppend(I64 x, I64 y)
{//Retain one visible sample until Escape clears the drawing.
    CTask *task = bootstrap_gui_terminal_task;
    if (!TaskValidate(task) || bootstrap_gui_paint_count >= GUI_PAINT_MAX_POINTS ||
        x < task->pix_left || x > task->pix_right ||
        y < task->pix_top || y > task->pix_bottom ||
        !BootstrapWinPixelVisible(task, x, y))
        return;
    if (bootstrap_gui_paint_count &&
        bootstrap_gui_paint_x[bootstrap_gui_paint_count - 1] == x &&
        bootstrap_gui_paint_y[bootstrap_gui_paint_count - 1] == y)
        return;
    bootstrap_gui_paint_x[bootstrap_gui_paint_count] = x;
    bootstrap_gui_paint_y[bootstrap_gui_paint_count] = y;
    bootstrap_gui_paint_count++;
}

U0 BootstrapGuiTerminalPaintSample()
{//Sample the live absolute pointer while Paint Demo is active.
    CMouseStateGlobals *active_mouse = ZcActiveMouseGlobals();
    I64 x, y, dx, dy, sx, sy, err, e2, steps = 0;
    CTask *task = bootstrap_gui_terminal_task;
    if (!bootstrap_gui_paint_active || !TaskValidate(task) || !active_mouse ||
        !active_mouse->lb)
    {
        bootstrap_gui_paint_have_last = FALSE;
        return;
    }
    x = active_mouse->pos.x;
    y = active_mouse->pos.y;
    if (x < task->pix_left || x > task->pix_right ||
        y < task->pix_top || y > task->pix_bottom ||
        !BootstrapWinPixelVisible(task, x, y))
    {
        bootstrap_gui_paint_have_last = FALSE;
        return;
    }
    if (!bootstrap_gui_paint_have_last)
    {
        BootstrapGuiTerminalPaintAppend(x, y);
        bootstrap_gui_paint_last_x = x;
        bootstrap_gui_paint_last_y = y;
        bootstrap_gui_paint_have_last = TRUE;
        return;
    }
    // Bridge gaps between 60 Hz pointer samples with a bounded Bresenham line.
    dx = AbsI64(x - bootstrap_gui_paint_last_x);
    dy = -AbsI64(y - bootstrap_gui_paint_last_y);
    if (bootstrap_gui_paint_last_x < x)
        sx = 1;
    else
        sx = -1;
    if (bootstrap_gui_paint_last_y < y)
        sy = 1;
    else
        sy = -1;
    err = dx + dy;
    while (steps++ < 1600)
    {
        BootstrapGuiTerminalPaintAppend(bootstrap_gui_paint_last_x,
                                        bootstrap_gui_paint_last_y);
        if (bootstrap_gui_paint_last_x == x &&
            bootstrap_gui_paint_last_y == y)
            break;
        e2 = 2 * err;
        if (e2 >= dy)
        {
            err += dy;
            bootstrap_gui_paint_last_x += sx;
        }
        if (e2 <= dx)
        {
            err += dx;
            bootstrap_gui_paint_last_y += sy;
        }
    }
    bootstrap_gui_paint_last_x = x;
    bootstrap_gui_paint_last_y = y;
}

U0 BootstrapGuiTerminalPaintDraw(CDC *dc)
{//Replay the small retained stroke list over each freshly composited frame.
    I64 i, old_color;
    CTask *task = bootstrap_gui_terminal_task;
    if (!dc || !bootstrap_gui_paint_active || !TaskValidate(task))
        return;
    BootstrapGuiTerminalPaintSample;
    old_color = dc->color.c0;
    dc->color.c0 = YELLOW;
    for (i = 0; i < bootstrap_gui_paint_count; i++)
        if (BootstrapWinPixelVisible(task, bootstrap_gui_paint_x[i],
                                     bootstrap_gui_paint_y[i]))
            GrPlot(dc, bootstrap_gui_paint_x[i], bootstrap_gui_paint_y[i]);
    dc->color.c0 = old_color;
}

Bool BootstrapGuiTerminalPaintCommand(U8 *command, U8 **output)
{//Route typed `paint` to the live app instead of the serial smoke loop.
    if (!command || StrCompare(command, "paint"))
        return FALSE;
    if (output)
        *output = BootstrapGuiTerminalMenuAction(19);
    return TRUE;
}

Bool BootstrapGuiTerminalEditCommand(U8 *command, U8 **path)
{//Keep the interactive editor inside the guest terminal task, not host shell.
    U8 *start = command;
    if (path)
        *path = NULL;
    if (!command)
        return FALSE;
    while (*start == ' ' || *start == '\t')
        start++;
    if (start[0] != 'e' || start[1] != 'd' ||
        start[2] != 'i' || start[3] != 't' ||
        (start[4] && start[4] != ' ' && start[4] != '\t'))
        return FALSE;
    if (!path)
        return TRUE;
    if (!start[4])
    {
        *path = start + 4;
        return TRUE;
    }
    *path = start + 5;
    while (**path == ' ' || **path == '\t')
        (*path)++;
    return TRUE;
}

Bool BootstrapGuiTerminalEditFile(U8 *path)
{//Use the upstream DolDoc editor while keeping its document in this task.
    CDoc *doc;
    CTaskSettings *settings;
    Bool result = FALSE;

    if (!path || !*path)
        return FALSE;
    settings = SettingsPush;
    if (!settings)
        return FALSE;
    doc = DocRead(path);
    if (!doc || doc->doc_signature != DOC_SIGNATURE_VAL)
    {
        if (doc)
            DocDel(doc);
        SettingsPop;
        return FALSE;
    }
    doc->desc = 'Edit';
    if (*doc->filename.name)
    {
        doc->filename.dirc = DirContextNew(doc->filename.name);
        if (!doc->filename.dirc)
        {
            DocDel(doc);
            SettingsPop;
            return FALSE;
        }
    }
    // This task is already running under the boot WinMgr redraw pump. Waiting
    // synchronously for two additional manager refreshes can starve its shell
    // task on the bootstrap scheduler; let the regular frame path redraw it.
    result = DocEd(doc, DOF_DONT_WINMGR_SYNC);
    if (result)
        DocWrite(doc);
    DirContextDel(doc->filename.dirc);
    doc->filename.dirc = NULL;
    DocDel(doc);
    SettingsPop;
    // Shift+Escape successfully closes an opened editor without saving.
    // Only allocation/read failures should be reported as an open failure.
    return TRUE;
}

U0 BootstrapGuiTerminalPrompt(Bool continuation)
{
    BootstrapGuiTerminalDocBottom;
    if (!continuation && Fs->new_answer)
    {
        if (Fs->answer_type & ~1 != RT_I0)
        {
            if (Fs->answer_type == RT_F64)
                DocPrint(DocPut, "ansf=%.7f\n", Fs->answer);
            else
                DocPrint(DocPut, "ans=0x%X=%d\n", Fs->answer, Fs->answer);
        }
        Fs->new_answer = FALSE;
    }
    if (continuation)
        DocPrint(DocPut, "... ");
    else
        DocPrint(DocPut, "> ");
}

U8 *BootstrapGuiTerminalReadLine2(Bool continuation)
{
    CBootstrapTerminalState *state = BootstrapGuiTerminalRegister;
    I64 ch, sc;
    I64 message;
    I64 command_len = 0;
    I64 command_pos = 0;
    Bool overflow = FALSE;
    I64 i;
    U8 command[256];

    U8 *output, *edit_path;

    command[0] = 0;
    bootstrap_gui_terminal_input_len = 0;
    bootstrap_gui_terminal_last_edit_result = 0;
    BootstrapGuiTerminalPrompt(continuation);

    while (TRUE)
    {
        // MessageScan discards events excluded by its mask. Separate DOWN,
        // UP and cleanup drains can lose a newly arriving USB key-down in
        // the UP/cleanup pass. Consume every event once in arrival order.
        while ((message = MessageScan(&ch, &sc, ~1)) != 0)
        {
            LBtr(&Fs->task_flags, TASKf_IDLE);
            LBtr(&Fs->task_flags, TASKf_CMD_LINE_PROMPT);
            if (message == MESSAGE_KEY_UP)
            {
                if (sc == GUI_MENU_ACTION_TAG)
                {
                    output = BootstrapGuiTerminalMenuSource(ch);
                    if (output)
                    {
                        BootstrapGuiTerminalHistorySave(state->history,
                                &state->history_len, output, StrLen(output));
                        StrCopy(bootstrap_gui_terminal_last_command, output);
                        DocPrint(DocPut, "\n> %s\n", output);
                        return StrNew(output);
                    }
                    output = BootstrapGuiTerminalMenuAction(ch);
                    if (ch == 5)
                        output = ZcGuiShellExec("windowdemo");
                    if (output)
                        BootstrapGuiTerminalPrintOutput(output, Fs);
                    command_len = 0;
                    command_pos = 0;
                    command[0] = 0;
                    overflow = FALSE;
                    BootstrapGuiTerminalPrompt(continuation);
                }
            }
            else if (message == MESSAGE_KEY_DOWN)
            {
                bootstrap_gui_terminal_key_events++;
                bootstrap_gui_terminal_last_key_char = ch;
                bootstrap_gui_terminal_last_scan = sc.u8[0];
                if (ch == '\r' || ch == '\n')
                {
                    BootstrapGuiTerminalDocBottom(DocPut);
                    DocPutKey(DocPut, ch, sc);
                    if (overflow)
                    {
                        DocPrint(DocPut, "input line exceeds 255 characters; chunk discarded\n");
                        return NULL;
                    }
                    command[command_len] = 0;
                    // Return on an empty line is a no-op, like the serial shell.
                    // In particular, don't flood the terminal with a command error
                    // when the host has delivered Return but not printable keys.
                    if (command_len && !continuation)
                    {
                        StrCopy(bootstrap_gui_terminal_last_command, command);
                        BootstrapGuiTerminalHistorySave(state->history, &state->history_len,
                                                        command, command_len);
                        if (BootstrapGuiTerminalEditCommand(command, &edit_path))
                        {
                            if (!*edit_path)
                                DocPrint(DocPut, "usage: edit <path>\n");
                            else
                            {
                                bootstrap_gui_terminal_editor_raw = IsRaw();
                                bootstrap_gui_terminal_editor_active = TRUE;
                                if (!BootstrapGuiTerminalEditFile(edit_path))
                                    DocPrint(DocPut, "edit: could not open document\n");
                                bootstrap_gui_terminal_editor_active = FALSE;
                            }
                        }
                        else
                        {
                            if (!BootstrapGuiTerminalPaintCommand(command,
                                                                  &output))
                                output = ZcGuiShellExec(command);
                            if (!output)
                                return StrNew(command);
                            BootstrapGuiTerminalPrintOutput(output, Fs);
                        }
                    }
                    if (continuation)
                        return StrNew(command);
                    command_len = 0;
                    command_pos = 0;
                    command[0] = 0;
                    BootstrapGuiTerminalPrompt(FALSE);
                }
                else if (ch == 27)
                {
                    BootstrapGuiTerminalDocBottom(DocPut);
                    if (BootstrapGuiTerminalPaintEscape(command,
                            &command_len, &command_pos, &overflow))
                    {
                        DocPrint(DocPut, "\nPaint Demo stopped; drawing cleared.\n");
                        BootstrapGuiTerminalPrompt(FALSE);
                    }
                    else
                    {
                        DocPrint(DocPut, "\n");
                        // Abort the complete pending chunk, including continuations.
                        return NULL;
                    }
                }
                else if (!ch && sc.u8[0] == SC_CURSOR_UP && state->history_len)
                {
                    BootstrapGuiTerminalDocBottom(DocPut);
                    for (i = 0; i < command_len; i++)
                        DocPutKey(DocPut, 8, 0);
                    BootstrapGuiTerminalHistoryRecall(command, &command_len,
                                                      state->history, state->history_len);
                    command_pos = command_len;
                    for (i = 0; i < command_len; i++)
                        DocPutKey(DocPut, command[i], 0);
                }
                else if (!ch && sc.u8[0] == SC_CURSOR_DOWN)
                {
                    BootstrapGuiTerminalDocBottom(DocPut);
                    for (i = 0; i < command_len; i++)
                        DocPutKey(DocPut, 8, 0);
                    command_len = 0;
                    command_pos = 0;
                    command[0] = 0;
                }
                else if (!ch && BootstrapGuiTerminalComplete(
                                        command, &command_len, &command_pos, sc))
                {
                    // The upstream Ctrl+Fn completion has already updated
                    // both the command buffer and visible document.
                }
                else
                {
                    // A mouse click inside the terminal can move DolDoc's
                    // insertion cursor into old text. Re-anchor at the end of
                    // the document, then move to the command-buffer position,
                    // so new prompt input never overwrites the transcript.
                    BootstrapGuiTerminalDocBottom(DocPut);
                    for (i = command_len; i > command_pos; i--)
                        DocPutKey(DocPut, 0, SC_CURSOR_LEFT);
                    if (ch >= 32 && ch < 127 && command_len == 255)
                        overflow = TRUE;
                    bootstrap_gui_terminal_last_edit_result =
                        BootstrapGuiTerminalCommandKey(command, &command_len,
                                                       &command_pos, ch, sc);
                    if (bootstrap_gui_terminal_last_edit_result == 1)
                        DocPutKey(DocPut, ch, sc);
                }
                bootstrap_gui_terminal_input_len = command_len;
            }
        }
        // User() waits for this task to reach its input prompt. Incoming
        // messages clear IDLE; reassert it only after draining the queue.
        LBts(&Fs->task_flags, TASKf_IDLE);
        LBts(&Fs->task_flags, TASKf_CMD_LINE_PROMPT);
        ZcTaskYield;
    }
}

U8 *BootstrapGuiTerminalReadLine(Bool continuation)
{//Restore wait flags on normal return and a reader/editor exception alike.
    I64 mask = 1 << TASKf_IDLE | 1 << TASKf_CMD_LINE_PROMPT;
    I64 old = Fs->task_flags & mask;
    U8 *result;
    try
    {
        result = BootstrapGuiTerminalReadLine2(continuation);
    }
    catch
    {
        bootstrap_gui_terminal_editor_active = FALSE;
        Fs->task_flags = Fs->task_flags & ~mask | old;
    }
    Fs->task_flags = Fs->task_flags & ~mask | old;
    return result;
}

I64 BootstrapGuiTerminalDevicesInit()
{//Initialize upstream keyboard-device services used by shell helpers.
    if (!bootstrap_gui_terminal_devices_ready)
    {
        KeyDevInit;
        bootstrap_gui_terminal_devices_ready = TRUE;
    }
    return 42;
}

U0 BootstrapGuiTerminalUserStartUp()
{//HomeSys owns the standard document/window setup; retain the accepted input.
    BootstrapHomeUserStartUp;
    // The source volume has no CDrive yet to supply its normal border color.
    if (!Fs->cur_dv)
        Fs->border_attr = CYAN;
    BootstrapGuiTerminalRegister;
    BootstrapGuiTerminalMenuInstall;
    // The welcome document changes foreground attributes. Give command input
    // the accepted white-on-black appearance after inserting that document.
    DocPrint(DocPut, "$$FG,WHITE$$$$BG,BLACK$$");
    DocPrint(DocPut, "ZealOS ARM64 graphical terminal\n");
    DocPrint(DocPut, "Edit with Left/Right, Home/End, Backspace and Delete.\n");
    DocPrint(DocPut, "Up recalls the last command; Down clears it.\n");
    DocPrint(DocPut, "ZealC runs directly; help lists bootstrap commands.\n");
    ZcUserPromptSet(&BootstrapGuiTerminalReadLine);
    ZcUserOutputSet(&BootstrapGuiTerminalPrintOutput);
}

U0 UserStartUp()
{//Late-bound customization point called by the original UserCmdLine.
    BootstrapGuiTerminalUserStartUp;
}

U0 ServerStartUp()
{//Late-bound HomeSys hook called by source-backed popup server tasks.
    BootstrapHomeServerStartUp;
}

U0 BootstrapGuiTerminalTileHomeWindows(CTask *first, CTask *second)
{//Tile only the two user terminals; bridge/System tasks are not desktop windows.
    I64 half = TEXT_COLS / 2;

    if (!TaskValidate(first) || !TaskValidate(second) || half < 4)
        return;
    WinHorz(1, half - 1, first);
    WinHorz(half + 1, TEXT_COLS - 2, second);
    WinVert(2, TEXT_ROWS - 2, first);
    WinVert(2, TEXT_ROWS - 2, second);
}

public I64 BootstrapGuiTerminalExeDocFile(U8 *filename, I64 ccf_flags=0)
{//Execute a source file as DolDoc so inline binary entries remain available.
    CDoc *doc = DocRead(filename);
    I64 result = 0;
    if (!doc)
        return 0;
    try
    {
        result = ExeDoc(doc, ccf_flags);
    }
    catch
    {
        Fs->catch_except = TRUE;
    }
    DocDel(doc);
    return result;
}

I64 BootstrapGuiTerminalHomeStart()
{//Run the supported first-terminal portion of HomeSys after the shell exists.
    if (bootstrap_gui_terminal_home_started)
        return 0x2a;

    // Execute the startup body extracted from pinned HomeSys.ZC. Its ARM64
    // overlay reuses the already-running first terminal and queues scheduler-
    // dependent commands there instead of issuing them from the C boot stack.
    // The DVD Once overlay opens a live session and explains that installation
    // is not yet supported on ARM64.
    if (BootstrapHomeStartUpTasks() != 0x2a)
        return 1;
    LBts(&sys_run_level, RLf_HOME);
    bootstrap_gui_terminal_home_started = TRUE;
    return 0x2a;
}

U0 BootstrapGuiTerminalTask(U8 *data)
{
    if (data) {}
    UserCmdLine;
}

U0 BootstrapGuiTerminalFinalUpdate(CDC *dc)
{//Paint the insertion caret after the source compositor's window redraws.
    CTask *term = sys_focus_task;
    CDoc *doc;
    I64 x, y, old_color;

    if (dc && BootstrapGuiTerminalState(term) && TaskValidate(term) &&
        Bt(&term->display_flags, DISPLAYf_SHOW) &&
        (doc = term->display_doc) && !(doc->flags & DOCF_HIDE_CURSOR) && !Blink)
    {
        x = term->win_left + doc->x - doc->line_start_col + (term->scroll_x >> 3);
        y = term->win_top + doc->y - doc->top_line_num + (term->scroll_y >> 3);
        if (term->win_left <= x <= term->win_right &&
            term->win_top <= y <= term->win_bottom &&
            BootstrapWinTextCellVisible(term, x, y))
        {
            old_color = dc->color.c0;
            dc->color.c0 = term->text_attr & 15;
            GrRect(dc, x * FONT_WIDTH, y * FONT_HEIGHT, 2, FONT_HEIGHT);
            dc->color.c0 = old_color;
        }
    }
    // Preserve the source menu/progress/mouse overlay, with the pointer last.
    if (bootstrap_gui_terminal_final_update)
        (*bootstrap_gui_terminal_final_update)(dc);
    BootstrapGuiTerminalPaintDraw(dc);
}

I64 BootstrapGuiTerminalStart()
{
    CTask *term;
    CGrGlobals *active_gr;

    if (TaskValidate(bootstrap_gui_terminal_task))
        return 1;
    term = Spawn(&BootstrapGuiTerminalTask, NULL, "Terminal");

    if (!TaskValidate(term))
        return 1;
    bootstrap_gui_terminal_task = term;
    term->display_flags = 1 << DISPLAYf_SHOW;
    term->border_attr = CYAN;
    term->win_left = 4;
    term->win_right = 70;
    term->win_top = 4;
    term->win_bottom = 34;
    WinDerivedValsUpdate(term);
    // The graphical display owns the VM keyboard from boot. The serial shell
    // continues to read its separate UART input path.
    sys_focus_task = term;
    active_gr = ZcActiveGrGlobals();
    if (active_gr && active_gr->fp_final_screen_update != &BootstrapGuiTerminalFinalUpdate)
    {
        bootstrap_gui_terminal_final_update = active_gr->fp_final_screen_update;
        active_gr->fp_final_screen_update = &BootstrapGuiTerminalFinalUpdate;
    }
    return 0x2a;
}

I64 BootstrapGuiTerminalStop()
{
    I64 i;
    CBootstrapTerminalState *state;
    CGrGlobals *active_gr = ZcActiveGrGlobals();

    if (active_gr && active_gr->fp_final_screen_update == &BootstrapGuiTerminalFinalUpdate)
        active_gr->fp_final_screen_update = bootstrap_gui_terminal_final_update;
    for (i = 0; i < 8; i++)
    {
        state = &bootstrap_terminal_states[i];
        if (TaskValidate(state->task) && state->task_num == state->task->task_num)
            Kill(state->task);
        state->task = NULL;
    }
    if (TaskValidate(bootstrap_gui_terminal_task))
        Kill(bootstrap_gui_terminal_task);
    bootstrap_gui_terminal_task = NULL;
    return 0x2a;
}

I64 BootstrapGuiTerminalWindowState()
{
    CTask *term = bootstrap_gui_terminal_task;
    I64 state = 0;

    if (!TaskValidate(term))
        return 0;
    state |= 1;
    if (Bt(&term->display_flags, DISPLAYf_SHOW))
        state |= 2;
    if (term->display_doc)
        state |= 4;
    if (term->put_doc)
        state |= 8;
    if (term->border_doc)
        state |= 16;
    if (term->win_width > 0 && term->win_height > 0)
        state |= 32;
    return state;
}

Bool BootstrapGuiTerminalDocumentsAvailable(CTask *task)
{//A frame must not wait on a document whose owner needs the next task slice.
    if (!TaskValidate(task))
        return FALSE;
    if (task->display_doc && Bt(&task->display_doc->locked_flags, DOClf_LOCKED))
        return FALSE;
    if (task->border_doc && Bt(&task->border_doc->locked_flags, DOClf_LOCKED))
        return FALSE;
    return TRUE;
}

I64 BootstrapGuiTerminalRedraw(CTask *task)
{
    if (!TaskValidate(task) || !task->display_doc)
        return 0;
    if (task->display_doc->win_task != task)
        return 0;
    if (!BootstrapGuiTerminalDocumentsAvailable(task))
        return 0;
    DocRecalc(task->display_doc, RECALCt_TO_SCREEN | RECALCF_HAS_CURSOR);
    if (task->border_doc && task->border_doc->win_task == task)
        DocRecalc(task->border_doc, RECALCt_TO_SCREEN);
    bootstrap_gui_terminal_redraws++;
    return 0x2a;
}

I64 BootstrapGuiTerminalRedrawCount()
{
    return bootstrap_gui_terminal_redraws;
}

I64 BootstrapGuiTerminalKeyEventCount()
{
    return bootstrap_gui_terminal_key_events;
}

I64 BootstrapGuiTerminalInputDiag()
{//Pack live line length and last editing result for cross-console diagnostics.
    return bootstrap_gui_terminal_input_len |
           bootstrap_gui_terminal_last_edit_result << 8;
}

I64 BootstrapGuiTerminalEditorActive()
{
    return bootstrap_gui_terminal_editor_active;
}

Bool BootstrapGuiTerminalEditorPutKey(I64 ch, I64 sc)
{//The headless ARM64 key bridge has no native KeyDev DolDoc device to echo into an editor.
    if (Fs == bootstrap_gui_terminal_task && bootstrap_gui_terminal_editor_active)
    {
        DocPutKey(DocPut, ch, sc);
        return TRUE;
    }
    return FALSE;
}

I64 BootstrapGuiTerminalEditorRaw()
{
    return bootstrap_gui_terminal_editor_raw;
}


I64 BootstrapGuiTerminalLastKeyChar()
{
    return bootstrap_gui_terminal_last_key_char;
}

I64 BootstrapGuiTerminalLastScan()
{
    return bootstrap_gui_terminal_last_scan;
}

I64 BootstrapGuiTerminalLastCommandIsHelp()
{
    U8 *command = bootstrap_gui_terminal_last_command;

    return command[0] == 'h' && command[1] == 'e' &&
           command[2] == 'l' && command[3] == 'p' && command[4] == 0;
}

I64 BootstrapGuiTerminalLastCommandIsZls()
{
    U8 *command = bootstrap_gui_terminal_last_command;

    return command[0] == 'z' && command[1] == 'l' &&
           command[2] == 's' && command[3] == 0;
}

I64 BootstrapGuiTerminalLastCommandIsZvol()
{
    U8 *command = bootstrap_gui_terminal_last_command;

    return command[0] == 'z' && command[1] == 'v' &&
           command[2] == 'o' && command[3] == 'l' && command[4] == 0;
}

I64 BootstrapGuiTerminalLastCommandIsEdit()
{
    U8 *command = bootstrap_gui_terminal_last_command;

    return BootstrapGuiTerminalEditCommand(command, NULL);
}

I64 BootstrapGuiTerminalTextPixelCount()
{
    CTask *task = bootstrap_gui_terminal_task;
    I64 x, y, count = 0;

    if (!TaskValidate(task))
        return 0;
    for (y = task->pix_top; y <= task->pix_bottom; y++)
        for (x = task->pix_left; x <= task->pix_right; x++)
            if (ZcFbTextPixel(x, y) == 0x00ffffff)
                count++;
    return count;
}

I64 BootstrapGuiTerminalPaintChecks()
{//Exercise pointer sampling, gap fill, and Escape cleanup.
    CMouseStateGlobals *active_mouse = ZcActiveMouseGlobals();
    CGrGlobals *active_gr = ZcActiveGrGlobals();
    CTask *task = bootstrap_gui_terminal_task;
    CDC *dc;
    U8 command[32];
    I64 command_len = 15, command_pos = 4;
    Bool overflow = TRUE;
    I64 old_x, old_y;
    I64 old_pixel, old_flags;
    Bool old_lb, old_active;
    I64 x, y;
    if (!TaskValidate(task) || !active_mouse || !active_gr ||
        !(dc = active_gr->dc) || !dc->body || dc->width_internal <= 0 ||
        dc->height <= 0)
        return 1;
    old_x = active_mouse->pos.x;
    old_y = active_mouse->pos.y;
    old_lb = active_mouse->lb;
    old_active = bootstrap_gui_paint_active;
    x = task->pix_left + 16;
    y = task->pix_top + 16;
    if (x < 0 || x >= dc->width_internal || y < 0 || y >= dc->height)
        return 1;
    old_pixel = dc->body[y * dc->width_internal + x];
    old_flags = dc->flags;
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;
    bootstrap_gui_paint_active = TRUE;
    bootstrap_gui_paint_count = 0;
    bootstrap_gui_paint_have_last = FALSE;
    active_mouse->pos.x = x;
    active_mouse->pos.y = y;
    active_mouse->lb = TRUE;
    BootstrapGuiTerminalPaintSample;
    if (bootstrap_gui_paint_count != 1 ||
        bootstrap_gui_paint_x[0] != x || bootstrap_gui_paint_y[0] != y)
        goto fail;
    BootstrapGuiTerminalPaintSample;
    if (bootstrap_gui_paint_count != 1)
        goto fail;
    active_mouse->pos.x = x + 5;
    active_mouse->pos.y = y + 3;
    BootstrapGuiTerminalPaintSample;
    if (bootstrap_gui_paint_count < 6 ||
        bootstrap_gui_paint_x[bootstrap_gui_paint_count - 1] != x + 5 ||
        bootstrap_gui_paint_y[bootstrap_gui_paint_count - 1] != y + 3)
        goto fail;
    bootstrap_gui_paint_count = 1;
    bootstrap_gui_paint_x[0] = x;
    bootstrap_gui_paint_y[0] = y;
    BootstrapGuiTerminalPaintDraw(dc);
    if (dc->body[y * dc->width_internal + x] != YELLOW)
        goto fail;
    StrCopy(command, "pending command");
    dc->body[y * dc->width_internal + x] = old_pixel;
    if (!BootstrapGuiTerminalPaintEscape(command, &command_len,
                                          &command_pos, &overflow) ||
        command[0] || command_len || command_pos || overflow ||
        bootstrap_gui_paint_active || bootstrap_gui_paint_count ||
        bootstrap_gui_paint_have_last)
        goto fail;
    active_mouse->lb = FALSE;
    BootstrapGuiTerminalPaintSample;
    BootstrapGuiTerminalPaintDraw(dc);
    if (bootstrap_gui_paint_have_last ||
        dc->body[y * dc->width_internal + x] != old_pixel)
        goto fail;
    active_mouse->pos.x = old_x;
    active_mouse->pos.y = old_y;
    active_mouse->lb = old_lb;
    dc->body[y * dc->width_internal + x] = old_pixel;
    dc->flags = old_flags;
    bootstrap_gui_paint_active = old_active;
    bootstrap_gui_paint_count = 0;
    bootstrap_gui_paint_have_last = FALSE;
    return 0x2a;
fail:
    active_mouse->pos.x = old_x;
    active_mouse->pos.y = old_y;
    active_mouse->lb = old_lb;
    dc->body[y * dc->width_internal + x] = old_pixel;
    dc->flags = old_flags;
    bootstrap_gui_paint_active = old_active;
    bootstrap_gui_paint_count = 0;
    bootstrap_gui_paint_have_last = FALSE;
    return 2;
}

I64 BootstrapGuiTerminalOutputOwnershipChecks()
{//Compiler diagnostics must append to the GUI terminal, not the active source doc.
    CTask *old_fs = Fs;
    CTask *terminal = bootstrap_gui_terminal_task;
    CTask *source_task = old_fs;
    CTask *candidate;
    CDoc *terminal_doc, *source_doc;
    CDoc *old_source_doc;
    CDocEntryBase *terminal_last, *source_last;
    I64 terminal_updates, source_updates;

    if (!TaskValidate(terminal) || !(terminal_doc = terminal->put_doc))
        return 1;
    if (!TaskValidate(source_task) || source_task == terminal)
        source_task = terminal->parent_task;
    if (!TaskValidate(source_task) || source_task == terminal)
        source_task = sys_task;
    if (!TaskValidate(source_task) || source_task == terminal)
    {
        candidate = terminal->next_task;
        if (TaskValidate(candidate) && candidate != terminal)
            source_task = candidate;
    }
    if (!TaskValidate(source_task))
        return 20;
    if (source_task == terminal)
        return 21;
    // The serial command task has no DolDoc put_doc in this startup profile.
    // Give it a temporary, real source document to model the compiler's Fs
    // context without changing the terminal or depending on another window.
    source_doc = DocNew(NULL, source_task);
    if (!source_doc)
        return 22;
    if (source_doc == terminal_doc)
        return 23;

    terminal_last = terminal_doc->head.last;
    terminal_updates = terminal_doc->updates_count;
    source_last = source_doc->head.last;
    source_updates = source_doc->updates_count;
    old_source_doc = source_task->put_doc;
    source_task->put_doc = source_doc;
    Fs = source_task;
    BootstrapGuiTerminalPrintOutput("GUI output ownership check\n", terminal);
    Fs = old_fs;
    source_task->put_doc = old_source_doc;

    if (source_doc->head.last != source_last ||
        source_doc->updates_count != source_updates ||
        terminal_doc->head.last == terminal_last ||
        terminal_doc->updates_count <= terminal_updates)
        return 3;
    return 0x2a;
}

I64 BootstrapGuiTerminalHide()
{
    if (TaskValidate(bootstrap_gui_terminal_task))
        bootstrap_gui_terminal_task->display_flags &= ~(1 << DISPLAYf_SHOW);
    return 0x2a;
}

I64 BootstrapGuiTerminalShow()
{
    CTask *term = bootstrap_gui_terminal_task;

    if (TaskValidate(term))
    {
        bootstrap_gui_terminal_task->display_flags |= 1 << DISPLAYf_SHOW;
        // Window-demo temporarily moves other task windows above the shell.
        // Showing the terminal and assigning keyboard focus alone leaves its
        // text behind those windows, so restore its z-order as well.
        WinToTop(term);
    }
    return 0x2a;
}

I64 BootstrapGuiTerminalSmoke()
{
    CMenu *menu;
    CMenuEntry *root;
    I64 command_len = 0;
    I64 history_len = 0;
    I64 command_pos = 0;
    U8 command[256];
    U8 history[256];
    U8 *output;
    U8 *edit_path;

    // The normal ARM64 boot already starts this task. In that configuration
    // the smoke confirms boot left a valid terminal instead of trying to
    // spawn a second one or tearing down the user's interactive window.
    if (TaskValidate(bootstrap_gui_terminal_task))
    {
        if (BootstrapGuiTerminalBufferSet(command, &command_len,
                                          "zstatus", 7) != 0x2a ||
            BootstrapGuiTerminalHistorySave(history, &history_len,
                                            command, command_len) != 0x2a ||
            history_len != 7 || StrCompare(history, "zstatus"))
            return 38;
        if (BootstrapGuiTerminalBufferSet(command, &command_len,
                                          "draft", 5) != 0x2a ||
            BootstrapGuiTerminalHistoryRecall(command, &command_len,
                                              history, history_len) != 0x2a ||
            command_len != 7 || StrCompare(command, "zstatus"))
            return 39;
        command_pos = 1;
        if (BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 'X', 0) != 1 ||
            command_len != 8 || command_pos != 2 ||
            StrCompare(command, "zXstatus"))
            return 42;
        if (BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 0,
                                           SC_CURSOR_LEFT) != 1 ||
            command_pos != 1 ||
            BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 8, 0) != 1 ||
            command_len != 7 || command_pos != 0 ||
            StrCompare(command, "Xstatus"))
            return 43;
        if (BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 0,
                                           SC_DELETE) != 1 ||
            command_len != 6 || StrCompare(command, "status"))
            return 44;
        if (BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 0,
                                           SC_END) != 1 || command_pos != 6 ||
            BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 0,
                                           SC_HOME) != 1 || command_pos != 0)
            return 45;
        if (BootstrapGuiTerminalBufferSet(command, &command_len,
                                          "", 0) != 0x2a ||
            command_len || command[0])
            return 41;
        StrCopy(command, "edit /Kernel/KernelA.HH");
        if (!BootstrapGuiTerminalEditCommand(command, &edit_path) ||
            StrCompare(edit_path, "/Kernel/KernelA.HH"))
            return 48;
        StrCopy(command, " \tedit \t/Kernel/KernelA.HH");
        if (!BootstrapGuiTerminalEditCommand(command, &edit_path) ||
            StrCompare(edit_path, "/Kernel/KernelA.HH"))
            return 53;
        StrCopy(command, "editor /Kernel/KernelA.HH");
        if (BootstrapGuiTerminalEditCommand(command, &edit_path))
            return 49;
        StrCopy(command, "edit");
        if (!BootstrapGuiTerminalEditCommand(command, &edit_path) ||
            *edit_path)
            return 50;
        // Bail mode exercises the real DocEd entry point and source-volume
        // read path without opening an interactive editor during boot tests.
        if (!Ed("/Tests/TaskAssertFun.ZC", 0x100))
            return 51;
        if (BootstrapGuiTerminalBufferSet(command, &command_len,
                                          "x", 256) != 0 || command_len)
            return 40;
        command_len = 255;
        command_pos = command_len;
        command[255] = 0;
        if (BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 'x', 0) != 2 ||
            command_len != 255 || command_pos != 255)
            return 46;
        menu = bootstrap_gui_terminal_task->cur_menu;
        if (!menu) return 11;
        if (menu->task != bootstrap_gui_terminal_task) return 18;
        root = menu->sub;
        if (!root || StrCompare(root->name, "File") || !root->dir) return 19;
        root = root->next;
        if (!root || StrCompare(root->name, "Windows") || !root->dir) return 69;
        root = root->next;
        if (!root || StrCompare(root->name, "Apps") || !root->dir) return 70;
        root = root->next;
        if (!root || StrCompare(root->name, "View") || !root->dir) return 71;
        root = root->next;
        if (!root || StrCompare(root->name, "OS") || !root->dir || root->next)
            return 72;
        if (!BootstrapGuiTerminalMenuActionValid(menu, "File", "Files", 3) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "File", "Disk", 4) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "Windows", "Window Demo", 5) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "Windows", "Tile Windows Horizontally", 6) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "Windows", "Tile Windows Vertically", 7) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "Windows", "Tile Windows as Grid", 8) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "Apps", "Lattice Play", 9) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "Apps", "Stock Play", 10) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "Apps", "Paint Demo", 19) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "Apps", "Net of Dots", 20) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "Apps", "Lines", 21) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "View", "View Angles", 11) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "View", "Zoom In", 12) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "View", "Zoom Out", 13) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "View", "Reset View", 14) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "View", "Pan Left", 15) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "View", "Pan Right", 16) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "View", "Pan Up", 17) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "View", "Pan Down", 18) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "OS", "Help", 1) ||
            !BootstrapGuiTerminalMenuActionValid(menu, "OS", "Status", 2))
            return 73;
        if (BootstrapGuiTerminalOutputOwnershipChecks() != 0x2a)
            return 74;
        if (BootstrapGuiTerminalZoomPanChecks() != 0x2a) return 64;
        output = BootstrapGuiTerminalMenuAction(19);
        if (!output || StrCompare(output,
            "Paint Demo: hold and drag in this window; Esc clears")) return 66;
        if (!bootstrap_gui_paint_active ||
            BootstrapGuiTerminalPaintChecks() != 0x2a)
            return 67;
        output = BootstrapGuiTerminalMenuAction(19);
        if (!output || StrCompare(output, "Paint Demo stopped") ||
            bootstrap_gui_paint_active || bootstrap_gui_paint_count)
            return 68;
        if (BootstrapGuiTerminalWindowState() != 0x3f) return 52;
        return 0x2a;
    }
    if (BootstrapGuiTerminalStart() != 0x2a ||
        !TaskValidate(bootstrap_gui_terminal_task))
        return 1;
    if (BootstrapGuiTerminalStop() != 0x2a ||
        TaskValidate(bootstrap_gui_terminal_task))
        return 2;
    return 0x2a;
}

I64 BootstrapGuiTerminalZoomPanChecks()
{//Pan shortcuts move the zoomed source viewport and remain bounded at each edge.
    CGrGlobals *active_gr = ZcActiveGrGlobals();
    CMouseStateGlobals *active_mouse = ZcActiveMouseGlobals();
    I64 old_mouse_x, old_mouse_y, old_mouse_z;
    I64 old_mouse_ox, old_mouse_oy, old_mouse_oz;
    F64 old_scale_x, old_scale_y, old_scale_z;
    I64 old_zoom, old_sx, old_sy, max_x, max_y;
    if (!active_gr)
        active_gr = &gr;
    if (!active_mouse)
        active_mouse = &mouse;
    old_zoom = active_gr->screen_zoom;
    old_sx = active_gr->sx;
    old_sy = active_gr->sy;
    old_mouse_x = active_mouse->pos.x;
    old_mouse_y = active_mouse->pos.y;
    old_mouse_z = active_mouse->pos.z;
    old_mouse_ox = active_mouse->offset.x;
    old_mouse_oy = active_mouse->offset.y;
    old_mouse_oz = active_mouse->offset.z;
    old_scale_x = active_mouse->scale.x;
    old_scale_y = active_mouse->scale.y;
    old_scale_z = active_mouse->scale.z;
    active_gr->screen_zoom = 1;
    active_gr->sx = active_gr->sy = 0;
    active_mouse->pos.x = 400;
    active_mouse->pos.y = 300;
    active_mouse->pos.z = 0;
    active_mouse->offset.x = active_mouse->offset.y = active_mouse->offset.z = 0;
    active_mouse->scale.x = active_mouse->scale.y = active_mouse->scale.z = 1.0;
    if (!BootstrapGuiTerminalZoomPanAction(12) || active_gr->screen_zoom != 2 ||
        !BootstrapGuiTerminalZoomPanAction(13) || active_gr->screen_zoom != 1 ||
        !BootstrapGuiTerminalZoomPanAction(14) || active_gr->sx || active_gr->sy)
        goto fail;
    active_gr->screen_zoom = 2;
    active_gr->sx = active_gr->sy = 0;
    if (!BootstrapGuiTerminalZoomPanAction(15) || active_gr->sx != 0 ||
        !BootstrapGuiTerminalZoomPanAction(16) || active_gr->sx != 40 ||
        !BootstrapGuiTerminalZoomPanAction(18) || active_gr->sy != 40 ||
        !BootstrapGuiTerminalZoomPanAction(17) || active_gr->sy != 0)
        goto fail;
    max_x = GR_WIDTH - GR_WIDTH / active_gr->screen_zoom;
    max_y = GR_HEIGHT - GR_HEIGHT / active_gr->screen_zoom;
    active_gr->sx = max_x;
    active_gr->sy = max_y;
    if (!BootstrapGuiTerminalZoomPanAction(16) || active_gr->sx != max_x ||
        !BootstrapGuiTerminalZoomPanAction(18) || active_gr->sy != max_y)
        goto fail;
    active_gr->screen_zoom = old_zoom;
    active_gr->sx = old_sx;
    active_gr->sy = old_sy;
    active_mouse->pos.x = old_mouse_x;
    active_mouse->pos.y = old_mouse_y;
    active_mouse->pos.z = old_mouse_z;
    active_mouse->offset.x = old_mouse_ox;
    active_mouse->offset.y = old_mouse_oy;
    active_mouse->offset.z = old_mouse_oz;
    active_mouse->scale.x = old_scale_x;
    active_mouse->scale.y = old_scale_y;
    active_mouse->scale.z = old_scale_z;
    return 0x2a;
fail:
    active_gr->screen_zoom = old_zoom;
    active_gr->sx = old_sx;
    active_gr->sy = old_sy;
    active_mouse->pos.x = old_mouse_x;
    active_mouse->pos.y = old_mouse_y;
    active_mouse->pos.z = old_mouse_z;
    active_mouse->offset.x = old_mouse_ox;
    active_mouse->offset.y = old_mouse_oy;
    active_mouse->offset.z = old_mouse_oz;
    active_mouse->scale.x = old_scale_x;
    active_mouse->scale.y = old_scale_y;
    active_mouse->scale.z = old_scale_z;
    return 0;
}

I64 BootstrapGuiShellSmoke()
{
    U8 *output;
    CDirEntry *tree, *entry;

    output = ZcGuiShellExec("");
    if (!output || output[0])
        return 6;
    output = ZcGuiShellExec(" \thelp \t");
    if (!output || output[0] != 'G' ||
        !StrMatch("OS menu: hold the pointer button, drag, then release on an item.", output))
        return 7;
    output = ZcGuiShellExec(" \tzstatus \t");
    if (!output || output[0] != 'z' || output[1] != 'c')
        return 8;
    output = ZcGuiShellExec("status");
    if (!output || output[0] != 'z' || output[1] != 'c')
        return 9;
    output = BootstrapGuiTerminalMenuAction(1);
    if (!output || output[0] != 'G')
        return 1;
    output = BootstrapGuiTerminalMenuAction(2);
    if (!output || output[0] != 'z')
        return 2;
    tree = BootstrapSourceFilesTree();
    if (!tree || !(tree->attr & RS_ATTR_DIR) || StrCompare(tree->full_name, "/"))
        return 3;
    entry = tree->sub;
    while (entry && StrCompare(entry->name, "System"))
        entry = entry->next;
    if (!entry || !(entry->attr & RS_ATTR_DIR) || !entry->sub)
    {
        DirTreeDel(tree);
        return 3;
    }
    DirTreeDel(tree);
    output = BootstrapGuiTerminalMenuAction(4);
    if (!output || output[0] != 'z')
        return 4;
    if (BootstrapGuiTerminalMenuAction(5))
        return 5;
    return 0x2a;
}
