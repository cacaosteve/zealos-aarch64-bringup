// Minimal document-backed terminal used by the ARM64 graphical bootstrap.
// The serial shell remains available independently through UART.
CTask *bootstrap_gui_terminal_task;
CTask *bootstrap_gui_terminal_home_second;
I64 bootstrap_gui_terminal_redraws = 0;
I64 bootstrap_gui_terminal_key_events = 0;
I64 bootstrap_gui_terminal_last_key_char = 0;
I64 bootstrap_gui_terminal_last_scan = 0;
I64 bootstrap_gui_terminal_editor_active = 0;
I64 bootstrap_gui_terminal_editor_raw = -1;
Bool bootstrap_gui_terminal_devices_ready = FALSE;
Bool bootstrap_gui_terminal_home_started = FALSE;
U8 bootstrap_gui_terminal_last_command[256];
I64 bootstrap_gui_terminal_input_len;
I64 bootstrap_gui_terminal_last_edit_result;
U0 (*bootstrap_gui_terminal_final_update)(CDC *dc);
extern U8 *ZcGuiShellExec(U8 *line);
// Task slots can be reused. Match both address and generation before reading
// a terminal's history; the fixed registry owns no task-heap allocations.
class CBootstrapTerminalState
{
    CTask *task;
    I64 task_num;
    U8 history[256];
    I64 history_len;
};
CBootstrapTerminalState bootstrap_terminal_states[8];

CBootstrapTerminalState *BootstrapGuiTerminalState(CTask *task)
{
    I64 i;
    CBootstrapTerminalState *state;
    for (i = 0; i < 8; i++)
    {
        state = &bootstrap_terminal_states[i];
        if (state->task == task && TaskValidate(task) &&
            state->task_num == task->task_num)
            return state;
    }
    return NULL;
}

CBootstrapTerminalState *BootstrapGuiTerminalRegister()
{
    I64 i;
    CBootstrapTerminalState *state = BootstrapGuiTerminalState(Fs);
    if (state)
        return state;
    for (i = 0; i < 8; i++)
    {
        state = &bootstrap_terminal_states[i];
        if (!TaskValidate(state->task) || state->task_num != state->task->task_num)
        {
            MemSet(state, 0, sizeof(CBootstrapTerminalState));
            state->task = Fs;
            state->task_num = Fs->task_num;
            return state;
        }
    }
    throw('TermSlot');
    return NULL;
}
extern I64 ZcFbTextPixel(I64 x, I64 y);

#define GUI_MENU_ACTION_TAG 0x475549

U0 BootstrapGuiTerminalPrintOutput(U8 *output)
{//Keep each DocPrint below the runtime formatter limit for long command output.
    I64 i = 0;
    I64 n;
    U8 chunk[1024];

    if (!output)
        return;
    while (output[i])
    {
        for (n = 0; n < 1023 && output[i]; n++, i++)
            chunk[n] = output[i];
        chunk[n] = 0;
        DocPrint(DocPut, "%s", chunk);
    }
}

I64 BootstrapGuiTerminalBufferSet(U8 *command, I64 *command_len,
                                  U8 *value, I64 value_len)
{
    I64 i;

    if (!command || !command_len || value_len < 0 || value_len > 255)
        return 0;
    if (value_len && !value)
        return 0;
    for (i = 0; i < value_len; i++)
        command[i] = value[i];
    command[value_len] = 0;
    *command_len = value_len;
    return 0x2a;
}

I64 BootstrapGuiTerminalHistorySave(U8 *history, I64 *history_len,
                                   U8 *command, I64 command_len)
{
    if (!command_len)
        return 0x2a;
    return BootstrapGuiTerminalBufferSet(history, history_len,
                                         command, command_len);
}

I64 BootstrapGuiTerminalHistoryRecall(U8 *command, I64 *command_len,
                                      U8 *history, I64 history_len)
{
    if (!history_len)
        return 0;
    return BootstrapGuiTerminalBufferSet(command, command_len,
                                         history, history_len);
}

I64 BootstrapGuiTerminalCommandKey(U8 *command, I64 *command_len,
                                   I64 *command_pos, I64 ch, I64 scan)
{
    I64 i;
    I64 code = scan.u8[0];

    if (!command || !command_len || !command_pos ||
        *command_len < 0 || *command_len > 255 ||
        *command_pos < 0 || *command_pos > *command_len)
        return 0;
    if (!ch)
    {
        if (code == SC_CURSOR_LEFT)
        {
            if (*command_pos)
                (*command_pos)--;
            else
                return 2;
            return 1;
        }
        if (code == SC_CURSOR_RIGHT)
        {
            if (*command_pos < *command_len)
                (*command_pos)++;
            else
                return 2;
            return 1;
        }
        if (code == SC_HOME)
        {
            if (*command_pos)
                *command_pos = 0;
            else
                return 2;
            return 1;
        }
        if (code == SC_END)
        {
            if (*command_pos < *command_len)
                *command_pos = *command_len;
            else
                return 2;
            return 1;
        }
        if (code == SC_DELETE)
        {
            if (*command_pos >= *command_len)
                return 2;
            for (i = *command_pos; i < *command_len; i++)
                command[i] = command[i + 1];
            (*command_len)--;
            return 1;
        }
        return 0;
    }
    if (ch == 8 || ch == 127)
    {
        if (!*command_pos)
            return 2;
        for (i = *command_pos - 1; i < *command_len; i++)
            command[i] = command[i + 1];
        (*command_len)--;
        (*command_pos)--;
        return 1;
    }
    if (ch >= 32 && ch < 127)
    {
        if (*command_len >= 255)
            return 2;
        for (i = *command_len; i >= *command_pos; i--)
            command[i + 1] = command[i];
        command[*command_pos] = ch;
        (*command_len)++;
        (*command_pos)++;
        return 1;
    }
    return 0;
}

Bool BootstrapGuiTerminalComplete(U8 *command, I64 *command_len,
                                  I64 *command_pos, I64 scan)
{//Route upstream Ctrl+F1..F12 autocomplete into the bootstrap line buffer.
    I64 i, code = scan.u8[0], n;
    U8 *word;

    if (!(scan & SCF_CTRL))
        return FALSE;
    if (SC_F1 <= code <= SC_F10)
        n = code - SC_F1 + 1;
    else if (code == SC_F11)
        n = 11;
    else if (code == SC_F12)
        n = 12;
    else
        return FALSE;

    if (AutoComplete(ON) && n <= ac.num_fillins &&
        ac.fillin_matches[n - 1] &&
        (word = ac.fillin_matches[n - 1]->str) &&
        StrLen(word) > ac.partial_len)
    {
        // Keep the command buffer and document caret in lockstep. The
        // upstream ACFillIn uses In(), which writes only to DolDoc and would
        // leave this bootstrap shell's separate command buffer stale.
        DocPutKey(DocPut, 0, SC_END);
        for (i = *command_len; i > *command_pos; i--)
            DocPutKey(DocPut, 0, SC_CURSOR_LEFT);
        for (i = ac.partial_len; word[i]; i++)
            if (BootstrapGuiTerminalCommandKey(command, command_len,
                                               command_pos, word[i], 0) == 1)
                DocPutKey(DocPut, word[i], 0);
            else
                break;
    }
    return TRUE;
}

CMenuEntry *BootstrapGuiTerminalMenuEntry(CTask *task, U8 *name, I64 action)
{
    CMenuEntry *entry = CAlloc(sizeof(CMenuEntry), task);
    StrCopy(entry->name, name);
    entry->message_code = MESSAGE_KEY_UP;
    entry->arg1 = action;
    entry->arg2 = GUI_MENU_ACTION_TAG;
    return entry;
}

U0 BootstrapGuiTerminalMenuInstall()
{
    CMenu *menu = CAlloc(sizeof(CMenu), Fs);
    CMenuEntry *root = CAlloc(sizeof(CMenuEntry), Fs);
    CMenuEntry *entry;

    StrCopy(root->name, "OS");
    root->dir = TRUE;
    root->sub = BootstrapGuiTerminalMenuEntry(Fs, "Help", 1);
    entry = root->sub;
    entry->next = BootstrapGuiTerminalMenuEntry(Fs, "Status", 2);
    entry = entry->next;
    entry->next = BootstrapGuiTerminalMenuEntry(Fs, "Files", 3);
    entry = entry->next;
    entry->next = BootstrapGuiTerminalMenuEntry(Fs, "Disk", 4);
    entry = entry->next;
    entry->next = BootstrapGuiTerminalMenuEntry(Fs, "Window Demo", 5);
    entry = entry->next;
    entry->next = BootstrapGuiTerminalMenuEntry(
            Fs, "Tile Windows Horizontally", 6);
    entry = entry->next;
    entry->next = BootstrapGuiTerminalMenuEntry(
            Fs, "Tile Windows Vertically", 7);
    entry = entry->next;
    entry->next = BootstrapGuiTerminalMenuEntry(
            Fs, "Tile Windows as Grid", 8);
    menu->task = Fs;
    menu->attr = BLUE << 4 + YELLOW;
    menu->sub = root;
    Fs->cur_menu = menu;
}

U8 *BootstrapGuiTerminalMenuAction(I64 action)
{
    if (action == 1)
        return ZcGuiShellExec("help");
    if (action == 2)
        return ZcGuiShellExec("zstatus");
    if (action == 3)
        return ZcGuiShellExec("zls");
    if (action == 4)
        return ZcGuiShellExec("zvol");
    if (action == 6)
        WinTileHorz;
    if (action == 7)
        WinTileVert;
    if (action == 8)
        WinTileGrid;
    return NULL;
}

Bool BootstrapGuiTerminalEditCommand(U8 *command, U8 **path)
{//Keep the interactive editor inside the guest terminal task, not host shell.
    if (path)
        *path = NULL;
    if (!command || command[0] != 'e' || command[1] != 'd' ||
        command[2] != 'i' || command[3] != 't' ||
        (command[4] && command[4] != ' ' && command[4] != '\t'))
        return FALSE;
    if (!path)
        return TRUE;
    if (!command[4])
    {
        *path = command + 4;
        return TRUE;
    }
    *path = command + 5;
    while (**path == ' ' || **path == '\t')
        (*path)++;
    return TRUE;
}

Bool BootstrapGuiTerminalEditFile(U8 *path)
{//Use the upstream DolDoc editor while keeping its document in this task.
    CDoc *doc;
    CTaskSettings *settings;
    Bool result = FALSE;

    if (!path || !*path)
        return FALSE;
    settings = SettingsPush;
    if (!settings)
        return FALSE;
    doc = DocRead(path);
    if (!doc || doc->doc_signature != DOC_SIGNATURE_VAL)
    {
        if (doc)
            DocDel(doc);
        SettingsPop;
        return FALSE;
    }
    doc->desc = 'Edit';
    if (*doc->filename.name)
    {
        doc->filename.dirc = DirContextNew(doc->filename.name);
        if (!doc->filename.dirc)
        {
            DocDel(doc);
            SettingsPop;
            return FALSE;
        }
    }
    // This task is already running under the boot WinMgr redraw pump. Waiting
    // synchronously for two additional manager refreshes can starve its shell
    // task on the bootstrap scheduler; let the regular frame path redraw it.
    result = DocEd(doc, DOF_DONT_WINMGR_SYNC);
    if (result)
        DocWrite(doc);
    DirContextDel(doc->filename.dirc);
    doc->filename.dirc = NULL;
    DocDel(doc);
    SettingsPop;
    // Shift+Escape successfully closes an opened editor without saving.
    // Only allocation/read failures should be reported as an open failure.
    return TRUE;
}

U0 BootstrapGuiTerminalPrompt(Bool continuation)
{
    if (!continuation && Fs->new_answer)
    {
        if (Fs->answer_type & ~1 != RT_I0)
        {
            if (Fs->answer_type == RT_F64)
                DocPrint(DocPut, "ansf=%.7f\n", Fs->answer);
            else
                DocPrint(DocPut, "ans=0x%X=%d\n", Fs->answer, Fs->answer);
        }
        Fs->new_answer = FALSE;
    }
    if (continuation)
        DocPrint(DocPut, "... ");
    else
        DocPrint(DocPut, "> ");
}

U8 *BootstrapGuiTerminalReadLine2(Bool continuation)
{
    CBootstrapTerminalState *state = BootstrapGuiTerminalRegister;
    I64 ch, sc;
    I64 message;
    I64 command_len = 0;
    I64 command_pos = 0;
    Bool overflow = FALSE;
    I64 i;
    U8 command[256];

    U8 *output, *edit_path;

    command[0] = 0;
    bootstrap_gui_terminal_input_len = 0;
    bootstrap_gui_terminal_last_edit_result = 0;
    BootstrapGuiTerminalPrompt(continuation);

    while (TRUE)
    {
        // MessageScan discards events excluded by its mask. Separate DOWN,
        // UP and cleanup drains can lose a newly arriving USB key-down in
        // the UP/cleanup pass. Consume every event once in arrival order.
        while ((message = MessageScan(&ch, &sc, ~1)) != 0)
        {
            LBtr(&Fs->task_flags, TASKf_IDLE);
            LBtr(&Fs->task_flags, TASKf_CMD_LINE_PROMPT);
            if (message == MESSAGE_KEY_UP)
            {
                if (sc == GUI_MENU_ACTION_TAG)
                {
                    output = BootstrapGuiTerminalMenuAction(ch);
                    if (ch == 5)
                        output = ZcGuiShellExec("windowdemo");
                    if (output)
                        BootstrapGuiTerminalPrintOutput(output);
                    command_len = 0;
                    command_pos = 0;
                    command[0] = 0;
                    overflow = FALSE;
                    BootstrapGuiTerminalPrompt(continuation);
                }
            }
            else if (message == MESSAGE_KEY_DOWN)
            {
                bootstrap_gui_terminal_key_events++;
                bootstrap_gui_terminal_last_key_char = ch;
                bootstrap_gui_terminal_last_scan = sc.u8[0];
                if (ch == '\r' || ch == '\n')
                {
                    DocPutKey(DocPut, 0, SC_END);
                    DocPutKey(DocPut, ch, sc);
                    if (overflow)
                    {
                        DocPrint(DocPut, "input line exceeds 255 characters; chunk discarded\n");
                        return NULL;
                    }
                    command[command_len] = 0;
                    // Return on an empty line is a no-op, like the serial shell.
                    // In particular, don't flood the terminal with a command error
                    // when the host has delivered Return but not printable keys.
                    if (command_len && !continuation)
                    {
                        StrCopy(bootstrap_gui_terminal_last_command, command);
                        BootstrapGuiTerminalHistorySave(state->history, &state->history_len,
                                                        command, command_len);
                        if (BootstrapGuiTerminalEditCommand(command, &edit_path))
                        {
                            if (!*edit_path)
                                DocPrint(DocPut, "usage: edit <path>\n");
                            else
                            {
                                bootstrap_gui_terminal_editor_raw = IsRaw();
                                bootstrap_gui_terminal_editor_active = TRUE;
                                if (!BootstrapGuiTerminalEditFile(edit_path))
                                    DocPrint(DocPut, "edit: could not open document\n");
                                bootstrap_gui_terminal_editor_active = FALSE;
                            }
                        }
                        else
                        {
                            output = ZcGuiShellExec(command);
                            if (!output)
                                return StrNew(command);
                            BootstrapGuiTerminalPrintOutput(output);
                        }
                    }
                    if (continuation)
                        return StrNew(command);
                    command_len = 0;
                    command_pos = 0;
                    command[0] = 0;
                    BootstrapGuiTerminalPrompt(FALSE);
                }
                else if (ch == 27)
                {
                    DocPutKey(DocPut, 0, SC_END);
                    DocPrint(DocPut, "\n");
                    // Abort the complete pending chunk, including continuations.
                    return NULL;
                }
                else if (!ch && sc.u8[0] == SC_CURSOR_UP && state->history_len)
                {
                    DocPutKey(DocPut, 0, SC_END);
                    for (i = 0; i < command_len; i++)
                        DocPutKey(DocPut, 8, 0);
                    BootstrapGuiTerminalHistoryRecall(command, &command_len,
                                                      state->history, state->history_len);
                    command_pos = command_len;
                    for (i = 0; i < command_len; i++)
                        DocPutKey(DocPut, command[i], 0);
                }
                else if (!ch && sc.u8[0] == SC_CURSOR_DOWN)
                {
                    DocPutKey(DocPut, 0, SC_END);
                    for (i = 0; i < command_len; i++)
                        DocPutKey(DocPut, 8, 0);
                    command_len = 0;
                    command_pos = 0;
                    command[0] = 0;
                }
                else if (!ch && BootstrapGuiTerminalComplete(
                                        command, &command_len, &command_pos, sc))
                {
                    // The upstream Ctrl+Fn completion has already updated
                    // both the command buffer and visible document.
                }
                else
                {
                    // A mouse click inside the terminal can move DolDoc's
                    // insertion cursor away from the command buffer. Re-anchor
                    // it to the current input position before echoing or editing
                    // so captured keyboard input remains visible after focus.
                    DocPutKey(DocPut, 0, SC_END);
                    for (i = command_len; i > command_pos; i--)
                        DocPutKey(DocPut, 0, SC_CURSOR_LEFT);
                    if (ch >= 32 && ch < 127 && command_len == 255)
                        overflow = TRUE;
                    bootstrap_gui_terminal_last_edit_result =
                        BootstrapGuiTerminalCommandKey(command, &command_len,
                                                       &command_pos, ch, sc);
                    if (bootstrap_gui_terminal_last_edit_result == 1)
                        DocPutKey(DocPut, ch, sc);
                }
                bootstrap_gui_terminal_input_len = command_len;
            }
        }
        // User() waits for this task to reach its input prompt. Incoming
        // messages clear IDLE; reassert it only after draining the queue.
        LBts(&Fs->task_flags, TASKf_IDLE);
        LBts(&Fs->task_flags, TASKf_CMD_LINE_PROMPT);
        ZcTaskYield;
    }
}

U8 *BootstrapGuiTerminalReadLine(Bool continuation)
{//Restore wait flags on normal return and a reader/editor exception alike.
    I64 mask = 1 << TASKf_IDLE | 1 << TASKf_CMD_LINE_PROMPT;
    I64 old = Fs->task_flags & mask;
    U8 *result;
    try
    {
        result = BootstrapGuiTerminalReadLine2(continuation);
    }
    catch
    {
        bootstrap_gui_terminal_editor_active = FALSE;
        Fs->task_flags = Fs->task_flags & ~mask | old;
    }
    Fs->task_flags = Fs->task_flags & ~mask | old;
    return result;
}

I64 BootstrapGuiTerminalDevicesInit()
{//KeyDev is global; its arrays and hooks must outlive every user terminal.
    if (!bootstrap_gui_terminal_devices_ready)
    {
        KeyDevInit;
        KeyDevAdd(&KDDocPutKey, &KDDocPutS, 0x80000000, TRUE);
        bootstrap_gui_terminal_devices_ready = TRUE;
    }
    return 42;
}

U0 BootstrapGuiTerminalUserStartUp()
{//HomeSys owns the standard document/window setup; retain the accepted input.
    BootstrapHomeUserStartUp;
    // The source volume has no CDrive yet to supply its normal border color.
    if (!Fs->cur_dv)
        Fs->border_attr = CYAN;
    BootstrapGuiTerminalRegister;
    BootstrapGuiTerminalMenuInstall;
    // The welcome document changes foreground attributes. Give command input
    // the accepted white-on-black appearance after inserting that document.
    DocPrint(DocPut, "$$FG,WHITE$$$$BG,BLACK$$");
    DocPrint(DocPut, "ZealOS ARM64 graphical terminal\n");
    DocPrint(DocPut, "Edit with Left/Right, Home/End, Backspace and Delete.\n");
    DocPrint(DocPut, "Up recalls the last command; Down clears it.\n");
    DocPrint(DocPut, "ZealC runs directly; help lists bootstrap commands.\n");
    ZcUserPromptSet(&BootstrapGuiTerminalReadLine);
    ZcUserOutputSet(&BootstrapGuiTerminalPrintOutput);
}

U0 UserStartUp()
{//Late-bound customization point called by the original UserCmdLine.
    BootstrapGuiTerminalUserStartUp;
}

U0 BootstrapGuiTerminalTileHomeWindows(CTask *first, CTask *second)
{//Tile only the two user terminals; bridge/System tasks are not desktop windows.
    I64 half = TEXT_COLS / 2;

    if (!TaskValidate(first) || !TaskValidate(second) || half < 4)
        return;
    WinHorz(1, half - 1, first);
    WinHorz(half + 1, TEXT_COLS - 2, second);
    WinVert(2, TEXT_ROWS - 2, first);
    WinVert(2, TEXT_ROWS - 2, second);
}

I64 BootstrapGuiTerminalHomeStart()
{//Run the supported first-terminal portion of HomeSys after the shell exists.
    CTask *user = bootstrap_gui_terminal_task;

    if (!TaskValidate(user))
        return 1;
    if (bootstrap_gui_terminal_home_started)
        return 0x2a;
    bootstrap_gui_terminal_home_started = TRUE;

    // The original HomeSys asks an interactive install question on DVD boot.
    // Keep that first-boot flow staged until the source-backed installer path
    // and its prompts are available; disk and RAM boots can run Once directly.
    if (sys_boot_src.u16[0] == BOOT_SRC_DVD)
        return 0x2a;

    // HomeSys creates a second terminal on disk/RAM boots. Keep the current
    // two-terminal layout used by the original HomeSys startup.
    bootstrap_gui_terminal_home_second = User();
    WinToTop(user);
    BootstrapGuiTerminalTileHomeWindows(user, bootstrap_gui_terminal_home_second);
    XTalk(user, "Cd; #include \"Once\";\n");
    // HomeSys builds the text index after the shell scheduler is running.
    // Queue it after Once so Spawn/TaskWait have a live guest task context.
    XTalk(user, "Silent; Cd(\"/\"); ACInit(\"/*;!*/Bible.TXT;!*/Clementine.TXT;!*/PCIDevices.DD;!*/HTML/*;!*/ChangeLog.DD\"); Cd(\"/Home\"); Silent(OFF);\n");
    return 0x2a;
}

U0 BootstrapGuiTerminalTask(U8 *data)
{
    if (data) {}
    UserCmdLine;
}

U0 BootstrapGuiTerminalFinalUpdate(CDC *dc)
{//Paint the insertion caret after the source compositor's window redraws.
    CTask *term = sys_focus_task;
    CDoc *doc;
    I64 x, y, old_color;

    if (dc && BootstrapGuiTerminalState(term) && TaskValidate(term) &&
        Bt(&term->display_flags, DISPLAYf_SHOW) &&
        (doc = term->display_doc) && !(doc->flags & DOCF_HIDE_CURSOR) && !Blink)
    {
        x = term->win_left + doc->x - doc->line_start_col + (term->scroll_x >> 3);
        y = term->win_top + doc->y - doc->top_line_num + (term->scroll_y >> 3);
        if (term->win_left <= x <= term->win_right &&
            term->win_top <= y <= term->win_bottom &&
            BootstrapWinTextCellVisible(term, x, y))
        {
            old_color = dc->color.c0;
            dc->color.c0 = term->text_attr & 15;
            GrRect(dc, x * FONT_WIDTH, y * FONT_HEIGHT, 2, FONT_HEIGHT);
            dc->color.c0 = old_color;
        }
    }
    // Preserve the source menu/progress/mouse overlay, with the pointer last.
    if (bootstrap_gui_terminal_final_update)
        (*bootstrap_gui_terminal_final_update)(dc);
}

I64 BootstrapGuiTerminalStart()
{
    CTask *term;
    CGrGlobals *active_gr;

    if (TaskValidate(bootstrap_gui_terminal_task))
        return 1;
    term = Spawn(&BootstrapGuiTerminalTask, NULL, "Terminal");

    if (!TaskValidate(term))
        return 1;
    bootstrap_gui_terminal_task = term;
    term->display_flags = 1 << DISPLAYf_SHOW;
    term->border_attr = CYAN;
    term->win_left = 4;
    term->win_right = 70;
    term->win_top = 4;
    term->win_bottom = 34;
    WinDerivedValsUpdate(term);
    // The graphical display owns the VM keyboard from boot. The serial shell
    // continues to read its separate UART input path.
    sys_focus_task = term;
    active_gr = ZcActiveGrGlobals();
    if (active_gr && active_gr->fp_final_screen_update != &BootstrapGuiTerminalFinalUpdate)
    {
        bootstrap_gui_terminal_final_update = active_gr->fp_final_screen_update;
        active_gr->fp_final_screen_update = &BootstrapGuiTerminalFinalUpdate;
    }
    return 0x2a;
}

I64 BootstrapGuiTerminalStop()
{
    I64 i;
    CBootstrapTerminalState *state;
    CGrGlobals *active_gr = ZcActiveGrGlobals();

    if (active_gr && active_gr->fp_final_screen_update == &BootstrapGuiTerminalFinalUpdate)
        active_gr->fp_final_screen_update = bootstrap_gui_terminal_final_update;
    for (i = 0; i < 8; i++)
    {
        state = &bootstrap_terminal_states[i];
        if (TaskValidate(state->task) && state->task_num == state->task->task_num)
            Kill(state->task);
        state->task = NULL;
    }
    if (TaskValidate(bootstrap_gui_terminal_task))
        Kill(bootstrap_gui_terminal_task);
    bootstrap_gui_terminal_task = NULL;
    return 0x2a;
}

I64 BootstrapGuiTerminalWindowState()
{
    CTask *term = bootstrap_gui_terminal_task;
    I64 state = 0;

    if (!TaskValidate(term))
        return 0;
    state |= 1;
    if (Bt(&term->display_flags, DISPLAYf_SHOW))
        state |= 2;
    if (term->display_doc)
        state |= 4;
    if (term->put_doc)
        state |= 8;
    if (term->border_doc)
        state |= 16;
    if (term->win_width > 0 && term->win_height > 0)
        state |= 32;
    return state;
}

Bool BootstrapGuiTerminalDocumentsAvailable(CTask *task)
{//A frame must not wait on a document whose owner needs the next task slice.
    if (!TaskValidate(task))
        return FALSE;
    if (task->display_doc && Bt(&task->display_doc->locked_flags, DOClf_LOCKED))
        return FALSE;
    if (task->border_doc && Bt(&task->border_doc->locked_flags, DOClf_LOCKED))
        return FALSE;
    return TRUE;
}

I64 BootstrapGuiTerminalRedraw(CTask *task)
{
    if (!TaskValidate(task) || !task->display_doc)
        return 0;
    if (task->display_doc->win_task != task)
        return 0;
    if (!BootstrapGuiTerminalDocumentsAvailable(task))
        return 0;
    DocRecalc(task->display_doc, RECALCt_TO_SCREEN | RECALCF_HAS_CURSOR);
    if (task->border_doc && task->border_doc->win_task == task)
        DocRecalc(task->border_doc, RECALCt_TO_SCREEN);
    bootstrap_gui_terminal_redraws++;
    return 0x2a;
}

I64 BootstrapGuiTerminalRedrawCount()
{
    return bootstrap_gui_terminal_redraws;
}

I64 BootstrapGuiTerminalKeyEventCount()
{
    return bootstrap_gui_terminal_key_events;
}

I64 BootstrapGuiTerminalInputDiag()
{//Pack live line length and last editing result for cross-console diagnostics.
    return bootstrap_gui_terminal_input_len |
           bootstrap_gui_terminal_last_edit_result << 8;
}

I64 BootstrapGuiTerminalEditorActive()
{
    return bootstrap_gui_terminal_editor_active;
}

I64 BootstrapGuiTerminalEditorRaw()
{
    return bootstrap_gui_terminal_editor_raw;
}


I64 BootstrapGuiTerminalLastKeyChar()
{
    return bootstrap_gui_terminal_last_key_char;
}

I64 BootstrapGuiTerminalLastScan()
{
    return bootstrap_gui_terminal_last_scan;
}

I64 BootstrapGuiTerminalLastCommandIsHelp()
{
    U8 *command = bootstrap_gui_terminal_last_command;

    return command[0] == 'h' && command[1] == 'e' &&
           command[2] == 'l' && command[3] == 'p' && command[4] == 0;
}

I64 BootstrapGuiTerminalLastCommandIsZls()
{
    U8 *command = bootstrap_gui_terminal_last_command;

    return command[0] == 'z' && command[1] == 'l' &&
           command[2] == 's' && command[3] == 0;
}

I64 BootstrapGuiTerminalLastCommandIsZvol()
{
    U8 *command = bootstrap_gui_terminal_last_command;

    return command[0] == 'z' && command[1] == 'v' &&
           command[2] == 'o' && command[3] == 'l' && command[4] == 0;
}

I64 BootstrapGuiTerminalLastCommandIsEdit()
{
    U8 *command = bootstrap_gui_terminal_last_command;

    return BootstrapGuiTerminalEditCommand(command, NULL);
}

I64 BootstrapGuiTerminalTextPixelCount()
{
    CTask *task = bootstrap_gui_terminal_task;
    I64 x, y, count = 0;

    if (!TaskValidate(task))
        return 0;
    for (y = task->pix_top; y <= task->pix_bottom; y++)
        for (x = task->pix_left; x <= task->pix_right; x++)
            if (ZcFbTextPixel(x, y) == 0x00ffffff)
                count++;
    return count;
}

I64 BootstrapGuiTerminalHide()
{
    if (TaskValidate(bootstrap_gui_terminal_task))
        bootstrap_gui_terminal_task->display_flags &= ~(1 << DISPLAYf_SHOW);
    return 0x2a;
}

I64 BootstrapGuiTerminalShow()
{
    CTask *term = bootstrap_gui_terminal_task;

    if (TaskValidate(term))
    {
        bootstrap_gui_terminal_task->display_flags |= 1 << DISPLAYf_SHOW;
        // Window-demo temporarily moves other task windows above the shell.
        // Showing the terminal and assigning keyboard focus alone leaves its
        // text behind those windows, so restore its z-order as well.
        WinToTop(term);
    }
    return 0x2a;
}

I64 BootstrapGuiTerminalSmoke()
{
    CMenu *menu;
    CMenuEntry *root;
    CMenuEntry *entry;
    I64 action;
    I64 command_len = 0;
    I64 history_len = 0;
    I64 command_pos = 0;
    U8 command[256];
    U8 history[256];
    U8 *edit_path;

    // The normal ARM64 boot already starts this task. In that configuration
    // the smoke confirms boot left a valid terminal instead of trying to
    // spawn a second one or tearing down the user's interactive window.
    if (TaskValidate(bootstrap_gui_terminal_task))
    {
        if (BootstrapGuiTerminalBufferSet(command, &command_len,
                                          "zstatus", 7) != 0x2a ||
            BootstrapGuiTerminalHistorySave(history, &history_len,
                                            command, command_len) != 0x2a ||
            history_len != 7 || StrCompare(history, "zstatus"))
            return 38;
        if (BootstrapGuiTerminalBufferSet(command, &command_len,
                                          "draft", 5) != 0x2a ||
            BootstrapGuiTerminalHistoryRecall(command, &command_len,
                                              history, history_len) != 0x2a ||
            command_len != 7 || StrCompare(command, "zstatus"))
            return 39;
        command_pos = 1;
        if (BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 'X', 0) != 1 ||
            command_len != 8 || command_pos != 2 ||
            StrCompare(command, "zXstatus"))
            return 42;
        if (BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 0,
                                           SC_CURSOR_LEFT) != 1 ||
            command_pos != 1 ||
            BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 8, 0) != 1 ||
            command_len != 7 || command_pos != 0 ||
            StrCompare(command, "Xstatus"))
            return 43;
        if (BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 0,
                                           SC_DELETE) != 1 ||
            command_len != 6 || StrCompare(command, "status"))
            return 44;
        if (BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 0,
                                           SC_END) != 1 || command_pos != 6 ||
            BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 0,
                                           SC_HOME) != 1 || command_pos != 0)
            return 45;
        if (BootstrapGuiTerminalBufferSet(command, &command_len,
                                          "", 0) != 0x2a ||
            command_len || command[0])
            return 41;
        StrCopy(command, "edit /Kernel/KernelA.HH");
        if (!BootstrapGuiTerminalEditCommand(command, &edit_path) ||
            StrCompare(edit_path, "/Kernel/KernelA.HH"))
            return 48;
        StrCopy(command, "editor /Kernel/KernelA.HH");
        if (BootstrapGuiTerminalEditCommand(command, &edit_path))
            return 49;
        StrCopy(command, "edit");
        if (!BootstrapGuiTerminalEditCommand(command, &edit_path) ||
            *edit_path)
            return 50;
        // Bail mode exercises the real DocEd entry point and source-volume
        // read path without opening an interactive editor during boot tests.
        if (!Ed("/Tests/TaskAssertFun.ZC", 0x100))
            return 51;
        if (BootstrapGuiTerminalBufferSet(command, &command_len,
                                          "x", 256) != 0 || command_len)
            return 40;
        command_len = 255;
        command_pos = command_len;
        command[255] = 0;
        if (BootstrapGuiTerminalCommandKey(command, &command_len,
                                           &command_pos, 'x', 0) != 2 ||
            command_len != 255 || command_pos != 255)
            return 46;
        menu = bootstrap_gui_terminal_task->cur_menu;
        if (!menu) return 11;
        if (menu->task != bootstrap_gui_terminal_task) return 18;
        root = menu->sub;
        if (!root) return 12;
        if (StrCompare(root->name, "OS") || !root->dir) return 19;
        entry = root->sub;
        for (action = 1; action <= 8; action++)
        {
            if (!entry) return 12 + action;
            if (entry->message_code != MESSAGE_KEY_UP) return 20 + action;
            if (entry->arg1 != action) return 24 + action;
            if (entry->arg2 != GUI_MENU_ACTION_TAG) return 28 + action;
            if (action == 1 && StrCompare(entry->name, "Help")) return 33;
            if (action == 2 && StrCompare(entry->name, "Status")) return 34;
            if (action == 3 && StrCompare(entry->name, "Files")) return 35;
            if (action == 4 && StrCompare(entry->name, "Disk")) return 36;
            if (action == 5 && StrCompare(entry->name, "Window Demo")) return 47;
            if (action == 6 &&
                StrCompare(entry->name, "Tile Windows Horizontally")) return 48;
            if (action == 7 &&
                StrCompare(entry->name, "Tile Windows Vertically")) return 49;
            if (action == 8 &&
                StrCompare(entry->name, "Tile Windows as Grid")) return 50;
            entry = entry->next;
        }
        if (entry) return 37;
        if (BootstrapGuiTerminalWindowState() != 0x3f) return 52;
        return 0x2a;
    }
    if (BootstrapGuiTerminalStart() != 0x2a ||
        !TaskValidate(bootstrap_gui_terminal_task))
        return 1;
    if (BootstrapGuiTerminalStop() != 0x2a ||
        TaskValidate(bootstrap_gui_terminal_task))
        return 2;
    return 0x2a;
}

I64 BootstrapGuiShellSmoke()
{
    U8 *output;

    output = ZcGuiShellExec("");
    if (!output || output[0])
        return 6;
    output = ZcGuiShellExec(" \thelp \t");
    if (!output || output[0] != 'G')
        return 7;
    output = ZcGuiShellExec(" \tzstatus \t");
    if (!output || output[0] != 'z' || output[1] != 'c')
        return 8;
    output = BootstrapGuiTerminalMenuAction(1);
    if (!output || output[0] != 'G')
        return 1;
    output = BootstrapGuiTerminalMenuAction(2);
    if (!output || output[0] != 'z')
        return 2;
    output = BootstrapGuiTerminalMenuAction(3);
    // Catalog order depends on bundled directories and subsequent guest
    // writes. Check the listing's completion marker, not its first filename.
    if (!output)
        return 3;
    if (StrCompare(output, "zls: native source partition unavailable\n") &&
        (!StrMatch("zls: n=", output) ||
         StrMatch("[output truncated]", output)))
        return 9;
    output = BootstrapGuiTerminalMenuAction(4);
    if (!output || output[0] != 'z')
        return 4;
    if (BootstrapGuiTerminalMenuAction(5))
        return 5;
    return 0x2a;
}
