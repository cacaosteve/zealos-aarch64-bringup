// Minimal document-backed terminal used by the ARM64 graphical bootstrap.
// The serial shell remains available independently through UART.
CTask *bootstrap_gui_terminal_task;
extern U8 *ZcGuiShellExec(U8 *line);

#define GUI_MENU_ACTION_TAG 0x475549

CMenuEntry *BootstrapGuiTerminalMenuEntry(CTask *task, U8 *name, I64 action)
{
    CMenuEntry *entry = CAlloc(sizeof(CMenuEntry), task);
    StrCopy(entry->name, name);
    entry->message_code = MESSAGE_KEY_UP;
    entry->arg1 = action;
    entry->arg2 = GUI_MENU_ACTION_TAG;
    return entry;
}

U0 BootstrapGuiTerminalMenuInstall()
{
    CMenu *menu = CAlloc(sizeof(CMenu), Fs);
    CMenuEntry *root = CAlloc(sizeof(CMenuEntry), Fs);
    CMenuEntry *entry;

    StrCopy(root->name, "OS");
    root->dir = TRUE;
    root->sub = BootstrapGuiTerminalMenuEntry(Fs, "Help", 1);
    entry = root->sub;
    entry->next = BootstrapGuiTerminalMenuEntry(Fs, "Status", 2);
    entry = entry->next;
    entry->next = BootstrapGuiTerminalMenuEntry(Fs, "Files", 3);
    entry = entry->next;
    entry->next = BootstrapGuiTerminalMenuEntry(Fs, "Disk", 4);
    menu->task = Fs;
    menu->attr = BLUE << 4 + YELLOW;
    menu->sub = root;
    Fs->cur_menu = menu;
}

U8 *BootstrapGuiTerminalMenuAction(I64 action)
{
    if (action == 1)
        return ZcGuiShellExec("help");
    if (action == 2)
        return ZcGuiShellExec("zstatus");
    if (action == 3)
        return ZcGuiShellExec("zls");
    if (action == 4)
        return ZcGuiShellExec("zvol");
    return NULL;
}

U0 BootstrapGuiTerminalTask(U8 *data)
{
    I64 ch, sc;
    I64 message;
    I64 command_len = 0;
    U8 command[256];
    U8 *output;

    KeyDevInit;
    DocTermNew;
    BootstrapGuiTerminalMenuInstall;
    KeyDevAdd(&KDDocPutKey, &KDDocPutS, 0x80000000, TRUE);
    DocPrint(DocPut, "ZealOS ARM64 graphical terminal\n");
    DocPrint(DocPut, "Use the ZealOS menu or enter a command and press Return.\n");
    DocPrint(DocPut, "The serial shell remains available.\n");
    DocPrint(DocPut, "> ");

    while (TRUE)
    {
        while ((message = MessageScan(&ch, &sc,
                                     1 << MESSAGE_KEY_DOWN)) == MESSAGE_KEY_DOWN)
        {
            if (ch == '\r' || ch == '\n')
            {
                DocPutKey(DocPut, ch, sc);
                command[command_len] = 0;
                output = ZcGuiShellExec(command);
                if (output)
                    DocPrint(DocPut, "%s", output);
                command_len = 0;
                DocPrint(DocPut, "> ");
            }
            else
            {
                if (ch == 8 || ch == 127)
                {
                    if (command_len)
                        command_len--;
                }
                else if (ch >= 32 && ch < 127 && command_len < sizeof(command) - 1)
                    command[command_len++] = ch;
                DocPutKey(DocPut, ch, sc);
            }
        }
        while ((message = MessageScan(&ch, &sc,
                                     1 << MESSAGE_KEY_UP)) == MESSAGE_KEY_UP)
        {
            if (sc == GUI_MENU_ACTION_TAG)
            {
                output = BootstrapGuiTerminalMenuAction(ch);
                if (output)
                    DocPrint(DocPut, "%s", output);
                command_len = 0;
                DocPrint(DocPut, "> ");
            }
        }
        while (MessageScan(NULL, NULL, ~1))
            ;
        ZcTaskYield;
    }
}

I64 BootstrapGuiTerminalStart()
{
    CTask *term;

    if (TaskValidate(bootstrap_gui_terminal_task))
        return 1;
    term = Spawn(&BootstrapGuiTerminalTask, NULL, "Terminal");

    if (!TaskValidate(term))
        return 1;
    bootstrap_gui_terminal_task = term;
    term->display_flags = 1 << DISPLAYf_SHOW;
    term->border_attr = CYAN;
    term->win_left = 4;
    term->win_right = 70;
    term->win_top = 4;
    term->win_bottom = 34;
    WinDerivedValsUpdate(term);
    return 0x2a;
}

I64 BootstrapGuiTerminalStop()
{
    if (TaskValidate(bootstrap_gui_terminal_task))
        Kill(bootstrap_gui_terminal_task);
    bootstrap_gui_terminal_task = NULL;
    return 0x2a;
}

I64 BootstrapGuiTerminalHide()
{
    if (TaskValidate(bootstrap_gui_terminal_task))
        bootstrap_gui_terminal_task->display_flags &= ~(1 << DISPLAYf_SHOW);
    return 0x2a;
}

I64 BootstrapGuiTerminalShow()
{
    if (TaskValidate(bootstrap_gui_terminal_task))
        bootstrap_gui_terminal_task->display_flags |= 1 << DISPLAYf_SHOW;
    return 0x2a;
}

I64 BootstrapGuiTerminalSmoke()
{
    CMenu *menu;
    CMenuEntry *root;
    CMenuEntry *entry;

    // The normal ARM64 boot already starts this task. In that configuration
    // the smoke confirms boot left a valid terminal instead of trying to
    // spawn a second one or tearing down the user's interactive window.
    if (TaskValidate(bootstrap_gui_terminal_task))
    {
        menu = bootstrap_gui_terminal_task->cur_menu;
        if (!menu) return 11;
        root = menu->sub;
        if (!root) return 12;
        entry = root->sub;
        if (!entry) return 13;
        entry = entry->next;
        if (!entry) return 14;
        if (entry->message_code != MESSAGE_KEY_UP) return 15;
        if (entry->arg1 != 2) return 16;
        if (entry->arg2 != GUI_MENU_ACTION_TAG) return 17;
        return 0x2a;
    }
    if (BootstrapGuiTerminalStart() != 0x2a ||
        !TaskValidate(bootstrap_gui_terminal_task))
        return 1;
    if (BootstrapGuiTerminalStop() != 0x2a ||
        TaskValidate(bootstrap_gui_terminal_task))
        return 2;
    return 0x2a;
}

I64 BootstrapGuiShellSmoke()
{
    U8 *output;

    output = BootstrapGuiTerminalMenuAction(1);
    if (!output || output[0] != 'G')
        return 1;
    output = BootstrapGuiTerminalMenuAction(2);
    if (!output || output[0] != 'z')
        return 2;
    output = BootstrapGuiTerminalMenuAction(3);
    if (!output || output[0] != 'K')
        return 3;
    output = BootstrapGuiTerminalMenuAction(4);
    if (!output || output[0] != 'z')
        return 4;
    if (BootstrapGuiTerminalMenuAction(5))
        return 5;
    return 0x2a;
}
