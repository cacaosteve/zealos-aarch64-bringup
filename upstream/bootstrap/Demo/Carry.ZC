// ARM64 port of the Carry demo.
//
// The original reads the x86 carry flag left by the immediately preceding
// arithmetic instruction. ZealC's AArch64 backend does not expose that
// implicit processor state, so spell out the same 64-bit carry computations
// in portable ZealC. This keeps the two-word counting and shifting examples
// useful on ARM64 without pretending ARM's condition flags are an x86 Carry
// intrinsic.

U0 BigCount()
{
	U64 lo = 0, hi = 0, old_lo;

	"BigCount\n";
	while (hi < 0x10)
	{
		old_lo = lo;
		lo += 1 << 58;
		hi += lo < old_lo;
		"%016X %016X\n", hi, lo;
	}
}

BigCount;

U0 BigShift()
{
	U64 lo = 1, hi = 0, carry;

	"Big Shift\n";
	while (lo || hi)
	{
		carry = lo >> 63;
		hi = (hi << 1) | carry;
		lo <<= 1;
		"%016X %016X\n", hi, lo;
	}
}

BigShift;

U0 Branch()
{
	U64 i = 0xFFCC3311, j;

	'Branch\n';
	for (j = 0; j < 64; j++)
	{
		if (i >> 63)
			Print("%c", '1');
		else
			Print("%c", '0');
		i <<= 1;
	}
	Print("\n");
}

Branch;
