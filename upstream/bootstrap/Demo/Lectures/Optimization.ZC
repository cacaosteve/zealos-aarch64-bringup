/*
ARM64-portable version of the instruction-level optimization demo.

The original x86 assembly compares dependency-heavy, unrolled, and compact
loops. This version keeps the same sum and contrasts equivalent ZealC loop
shapes. It intentionally does not claim to benchmark x86 or hand-written
AArch64 instructions.
*/
#define SAMPLES (8 * 10000000 + 1)

I64 limit = SAMPLES - 1;

I64 Loop1()
{
	I64 i = 1, sum = 0;
	while (i <= limit)
	{
		sum += i;
		i++;
	}
	return sum;
}

I64 Loop2()
{
	I64 i = limit, sum = 0;
	while (i)
	{
		sum += i;
		i--;
	}
	return sum;
}

I64 Loop3()
{
	I64 i = limit, sum = 0;
	while (i)
	{
		sum += i--; sum += i--;
		sum += i--; sum += i--;
		sum += i--; sum += i--;
		sum += i--; sum += i--;
	}
	return sum;
}

I64 Loop4()
{
	I64 i, sum = 0;
	for (i = 1; i <= limit; i++)
		sum += i;
	return sum;
}

U0 Main()
{
	I64 i, expected = limit * (limit + 1) / 2;
	F64 t0;

	"ARM64 ZealC loop-shape comparison\n";
	"Expected sum:%d\n", expected;
	"Dependency loop\n";
	t0 = tS; i = Loop1;
	"Res:%d Time:%9.6f\n", i, tS - t0;
	"Descending loop\n";
	t0 = tS; i = Loop2;
	"Res:%d Time:%9.6f\n", i, tS - t0;
	"Eight-way unrolled loop\n";
	t0 = tS; i = Loop3;
	"Res:%d Time:%9.6f\n", i, tS - t0;
	"For loop\n";
	t0 = tS; i = Loop4;
	"Res:%d Time:%9.6f\n", i, tS - t0;
}

Main;
