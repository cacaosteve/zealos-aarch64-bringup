/* Milestone 27: multi-clus RSAlloc file write.
 *
 * Upstream: RedSeaFileWrite contiguous ClusAlloc(cnt) + BlkWrite span.
 * RSAlloc(sects, 2) claims two bits; write/read blk base and base+1.
 *
 * Bring-up deltas:
 *   - Alloc root=2; alloc file run of 2 → clus 3
 *   - Dir "Big"; payload "Hi"@"OS" across two blks; verify both
 *   - Returns block count (2)
 *   - return RSMultiDemo();
 */

I64 RSFmt(I64 sects, I64 uid)
{
	U8 *br;
	U8 *map;
	I64 *w;

	br = MAlloc(512);
	map = MAlloc(512);
	if (!br || !map)
		return 0;
	MemSet(br, 0, 512);
	br[3] = 0x88;
	w = br + 8;
	w[0] = 0;
	w[1] = sects;
	w[2] = 0;
	w[3] = 1;
	w[4] = uid;
	br[510] = 0x55;
	br[511] = 0xAA;
	if (!BlkWrite(br, 0, 1))
		return 0;
	MemSet(map, 0, 512);
	map[0] = 0x03;
	if (!BlkWrite(map, 1, 1))
		return 0;
	return 1;
}

I64 RSAlloc(I64 sects, I64 cnt)
{
	U8 *map;
	I64 i, j, ok, b, m;

	if (cnt < 1)
		return 0;
	map = MAlloc(512);
	if (!map)
		return 0;
	MemSet(map, 0, 512);
	if (!BlkRead(map, 1, 1))
		return 0;
	for (i = 0; i <= sects - cnt; i = i + 1)
	{
		ok = 1;
		for (j = 0; j < cnt; j = j + 1)
		{
			b = i + j;
			m = 1 << (b & 7);
			if (map[b >> 3] & m)
			{
				ok = 0;
				break;
			}
		}
		if (ok)
		{
			for (j = 0; j < cnt; j = j + 1)
			{
				b = i + j;
				m = 1 << (b & 7);
				map[b >> 3] = map[b >> 3] | m;
			}
			if (!BlkWrite(map, 1, 1))
				return 0;
			return i;
		}
	}
	return 0;
}

U0 RSEnt(I64 dir, I64 slot, I64 name, I64 clus, I64 size)
{
	U8 *e;
	U8 *n;
	I64 *w;

	e = dir + slot * 64;
	n = name;
	MemSet(e, 0, 64);
	if (n[0] == '.')
	{
		e[0] = 0x10;
		e[1] = 0x04;
	}
	else
	{
		e[0] = 0x20;
		e[1] = 0x04;
	}
	MemCpy(e + 2, name, StrLen(name) + 1);
	w = e + 40;
	w[0] = clus;
	w[1] = size;
	w[2] = 0;
}

I64 RSFind(I64 root, I64 want)
{
	U8 *dir;
	U8 *e;
	I64 *w;
	I64 i;

	dir = MAlloc(512);
	if (!dir)
		return 0;
	MemSet(dir, 0, 512);
	if (!BlkRead(dir, root, 1))
		return 0;
	for (i = 0; i < 8; i = i + 1)
	{
		e = dir + i * 64;
		if (e[2] && StrCmp(e + 2, want) == 0)
		{
			w = e + 40;
			return w[0];
		}
	}
	return 0;
}

I64 RSMultiDemo()
{
	U8 *dir;
	U8 *data;
	I64 root, fclus, clus, v, n;

	if (!RSFmt(16, 7))
		return 0;
	root = RSAlloc(16, 1);
	if (root != 2)
		return 0;
	fclus = RSAlloc(16, 2);
	if (fclus != 3)
		return 0;

	dir = MAlloc(512);
	data = MAlloc(512);
	if (!dir || !data)
		return 0;
	MemSet(dir, 0, 512);
	RSEnt(dir, 0, ".", root, 512);
	RSEnt(dir, 1, "..", root, 512);
	RSEnt(dir, 2, "Big", fclus, 4);
	BlkWrite(dir, root, 1);

	MemSet(data, 0, 512);
	MemCpy(data, "Hi", 3);
	BlkWrite(data, fclus, 1);
	MemSet(data, 0, 512);
	MemCpy(data, "OS", 3);
	BlkWrite(data, fclus + 1, 1);

	clus = RSFind(root, "Big");
	if (clus != fclus)
		return 0;
	MemSet(data, 0, 512);
	if (!BlkRead(data, clus, 1))
		return 0;
	if (StrCmp(data, "Hi") != 0)
		return 0;
	v = data[0];
	MemSet(data, 0, 512);
	if (!BlkRead(data, clus + 1, 1))
		return 0;
	if (StrCmp(data, "OS") != 0)
		return 0;
	n = 2;

	Cls(0x00101820);
	PrintAt(2, 1, "RSMulti");
	PrintAt(2, 3, "Hi");
	PrintAt(2, 4, "OS");
	FillRect(120, 400 - (v & 63) * 4, 100, (v & 63) * 4 + 8, 0x0080A0E0);
	v = data[0];
	FillRect(320, 400 - (v & 63) * 4, 100, (v & 63) * 4 + 8, 0x0080A0E0);
	Sleep(1200);
	Free(0);
	return n;
}

return RSMultiDemo();
