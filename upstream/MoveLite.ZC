/* Milestone 68: MemCopy class + !bool member + angles[idx] + goto + MoveLite.
 *
 * Upstream need: Lattice.ZC â€”
 *   MemCopy(&t2, &tt, sizeof(Turtle));
 *   t->Î¸ = Wrap(t->Î¸ + dt * angles[t->dÎ¸_idx]);
 *   tt.ends = !tt.ends;
 *   goto lt_done;
 *
 *   - M187: Turtle.é / dé_idx (stock Lattice names)
 * Bring-up:
 *   - MemCopy/sizeof(class) struct blob
 *   - Bool member not-assign
 *   - global F64 angles[i] / angles[t->dé_idx]
 *   - goto label inside fn
 *   - return MoveLite();  expect 15
 */

#define ANGLES 4

F64 angles[ANGLES] = {1.0, 2.0, 3.0, 4.0};

class Turtle
{
	F64 w;
	I64 dé_idx;
	Bool ends;
};

I64 MoveLite()
{
	Turtle t;
	Turtle t2;
	Turtle *p;
	I64 h;

	h = 0;
	t.w = 5.0;
	t.dé_idx = 2;
	t.ends = 1;
	p = &t;

	MemCopy(&t2, &t, sizeof(Turtle));
	if (ToI64(t2.w) == 5 && t2.dé_idx == 2 && t2.ends)
		h = h + 1;

	t.ends = !t.ends;
	if (!t.ends)
		h = h + 2;

	if (ToI64(angles[t.dé_idx]) == 3)
		h = h + 4;

	t.dé_idx = 1;
	if (ToI64(angles[p->dé_idx] * 2.0) == 4)
		h = h + 8;

	goto done;
	h = 0;
done:
	return h;
}

return MoveLite();
