/* Milestone 68: MemCopy class + !bool member + angles[idx] + goto + MoveLite.
 *
 * Upstream need: Lattice.ZC —
 *   MemCopy(&t2, &tt, sizeof(Turtle));
 *   t->θ = Wrap(t->θ + dt * angles[t->dθ_idx]);
 *   tt.ends = !tt.ends;
 *   goto lt_done;
 *
 * Bring-up:
 *   - MemCopy/sizeof(class) struct blob
 *   - Bool member not-assign
 *   - global F64 angles[i] / angles[t->idx]
 *   - goto label inside fn
 *   - return MoveLite();  expect 15
 */

#define ANGLES 4

F64 angles[ANGLES] = {1.0, 2.0, 3.0, 4.0};

class Turtle
{
	F64 w;
	I64 idx;
	Bool ends;
};

I64 MoveLite()
{
	Turtle t;
	Turtle t2;
	Turtle *p;
	I64 h;

	h = 0;
	t.w = 5.0;
	t.idx = 2;
	t.ends = 1;
	p = &t;

	MemCopy(&t2, &t, sizeof(Turtle));
	if (ToI64(t2.w) == 5 && t2.idx == 2 && t2.ends)
		h = h + 1;

	t.ends = !t.ends;
	if (!t.ends)
		h = h + 2;

	if (ToI64(angles[t.idx]) == 3)
		h = h + 4;

	t.idx = 1;
	if (ToI64(angles[p->idx] * 2.0) == 4)
		h = h + 8;

	goto done;
	h = 0;
done:
	return h;
}

return MoveLite();
