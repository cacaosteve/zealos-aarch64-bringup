/* Shared RedSea + CFile helpers (concat before demos).
 * Milestone 31+: one copy of RSFmt/RSAlloc/FCreate/FOpen/FBlk/FSeek/FSize.
 * No CDrive yet; 16-blk RAM disk; RSFmt wipes data blks for re-run safety.
 */

class CFile
{
	I64 blk;
	I64 len;
	I64 pos;
	I64 valid;
};

I64 RSFmt(I64 sects, I64 uid)
{
	U8 *br;
	U8 *map;
	I64 *w;
	I64 i;

	br = MAlloc(512);
	map = MAlloc(512);
	if (!br || !map)
		return 0;
	MemSet(br, 0, 512);
	br[3] = 0x88;
	w = br + 8;
	w[0] = 0;
	w[1] = sects;
	w[2] = 0;
	w[3] = 1;
	w[4] = uid;
	br[510] = 0x55;
	br[511] = 0xAA;
	if (!BlkWrite(br, 0, 1))
		return 0;
	MemSet(map, 0, 512);
	map[0] = 0x03;
	if (!BlkWrite(map, 1, 1))
		return 0;
	MemSet(map, 0, 512);
	for (i = 2; i < sects; i = i + 1)
	{
		if (!BlkWrite(map, i, 1))
			return 0;
	}
	return 1;
}

I64 RSAlloc(I64 sects, I64 cnt)
{
	U8 *map;
	I64 i, j, ok, b, m;

	if (cnt < 1)
		return 0;
	map = MAlloc(512);
	if (!map)
		return 0;
	MemSet(map, 0, 512);
	if (!BlkRead(map, 1, 1))
		return 0;
	for (i = 0; i <= sects - cnt; i = i + 1)
	{
		ok = 1;
		for (j = 0; j < cnt; j = j + 1)
		{
			b = i + j;
			m = 1 << (b & 7);
			if (map[b >> 3] & m)
			{
				ok = 0;
				break;
			}
		}
		if (ok)
		{
			for (j = 0; j < cnt; j = j + 1)
			{
				b = i + j;
				m = 1 << (b & 7);
				map[b >> 3] = map[b >> 3] | m;
			}
			if (!BlkWrite(map, 1, 1))
				return 0;
			return i;
		}
	}
	return 0;
}

I64 FCreate(I64 root, I64 name, I64 blk)
{
	U8 *dir;
	U8 *e;
	I64 *w;
	CFile *f;
	I64 i, slot;

	dir = MAlloc(512);
	if (!dir)
		return 0;
	MemSet(dir, 0, 512);
	BlkRead(dir, root, 1);
	for (i = 0; i < 8; i = i + 1)
	{
		e = dir + i * 64;
		if (e[2] && StrCmp(e + 2, name) == 0)
			return 0;
	}
	slot = -1;
	for (i = 0; i < 8; i = i + 1)
	{
		e = dir + i * 64;
		if (!e[2])
		{
			slot = i;
			break;
		}
	}
	if (slot < 0)
		return 0;
	e = dir + slot * 64;
	MemSet(e, 0, 64);
	e[0] = 0x20;
	e[1] = 0x04;
	MemCpy(e + 2, name, StrLen(name) + 1);
	w = e + 40;
	w[0] = blk;
	w[1] = 0;
	w[2] = 0;
	if (!BlkWrite(dir, root, 1))
		return 0;
	f = MAlloc(sizeof(CFile));
	if (!f)
		return 0;
	f->blk = blk;
	f->len = 0;
	f->pos = 0;
	f->valid = 1;
	return f;
}

I64 FOpen(I64 root, I64 name)
{
	U8 *dir;
	U8 *e;
	I64 *w;
	CFile *f;
	I64 i;

	dir = MAlloc(512);
	if (!dir)
		return 0;
	MemSet(dir, 0, 512);
	if (!BlkRead(dir, root, 1))
		return 0;
	for (i = 0; i < 8; i = i + 1)
	{
		e = dir + i * 64;
		if (e[2] && StrCmp(e + 2, name) == 0)
		{
			w = e + 40;
			f = MAlloc(sizeof(CFile));
			if (!f)
				return 0;
			f->blk = w[0];
			f->len = w[1];
			f->pos = 0;
			f->valid = 1;
			return f;
		}
	}
	return 0;
}

I64 FClose(I64 faddr)
{
	CFile *f = faddr;
	if (!f || !f->valid)
		return 0;
	f->valid = 0;
	return 1;
}

I64 FBlkWrite(I64 faddr, I64 buf, I64 nbytes)
{
	CFile *f = faddr;
	I64 nl;

	if (!f || !f->valid)
		return 0;
	if (!BlkWrite(buf, f->blk + f->pos, 1))
		return 0;
	nl = f->len + nbytes;
	f->len = nl;
	f->pos = f->pos + 1;
	return 1;
}

I64 FBlkRead(I64 faddr, I64 buf)
{
	CFile *f = faddr;
	if (!f || !f->valid)
		return 0;
	if (!BlkRead(buf, f->blk + f->pos, 1))
		return 0;
	f->pos = f->pos + 1;
	return 1;
}

I64 FSeek(I64 faddr, I64 pos)
{
	CFile *f = faddr;
	if (!f || !f->valid)
		return 0;
	if (pos < 0)
		return 0;
	f->pos = pos;
	return 1;
}

I64 FSize(I64 faddr)
{
	CFile *f = faddr;
	if (!f || !f->valid)
		return 0;
	return f->len;
}

/* Milestone 32: probe boot without wipe — persist across shell/smoke reruns. */
I64 RSValid()
{
	U8 *br;

	br = MAlloc(512);
	if (!br)
		return 0;
	MemSet(br, 0, 512);
	if (!BlkRead(br, 0, 1))
		return 0;
	if (br[3] != 0x88)
		return 0;
	if (br[510] != 0x55 || br[511] != 0xAA)
		return 0;
	return 1;
}

I64 RSRoot()
{
	U8 *br;
	I64 *w;

	br = MAlloc(512);
	if (!br)
		return 0;
	MemSet(br, 0, 512);
	if (!BlkRead(br, 0, 1))
		return 0;
	if (br[3] != 0x88)
		return 0;
	w = br + 8;
	return w[2];
}
