/* Milestone 111/137: try/catch + '\n' restart compose + WrapLatticeLite.
 *
 * Upstream need: Lattice.ZC —
 *   try { … } catch PutExcept;
 *   case '\n': DCFill(dc); TurtleInit(&tt); SetMenu;
 *   full SetMenu sibling-clear; init outside try
 *
 * Bring-up:
 *   - M137: full SetMenu + MenuPush + Lattice setup order
 *   - return WrapLatticeLite();  expect 15
 */

class Turtle
{
	F64 x;
	F64 y;
	F64 z;
	F64 w;
	F64 speed;
	CColorROPU16 edge;
	CColorROPU16 middle;
	Bool ends;
	Bool first;
} tt;

U0 TurtleInit(Turtle *t)
{
	MemSet(t, 0, sizeof(Turtle));
	t->x = Fs->pix_width >> 1;
	t->y = Fs->pix_height >> 1;
	t->z = 5;
	t->edge = BLACK;
	t->middle = YELLOW;
	t->first = TRUE;
	t->ends = TRUE;
}

U0 SetMenu()
{
	I64 i;
	U8 buf[STR_LEN];
	CMenuEntry *tmpse;

	for (i = 0; i <= 9; i++)
	{
		StrPrint(buf, "Settings/Layer%d", i);
		if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
		{
			if (i == ToI64(tt.z))
				tmpse->checked = TRUE;
			else
				tmpse->checked = FALSE;
		}
	}
	if (tmpse = MenuEntryFind(Fs->cur_menu, "Settings/Ends"))
	{
		if (tt.ends)
			tmpse->checked = TRUE;
		else
			tmpse->checked = FALSE;
	}
}

I64 WrapLatticeLite()
{
	CDC *dc;
	I64 h;
	I64 arg1;
	I64 arg2;

	h = 0;
	dc = DCAlias;
	MenuPush(
		"File {"
		"  Abort(,CH_SHIFT_ESC);"
		"  Exit(,CH_ESC);"
		"}"
		"Play {"
		"  Restart(,'\n');"
		"  Step(,CH_SPACE);"
		"  Accelerator(,,SC_CURSOR_UP);"
		"  Break(,,SC_CURSOR_DOWN);"
		"  Left(,,SC_CURSOR_LEFT);"
		"  Right(,,SC_CURSOR_RIGHT);"
		"}"
		"Settings {"
		"  Color(,'c');"
		"  Wider(,'+');"
		"  Narrower(,'-');"
		"  Ends(,'e');"
		"  Layer0(,'0');"
		"  Layer1(,'1');"
		"  Layer2(,'2');"
		"  Layer3(,'3');"
		"  Layer4(,'4');"
		"  Layer5(,'5');"
		"  Layer6(,'6');"
		"  Layer7(,'7');"
		"  Layer8(,'8');"
		"  Layer9(,'9');"
		"}"
		);
	SettingsPush;
	AutoComplete;
	WinBorder;
	WinMax;
	DocCursor;
	DocClear;
	TurtleInit(&tt);
	SetMenu;
	Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_FOCUS_TASK_MENU -
		WIF_SELF_FOCUS - WIF_SELF_GRAB_SCROLL;
	try
	{
		/* Mutate, then '\n' restarts, then ESC. */
		MsgQuePush(MESSAGE_KEY_DOWN, '3', 0);
		MsgQuePush(MESSAGE_KEY_DOWN, 'e', 0);
		MsgQuePush(MESSAGE_KEY_DOWN, '+', 0);
		MsgQuePush(MESSAGE_KEY_DOWN, '\n', 0);
		MsgQuePush(MESSAGE_KEY_DOWN, CH_ESC, 0);

		while (TRUE)
		{
			switch (MessageGet(&arg1, &arg2, 1 << MESSAGE_KEY_DOWN))
			{
				case MESSAGE_KEY_DOWN:
					switch (arg1)
					{
						case '0'...'9':
							tt.z = arg1 - '0';
							SetMenu;
							break;
						case 'e':
							tt.ends = !tt.ends;
							SetMenu;
							break;
						case '+':
							tt.w = tt.w + 1.0;
							break;
						case '\r':
						case '\n':
							DCFill(dc);
							TurtleInit(&tt);
							SetMenu;
							GrPrint(dc, 0, 16, "Esc=exit Enter=restart Space=step c=color");
							break;
						case CH_ESC:
						case CH_SHIFT_ESC:
							goto lt_done;
					}
					break;
				case MESSAGE_NULL:
					/* Lattice idle: Sleep until ESC (scripted CH_ESC ends smoke). */
					Sleep(1);
					break;
			}
		}
lt_done:
		MessageGet(,, 1 << MESSAGE_KEY_UP);
	}
	catch
		PutExcept;

	/* After '\n': back to init (z=5, ends TRUE, w=0). */
	if (ToI64(tt.z) == 5)
		h = h + 1;
	if (tt.ends)
		h = h + 2;
	if (ToI64(tt.w) == 0)
		h = h + 4;
	if (tt.first && tt.middle == YELLOW)
		h = h + 8;

	SettingsPop;
	MenuPop;
	return h;
}

return WrapLatticeLite();
