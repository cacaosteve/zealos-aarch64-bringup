/* Milestone 25: RedSea allocation bitmap stub.
 *
 * Upstream: FileSysRedSea.ZC bitmap @ fat1 + ClusAlloc / LBts bits.
 * Blk0 boot (bitmap_sects=1), blk1 bitmap; bits 0..sects-1.
 * Pre-mark boot+bitmap; RSAlloc finds a free run and sets bits.
 *
 * Bring-up deltas:
 *   - RSFmt writes boot + zeroed bitmap (bits 0,1 set)
 *   - RSAlloc(sects,cnt) → first free clus; alloc root then file
 *   - Returns file clus (3)
 *   - return RSAllocDemo();
 */

I64 RSFmt(I64 sects, I64 uid)
{
	U8 *br;
	U8 *map;
	I64 *w;

	br = MAlloc(512);
	map = MAlloc(512);
	if (!br || !map)
		return 0;
	MemSet(br, 0, 512);
	br[3] = 0x88;
	w = br + 8;
	w[0] = 0;
	w[1] = sects;
	w[2] = 0;
	w[3] = 1;
	w[4] = uid;
	br[510] = 0x55;
	br[511] = 0xAA;
	if (!BlkWrite(br, 0, 1))
		return 0;
	MemSet(map, 0, 512);
	/* Reserve boot (0) + bitmap (1). */
	map[0] = 0x03;
	if (!BlkWrite(map, 1, 1))
		return 0;
	return 1;
}

I64 RSAlloc(I64 sects, I64 cnt)
{
	U8 *map;
	I64 i, j, ok, b, m;

	if (cnt < 1)
		return 0;
	map = MAlloc(512);
	if (!map)
		return 0;
	MemSet(map, 0, 512);
	if (!BlkRead(map, 1, 1))
		return 0;
	for (i = 0; i <= sects - cnt; i = i + 1)
	{
		ok = 1;
		for (j = 0; j < cnt; j = j + 1)
		{
			b = i + j;
			m = 1 << (b & 7);
			if (map[b >> 3] & m)
			{
				ok = 0;
				break;
			}
		}
		if (ok)
		{
			for (j = 0; j < cnt; j = j + 1)
			{
				b = i + j;
				m = 1 << (b & 7);
				map[b >> 3] = map[b >> 3] | m;
			}
			if (!BlkWrite(map, 1, 1))
				return 0;
			return i;
		}
	}
	return 0;
}

U0 RSEnt(I64 dir, I64 slot, I64 name, I64 clus, I64 size)
{
	U8 *e;
	U8 *n;
	I64 *w;

	e = dir + slot * 64;
	n = name;
	MemSet(e, 0, 64);
	if (n[0] == '.')
	{
		e[0] = 0x10;
		e[1] = 0x04;
	}
	else
	{
		e[0] = 0x20;
		e[1] = 0x04;
	}
	MemCpy(e + 2, name, StrLen(name) + 1);
	w = e + 40;
	w[0] = clus;
	w[1] = size;
	w[2] = 0;
}

I64 RSAllocDemo()
{
	U8 *dir;
	U8 *data;
	U8 *br;
	I64 *w;
	I64 root, fclus, v;

	if (!RSFmt(16, 7))
		return 0;
	root = RSAlloc(16, 1);
	if (root != 2)
		return 0;
	fclus = RSAlloc(16, 1);
	if (fclus != 3)
		return 0;

	/* Persist root_clus into boot. */
	br = MAlloc(512);
	if (!br)
		return 0;
	BlkRead(br, 0, 1);
	w = br + 8;
	w[2] = root;
	BlkWrite(br, 0, 1);

	dir = MAlloc(512);
	data = MAlloc(512);
	if (!dir || !data)
		return 0;
	MemSet(dir, 0, 512);
	RSEnt(dir, 0, ".", root, 512);
	RSEnt(dir, 1, "..", root, 512);
	RSEnt(dir, 2, "OS", fclus, 2);
	BlkWrite(dir, root, 1);
	MemSet(data, 0, 512);
	MemCpy(data, "OS", 3);
	BlkWrite(data, fclus, 1);

	Cls(0x00101820);
	PrintAt(2, 1, "RSAlloc");
	PrintAt(2, 3, data);
	v = root;
	FillRect(100, 400 - (v & 63) * 4, 100, (v & 63) * 4 + 8, 0x0060E080);
	v = fclus;
	FillRect(280, 400 - (v & 63) * 4, 100, (v & 63) * 4 + 8, 0x0060E080);
	v = 0x03;
	FillRect(460, 400 - (v & 63) * 4, 100, (v & 63) * 4 + 8, 0x0060E080);
	Sleep(1200);
	Free(0);
	return fclus;
}

return RSAllocDemo();
