/* Milestone 92: layer digit keys + SetMenu + LayerLite.
 *
 * Upstream need: Lattice.ZC —
 *   case '0'...'9': tt.z = arg1-'0'; SetMenu;
 *
 * Bring-up:
 *   - Scripted KEY digits update tt.z + menu Layer%d checked
 *   - return LayerLite();  expect 15
 */

class Turtle
{
	F64 z;
	Bool ends;
} tt;

U0 SetMenu()
{
	I64 i;
	U8 buf[STR_LEN];
	CMenuEntry *tmpse;

	for (i = 0; i <= 9; i++)
	{
		StrPrint(buf, "Settings/Layer%d", i);
		if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
		{
			if (i == ToI64(tt.z))
				tmpse->checked = TRUE;
			else
				tmpse->checked = FALSE;
		}
	}
	if (tmpse = MenuEntryFind(Fs->cur_menu, "Settings/Ends"))
	{
		if (tt.ends)
			tmpse->checked = TRUE;
		else
			tmpse->checked = FALSE;
	}
}

I64 LayerLite()
{
	I64 a1;
	I64 a2;
	I64 m;
	I64 h;
	I64 mask;
	CMenuEntry *tmpse;
	U8 buf[STR_LEN];

	h = 0;
	tt.z = 0.0;
	tt.ends = FALSE;
	mask = 1 << MESSAGE_KEY_DOWN;

	MsgQuePush(MESSAGE_KEY_DOWN, '7', 0);
	MsgQuePush(MESSAGE_KEY_DOWN, '2', 0);
	MsgQuePush(MESSAGE_KEY_DOWN, CH_ESC, 0);

	while (TRUE)
	{
		switch (MessageGet(&a1, &a2, mask))
		{
			case MESSAGE_KEY_DOWN:
				switch (a1)
				{
					case '0'...'9':
						tt.z = a1 - '0';
						SetMenu;
						break;
					case CH_ESC:
						goto lt_done;
					case CH_SHIFT_ESC:
						goto lt_done;
				}
				break;
			case MESSAGE_NULL:
				goto lt_done;
		}
	}
lt_done:
	/* Last digit wins: '2'. */
	if (ToI64(tt.z) == 2)
		h = h + 1;
	StrPrint(buf, "Settings/Layer%d", 2);
	if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
	{
		if (tmpse->checked)
			h = h + 2;
	}
	/* Re-select layer 7 and confirm. */
	MsgQuePush(MESSAGE_KEY_DOWN, '7', 0);
	m = MessageGet(&a1, &a2, mask);
	if (m == MESSAGE_KEY_DOWN && a1 == '7')
	{
		tt.z = a1 - '0';
		SetMenu;
	}
	if (ToI64(tt.z) == 7)
		h = h + 4;
	StrPrint(buf, "Settings/Layer%d", 7);
	if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
	{
		if (tmpse->checked)
			h = h + 8;
	}
	return h;
}

return LayerLite();
