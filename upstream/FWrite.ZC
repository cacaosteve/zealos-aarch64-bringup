/* Milestone 20: FBlkWrite + create path (ZealOS FOpen "w"-shaped).
 *
 * Upstream: DiskCFile.ZC FOpen flags "w"/"w+" + FBlkWrite —
 * single contiguous blk; DirAlloc for new names.
 *
 * Bring-up deltas:
 *   - FCreate(dir,name,blk) allocates dir slot + CFile
 *   - FBlkWrite(f,buf) / FBlkRead; create "New", write, reopen read
 *   - Returns written len (3)
 *   - return FWriteDemo();
 */

class CFile
{
	I64 blk;
	I64 len;
	I64 pos;
	I64 valid;
};

U0 DirPut(I64 dir, I64 slot, I64 name, I64 blk, I64 len)
{
	U8 *e;
	I64 *w;

	e = dir + slot * 32;
	MemSet(e, 0, 32);
	MemCpy(e, name, StrLen(name) + 1);
	w = e;
	w[2] = blk;
	w[3] = len;
}

I64 DirFind(I64 dir, I64 want)
{
	I64 i;
	U8 *e;

	for (i = 0; i < 8; i = i + 1)
	{
		e = dir + i * 32;
		if (e[0] && StrCmp(e, want) == 0)
			return i;
	}
	return -1;
}

I64 FCreate(I64 dir, I64 name, I64 blk)
{
	I64 slot, i;
	U8 *e;
	CFile *f;

	if (DirFind(dir, name) >= 0)
		return 0;
	slot = -1;
	for (i = 0; i < 8; i = i + 1)
	{
		e = dir + i * 32;
		if (!e[0])
		{
			slot = i;
			break;
		}
	}
	if (slot < 0)
		return 0;
	DirPut(dir, slot, name, blk, 0);
	f = MAlloc(sizeof(CFile));
	if (!f)
		return 0;
	f->blk = blk;
	f->len = 0;
	f->pos = 0;
	f->valid = 1;
	return f;
}

I64 FOpen(I64 dir, I64 name)
{
	I64 slot;
	U8 *e;
	I64 *w;
	CFile *f;

	slot = DirFind(dir, name);
	if (slot < 0)
		return 0;
	e = dir + slot * 32;
	w = e;
	f = MAlloc(sizeof(CFile));
	if (!f)
		return 0;
	f->blk = w[2];
	f->len = w[3];
	f->pos = 0;
	f->valid = 1;
	return f;
}

I64 FClose(I64 faddr)
{
	CFile *f = faddr;
	if (!f || !f->valid)
		return 0;
	f->valid = 0;
	return 1;
}

I64 FBlkWrite(I64 faddr, I64 buf, I64 len)
{
	CFile *f = faddr;
	if (!f || !f->valid)
		return 0;
	if (!BlkWrite(buf, f->blk + f->pos, 1))
		return 0;
	f->len = len;
	f->pos = f->pos + 1;
	return 1;
}

I64 FBlkRead(I64 faddr, I64 buf)
{
	CFile *f = faddr;
	if (!f || !f->valid)
		return 0;
	if (!BlkRead(buf, f->blk + f->pos, 1))
		return 0;
	f->pos = f->pos + 1;
	return 1;
}

I64 FWriteDemo()
{
	U8 *dir;
	U8 *data;
	CFile *f;
	I64 slot, i, v, len;
	U8 *e;
	I64 *w;

	dir = MAlloc(512);
	data = MAlloc(512);
	if (!dir || !data)
		return 0;
	MemSet(dir, 0, 512);

	f = FCreate(dir, "New", 1);
	if (!f)
		return 0;
	MemSet(data, 0, 512);
	MemCpy(data, "New", 4);
	if (!FBlkWrite(f, data, 3))
		return 0;
	/* Persist updated len into dir slot 0. */
	slot = DirFind(dir, "New");
	e = dir + slot * 32;
	w = e;
	w[3] = f->len;
	BlkWrite(dir, 0, 1);
	FClose(f);

	MemSet(dir, 0, 512);
	BlkRead(dir, 0, 1);
	f = FOpen(dir, "New");
	if (!f)
		return 0;
	MemSet(data, 0, 512);
	if (!FBlkRead(f, data))
		return 0;
	len = f->len;
	FClose(f);
	if (StrCmp(data, "New") != 0)
		return 0;

	Cls(0x00101820);
	PrintAt(2, 1, "FWrite");
	PrintAt(2, 3, data);
	for (i = 0; i < len; i = i + 1)
	{
		v = data[i];
		FillRect(80 + i * 120, 400 - (v & 63) * 4, 90, (v & 63) * 4 + 8, 0x00E08020);
	}
	Sleep(1200);
	Free(0);
	return len;
}

return FWriteDemo();
