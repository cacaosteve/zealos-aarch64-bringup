/* Milestone 87: MessageGet loop + Refresh + FrameLite.
 *
 * Upstream need: Lattice.ZC —
 *   while MessageGet → handle → Refresh (WinMgr-shaped paint).
 *
 * Bring-up:
 *   - Fs->draw_it paints turtle tip; Refresh after each event
 *   - Scripted place / aim / Step / ESC (same as PlayLite)
 *   - return FrameLite();  expect 15
 */

#define ANGLES 3

F64 angles[ANGLES] = {0.0, 0.0, 0.0};

class Turtle
{
	F64 x;
	F64 y;
	F64 z;
	F64 speed;
	F64 th;
	F64 w;
	I64 idx;
	CColorROPU16 edge;
	CColorROPU16 middle;
	Bool ends;
	Bool first;
} tt;

U0 TurtlePlot(CDC *dc, Turtle *t, CColorROPU16 edge, CColorROPU16 middle)
{
	F64 w;

	w = t->w / 2.0 - 1;
	if (w < 0)
		w = 0;
	dc->color = middle;
	GrLine3(dc,
		t->x + w * Cos(t->th + pi / 2), t->y + w * Sin(t->th + pi / 2), t->z,
		t->x + w * Cos(t->th - pi / 2), t->y + w * Sin(t->th - pi / 2), t->z);
	w = t->w / 2.0;
	dc->color = edge;
	GrPlot3(dc, t->x + w * Cos(t->th + pi / 2), t->y + w * Sin(t->th + pi / 2), t->z);
	GrPlot3(dc, t->x + w * Cos(t->th - pi / 2), t->y + w * Sin(t->th - pi / 2), t->z);
}

U0 TurtleMicroMove(Turtle *t, F64 dt)
{
	F64 c;
	F64 s;

	c = Cos(t->th);
	s = Sin(t->th);
	t->x = t->x + c * t->speed * dt;
	t->y = t->y + s * t->speed * dt;
	t->th = Wrap(t->th + dt * angles[t->idx]);
}

U0 TurtleMove(CDC *dc, Turtle *t, CColorROPU16 edge, CColorROPU16 middle)
{
	I64 i;
	I64 l;

	l = 4;
	t->first = FALSE;
	for (i = 0; i < l; i++)
	{
		TurtleMicroMove(t, 1.0 / l);
		TurtlePlot(dc, t, edge, middle);
	}
}

U0 TurtleInit(Turtle *t)
{
	MemSet(t, 0, sizeof(Turtle));
	t->x = Fs->pix_width >> 1;
	t->y = Fs->pix_height >> 1;
	t->z = 5;
	t->speed = 40.0;
	t->th = 0.0;
	t->w = 12.0;
	t->edge = RED;
	t->middle = YELLOW;
	t->idx = 1;
	t->first = TRUE;
	t->ends = FALSE;
}

U0 SetMenu()
{
	I64 i;
	U8 buf[STR_LEN];
	CMenuEntry *tmpse;

	for (i = 0; i <= 9; i++)
	{
		StrPrint(buf, "Settings/Layer%d", i);
		if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
		{
			if (i == ToI64(tt.z))
				tmpse->checked = TRUE;
			else
				tmpse->checked = FALSE;
		}
	}
	if (tmpse = MenuEntryFind(Fs->cur_menu, "Settings/Ends"))
	{
		if (tt.ends)
			tmpse->checked = TRUE;
		else
			tmpse->checked = FALSE;
	}
}

U0 DrawIt(CTask *, CDC *dc)
{
	dc->color = LTRED;
	GrPlot(dc, tt.x, tt.y);
}

I64 FrameLite()
{
	CDC *dc;
	I64 h;
	I64 arg1;
	I64 arg2;
	I64 mask;
	I64 frames;
	Bool aim;

	h = 0;
	aim = FALSE;
	frames = 0;
	dc = DCAlias;
	DCDepthBufAlloc(dc);
	MenuPush(
		"File {"
		"  Abort(,CH_SHIFT_ESC);"
		"  Exit(,CH_ESC);"
		"}"
		"Play {"
		"  Restart(,'\n');"
		"  Step(,CH_SPACE);"
		"  Accelerator(,,SC_CURSOR_UP);"
		"  Break(,,SC_CURSOR_DOWN);"
		"  Left(,,SC_CURSOR_LEFT);"
		"  Right(,,SC_CURSOR_RIGHT);"
		"}"
		"Settings {"
		"  Color(,'c');"
		"  Wider(,'+');"
		"  Narrower(,'-');"
		"  Ends(,'e');"
		"  Layer0(,'0');"
		"  Layer1(,'1');"
		"  Layer2(,'2');"
		"  Layer3(,'3');"
		"  Layer4(,'4');"
		"  Layer5(,'5');"
		"  Layer6(,'6');"
		"  Layer7(,'7');"
		"  Layer8(,'8');"
		"  Layer9(,'9');"
		"}"
		);
	SettingsPush;
	AutoComplete;
	WinBorder;
	WinMax;
	DocCursor;
	DocClear;
	TurtleInit(&tt);
	SetMenu;
	Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_FOCUS_TASK_MENU -
		WIF_SELF_FOCUS - WIF_SELF_GRAB_SCROLL;
	Fs->draw_it = &DrawIt;

	Cls(0);
	mask = 1 << MESSAGE_KEY_DOWN | 1 << MESSAGE_MS_L_DOWN |
		1 << MESSAGE_MS_R_DOWN | 1 << MESSAGE_MS_R_UP;

	MsgQuePush(MESSAGE_MS_L_DOWN, 200, 300);
	MsgQuePush(MESSAGE_MS_R_DOWN, 300, 300);
	MsgQuePush(MESSAGE_MS_R_UP, 300, 300);
	MsgQuePush(MESSAGE_KEY_DOWN, CH_SPACE, 0);
	MsgQuePush(MESSAGE_KEY_DOWN, CH_ESC, 0);

	while (TRUE)
	{
		switch (MessageGet(&arg1, &arg2, mask))
		{
			case MESSAGE_MS_L_DOWN:
				tt.first = TRUE;
				tt.x = arg1;
				tt.y = arg2;
				break;
			case MESSAGE_MS_R_DOWN:
				aim = TRUE;
				tt.th = Arg(arg1 - tt.x, arg2 - tt.y);
				break;
			case MESSAGE_MS_R_UP:
				tt.th = Arg(arg1 - tt.x, arg2 - tt.y);
				aim = FALSE;
				break;
			case MESSAGE_KEY_DOWN:
				switch (arg1)
				{
					case CH_SPACE:
						TurtleMove(dc, &tt, tt.edge, tt.middle);
						break;
					case CH_ESC:
						goto lt_done;
					case CH_SHIFT_ESC:
						goto lt_done;
				}
				break;
			case MESSAGE_NULL:
				/* Lattice idle: Sleep+Refresh until ESC (scripted CH_ESC ends smoke). */
				Sleep(1);
				break;
		}
		if (Refresh())
			frames = frames + 1;
	}
lt_done:
	/* place+aim+aim+step → ≥4 Refresh calls before ESC. */
	if (frames >= 4)
		h = h + 1;
	if (GrPeek(200, 300) == 0x00FF5555)
		h = h + 2;
	if (!tt.first && ToI64(tt.x) > 220)
		h = h + 4;
	if (GrPeek(ToI64(tt.x), ToI64(tt.y) + 6) == 0x00AA0000)
		h = h + 8;

	MessageGet(,, 1 << MESSAGE_KEY_UP);
	SettingsPop;
	DCFill(dc);
	DCDel(dc);
	MenuPop;
	return h;
}

return FrameLite();
