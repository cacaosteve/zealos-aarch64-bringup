/* Milestone 28: CFile over RedSea clus.
 *
 * Upstream: DiskCFile.ZC FOpen/FBlkRead on RedSea contiguous files.
 * Dir is CDirEntry (64B) at root_clus; CFile {blk,len,pos,valid}.
 *
 * Bring-up deltas:
 *   - RSFmt + RSAlloc root/file; RSEnt "Zeal"; payload @ clus
 *   - FOpen(root,name) / FBlkRead / FClose; return len (4)
 *   - return RSCFileDemo();
 */

class CFile
{
	I64 blk;
	I64 len;
	I64 pos;
	I64 valid;
};

I64 RSFmt(I64 sects, I64 uid)
{
	U8 *br;
	U8 *map;
	I64 *w;

	br = MAlloc(512);
	map = MAlloc(512);
	if (!br || !map)
		return 0;
	MemSet(br, 0, 512);
	br[3] = 0x88;
	w = br + 8;
	w[0] = 0;
	w[1] = sects;
	w[2] = 0;
	w[3] = 1;
	w[4] = uid;
	br[510] = 0x55;
	br[511] = 0xAA;
	if (!BlkWrite(br, 0, 1))
		return 0;
	MemSet(map, 0, 512);
	map[0] = 0x03;
	if (!BlkWrite(map, 1, 1))
		return 0;
	return 1;
}

I64 RSAlloc(I64 sects, I64 cnt)
{
	U8 *map;
	I64 i, j, ok, b, m;

	if (cnt < 1)
		return 0;
	map = MAlloc(512);
	if (!map)
		return 0;
	MemSet(map, 0, 512);
	if (!BlkRead(map, 1, 1))
		return 0;
	for (i = 0; i <= sects - cnt; i = i + 1)
	{
		ok = 1;
		for (j = 0; j < cnt; j = j + 1)
		{
			b = i + j;
			m = 1 << (b & 7);
			if (map[b >> 3] & m)
			{
				ok = 0;
				break;
			}
		}
		if (ok)
		{
			for (j = 0; j < cnt; j = j + 1)
			{
				b = i + j;
				m = 1 << (b & 7);
				map[b >> 3] = map[b >> 3] | m;
			}
			if (!BlkWrite(map, 1, 1))
				return 0;
			return i;
		}
	}
	return 0;
}

U0 RSEnt(I64 dir, I64 slot, I64 name, I64 clus, I64 size)
{
	U8 *e;
	U8 *n;
	I64 *w;

	e = dir + slot * 64;
	n = name;
	MemSet(e, 0, 64);
	if (n[0] == '.')
	{
		e[0] = 0x10;
		e[1] = 0x04;
	}
	else
	{
		e[0] = 0x20;
		e[1] = 0x04;
	}
	MemCpy(e + 2, name, StrLen(name) + 1);
	w = e + 40;
	w[0] = clus;
	w[1] = size;
	w[2] = 0;
}

I64 FOpen(I64 root, I64 name)
{
	U8 *dir;
	U8 *e;
	I64 *w;
	CFile *f;
	I64 i;

	dir = MAlloc(512);
	if (!dir)
		return 0;
	MemSet(dir, 0, 512);
	if (!BlkRead(dir, root, 1))
		return 0;
	for (i = 0; i < 8; i = i + 1)
	{
		e = dir + i * 64;
		if (e[2] && StrCmp(e + 2, name) == 0)
		{
			w = e + 40;
			f = MAlloc(sizeof(CFile));
			if (!f)
				return 0;
			f->blk = w[0];
			f->len = w[1];
			f->pos = 0;
			f->valid = 1;
			return f;
		}
	}
	return 0;
}

I64 FClose(I64 faddr)
{
	CFile *f = faddr;
	if (!f || !f->valid)
		return 0;
	f->valid = 0;
	return 1;
}

I64 FBlkRead(I64 faddr, I64 buf)
{
	CFile *f = faddr;
	if (!f || !f->valid)
		return 0;
	if (!BlkRead(buf, f->blk + f->pos, 1))
		return 0;
	f->pos = f->pos + 1;
	return 1;
}

I64 RSCFileDemo()
{
	U8 *dir;
	U8 *data;
	CFile *f;
	I64 root, fclus, i, v, len;

	if (!RSFmt(16, 7))
		return 0;
	root = RSAlloc(16, 1);
	if (root != 2)
		return 0;
	fclus = RSAlloc(16, 1);
	if (fclus != 3)
		return 0;

	dir = MAlloc(512);
	data = MAlloc(512);
	if (!dir || !data)
		return 0;
	MemSet(dir, 0, 512);
	RSEnt(dir, 0, ".", root, 512);
	RSEnt(dir, 1, "..", root, 512);
	RSEnt(dir, 2, "Zeal", fclus, 4);
	BlkWrite(dir, root, 1);
	MemSet(data, 0, 512);
	MemCpy(data, "Zeal", 5);
	BlkWrite(data, fclus, 1);

	f = FOpen(root, "Zeal");
	if (!f)
		return 0;
	MemSet(data, 0, 512);
	if (!FBlkRead(f, data))
		return 0;
	len = f->len;
	FClose(f);
	if (StrCmp(data, "Zeal") != 0)
		return 0;

	Cls(0x00101820);
	PrintAt(2, 1, "RSCFile");
	PrintAt(2, 3, data);
	for (i = 0; i < len; i = i + 1)
	{
		v = data[i];
		FillRect(60 + i * 100, 400 - (v & 63) * 4, 70, (v & 63) * 4 + 8, 0x00C08020);
	}
	Sleep(1200);
	Free(0);
	return len;
}

return RSCFileDemo();
