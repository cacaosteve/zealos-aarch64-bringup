/* Milestone 90: MS_MOVE while aiming + AimMoveLite.
 *
 * Upstream need: Lattice.ZC â€”
 *   MS_R_DOWN aim=TRUE; MS_MOVE while aim â†’ Arg; MS_R_UP aim=FALSE
 *
 *   - M187: Turtle.é / dé_idx (stock Lattice names)
 * Bring-up:
 *   - Mask includes MESSAGE_MS_MOVE
 *   - Scripted R_DOWN â†’ MOVE â†’ R_UP; MOVE after up ignored
 *   - return AimMoveLite();  expect 15
 */

class Turtle
{
	F64 x;
	F64 y;
	F64 é;
} tt;

I64 AimMoveLite()
{
	I64 arg1;
	I64 arg2;
	I64 h;
	I64 mask;
	I64 moves;
	Bool aim;
	F64 th_move;

	h = 0;
	aim = FALSE;
	moves = 0;
	th_move = 0.0;
	tt.x = 100.0;
	tt.y = 200.0;
	tt.é = 1.0;

	mask = 1 << MESSAGE_MS_MOVE | 1 << MESSAGE_MS_R_DOWN |
		1 << MESSAGE_MS_R_UP;

	/* Precedence: 1<<4|1<<7|1<<8 == 400. */
	if (mask == 400)
		h = h + 1;

	MsgQuePush(MESSAGE_MS_R_DOWN, 200, 200);
	MsgQuePush(MESSAGE_MS_MOVE, 100, 100);
	MsgQuePush(MESSAGE_MS_R_UP, 100, 100);
	/* After aim ends, MOVE must not change th. */
	MsgQuePush(MESSAGE_MS_MOVE, 300, 200);

	while (TRUE)
	{
		switch (MessageGet(&arg1, &arg2, mask))
		{
			case MESSAGE_MS_R_DOWN:
				aim = TRUE;
				tt.é = Arg(arg1 - tt.x, arg2 - tt.y);
				break;
			case MESSAGE_MS_MOVE:
				if (aim)
				{
					tt.é = Arg(arg1 - tt.x, arg2 - tt.y);
					th_move = tt.é;
					moves = moves + 1;
				}
				break;
			case MESSAGE_MS_R_UP:
				tt.é = Arg(arg1 - tt.x, arg2 - tt.y);
				aim = FALSE;
				break;
			case MESSAGE_NULL:
				goto lt_done;
		}
	}
lt_done:
	/* R_DOWN aim +x â†’ thâ‰ˆ0. */
	if (moves == 1)
		h = h + 2;
	/* MOVE to (100,100) from (100,200) â†’ Arg(0,-100) â‰ˆ -Ï€/2. */
	if (ToI64(th_move * 1000.0) == ToI64(-pi / 2 * 1000.0))
		h = h + 4;
	/* Final th from R_UP still -Ï€/2; post-aim MOVE ignored. */
	if (!aim && ToI64(tt.é * 1000.0) == ToI64(-pi / 2 * 1000.0))
		h = h + 8;
	return h;
}

return AimMoveLite();
