/* Milestone 15: RAM-disk BlkRead / BlkWrite stub.
 *
 * Upstream: Kernel/BlkDev BlkRead/BlkWrite (512-byte blocks) — no CDrive.
 *
 * Bring-up deltas:
 *   - Fixed 16×512 RAM disk in kernel
 *   - BlkWrite(buf, blk, count) / BlkRead(buf, blk, count)
 *   - Write "Zeal" pattern; read back; return checksum
 *   - return RamBlk();
 */

I64 RamBlk()
{
	U8 *buf;
	I64 i, s, v;

	buf = MAlloc(512);
	if (!buf)
		return 0;
	MemSet(buf, 0, 512);
	buf[0] = 'Z';
	buf[1] = 'e';
	buf[2] = 'a';
	buf[3] = 'l';
	buf[4] = 7;
	buf[5] = 11;
	if (!BlkWrite(buf, 0, 1))
		return 0;

	MemSet(buf, 0, 512);
	if (!BlkRead(buf, 0, 1))
		return 0;

	Cls(0x00101820);
	PrintAt(2, 1, "RamBlk");
	s = 0;
	for (i = 0; i < 6; i = i + 1)
	{
		v = buf[i];
		s = s + v;
		FillRect(60 + i * 70, 400 - (v & 63) * 4, 50, (v & 63) * 4 + 8, 0x0000C0FF);
	}
	Sleep(1200);
	Free(0);
	return s;
}

return RamBlk();
