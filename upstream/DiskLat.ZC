/* Milestone 115/118/121/122/125/134/136/143/144: Lattice compose from RedSea + DiskLat.
 *
 * Upstream need: runzc-shaped path for a Lattice *Lite (not freeze catalog).
 *
 * Bring-up:
 *   - rs_put_file → rs_load_file → hc_run_src (8K load; RedSea put still ≤~7K / free clus)
 *   - M144: TurtlePlot/MicroMove/Move + scripted CH_SPACE (before '\n'); slim ANGLES=3
 *   - Freeze catalog unchanged (ephemeral disk file)
 *   - return DiskLat();  expect 15
 */

#define ANGLES 3

F64 angles[ANGLES] = {0, 0, 0};

class Turtle
{
	F64 x;
	F64 y;
	F64 z;
	F64 speed;
	F64 th;
	F64 w;
	I64 idx;
	CColorROPU16 edge;
	CColorROPU16 middle;
	Bool ends;
	Bool first;
} tt;

U0 TurtlePlot(CDC *dc, Turtle *t, CColorROPU16 edge, CColorROPU16 middle)
{
	F64 w;

	w = t->w / 2.0 - 1;
	if (w < 0)
		w = 0;
	dc->color = middle;
	GrLine3(dc,
		t->x + w * Cos(t->th + pi / 2), t->y + w * Sin(t->th + pi / 2), t->z,
		t->x + w * Cos(t->th - pi / 2), t->y + w * Sin(t->th - pi / 2), t->z);
	w = t->w / 2.0;
	dc->color = edge;
	GrPlot3(dc, t->x + w * Cos(t->th + pi / 2), t->y + w * Sin(t->th + pi / 2), t->z);
	GrPlot3(dc, t->x + w * Cos(t->th - pi / 2), t->y + w * Sin(t->th - pi / 2), t->z);
}

U0 TurtleMicroMove(Turtle *t, F64 dt)
{
	F64 c;
	F64 s;

	c = Cos(t->th);
	s = Sin(t->th);
	t->x = t->x + c * t->speed * dt;
	t->y = t->y + s * t->speed * dt;
	t->th = Wrap(t->th + dt * angles[t->idx]);
}

U0 TurtleMove(CDC *dc, Turtle *t, CColorROPU16 edge, CColorROPU16 middle)
{
	I64 i;
	I64 l;

	l = 16 * AbsI64(t->w + 1) * AbsI64(t->speed + 1);
	t->first = FALSE;
	for (i = 0; i < l; i++)
	{
		TurtleMicroMove(t, 1.0 / l);
		TurtlePlot(dc, t, edge, middle);
	}
}

U0 TurtleInit(Turtle *t)
{
	MemSet(t, 0, sizeof(Turtle));
	t->x = Fs->pix_width >> 1;
	t->y = Fs->pix_height >> 1;
	t->z = 5;
	t->edge = BLACK;
	t->middle = YELLOW;
	t->idx = ANGLES / 2;
	t->first = TRUE;
	t->ends = TRUE;
}

U0 SetMenu()
{
	I64 i;
	U8 buf[STR_LEN];
	CMenuEntry *tmpse;

	for (i = 0; i <= 9; i++)
	{
		StrPrint(buf, "Settings/Layer%d", i);
		if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
		{
			if (i == ToI64(tt.z))
				tmpse->checked = TRUE;
			else
				tmpse->checked = FALSE;
		}
	}
	if (tmpse = MenuEntryFind(Fs->cur_menu, "Settings/Ends"))
	{
		if (tt.ends)
			tmpse->checked = TRUE;
		else
			tmpse->checked = FALSE;
	}
}

I64 DiskLat()
{
	CDC *dc;
	I64 h;
	I64 arg1;
	I64 arg2;

	h = 0;
	dc = DCAlias;
	DCDepthBufAlloc(dc);
	MenuPush(
		"File {"
		"  Abort(,CH_SHIFT_ESC);"
		"  Exit(,CH_ESC);"
		"}"
		"Play {"
		"  Restart(,'\n');"
		"  Step(,CH_SPACE);"
		"  Accelerator(,,SC_CURSOR_UP);"
		"  Break(,,SC_CURSOR_DOWN);"
		"  Left(,,SC_CURSOR_LEFT);"
		"  Right(,,SC_CURSOR_RIGHT);"
		"}"
		"Settings {"
		"  Color(,'c');"
		"  Wider(,'+');"
		"  Narrower(,'-');"
		"  Ends(,'e');"
		"  Layer0(,'0');"
		"  Layer1(,'1');"
		"  Layer2(,'2');"
		"  Layer3(,'3');"
		"  Layer4(,'4');"
		"  Layer5(,'5');"
		"  Layer6(,'6');"
		"  Layer7(,'7');"
		"  Layer8(,'8');"
		"  Layer9(,'9');"
		"}"
		);
	SettingsPush;
	AutoComplete;
	WinBorder;
	WinMax;
	DocCursor;
	DocClear;
	TurtleInit(&tt);
	SetMenu;
	Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_FOCUS_TASK_MENU -
		WIF_SELF_FOCUS - WIF_SELF_GRAB_SCROLL;
	try
	{
		MsgQuePush(MESSAGE_KEY_DOWN, '3', 0);
		MsgQuePush(MESSAGE_KEY_DOWN, 'e', 0);
		MsgQuePush(MESSAGE_KEY_DOWN, '+', 0);
		MsgQuePush(MESSAGE_KEY_DOWN, '-', 0);
		MsgQuePush(MESSAGE_KEY_DOWN, CH_SPACE, 0);
		MsgQuePush(MESSAGE_KEY_DOWN, '\n', 0);
		MsgQuePush(MESSAGE_KEY_DOWN, 'c', 0);
		MsgQuePush(MESSAGE_KEY_DOWN, CH_ESC, 0);

		while (TRUE)
		{
			switch (MessageGet(&arg1, &arg2, 1 << MESSAGE_KEY_DOWN))
			{
				case MESSAGE_KEY_DOWN:
					switch (arg1)
					{
						case '0'...'9':
							tt.z = arg1 - '0';
							SetMenu;
							break;
						case 'e':
							tt.ends = !tt.ends;
							SetMenu;
							break;
						case '+':
							tt.w = tt.w + 1.0;
							break;
						case '-':
							tt.w = tt.w - 1.0;
							break;
						case 'c':
							tt.middle = PopUpColor("Mid Color\n\n");
							tt.edge = PopUpColor("Edge Color\n\n");
							break;
						case CH_SPACE:
							TurtleMove(dc, &tt, tt.edge, tt.middle);
							break;
						case '\n':
							DCFill(dc);
							TurtleInit(&tt);
							SetMenu;
							break;
						case CH_ESC:
						case CH_SHIFT_ESC:
							goto lt_done;
					}
					break;
				case MESSAGE_NULL:
					goto lt_done;
			}
		}
lt_done:
		MessageGet(,, 1 << MESSAGE_KEY_UP);
	}
	catch
		PutExcept;

	if (ToI64(tt.z) == 5)
		h = h + 1;
	if (tt.ends)
		h = h + 2;
	if (ToI64(tt.w) == 0)
		h = h + 4;
	if (tt.first && tt.middle == YELLOW)
		h = h + 8;

	SettingsPop;
	MenuPop;
	return h;
}

return DiskLat();
