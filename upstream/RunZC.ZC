/* Milestone 34: seed Hi.ZC on RedSea for load+JIT from disk.
 *
 * Built as: lib/RedSeaCFile.ZC + this file (Makefile concat).
 * Creates Hi.ZC with source `return 42;` if missing (persist-safe).
 * Returns file size (11). C shell `runzc` then reads+JITs it.
 *
 * Bring-up deltas:
 *   - Same RSValid/RSRoot probe as RSCPersist (no wipe if vol exists)
 *   - return RunZCSeed();
 */

I64 RunZCSeed()
{
	U8 *br;
	U8 *dir;
	U8 *data;
	U8 *e;
	U8 *ent;
	I64 *w;
	CFile *f;
	I64 root;
	I64 fclus;
	I64 i;
	I64 sz;

	root = 0;
	if (RSValid())
		root = RSRoot();
	if (!root)
	{
		if (!RSFmt(16, 9))
			return 0;
		root = RSAlloc(16, 1);
		if (!root)
			return 0;
		br = MAlloc(512);
		if (!br)
			return 0;
		MemSet(br, 0, 512);
		if (!BlkRead(br, 0, 1))
			return 0;
		w = br + 8;
		w[2] = root;
		if (!BlkWrite(br, 0, 1))
			return 0;
		ent = MAlloc(64);
		if (!ent)
			return 0;
		MemSet(ent, 0, 64);
		ent[2] = '.';
		ent[3] = 0;
		w = ent + 40;
		w[0] = root;
		w[1] = 1;
		if (!BlkWrite(ent, root, 1))
			return 0;
	}

	f = FOpen(root, "Hi.ZC");
	if (!f)
	{
		fclus = RSAlloc(16, 1);
		if (!fclus)
			return 0;
		f = FCreate(root, "Hi.ZC", fclus);
		if (!f)
			return 0;
		data = MAlloc(512);
		if (!data)
			return 0;
		MemSet(data, 0, 512);
		MemCpy(data, "return 42;", 11);
		if (!FBlkWrite(f, data, 10))
			return 0;
		dir = MAlloc(512);
		if (!dir)
			return 0;
		BlkRead(dir, root, 1);
		for (i = 0; i < 8; i = i + 1)
		{
			e = dir + i * 64;
			if (e[2] && StrCmp(e + 2, "Hi.ZC") == 0)
			{
				w = e + 40;
				w[1] = f->len;
				break;
			}
		}
		BlkWrite(dir, root, 1);
		FClose(f);
		f = FOpen(root, "Hi.ZC");
		if (!f)
			return 0;
	}

	sz = FSize(f);
	if (sz != 10)
		return 0;
	data = MAlloc(512);
	if (!data)
		return 0;
	MemSet(data, 0, 512);
	if (!FBlkRead(f, data))
		return 0;
	if (data[0] != 'r' || data[7] != '4' || data[8] != '2')
		return 0;
	FClose(f);

	Cls(0x00101820);
	PrintAt(2, 1, "RunZC");
	PrintAt(2, 3, "Hi.ZC");
	FillRect(120, 360, 80, 24, 0x0060C080);
	FillRect(240, 360, 120, 24, 0x0060C080);
	Sleep(400);
	Free(0);
	return sz;
}

return RunZCSeed();
