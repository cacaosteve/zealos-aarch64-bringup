/* Milestone 23: RedSea root dir entries (CDirEntry-shaped).
 *
 * Upstream: FileSysRedSea.ZC RedSeaFormat writes "." / ".." at root_clus.
 * On-disk CDirEntry from start: U16 attr, U8 name[38], I64 clus,size,datetime
 * (64 bytes). RS_ATTR_DIR|RS_ATTR_CONTIGUOUS = 0x0410.
 *
 * Bring-up deltas:
 *   - RSFmt boot; RSMkRoot writes . and .. @ root_clus
 *   - RSFindDot reads back "." → returns its clus (2)
 *   - return RSRootDemo();
 */

I64 RSFmt(I64 sects, I64 root, I64 bmap, I64 uid)
{
	U8 *br;
	I64 *w;

	br = MAlloc(512);
	if (!br)
		return 0;
	MemSet(br, 0, 512);
	br[3] = 0x88;
	w = br + 8;
	w[0] = 0;
	w[1] = sects;
	w[2] = root;
	w[3] = bmap;
	w[4] = uid;
	br[510] = 0x55;
	br[511] = 0xAA;
	if (!BlkWrite(br, 0, 1))
		return 0;
	return 1;
}

I64 RSMkRoot(I64 root)
{
	U8 *dir;
	U8 *e;
	I64 *w;

	dir = MAlloc(512);
	if (!dir)
		return 0;
	MemSet(dir, 0, 512);

	/* "." */
	e = dir;
	e[0] = 0x10;
	e[1] = 0x04;
	e[2] = '.';
	e[3] = 0;
	w = e + 40;
	w[0] = root;
	w[1] = 512;
	w[2] = 0;

	/* ".." */
	e = dir + 64;
	e[0] = 0x10;
	e[1] = 0x04;
	e[2] = '.';
	e[3] = '.';
	e[4] = 0;
	w = e + 40;
	w[0] = root;
	w[1] = 512;
	w[2] = 0;

	if (!BlkWrite(dir, root, 1))
		return 0;
	return 1;
}

I64 RSFindDot(I64 root)
{
	U8 *dir;
	U8 *e;
	I64 *w;
	I64 i;

	dir = MAlloc(512);
	if (!dir)
		return 0;
	MemSet(dir, 0, 512);
	if (!BlkRead(dir, root, 1))
		return 0;
	for (i = 0; i < 8; i = i + 1)
	{
		e = dir + i * 64;
		if (e[2] == '.' && e[3] == 0)
		{
			w = e + 40;
			return w[0];
		}
	}
	return 0;
}

I64 RSRootDemo()
{
	I64 root, clus, v;

	root = 2;
	if (!RSFmt(16, root, 1, 7))
		return 0;
	if (!RSMkRoot(root))
		return 0;
	clus = RSFindDot(root);
	if (clus != root)
		return 0;

	Cls(0x00101820);
	PrintAt(2, 1, "RSRoot");
	PrintAt(2, 3, ".");
	v = 0x10;
	FillRect(80, 400 - (v & 63) * 4, 90, (v & 63) * 4 + 8, 0x0040C0E0);
	v = clus;
	FillRect(220, 400 - (v & 63) * 4, 90, (v & 63) * 4 + 8, 0x0040C0E0);
	v = 512 >> 6;
	FillRect(360, 400 - (v & 63) * 4, 90, (v & 63) * 4 + 8, 0x0040C0E0);
	Sleep(1200);
	Free(0);
	return clus;
}

return RSRootDemo();
