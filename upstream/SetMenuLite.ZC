/* Milestone 108: per-path MenuEntryFind + SetMenuLite.
 *
 * Upstream need: Lattice.ZC SetMenu —
 *   for i 0..9: Layer%d checked = (i == tt.z);
 *   Ends checked = tt.ends;
 *
 * Bring-up:
 *   - MenuEntryFind returns distinct CMenuEntry per path string
 *   - return SetMenuLite();  expect 15
 */

class Turtle
{
	F64 z;
	Bool ends;
} tt;

U0 SetMenu()
{
	I64 i;
	U8 buf[32];
	CMenuEntry *tmpse;

	for (i = 0; i <= 9; i++)
	{
		StrPrint(buf, "Settings/Layer%d", i);
		if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
		{
			if (i == ToI64(tt.z))
				tmpse->checked = TRUE;
			else
				tmpse->checked = FALSE;
		}
	}
	if (tmpse = MenuEntryFind(Fs->cur_menu, "Settings/Ends"))
	{
		if (tt.ends)
			tmpse->checked = TRUE;
		else
			tmpse->checked = FALSE;
	}
}

I64 SetMenuLite()
{
	I64 h;
	CMenuEntry *tmpse;
	U8 buf[32];

	h = 0;
	tt.z = 5;
	tt.ends = TRUE;
	SetMenu;

	StrPrint(buf, "Settings/Layer%d", 5);
	if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
	{
		if (tmpse->checked)
			h = h + 1;
	}
	/* Sibling layer cleared. */
	StrPrint(buf, "Settings/Layer%d", 3);
	if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
	{
		if (!tmpse->checked)
			h = h + 2;
	}
	if (tmpse = MenuEntryFind(Fs->cur_menu, "Settings/Ends"))
	{
		if (tmpse->checked)
			h = h + 4;
	}
	/* Switch layer 2; Ends stays. */
	tt.z = 2;
	SetMenu;
	StrPrint(buf, "Settings/Layer%d", 2);
	if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
	{
		if (tmpse->checked)
		{
			StrPrint(buf, "Settings/Layer%d", 5);
			if (tmpse = MenuEntryFind(Fs->cur_menu, buf))
			{
				if (!tmpse->checked)
					h = h + 8;
			}
		}
	}
	return h;
}

return SetMenuLite();
