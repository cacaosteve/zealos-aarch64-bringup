/* Milestone 24: RedSea file entry + BlkRead payload.
 *
 * Upstream: RedSeaFileFind / RedSeaFileRead — CDirEntry name → clus → data.
 * No free bitmap / ClusAlloc; fixed root=2, file data @ blk 3.
 *
 * Bring-up deltas:
 *   - Boot + . / .. + "Zeal" entry; payload at clus 3
 *   - RSFind by name; BlkRead; StrCmp "Zeal"
 *   - Returns file size (4)
 *   - return RSFileDemo();
 */

I64 RSFmt(I64 sects, I64 root, I64 bmap, I64 uid)
{
	U8 *br;
	I64 *w;

	br = MAlloc(512);
	if (!br)
		return 0;
	MemSet(br, 0, 512);
	br[3] = 0x88;
	w = br + 8;
	w[0] = 0;
	w[1] = sects;
	w[2] = root;
	w[3] = bmap;
	w[4] = uid;
	br[510] = 0x55;
	br[511] = 0xAA;
	if (!BlkWrite(br, 0, 1))
		return 0;
	return 1;
}

U0 RSEnt(I64 dir, I64 slot, I64 name, I64 clus, I64 size)
{
	U8 *e;
	U8 *n;
	I64 *w;

	e = dir + slot * 64;
	n = name;
	MemSet(e, 0, 64);
	if (n[0] == '.')
	{
		e[0] = 0x10;
		e[1] = 0x04;
	}
	else
	{
		e[0] = 0x20;
		e[1] = 0x04;
	}
	MemCpy(e + 2, name, StrLen(name) + 1);
	w = e + 40;
	w[0] = clus;
	w[1] = size;
	w[2] = 0;
}

I64 RSMkVol(I64 root, I64 fclus)
{
	U8 *dir;
	U8 *data;

	dir = MAlloc(512);
	data = MAlloc(512);
	if (!dir || !data)
		return 0;
	MemSet(dir, 0, 512);
	RSEnt(dir, 0, ".", root, 512);
	RSEnt(dir, 1, "..", root, 512);
	RSEnt(dir, 2, "Zeal", fclus, 4);
	if (!BlkWrite(dir, root, 1))
		return 0;
	MemSet(data, 0, 512);
	MemCpy(data, "Zeal", 5);
	if (!BlkWrite(data, fclus, 1))
		return 0;
	return 1;
}

I64 RSFind(I64 root, I64 want)
{
	U8 *dir;
	U8 *e;
	I64 *w;
	I64 i;

	dir = MAlloc(512);
	if (!dir)
		return 0;
	MemSet(dir, 0, 512);
	if (!BlkRead(dir, root, 1))
		return 0;
	for (i = 0; i < 8; i = i + 1)
	{
		e = dir + i * 64;
		if (e[2] && StrCmp(e + 2, want) == 0)
		{
			w = e + 40;
			return w[0];
		}
	}
	return 0;
}

I64 RSFileDemo()
{
	U8 *data;
	I64 root, fclus, clus, i, v, len;

	root = 2;
	fclus = 3;
	if (!RSFmt(16, root, 1, 7))
		return 0;
	if (!RSMkVol(root, fclus))
		return 0;
	clus = RSFind(root, "Zeal");
	if (clus != fclus)
		return 0;
	data = MAlloc(512);
	if (!data)
		return 0;
	MemSet(data, 0, 512);
	if (!BlkRead(data, clus, 1))
		return 0;
	if (StrCmp(data, "Zeal") != 0)
		return 0;
	len = StrLen(data);

	Cls(0x00101820);
	PrintAt(2, 1, "RSFile");
	PrintAt(2, 3, data);
	for (i = 0; i < len; i = i + 1)
	{
		v = data[i];
		FillRect(60 + i * 100, 400 - (v & 63) * 4, 70, (v & 63) * 4 + 8, 0x00E06040);
	}
	Sleep(1200);
	Free(0);
	return len;
}

return RSFileDemo();
