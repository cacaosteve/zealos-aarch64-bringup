/* Milestone 71: for-step i++/i-- + ForIncLite.
 *
 * Upstream need: Lattice.ZC TurtleMove / SetMenu —
 *   for (i = 0; i < l; i++) { … }
 *   for (i = 0; i <= 9; i++) { … }
 *
 * Bring-up:
 *   - for third clause accepts ident++ / ident--
 *   - return ForIncLite();  expect 15
 */

I64 ForIncLite()
{
	I64 i;
	I64 s;
	I64 h;

	h = 0;
	s = 0;
	for (i = 0; i < 5; i++)
		s = s + i;
	if (s == 10)
		h = h + 1;
	s = 0;
	for (i = 5; i > 0; i--)
		s = s + i;
	if (s == 15)
		h = h + 2;
	s = 0;
	for (i = 0; i <= 3; i++)
		s = s + 1;
	if (s == 4)
		h = h + 4;
	s = 0;
	for (i = 0; i < 3; i = i + 1)
		s = s + 1;
	if (s == 3)
		h = h + 8;
	return h;
}

return ForIncLite();
