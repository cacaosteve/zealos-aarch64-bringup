/* Milestone 74: TurtleEnd + AbsI64(F64) + EndLite.
 *
 * Upstream need: Lattice.ZC â€”
 *   l = 16 * AbsI64(t->w + 1) * AbsI64(t->speed + 1);
 *   if (t->ends && t->first) TurtleEnd(...);
 *   U0 TurtleEnd â€” while(TRUE) semicircle + MemCopy restore
 *
 *   - M187: Turtle.é / dé_idx (stock Lattice names)
 * Bring-up:
 *   - AbsI64(F64) via F2I then Abs
 *   - TurtleEnd (assign-as-expr if(r=t->w), while/break, Sqrt)
 *   - TurtleMove with ends=TRUE
 *   - return EndLite();  expect 15
 */

#define ANGLES 3

F64 angles[ANGLES] = {0.0, 0.0, 0.0};

class Turtle
{
	F64 x;
	F64 y;
	F64 z;
	F64 speed;
	F64 é;
	F64 w;
	I64 dé_idx;
	Bool ends;
	Bool first;
};

U0 TurtlePlot(CDC *dc, Turtle *t, CColorROPU16 edge, CColorROPU16 middle)
{
	F64 w;

	w = t->w / 2.0 - 1;
	if (w < 0)
		w = 0;
	dc->color = middle;
	GrLine3(dc,
		t->x + w * Cos(t->é + pi / 2), t->y + w * Sin(t->é + pi / 2), t->z,
		t->x + w * Cos(t->é - pi / 2), t->y + w * Sin(t->é - pi / 2), t->z);
	w = t->w / 2.0;
	dc->color = edge;
	GrPlot3(dc, t->x + w * Cos(t->é + pi / 2), t->y + w * Sin(t->é + pi / 2), t->z);
	GrPlot3(dc, t->x + w * Cos(t->é - pi / 2), t->y + w * Sin(t->é - pi / 2), t->z);
}

U0 TurtleMicroMove(Turtle *t, F64 dt)
{
	F64 c;
	F64 s;

	c = Cos(t->é);
	s = Sin(t->é);
	t->x = t->x + c * t->speed * dt;
	t->y = t->y + s * t->speed * dt;
	t->é = Wrap(t->é + dt * angles[t->dé_idx]);
}

U0 TurtleEnd(CDC *dc, Turtle *t, CColorROPU16 edge, CColorROPU16 middle, F64 th)
{
	F64 r;
	F64 x;
	F64 y2;
	Turtle t2;

	if (r = t->w)
	{
		MemCopy(&t2, t, sizeof(Turtle));
		x = 0;
		while (TRUE)
		{
			t->x = t->x + 1 / r * Cos(th);
			t->y = t->y + 1 / r * Sin(th);
			x = x + 1 / r;
			y2 = r * r - 4 * x * x;
			if (y2 >= 0)
			{
				t->w = Sqrt(y2);
				TurtlePlot(dc, t, edge, middle);
			}
			else
				break;
		}
		MemCopy(t, &t2, sizeof(Turtle));
	}
}

U0 TurtleMove(CDC *dc, Turtle *t, CColorROPU16 edge, CColorROPU16 middle)
{
	I64 i;
	I64 l;

	/* Lattice uses 16*; keep small for smoke. AbsI64(F64) is the gap. */
	l = 2 * AbsI64(t->w + 1) * AbsI64(t->speed + 1);
	if (t->ends && t->first)
		TurtleEnd(dc, t, edge, middle, t->é + pi);
	t->first = FALSE;
	for (i = 0; i < l; i++)
	{
		TurtleMicroMove(t, 1.0 / l);
		TurtlePlot(dc, t, edge, middle);
	}
	if (t->ends)
		TurtleEnd(dc, t, edge, middle, t->é);
}

I64 EndLite()
{
	Turtle t;
	CDC *dc;
	I64 h;
	I64 rgb;

	h = 0;
	/* AbsI64(F64) truncate + abs â€” Lattice TurtleMove step count. */
	if (AbsI64(-3.7) == 3)
		h = h + 1;
	if (AbsI64(2.0 + 1.0) == 3)
		h = h + 2;

	dc = DCAlias;
	t.x = 100.0;
	t.y = 100.0;
	t.z = 0.0;
	t.speed = 1.0;
	t.é = 0.0;
	t.w = 4.0;
	t.dé_idx = 0;
	t.ends = TRUE;
	t.first = TRUE;

	Cls(0);
	/* l = 2*AbsI64(5)*AbsI64(2) = 20 steps of speed 1 â†’ xâ‰ˆ120 */
	TurtleMove(dc, &t, RED, YELLOW);

	if (!t.first)
		h = h + 4;
	/* Edge GrPlot3 after move; RED â†’ palette 0x00AA0000. */
	rgb = 0x00AA0000;
	if (GrPeek(ToI64(t.x), ToI64(t.y) + 2) == rgb)
		h = h + 8;
	return h;
}

return EndLite();
