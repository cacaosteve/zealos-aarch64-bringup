+  char *data;
+  if (!dim || dim->cnt != INT64_MIN || stride <= 0) {
+    ParseErr(ccmp, "Invalid inferred array layout.");
+    return NULL;
+  }
+  if (dim->next && dim->next->cnt == INT64_MIN) {
+    ParseErr(ccmp, "Only the first array bound may be inferred.");
+    return NULL;
