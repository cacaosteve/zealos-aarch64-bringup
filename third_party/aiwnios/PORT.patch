+static int PrsSameFunctionABI(CHashFun *a, CHashFun *b) {
+  CMemberLst *am = a->base.members_lst, *bm = b->base.members_lst;
+  if (a->argc != b->argc ||
+      !PrsSameCallType(a->return_class, b->return_class) ||
