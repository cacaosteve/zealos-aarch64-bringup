+    *(rpn = A_CALLOC(sizeof(CRPN), NULL)) = (CRPN){
+        .type = IC_LOCAL, .local_mem = lst};
+    QueIns(rpn, ccmp->code_ctrl->ir_code);
+    *(rpn = A_CALLOC(sizeof(CRPN), NULL)) = (CRPN){
+        .type = IC_I64, .integer = i};
+    QueIns(rpn, ccmp->code_ctrl->ir_code);
