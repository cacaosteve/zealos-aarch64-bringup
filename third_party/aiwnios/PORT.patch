+static int PrsSameArrayDim(CArrayDim *a, CArrayDim *b) {
+  while (a && b) {
+    if (a->cnt != b->cnt)
+      return 0;
+    a = a->next;
+    b = b->next;
+  }
+  return !a && !b;
