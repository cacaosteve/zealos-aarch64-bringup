+/* Emit stores at the declaration, so expressions and repeated calls use the
+ * current frame. The bootstrap extension is limited to one scalar dimension;
+ * the existing static/global initializer parser handles aggregate layouts. */
+static void PrsLocalArrayInit(CCmpCtrl *ccmp, CMemberLst *lst) {
+  CArrayDim *dim = lst->dim.next;
+  CRPN *rpn;
+  int64_t i;
+  if (!dim || dim->next || lst->member_class->raw_type < RT_I8i ||
+      lst->member_class->raw_type > RT_F64)
+    ParseErr(ccmp, "Local brace initializer requires a 1D scalar array.");
+  Lex(ccmp->lex); /* '{' */
+  for (i = 0; i < dim->cnt; i++) {
+    *(rpn = A_CALLOC(sizeof(CRPN), NULL)) = (CRPN){
+        .type = IC_LOCAL, .local_mem = lst};
+    QueIns(rpn, ccmp->code_ctrl->ir_code);
+    *(rpn = A_CALLOC(sizeof(CRPN), NULL)) = (CRPN){
+        .type = IC_I64, .integer = i};
+    QueIns(rpn, ccmp->code_ctrl->ir_code);
+    (rpn = A_CALLOC(sizeof(CRPN), NULL))->type = IC_ARRAY_ACC;
+    QueIns(rpn, ccmp->code_ctrl->ir_code);
+    if (!ParseExpr(ccmp, PEF_NO_COMMA))
+      ParseErr(ccmp, "Expected a local array element.");
+    (rpn = A_CALLOC(sizeof(CRPN), NULL))->type = IC_EQ;
+    QueIns(rpn, ccmp->code_ctrl->ir_code);
+    if (ccmp->lex->cur_tok == ',')
+      Lex(ccmp->lex);
+    else if (i + 1 != dim->cnt)
+      ParseErr(ccmp, "Expected another local array element.");
+  }
+  if (ccmp->lex->cur_tok != '}')
+    ParseErr(ccmp, "Expected '}' after local array initializer.");
+  Lex(ccmp->lex);
