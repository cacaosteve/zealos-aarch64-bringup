// Cooperative Sleep over the ARM generic timer and pinned task signatures.
extern U0 SleepUntil(I64 wake_jiffy);
I64 timer_phase;

U0 TimerWorker(U8 *data)
{
    timer_phase = 1;
    Sleep(8);
    timer_phase = 2;
}

U0 TimerLongWorker(U8 *data)
{
    timer_phase = 1;
    Sleep(500);
    timer_phase = 2;
}

U0 TimerUntilWorker(U8 *data)
{
    Sleep(2);
    timer_phase = 2;
}

I64 TaskTimerChecks()
{
    CTask *worker;
    I64 start = TSCGet;

    Sleep(2);
    if (TSCGet <= start)
        return 1;
    timer_phase = 0;
    worker = Spawn(&TimerWorker);
    if (!worker)
        return 2;
    Sleep(1);
    if (timer_phase != 1 || !TaskValidate(worker))
        return 3;
    DeathWait(&worker);
    if (timer_phase != 2 || TaskValidate(worker))
        return 4;
    return 42;
}

I64 TaskTimerRunChecks()
{
    CTask *worker;
    timer_phase = 0;
    worker = Spawn(&TimerWorker);
    if (!worker || ZcTaskRun != 1 || timer_phase != 2 ||
        TaskValidate(worker))
        return 1;
    return 42;
}

I64 TaskTimerSuspendChecks()
{
    CTask *worker;
    timer_phase = 0;
    worker = Spawn(&TimerLongWorker);
    if (!worker)
        return 1;
    Sleep(1);
    if (timer_phase != 1 || Suspend(worker, TRUE) || ZcTaskRun != -2)
        return 2;
    if (!Kill(worker) || timer_phase != 1)
        return 3;
    return 42;
}

I64 TaskTimerJobChecks()
{
    CJob *job = TaskExe(Fs, Fs, "Sleep(2); 42;", 0);
    if (!job || JobsHandler(0) != 1 || JobResGet(job) != 42)
        return 1;
    return 42;
}

I64 TaskSleepUntilChecks()
{
    CTask *worker;
    I64 deadline;
    timer_phase = 0;
    worker = Spawn(&TimerUntilWorker);
    if (!worker)
        return 1;
    deadline = ZcMonotonicNs() / 1000000 + 12;
    SleepUntil(deadline);
    if (counts.jiffies < deadline || timer_phase != 2)
        return 2;
    DeathWait(&worker);
    if (TaskValidate(worker))
        return 3;
    return 42;
}

CTask *timer_background_task;

I64 TaskTimerBackgroundStart()
{
    timer_phase = 0;
    timer_background_task = Spawn(&TimerWorker);
    if (!timer_background_task || timer_phase != 0)
        return 1;
    return 42;
}

I64 TaskTimerBackgroundChecks()
{
    // This function does not Yield: the worker must have run at the shell.
    if (timer_phase != 2 || TaskValidate(timer_background_task))
        return 1;
    return 42;
}

I64 timer_wait_code, timer_wait_arg1, timer_wait_arg2;
I64 doc_lock_child_acquired;

U0 TimerWaitMessageServer(U8 *data)
{
    timer_wait_code = ZcMessageGetTimeout(&timer_wait_arg1,
                                          &timer_wait_arg2,
                                          1 << MESSAGE_CMD, Fs, 200);
}

U0 TimerWaitTimeoutServer(U8 *data)
{
    timer_wait_code = ZcMessageGetTimeout(NULL, NULL,
                                          1 << MESSAGE_CMD, Fs, 5);
}

U0 DocLockContender(U8 *data)
{
    CDoc *doc = data;
    if (DocLock(doc))
    {
        doc_lock_child_acquired = TRUE;
        DocUnlock(doc);
    }
}

I64 TaskDocLockChecks()
{
    CDoc *doc = CAlloc(sizeof(CDoc));
    CTask *task;

    doc_lock_child_acquired = FALSE;
    if (!DocLock(doc))
        return 1;
    task = Spawn(&DocLockContender, doc);
    if (!task)
    {
        DocUnlock(doc);
        Free(doc);
        return 2;
    }
    Sleep(1);
    if (doc_lock_child_acquired || doc->owning_task != Fs)
    {
        DocUnlock(doc);
        DeathWait(&task);
        Free(doc);
        return 3;
    }
    if (!DocUnlock(doc))
    {
        DeathWait(&task);
        Free(doc);
        return 4;
    }
    DeathWait(&task);
    if (!doc_lock_child_acquired || Bt(&doc->locked_flags, DOClf_LOCKED))
    {
        Free(doc);
        return 5;
    }
    Free(doc);
    return 42;
}

I64 TaskTimerWaitChecks()
{
    CTask *task;
    task = Spawn(&TimerLongWorker);
    if (!task)
        return 1;
    Sleep(2);
    if (!ZcTaskWaitTimeout(task, 1, FALSE))
        return 2;
    if (!TaskValidate(task) || timer_phase != 1 ||
        !Bt(&task->task_flags, TASKf_IDLE))
        return 3;
    if (!Kill(task))
        return 4;

    timer_wait_code = timer_wait_arg1 = timer_wait_arg2 = 0;
    task = Spawn(&TimerWaitMessageServer);
    if (!task)
        return 5;
    Sleep(1);
    if (!ZcTaskWaitTimeout(task, 100, FALSE))
        return 6;
    MessagePost(task, MESSAGE_CMD, 42, 9);
    DeathWait(&task);
    if (timer_wait_code != MESSAGE_CMD || timer_wait_arg1 != 42 ||
        timer_wait_arg2 != 9)
        return 7;

    timer_wait_code = -1;
    task = Spawn(&TimerWaitTimeoutServer);
    if (!task)
        return 8;
    DeathWait(&task);
    if (timer_wait_code)
        return 9;
    if (ZcMessageGetTimeout(NULL, NULL, 1 << MESSAGE_CMD, Fs, 0))
        return 10;
    if (ZcMessageGetTimeout(NULL, NULL, 1 << MESSAGE_CMD, Fs, 3))
        return 11;
    return 42;
}
