// Brace initializers for frame-local scalar arrays must run on every call.
I64 LocalArrayOne(I64 n)
{
    I64 numbers[3] = {n, n + 2, 30};
    U32 narrow[2] = {0x100000001, n + 1};
    F64 real[2] = {1.5, n + 0.5};

    if (numbers[0] != n || numbers[1] != n + 2 || numbers[2] != 30)
        return -1;
    if (narrow[0] != 1 || narrow[1] != n + 1)
        return -2;
    if (real[0] != 1.5 || real[1] != n + 0.5)
        return -3;
    return numbers[0] + numbers[1] + numbers[2] + narrow[0] + narrow[1];
}

I64 LocalArrayChecks()
{
    if (LocalArrayOne(3) != 43 || LocalArrayOne(5) != 49)
        return 1;
    return 42;
}
