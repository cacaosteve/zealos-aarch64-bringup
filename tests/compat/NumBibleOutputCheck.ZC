U0 NumBibleOutputCheck()
{
	I64 size = 0;
	U8 *data = FileRead("~/DemoNumBible.DD", &size);
	if (data && size > 0x400000 && data[0] == '0' && data[1] == '0' &&
		data[2] == '0' && data[3] == '0' && data[4] == '1' && data[5] == ' ')
		Print("NUMBIBLE_OUTPUT_OK");
	else
		Print("NUMBIBLE_OUTPUT_BAD size=%d", size);
	Free(data);
}

NumBibleOutputCheck;
