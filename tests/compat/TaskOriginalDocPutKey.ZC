// Smoke: live put_doc StdOut via DocNew + DocPrint + PutS/DocPrintPartial.
I64 TaskOriginalDocPutKeyChecks()
{
    CDoc *doc;
    CDocEntry *entry;
    CKeyDevEntry *tmp;
    I64 v;

    KeyDevInit;
    doc = DocNew;
    if (!doc || doc->doc_signature != DOC_SIGNATURE_VAL)
        return 1;

    // Funptr members must load the stored pointer. Typing them RT_FUNC made
    // OptPassExpandPtrs drop IC_DEREF, so user_put_s read as &member (always
    // non-NULL) and DocPrintPartial called that address.
    (&doc->user_put_s)(I64 *)[0] = 0x3333;
    v = doc->user_put_s(I64);
    if (v != 0x3333)
        return 10;
    (&doc->left_click_link)(I64 *)[0] = 0x4444;
    v = doc->left_click_link(I64);
    if (v != 0x4444)
        return 11;

    doc->user_put_data = NULL;
    doc->user_put_key = NULL;
    doc->user_put_s = NULL;
    doc->left_click_link = NULL;
    Fs->put_doc = Fs->display_doc = doc;
    if (DocPut != doc)
        return 2;
    Raw(OFF);
    if (IsRaw)
        return 3;
    if (!KeyDevAdd(&KDDocPutKey, &KDDocPutS, 0x80000000, TRUE))
        return 4;
    tmp = keydev.put_key_head.next;
    while (tmp != &keydev.put_key_head)
    {
        if (tmp->priority == 0x80000000)
            break;
        tmp = tmp->next;
    }
    if (tmp == &keydev.put_key_head)
        return 5;

    // DocPrint → DocPutS is the empty-doc StdOut path MakeDoc eventually needs.
    DocPrint(doc, "Hi");
    entry = doc->head.next;
    if (entry == doc)
        return 6;
    if (entry->type_u8 != DOCT_TEXT)
        return 7;
    if (!entry->tag || entry->tag[0] != 'H' || entry->tag[1] != 'i')
        return 8;
    if (DocPut->head.next->tag[0] != 'H')
        return 9;

    // PutS → KDDocPutS → DocPrintPartial must append without trapping on the
    // NULL user_put_s funptr member load.
    PutS("!");
    entry = doc->head.next;
    if (entry->type_u8 != DOCT_TEXT || !entry->tag)
        return 12;
    if (entry->tag[0] == 'H' && entry->tag[1] == 'i' && entry->tag[2] == '!')
        return 42;
    if (entry->next != doc && entry->next->type_u8 == DOCT_TEXT &&
        entry->next->tag && entry->next->tag[0] == '!')
        return 42;
    return 13;
}
