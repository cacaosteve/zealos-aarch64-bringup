I64 ProgressAliasChecks()
{
    I64 i;
    U8 *bytes = sys_progresses;
    if (&progress1 != &sys_progresses[0].val ||
        &progress2 != &sys_progresses[1].val ||
        &progress3 != &sys_progresses[2].val ||
        &progress4 != &sys_progresses[3].val ||
        &progress1_t0 != &sys_progresses[0].t0 ||
        &progress4_tf != &sys_progresses[3].tf) return 1;
    progress1 = 31;
    progress1_max = 100;
    progress1_t0 = 1.0;
    progress4_tf = 2.0;
    StrCopy(progress2_desc, "Logic");
    if (sys_progresses[0].val != 31 || sys_progresses[0].max != 100 ||
        sys_progresses[0].t0 != 1.0 || sys_progresses[3].tf != 2.0 ||
        StrCompare(sys_progresses[1].desc, "Logic")) return 2;
    ProgressBarsReset;
    for (i = 0; i < sizeof(sys_progresses); i++)
        if (bytes[i]) return 3;
    return 42;
}
