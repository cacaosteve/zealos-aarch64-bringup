// Smoke: DocTermNew installs put/display/border docs for StdOut.
I64 TaskOriginalDocTermChecks()
{
    CDoc *doc;
    CDocEntry *entry;
    I64 saw_cm = FALSE, saw_tx = FALSE;

    KeyDevInit;
    DocTermNew;
    doc = DocPut;
    if (!doc || doc->doc_signature != DOC_SIGNATURE_VAL)
        return 1;
    if (Fs->display_doc != doc)
        return 2;
    if (!Fs->border_doc || Fs->border_doc->doc_signature != DOC_SIGNATURE_VAL)
        return 3;
    if (doc->desc != 'Term')
        return 4;
    if (IsRaw)
        return 5;
    entry = Fs->border_doc->head.next;
    while (entry != Fs->border_doc)
    {
        if (entry->type_u8 == DOCT_CURSOR_MOVEMENT)
            saw_cm = TRUE;
        if (entry->type_u8 == DOCT_TEXT)
            saw_tx = TRUE;
        entry = entry->next;
    }
    if (!saw_cm || !saw_tx)
        return 11;
    if (!KeyDevAdd(&KDDocPutKey, &KDDocPutS, 0x80000000, TRUE))
        return 6;

    DocPrint(doc, "Hi");
    entry = doc->head.next;
    if (entry == doc || entry->type_u8 != DOCT_TEXT)
        return 7;
    if (!entry->tag || entry->tag[0] != 'H' || entry->tag[1] != 'i')
        return 8;

    PutS("!");
    entry = doc->head.next;
    if (!entry->tag)
        return 9;
    if (entry->tag[0] == 'H' && entry->tag[1] == 'i' && entry->tag[2] == '!')
        return 42;
    if (entry->next != doc && entry->next->type_u8 == DOCT_TEXT &&
        entry->next->tag && entry->next->tag[0] == '!')
        return 42;
    return 10;
}
