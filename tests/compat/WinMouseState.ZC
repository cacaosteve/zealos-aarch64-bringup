// TaskBridge supplies the zeroed mouse globals before its input helpers load.
// This probe uses that shared storage without starting the mouse subsystem.
extern CMouseStateGlobals *ZcActiveMouseGlobals();
CTask *sys_winmgr_task;

// The real KeyDev.ZC callback registry is intentionally outside this probe.
U0 CtrlAltCBSet(U8 ch, U0 (*fp_handler)(I64 sc), U8 *no_shift_desc=NULL,
                U8 *shift_desc=NULL, Bool in_irq=FALSE)
{
}

// DrawMenu normally comes from the full menu subsystem, which this focused
// Win.ZC parser probe does not load. WinFinalUpdate is not executed here.
U0 DrawMenu(CDC *dc)
{
}

// GrScaleZoom is defined by GrScreen.ZC later in the source load order.
extern U0 GrScaleZoom(F64 scale);

I64 WinCAllocCheck()
{
    return CAlloc(8) != NULL;
}

I64 WinTimeCheck()
{
    return ZcMonotonicNs() > 0;
}

I64 WinMousePointerStateCheck()
{//The virtual tablet must update transformed ZealOS mouse coordinates.
    I64 old_x = mouse.pos.x, old_y = mouse.pos.y;
    I64 old_text_x = mouse.pos_text.x, old_text_y = mouse.pos_text.y;
    I64 old_timestamp = mouse.timestamp;
    I64 old_offset_x = mouse.offset.x, old_offset_y = mouse.offset.y;
    F64 old_scale_x = mouse.scale.x, old_scale_y = mouse.scale.y;
    Bool old_sampled = bootstrap_mouse_sampled;
    I64 old_buttons = bootstrap_mouse_last_buttons;
    I64 old_last_x = bootstrap_mouse_last_x, old_last_y = bootstrap_mouse_last_y;
    Bool old_installed = mouse_hard.installed;
    I64 raw_x = 100, raw_y = 200;
    I64 x = 200, y = 300;
    Bool active_same;
    Bool ok;

    if (!TaskValidate(sys_task))
        return 1;
    mouse.offset.x = 100;
    mouse.offset.y = 100;
    active_same = ZcActiveMouseGlobals() == &mouse;
    bootstrap_mouse_sampled = FALSE;
    BootstrapCtrlInputSample(sys_task, raw_x | (raw_y << 16));
    ok = active_same && mouse.pos.x == x && mouse.pos.y == y &&
         mouse.pos_text.x == (x - gr.pan_text_x) >> 3 &&
         mouse.pos_text.y == (y - gr.pan_text_y) >> 3 &&
         mouse.timestamp > 0 && mouse_hard.installed;
    mouse.pos.x = old_x;
    mouse.pos.y = old_y;
    mouse.pos_text.x = old_text_x;
    mouse.pos_text.y = old_text_y;
    mouse.timestamp = old_timestamp;
    mouse.offset.x = old_offset_x;
    mouse.offset.y = old_offset_y;
    mouse.scale.x = old_scale_x;
    mouse.scale.y = old_scale_y;
    bootstrap_mouse_sampled = old_sampled;
    bootstrap_mouse_last_buttons = old_buttons;
    bootstrap_mouse_last_x = old_last_x;
    bootstrap_mouse_last_y = old_last_y;
    mouse_hard.installed = old_installed;
    if (ok)
        return 42;
    return 2;
}

F64 WinF64One()
{
    return 1.0;
}

F64 WinF64FromClock()
{
    return ZcMonotonicNs() * 0.000000001;
}

I64 WinF64Check()
{
    return WinF64One > 0;
}

I64 WinF64ClockCheck()
{
    return WinF64FromClock > 0;
}

I64 WinExtTableCheck()
{
    return ext[EXT_WIN_TO_TOP] != NULL && ext[EXT_WIN_FOCUS] != NULL;
}
