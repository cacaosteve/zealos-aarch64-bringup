// TaskBridge supplies the zeroed mouse globals before its input helpers load.
// This probe uses that shared storage without starting the mouse subsystem.
extern CMouseStateGlobals *ZcActiveMouseGlobals();
CTask *sys_winmgr_task;

// The real KeyDev.ZC callback registry is intentionally outside this probe.
U0 CtrlAltCBSet(U8 ch, U0 (*fp_handler)(I64 sc), U8 *no_shift_desc=NULL,
                U8 *shift_desc=NULL, Bool in_irq=FALSE)
{
}

// DrawMenu normally comes from the full menu subsystem, which this focused
// Win.ZC parser probe does not load. WinFinalUpdate is not executed here.
U0 DrawMenu(CDC *dc)
{
}

// GrScaleZoom is defined by GrScreen.ZC later in the source load order.
extern U0 GrScaleZoom(F64 scale);

I64 WinCAllocCheck()
{
    return CAlloc(8) != NULL;
}

I64 WinTimeCheck()
{
    return ZcMonotonicNs() > 0;
}

I64 WinMousePointerStateCheck()
{//The virtual tablet must update transformed ZealOS mouse coordinates.
    I64 old_x = mouse.pos.x, old_y = mouse.pos.y;
    I64 old_text_x = mouse.pos_text.x, old_text_y = mouse.pos_text.y;
    I64 old_timestamp = mouse.timestamp;
    I64 old_offset_x = mouse.offset.x, old_offset_y = mouse.offset.y;
    F64 old_scale_x = mouse.scale.x, old_scale_y = mouse.scale.y;
    Bool old_sampled = bootstrap_mouse_sampled;
    I64 old_buttons = bootstrap_mouse_last_buttons;
    I64 old_last_x = bootstrap_mouse_last_x, old_last_y = bootstrap_mouse_last_y;
    Bool old_installed = mouse_hard.installed;
    I64 raw_x = 100, raw_y = 200;
    I64 x = 200, y = 300;
    Bool active_same;
    Bool ok;

    if (!TaskValidate(sys_task))
        return 1;
    mouse.offset.x = 100;
    mouse.offset.y = 100;
    active_same = ZcActiveMouseGlobals() == &mouse;
    bootstrap_mouse_sampled = FALSE;
    BootstrapCtrlInputSample(sys_task, raw_x | (raw_y << 16));
    ok = active_same && mouse.pos.x == x && mouse.pos.y == y &&
         mouse.pos_text.x == (x - gr.pan_text_x) >> 3 &&
         mouse.pos_text.y == (y - gr.pan_text_y) >> 3 &&
         mouse.timestamp > 0 && mouse_hard.installed;
    mouse.pos.x = old_x;
    mouse.pos.y = old_y;
    mouse.pos_text.x = old_text_x;
    mouse.pos_text.y = old_text_y;
    mouse.timestamp = old_timestamp;
    mouse.offset.x = old_offset_x;
    mouse.offset.y = old_offset_y;
    mouse.scale.x = old_scale_x;
    mouse.scale.y = old_scale_y;
    bootstrap_mouse_sampled = old_sampled;
    bootstrap_mouse_last_buttons = old_buttons;
    bootstrap_mouse_last_x = old_last_x;
    bootstrap_mouse_last_y = old_last_y;
    mouse_hard.installed = old_installed;
    if (ok)
        return 42;
    return 2;
}

I64 WinMouseHardStateCheck()
{//Tablet samples must feed ZealOS's hard-state and MouseUpdate contract.
    I64 old_hard_x = mouse_hard.pos.x, old_hard_y = mouse_hard.pos.y;
    I64 old_hard_z = mouse_hard.pos.z, old_hard_ts = mouse_hard.timestamp;
    Bool old_hard_l = mouse_hard.bttns[0], old_hard_r = mouse_hard.bttns[1];
    Bool old_hard_event = mouse_hard.event;
    Bool old_hard_installed = mouse_hard.installed;
    Bool old_has_wheel = mouse_hard.has_wheel;
    I64 old_x = mouse.pos.x, old_y = mouse.pos.y, old_z = mouse.pos.z;
    I64 old_px = mouse.presnap.x, old_py = mouse.presnap.y;
    I64 old_pz = mouse.presnap.z, old_scan_code = kbd.scan_code;
    I64 old_ox = mouse.offset.x, old_oy = mouse.offset.y;
    I64 old_oz = mouse.offset.z;
    F64 old_sx = mouse.scale.x, old_sy = mouse.scale.y;
    F64 old_sz = mouse.scale.z;
    Bool old_lb = mouse.lb, old_rb = mouse.rb, old_snap = mouse_grid.snap;
    I64 sample = 100 | (200 << 16) | (1 << 32) | (2 << 40);
    I64 fail_code = 0;
    Bool ok;

    mouse.scale.x = 2.0;
    mouse.scale.y = 1.5;
    mouse.scale.z = 1.0;
    mouse.offset.x = 7;
    mouse.offset.y = -4;
    mouse.offset.z = 0;
    mouse_grid.snap = FALSE;
    mouse_hard.pos.z = 0;
    BootstrapMouseHardSample(sample, 1234);
    ok = mouse_hard.pos.x == 100 && mouse_hard.pos.y == 200 &&
         mouse_hard.pos.z == 2 && mouse_hard.bttns[0] &&
         !mouse_hard.bttns[1] && mouse_hard.event &&
         mouse_hard.installed && mouse_hard.has_wheel &&
         mouse_hard.timestamp == 1234;
    if (!ok)
        fail_code = 3;
    MouseUpdate(mouse_hard.pos.x, mouse_hard.pos.y, mouse_hard.pos.z,
                mouse_hard.bttns[0], mouse_hard.bttns[1]);
    if (mouse.presnap.x != 207) fail_code = 5;
    else if (mouse.presnap.y != 296) fail_code = 6;
    else if (mouse.pos.x != 207 || mouse.pos.y != 296) fail_code = 7;
    else if (mouse.pos.z != 2) fail_code = 8;
    else if (!mouse.lb || mouse.rb) fail_code = 9;
    if (!ok && !fail_code)
        fail_code = 4;

    mouse_hard.pos.x = old_hard_x;
    mouse_hard.pos.y = old_hard_y;
    mouse_hard.pos.z = old_hard_z;
    mouse_hard.timestamp = old_hard_ts;
    mouse_hard.bttns[0] = old_hard_l;
    mouse_hard.bttns[1] = old_hard_r;
    mouse_hard.event = old_hard_event;
    mouse_hard.installed = old_hard_installed;
    mouse_hard.has_wheel = old_has_wheel;
    mouse.pos.x = old_x;
    mouse.pos.y = old_y;
    mouse.pos.z = old_z;
    mouse.presnap.x = old_px;
    mouse.presnap.y = old_py;
    mouse.presnap.z = old_pz;
    mouse.offset.x = old_ox;
    mouse.offset.y = old_oy;
    mouse.offset.z = old_oz;
    mouse.scale.x = old_sx;
    mouse.scale.y = old_sy;
    mouse.scale.z = old_sz;
    mouse.lb = old_lb;
    mouse.rb = old_rb;
    mouse_grid.snap = old_snap;
    kbd.scan_code = old_scan_code;
    if (!fail_code)
        return 0x2a;
    return fail_code;
}

F64 WinF64One()
{
    return 1.0;
}

F64 WinF64FromClock()
{
    return ZcMonotonicNs() * 0.000000001;
}

I64 WinF64Check()
{
    return WinF64One > 0;
}

I64 WinF64ClockCheck()
{
    return WinF64FromClock > 0;
}

I64 WinExtTableCheck()
{
    return ext[EXT_WIN_TO_TOP] != NULL && ext[EXT_WIN_FOCUS] != NULL;
}
