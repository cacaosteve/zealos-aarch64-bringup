#include "/System/Math/Types"
#include "/System/Math/Conversion"
#include "/System/Math/F32"

I64 StockConversionChecks()
{
	U32 one_and_half = F64ToF32(1.5);
	if (one_and_half != 0x3FC00000)
		return 1;
	if (F32ToF64(one_and_half) != 1.5)
		return 2;
	if (F64ToF32(-0.5) != 0xBF000000 || F32ToF64(0xBF000000) != -0.5)
		return 3;
	// Preserve the pinned x86 implementation's constants and operation order.
	if (F32RadToDeg(F64ToF32(180.0)) != 0x40490FDB)
		return 4;
	if (Abs(F32ToF64(F32DegToRad(0x40490FDB)) - 180.0) > 0.001)
		return 5;
	if (CosF32(F64ToF32(0.0)) != 0x3F800000)
		return 6;
	if (Abs(F32ToF64(CosF32(F64ToF32(1.57079632679)))) > 0.00001)
		return 7;
	return 42;
}
