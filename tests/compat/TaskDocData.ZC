// Smoke the bridge's DolDoc editable-field format/scan round trip.
I64 TaskSourceFileReadChecks()
{
    I64 size, attr;
    U8 *contents;

    contents = FileRead("disk:Tests/TaskDocData.ZC", &size, &attr);
    if (!contents || size <= 0 || size > 4096)
        return 1;
    if (contents[0] != '/' || contents[1] != '/' || contents[2] != ' ' ||
        contents[3] != 'S' || contents[4] != 'm')
        return 3;
    Free(contents);
    return 42;
}

I64 TaskDocReadChecks()
{
    CDoc *doc;
    U8 *saved;
    I64 size;

    doc = DocRead("disk:Tests/TaskDocData.ZC");
    if (!doc)
        return 1;
    saved = DocSave(doc, &size);
    if (!saved || size < 5 || saved[0] != '/' || saved[1] != '/' ||
        saved[2] != ' ' || saved[3] != 'S' || saved[4] != 'm')
        return 2;
    Free(saved);
    DocDel(doc);
    return 42;
}

I64 TaskDocWriteChecks()
{
    CDoc *doc;
    U8 *saved;
    I64 size;

    doc = DocNew("disk:App/DocWriteCheck.DD");
    if (!doc)
        return 1;
    DocLoad(doc, "persisted doc", 13);
    if (!DocWrite(doc))
        return 2;
    DocDel(doc);
    doc = DocRead("App/DocWriteCheck.DD");
    if (!doc)
        return 3;
    saved = DocSave(doc, &size);
    if (!saved || size != 13 || StrCompare(saved, "persisted doc"))
        return 4;
    Free(saved);
    DocDel(doc);
    return 42;
}

I64 TaskDocDataChecks()
{
    CDoc *doc;
    CDocEntry *entry;
    I64 value = 42;
    I8 checked = 1;

    doc = DocNew;
    if (!doc)
        return 1;
    entry = CAlloc(sizeof(CDocEntry), doc->mem_task);
    entry->type = DOCT_DATA;
    entry->de_flags = DOCEF_AUX_STR | DOCEF_DEREF_DATA;
    entry->raw_type = RT_I64;
    entry->len = 16;
    entry->tag = MAlloc(32, doc->mem_task);
    entry->aux_str = StrNew("%d", doc->mem_task);
    entry->data = &value;
    DocDataFormat(doc, entry);
    if (StrCompare(entry->tag, "42") || entry->max_col != 2)
        return 2;
    StrCopy(entry->tag, "123");
    DocDataScan(doc, entry);
    if (value != 123)
        return 3;

    entry->type = DOCT_CHECK_BOX;
    entry->de_flags = DOCEF_DEREF_DATA;
    entry->raw_type = RT_I8;
    entry->data = &checked;
    DocDataFormat(doc, entry);
    if (!(entry->de_flags & DOCEF_CHECKED_COLLAPSED))
        return 4;
    checked = 0;
    DocDataScan(doc, entry);
    if (!checked)
        return 5;

    Free(entry->aux_str);
    Free(entry->tag);
    Free(entry);
    DocDel(doc);
    return 42;
}

I64 TaskDocPlainSaveChecks()
{
    CDoc *doc, *copy;
    U8 *saved, *saved_copy, *bounded_source;
    I64 size, copy_size;

    doc = DocNew;
    doc->flags |= DOCF_PLAIN_TEXT | DOCF_PLAIN_TEXT_TABS;
    DocPrint(doc, "alpha\t$\nbeta");
    saved = DocSave(doc, &size);
    if (!saved)
        return 1;
    if (size != 12)
        return 2;
    if (StrCompare(saved, "alpha\t$\nbeta"))
        return 3;
    copy = DocNew;
    copy->flags |= DOCF_PLAIN_TEXT | DOCF_PLAIN_TEXT_TABS;
    bounded_source = MAlloc(size, copy->mem_task);
    MemCopy(bounded_source, saved, size);
    DocLoad(copy, bounded_source, size);
    Free(bounded_source);
    saved_copy = DocSave(copy, &copy_size);
    if (!saved_copy || copy_size != size || StrCompare(saved, saved_copy))
        return 4;
    Free(saved_copy);
    Free(saved);
    DocDel(copy);
    DocDel(doc);
    return 42;
}

I64 TaskFileMaskChecks()
{
    if (!FilesFindMatch("/Docs/HELLO.ZC", "*.ZC*;*.HH*"))
        return 1;
    if (!FilesFindMatch("notes.dd", "*.ZC;*.DD"))
        return 2;
    if (!FilesFindMatch("ab.zc", "A?.ZC"))
        return 3;
    if (FilesFindMatch("image.png", "*.ZC*;*.HH*;*.DD*"))
        return 4;
    if (FilesFindMatch("hello.zc", ""))
        return 5;
    return 42;
}
