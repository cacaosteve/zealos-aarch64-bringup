I64 TaskDocReadChecks()
{
    CDoc *doc;
    U8 *saved;
    I64 size;

    doc = DocRead("/Tests/TaskDocData.ZC");
    if (!doc)
        return 1;
    saved = DocSave(doc, &size);
    if (!saved || size < 5 || saved[0] != '/' || saved[1] != '/' ||
        saved[2] != ' ' || saved[3] != 'S' || saved[4] != 'm')
        return 2;
    Free(saved);
    DocDel(doc);
    return 42;
}

I64 TaskDocWriteChecks()
{
    CDoc *doc;
    U8 *saved;
    I64 size;

    doc = DocNew("disk:DocWriteCheck.DD");
    if (!doc)
        return 1;
    DocLoad(doc, "persisted doc", 13);
    if (!DocWrite(doc))
        return 2;
    DocDel(doc);
    doc = DocRead("DocWriteCheck.DD");
    if (!doc)
        return 3;
    saved = DocSave(doc, &size);
    if (!saved || size != 13 || StrCompare(saved, "persisted doc"))
        return 4;
    Free(saved);
    DocDel(doc);
    return 42;
}

I64 TaskDocAbsoluteSourceWriteChecks()
{
    CDoc *doc;
    I64 size;
    U8 *contents;
    U8 *expected = "absolute source edit";

    doc = DocNew("/Tests/DocSourceWriteCheck.DD");
    if (!doc)
        return 1;
    DocLoad(doc, expected, StrLen(expected));
    DocWrite(doc);
    DocDel(doc);
    contents = FileRead("/Tests/DocSourceWriteCheck.DD", &size);
    if (!contents || size != StrLen(expected) || StrCompare(contents, expected))
    {
        if (contents)
            Free(contents);
        return 2;
    }
    Free(contents);
    return 42;
}

I64 TaskFileFindDirectoryFilterChecks()
{
    CDirEntry de;
    U8 *old_cur_dir, *abs_name;
    I64 result = 42;

    if (!FileFind("/Tests/TaskDocData.ZC"))
        return 1;
    if (FileFind("/Tests/TaskDocData.ZC", NULL, FUF_JUST_DIRS) ||
        !FileFind("/Tests/", &de, FUF_JUST_DIRS) ||
        !(de.attr & RS_ATTR_DIR) || de.size ||
        StrCompare(de.name, "Tests") || !de.full_name ||
        StrCompare(de.full_name, "/Tests") ||
        FileFind("/NoSuchDirectory", NULL, FUF_JUST_DIRS))
        return 2;
    if (!FileFind("/Tests/TaskDocData.ZC", NULL, FUF_JUST_SRC))
        return 3;
    if (FileFind("/Tests/DocSourceWriteCheck.DD", NULL, FUF_JUST_SRC))
        return 4;
    if (!FileFind("/LICENSE/Aiwnios.txt", NULL, FUF_JUST_TXT) ||
        !BootstrapFileFindTypeMatch("fixture.TXT", FUF_JUST_TXT) ||
        !FileFind("/Tests/DocSourceWriteCheck.DD", NULL, FUF_JUST_DD) ||
        FileFind("/Tests/TaskDocData.ZC", NULL, FUF_JUST_DD) ||
        FileFind("/Tests/TaskDocData.ZC", NULL, FUF_JUST_AOT) ||
        !BootstrapFileFindTypeMatch("fixture.AOT", FUF_JUST_AOT) ||
        !BootstrapFileFindTypeMatch("fixture.JIT", FUF_JUST_JIT) ||
        !BootstrapFileFindTypeMatch("fixture.GR", FUF_JUST_GR) ||
        !BootstrapFileFindTypeMatch("fixture.ZC",
            FUF_JUST_SRC | FUF_JUST_DD) ||
        BootstrapFileFindTypeMatch("fixture.ZC", FUF_JUST_DD))
        return 6;
    de.name[0] = 'x';
    de.full_name = "stale";
    if (!FileFind("/Tests/TaskDocData.ZC", &de) ||
        StrCompare(de.name, "TaskDocData.ZC") ||
        !de.full_name || StrCompare(de.full_name, "/Tests/TaskDocData.ZC") ||
        de.next || de.parent || de.sub || de.size <= 0 ||
        !(de.attr & RS_ATTR_ARCHIVE))
        return 5;
    old_cur_dir = Fs->cur_dir;
    Fs->cur_dir = StrNew("/LICENSE/subdir");
    if (!FileFind("Aiwnios.txt", &de, FUF_JUST_FILES | FUF_SCAN_PARENTS) ||
        StrCompare(de.name, "Aiwnios.txt") || !de.full_name ||
        StrCompare(de.full_name, "/LICENSE/Aiwnios.txt"))
        result = 7;
    if (result == 42)
    {
        abs_name = FileNameAbs("Aiwnios.txt", FUF_SCAN_PARENTS);
        if (!abs_name || StrCompare(abs_name, "/LICENSE/Aiwnios.txt"))
            result = 8;
        if (abs_name)
            Free(abs_name);
    }
    Free(Fs->cur_dir);
    Fs->cur_dir = old_cur_dir;
    return result;
}

I64 TaskFileFindTombstoneChecks()
{
    CDirEntry *entries, *de, *next;

    if (FileFind("/Tests/CallNOnStack.ZC"))
        return 1;
    entries = FilesFind("CallNOnStack.ZC", FUF_JUST_FILES);
    if (entries)
    {
        for (de = entries; de; de = next)
        {
            next = de->next;
            Free(de->full_name);
            Free(de);
        }
        return 2;
    }
    return 42;
}

I64 TaskFilesFindNativeOverlayChecks()
{
    CDirEntry *entries, *de, *next;
    U8 *old_cur_dir;
    I64 count = 0, found = FALSE;

    old_cur_dir = Fs->cur_dir;
    Fs->cur_dir = StrNew("/Tests");
    entries = FilesFind("CallNOnStack.ZC", FUF_JUST_FILES);
    for (de = entries; de; de = de->next)
    {
        count++;
        if (de->full_name &&
            !StrCompare(de->full_name, "/Tests/CallNOnStack.ZC") &&
            de->size == StrLen("I64 NativeOverlayLoaded(){return 42;}"))
            found = TRUE;
    }
    for (de = entries; de; de = next)
    {
        next = de->next;
        Free(de->full_name);
        Free(de);
    }
    if (!found || count != 1)
    {
        Free(Fs->cur_dir);
        Fs->cur_dir = old_cur_dir;
        return 1;
    }
    entries = FilesFind("FilesFindOverlayOnly.ZC", FUF_JUST_FILES);
    found = entries && entries->full_name &&
        !StrCompare(entries->full_name, "/Tests/FilesFindOverlayOnly.ZC") &&
        entries->size == StrLen("I64 OverlayOnly(){return 42;}") &&
        !entries->next;
    for (de = entries; de; de = next)
    {
        next = de->next;
        Free(de->full_name);
        Free(de);
    }
    Free(Fs->cur_dir);
    Fs->cur_dir = old_cur_dir;
    if (!found)
        return 2;
    return 42;
}

I64 TaskFilesFindChecks()
{
    CDirEntry *entries, *de, *next;
    U8 *old_cur_dir;
    I64 count, found, result = 42;

    old_cur_dir = Fs->cur_dir;
    Fs->cur_dir = StrNew("/Tests");
    entries = FilesFind("*.ZC", FUF_JUST_FILES);
    found = FALSE;
    count = 0;
    for (de = entries; de; de = de->next)
    {
        count++;
        if (de->full_name &&
            !StrCompare(de->full_name, "/Tests/TaskDocData.ZC"))
        {
            if (StrCompare(de->name, "TaskDocData.ZC"))
                result = 7;
            else if (!(de->attr & RS_ATTR_ARCHIVE) || de->size <= 0)
                result = 8;
            else
                found = TRUE;
        }
    }
    if (!found && result == 42)
    {
        if (count)
            result = 9;
        else
            result = 1;
    }
    for (de = entries; de; de = next)
    {
        next = de->next;
        Free(de->full_name);
        Free(de);
    }

    entries = FilesFind("Tests/TaskDocData.ZC",
                        FUF_RECURSE | FUF_JUST_FILES | FUF_SINGLE);
    found = entries && entries->full_name &&
            !StrCompare(entries->full_name, "/Tests/TaskDocData.ZC") &&
            !entries->next;
    if (!found && result == 42)
        result = 6;
    for (de = entries; de; de = next)
    {
        next = de->next;
        Free(de->full_name);
        Free(de);
    }

    Free(Fs->cur_dir);
    Fs->cur_dir = StrNew("/");
    entries = FilesFind("Aiwnios.txt", FUF_RECURSE | FUF_JUST_FILES);
    found = FALSE;
    for (de = entries; de; de = de->next)
        if (de->full_name &&
            !StrCompare(de->full_name, "/LICENSE/Aiwnios.txt"))
            found = TRUE;
    if (!found && result == 42)
        result = 2;
    for (de = entries; de; de = next)
    {
        next = de->next;
        Free(de->full_name);
        Free(de);
    }

    Free(Fs->cur_dir);
    Fs->cur_dir = StrNew("/");
    entries = FilesFind("Tests", FUF_JUST_DIRS | FUF_SINGLE);
    count = 0;
    found = FALSE;
    for (de = entries; de; de = de->next)
    {
        count++;
        if (de->full_name && !StrCompare(de->full_name, "/Tests"))
        {
            if (!(de->attr & RS_ATTR_DIR) || de->size)
                result = 5;
            else
                found = TRUE;
        }
    }
    if (!found && result == 42)
        result = 3;
    if (count != 1 && result == 42)
        result = 4;
    for (de = entries; de; de = next)
    {
        next = de->next;
        Free(de->full_name);
        Free(de);
    }
    Free(Fs->cur_dir);
    Fs->cur_dir = old_cur_dir;
    return result;
}

I64 TaskDocDataChecks()
{
    CDoc *doc;
    CDocEntry *entry;
    I64 value = 42;
    I8 checked = 1;

    doc = DocNew;
    if (!doc)
        return 1;
    entry = CAlloc(sizeof(CDocEntry), doc->mem_task);
    entry->type = DOCT_DATA;
    entry->de_flags = DOCEF_AUX_STR | DOCEF_DEREF_DATA;
    entry->raw_type = RT_I64;
    entry->len = 16;
    entry->tag = MAlloc(32, doc->mem_task);
    entry->aux_str = StrNew("%d", doc->mem_task);
    entry->data = &value;
    DocDataFormat(doc, entry);
    if (StrCompare(entry->tag, "42") || entry->max_col != 2)
        return 2;
    StrCopy(entry->tag, "123");
    DocDataScan(doc, entry);
    if (value != 123)
        return 3;

    entry->type = DOCT_CHECK_BOX;
    entry->de_flags = DOCEF_DEREF_DATA;
    entry->raw_type = RT_I8;
    entry->data = &checked;
    DocDataFormat(doc, entry);
    if (!(entry->de_flags & DOCEF_CHECKED_COLLAPSED))
        return 4;
    checked = 0;
    DocDataScan(doc, entry);
    if (!checked)
        return 5;

    Free(entry->aux_str);
    Free(entry->tag);
    Free(entry);
    DocDel(doc);
    return 42;
}

I64 TaskDocPlainSaveChecks()
{
    CDoc *doc, *copy;
    U8 *saved, *saved_copy, *bounded_source;
    I64 size, copy_size;

    doc = DocNew;
    doc->flags |= DOCF_PLAIN_TEXT | DOCF_PLAIN_TEXT_TABS | DOCF_NO_CURSOR;
    DocPrint(doc, "alpha\t$\nbeta");
    saved = DocSave(doc, &size);
    if (!saved)
        return 1;
    if (size != 12)
        return 2;
    if (StrCompare(saved, "alpha\t$\nbeta"))
        return 3;
    copy = DocNew;
    copy->flags |= DOCF_PLAIN_TEXT | DOCF_PLAIN_TEXT_TABS | DOCF_NO_CURSOR;
    bounded_source = MAlloc(size, copy->mem_task);
    MemCopy(bounded_source, saved, size);
    DocLoad(copy, bounded_source, size);
    Free(bounded_source);
    saved_copy = DocSave(copy, &copy_size);
    if (!saved_copy || copy_size != size || StrCompare(saved, saved_copy))
        return 4;
    Free(saved_copy);
    Free(saved);
    DocDel(copy);
    DocDel(doc);
    return 42;
}

I64 TaskDocFormattedSaveChecks()
{
    CDoc *doc, *copy;
    CDocEntry *entry;
    U8 *saved, *saved_copy, *plain;
    I64 size, copy_size, expected_red = -1;
    Bool saw_red = FALSE;

    doc = DocNew;
    doc->flags |= DOCF_NO_CURSOR;
    DocPutS(doc, "plain $FG,RED$red text$FG,WHITE$ normal");
    for (entry = doc->head.next; entry != doc; entry = entry->next)
        if (entry->type_u8 == DOCT_FOREGROUND)
        {
            if (expected_red < 0)
                expected_red = entry->attr;
            plain = Doc2PlainText(doc, entry);
            if (!plain)
                return 4;
            Free(plain);
            break;
        }
    DocBinsValidate(doc);
    saved = DocSave(doc, &size);
    if (!saved || size <= 0)
        return 1;
    copy = DocNew;
    copy->flags |= DOCF_NO_CURSOR;
    DocLoad(copy, saved, size);
    for (entry = copy->head.next; entry != copy; entry = entry->next)
        if (entry->type_u8 == DOCT_FOREGROUND)
            if (entry->attr == expected_red)
                saw_red = TRUE;
    if (!saw_red)
        return 2;
    saved_copy = DocSave(copy, &copy_size);
    if (!saved_copy || size != copy_size || StrCompare(saved, saved_copy))
        return 3;
    Free(saved_copy);
    Free(saved);
    DocDel(copy);
    DocDel(doc);
    return 42;
}

I64 TaskFileMaskChecks()
{
    if (!FilesFindMatch("/Docs/HELLO.ZC", "*.ZC*;*.HH*"))
        return 1;
    if (!FilesFindMatch("notes.dd", "*.ZC;*.DD"))
        return 2;
    if (!FilesFindMatch("ab.zc", "A?.ZC"))
        return 3;
    if (FilesFindMatch("image.png", "*.ZC*;*.HH*;*.DD*"))
        return 4;
    if (FilesFindMatch("hello.zc", ""))
        return 5;
    return 42;
}
