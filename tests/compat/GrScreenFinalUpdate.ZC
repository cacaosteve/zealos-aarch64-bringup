// Verify that the bootstrap WinMgr tick runs the optional screen overlay
// after composing task windows, with screen-space CDC state.
extern I64 bootstrap_gr_text_updates;
extern I64 bootstrap_gr_screen_updates;
I64 gr_screen_final_update_calls;
U8 gr_screen_final_update_old_pixel;
U8 gr_screen_final_update_overlay_off[FONT_WIDTH * 10 * FONT_HEIGHT];
U32 gr_screen_cursor_off[13 * 13];

U0 GrScreenNoCursorProbe(CDC *dc)
{
}

U0 GrScreenCursorProbe(CDC *dc)
{
    BootstrapDrawMouse(dc, 123, 234);
}

U0 GrScreenFinalUpdateProbe(CDC *dc)
{
    gr_screen_final_update_calls++;
    if (!dc || !dc->body || dc->width_internal != 800 || dc->height != 600)
        return;
    dc->body[599 * 800 + 799] = 15;
}

I64 GrScreenFinalUpdateChecks()
{
    U0 (*old_final_update)(CDC *dc);
    CTask *paint_task;
    I64 old_coord, old_mouse_x, old_mouse_y, old_draw_calls;
    I64 old_text_updates, old_screen_updates, old_window_updates;
    I64 old_window_display_flags;
    I64 x, y, i, overlay_x, overlay_y, changed;
    U32 *screen;
    I64 pitch;
    Bool old_mouse_show, old_mouse_installed;

    if (!TaskValidate(sys_winmgr_task) && !TaskValidate(sys_task))
        return 3;
    old_final_update = gr.fp_final_screen_update;
    if (!old_final_update)
        return 8;
    // Win.ZC's file-scope initializer installs WinFinalUpdate in the later
    // graphics global. Exercise that real callback once before substituting
    // the pixel probe below. This also checks that its current no-menu,
    // no-progress, no-cursor state can run against the bridge CDC.
    BootstrapWinMgrTick();
    gr_screen_final_update_old_pixel = bootstrap_graphics_pixels[599 * 800 + 799];
    gr_screen_final_update_calls = 0;
    gr.fp_final_screen_update = &GrScreenFinalUpdateProbe;
    if (gr.fp_final_screen_update != &GrScreenFinalUpdateProbe)
        return 4;
    BootstrapWinMgrTick();
    gr.fp_final_screen_update = old_final_update;

    if (gr_screen_final_update_calls != 1)
        return 1;
    if (bootstrap_graphics_pixels[599 * 800 + 799] != 15)
        return 2;
    bootstrap_graphics_pixels[599 * 800 + 799] = gr_screen_final_update_old_pixel;

    // Direct zcall has no staged framebuffer transaction. Render both states
    // through the idle compositor's frame wrapper and verify the actual
    // WinFinalUpdate coordinate text changes the composed pixels.
    old_coord = mouse_grid.coord;
    old_mouse_x = mouse.pos.x;
    old_mouse_y = mouse.pos.y;
    screen = sys_framebuffer_addr;
    pitch = sys_framebuffer_pitch / 4;
    if (!screen || sys_framebuffer_bpp != 32 || pitch < 800)
        return 13;
    overlay_x = GR_WIDTH - FONT_WIDTH * 10;
    overlay_y = FONT_HEIGHT * 3;
    mouse.pos.x = 123;
    mouse.pos.y = 234;
    mouse_grid.coord = FALSE;
    paint_task = sys_winmgr_task;
    if (!TaskValidate(paint_task))
        paint_task = sys_task;
    if (!TaskValidate(paint_task))
        return 17;
    old_window_display_flags = paint_task->display_flags;
    paint_task->display_flags |= 1 << DISPLAYf_SHOW;
    old_text_updates = bootstrap_gr_text_updates;
    old_screen_updates = bootstrap_gr_screen_updates;
    old_window_updates = bootstrap_upstream_window_updates;
    if (!ZcTaskFrameRun())
    {
        paint_task->display_flags = old_window_display_flags;
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 5;
    }
    paint_task->display_flags = old_window_display_flags;
    if (bootstrap_upstream_window_updates <= old_window_updates)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 18;
    }
    if (bootstrap_gr_text_updates != old_text_updates + 1)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 15;
    }
    if (bootstrap_gr_screen_updates != old_screen_updates + 1)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 16;
    }
    for (y = 0, i = 0; y < FONT_HEIGHT; y++)
        for (x = 0; x < FONT_WIDTH * 10; x++, i++)
            gr_screen_final_update_overlay_off[i] =
                bootstrap_graphics_pixels[(overlay_y + y) * 800 + overlay_x + x];
    mouse_grid.coord = TRUE;
    if (!ZcTaskFrameRun())
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 6;
    }
    for (y = 0, i = 0; y < FONT_HEIGHT; y++)
        for (x = 0; x < FONT_WIDTH * 10; x++, i++)
            if (gr_screen_final_update_overlay_off[i] !=
                bootstrap_graphics_pixels[(overlay_y + y) * 800 + overlay_x + x])
            {
                mouse_grid.coord = old_coord;
                mouse.pos.x = old_mouse_x;
                mouse.pos.y = old_mouse_y;
                return 7;
            }
    mouse_grid.coord = old_coord;
    mouse.pos.x = old_mouse_x;
    mouse.pos.y = old_mouse_y;

    // Check the unchanged Win callback invokes our virtual mouse renderer.
    old_mouse_show = mouse.show;
    old_mouse_installed = mouse_hard.installed;
    mouse_hard.installed = TRUE;
    mouse.show = TRUE;
    old_draw_calls = bootstrap_mouse_draw_calls;
    if (!ZcTaskFrameRun())
    {
        mouse.show = old_mouse_show;
        mouse_hard.installed = old_mouse_installed;
        return 8;
    }
    if (bootstrap_mouse_draw_calls == old_draw_calls)
    {
        mouse.show = old_mouse_show;
        mouse_hard.installed = old_mouse_installed;
        return 14;
    }
    mouse.show = old_mouse_show;
    mouse_hard.installed = old_mouse_installed;

    // Isolate this fixed-position draw from live tablet polling and verify
    // pixels on the Limine framebuffer after the staged frame is presented.
    gr.fp_final_screen_update = &GrScreenNoCursorProbe;
    if (!ZcTaskFrameRun())
    {
        gr.fp_final_screen_update = old_final_update;
        return 8;
    }
    for (y = 0, i = 0; y < 13; y++)
        for (x = 0; x < 13; x++, i++)
            gr_screen_cursor_off[i] =
                screen[(234 + y) * pitch + 123 + x];
    gr.fp_final_screen_update = &GrScreenCursorProbe;
    if (!ZcTaskFrameRun())
    {
        gr.fp_final_screen_update = old_final_update;
        return 9;
    }
    changed = 0;
    for (y = 0, i = 0; y < 13; y++)
        for (x = 0; x < 13; x++, i++)
            if (gr_screen_cursor_off[i] !=
                screen[(234 + y) * pitch + 123 + x])
                changed++;
    gr.fp_final_screen_update = old_final_update;
    if (changed < 20)
    {
        return 100 + changed;
    }
    ZcTaskFrameRun();
    return 42;
}
