// Verify that the bootstrap WinMgr tick runs the optional screen overlay
// after composing task windows, with screen-space CDC state.
extern I64 bootstrap_gr_text_updates;
extern I64 bootstrap_gr_screen_updates;
extern I64 bootstrap_gr_planar_updates;
extern I64 bootstrap_upstream_ode_updates;
extern I64 bootstrap_upstream_gr_update_tasks;
extern I64 bootstrap_upstream_gr_update_screen;
extern U16 bootstrap_win_z_buf[TEXT_COLS * TEXT_ROWS];
extern U16 bootstrap_win_uncovered[(BOOTSTRAP_WIN_MAX + 16) / 16];
extern CDC bootstrap_graphics_dc, bootstrap_planar_dc;
extern CDC bootstrap_planar_cache_dc, bootstrap_zoom_dc;
extern U32 bootstrap_text_base[TEXT_COLS * TEXT_ROWS];
extern U8 bootstrap_present_cache[800 * 600];
extern U64 bootstrap_text_bits[256], bootstrap_text_colors[16];
extern Bool bootstrap_present_cache_ready, bootstrap_present_ready;
extern U0 BootstrapGrContextInit();
extern Bool BootstrapCanUseUpstreamGrUpdateTasks();
extern Bool BootstrapWinIsUncovered(CTask *task);
extern Bool ZcWinMouseUpdate();
extern CWinMgrGlobals *ZcActiveWinMgrGlobals();
extern U0 WinCalcIdles();
extern I64 gr_screen_ode_update_calls;
extern Bool gr_screen_ode_root_seen;
I64 gr_screen_final_update_calls;
U8 gr_screen_final_update_old_pixel;
U8 gr_screen_final_update_overlay_off[FONT_WIDTH * 10 * FONT_HEIGHT];
U32 gr_screen_cursor_off[13 * 13];

I64 GrScreenVisibleWindowCount()
{//Count app windows only; sys_task and WinMgr are frame infrastructure.
    CTask *root = sys_winmgr_task, *task;
    I64 count = 0, visited = 0;
    if (!TaskValidate(root))
        root = sys_task;
    if (!TaskValidate(root))
        return 0;
    task = root;
    do
    {
        if (!TaskValidate(task))
            break;
        if (task != sys_task && task != sys_winmgr_task &&
            (task->display_flags & (1 << DISPLAYf_SHOW)) &&
            BootstrapWinIsUncovered(task))
            count++;
        task = task->next_task;
        visited++;
    }
    while (task && task != root && visited < 64);
    return count;
}

U0 GrScreenNoCursorProbe(CDC *dc)
{
}

U0 GrScreenCursorProbe(CDC *dc)
{
    BootstrapDrawMouse(dc, 123, 234);
}

U0 GrScreenFinalUpdateProbe(CDC *dc)
{
    gr_screen_final_update_calls++;
    if (!dc || !dc->body || dc->width_internal != 800 || dc->height != 600)
        return;
    dc->body[599 * 800 + 799] = 15;
}

I64 GrScreenZoomTransformChecks()
{//GrScaleZoom must preserve the pointer through mouse scale/offset updates.
    I64 old_zoom = gr.screen_zoom, old_sx = gr.sx, old_sy = gr.sy;
    I64 old_x = mouse.pos.x, old_y = mouse.pos.y, old_z = mouse.pos.z;
    I64 old_ox = mouse.offset.x, old_oy = mouse.offset.y, old_oz = mouse.offset.z;
    F64 old_scale_x = mouse.scale.x, old_scale_y = mouse.scale.y;
    F64 old_scale_z = mouse.scale.z;
    Bool ok;

    mouse.scale.x = 0.5;
    if (mouse.scale.x != 0.5)
        return 1;
    mouse.scale.x = old_scale_x;

    gr.screen_zoom = 2;
    gr.sx = gr.sy = 0;
    mouse.pos.x = 400;
    mouse.pos.y = 300;
    mouse.pos.z = 10;
    mouse.offset.x = 20;
    mouse.offset.y = 40;
    mouse.offset.z = 4;
    mouse.scale.x = mouse.scale.y = mouse.scale.z = 1.0;
    GrScaleZoom(2.0);
    ok = gr.screen_zoom == 4 && mouse.scale.x == 0.5 &&
         mouse.scale.y == 0.5 && mouse.scale.z == 0.5 &&
         mouse.offset.x == 210 && mouse.offset.y == 170 &&
         mouse.offset.z == 7;

    gr.screen_zoom = old_zoom;
    gr.sx = old_sx;
    gr.sy = old_sy;
    mouse.pos.x = old_x;
    mouse.pos.y = old_y;
    mouse.pos.z = old_z;
    mouse.offset.x = old_ox;
    mouse.offset.y = old_oy;
    mouse.offset.z = old_oz;
    mouse.scale.x = old_scale_x;
    mouse.scale.y = old_scale_y;
    mouse.scale.z = old_scale_z;
    if (ok)
        return 0x2a;
    return 0;
}

I64 GrScreenMouseEdgeChecks()
{//The unchanged WinMouseUpdate recenters a zoomed view at pointer edges.
    I64 old_zoom = gr.screen_zoom, old_sx = gr.sx, old_sy = gr.sy;
    I64 old_ox = mouse.offset.x, old_oy = mouse.offset.y, old_oz = mouse.offset.z;
    F64 old_scale_x = mouse.scale.x, old_scale_y = mouse.scale.y;
    F64 old_scale_z = mouse.scale.z, old_speed = mouse.speed;
    Bool old_has_wheel = mouse.has_wheel;
    Bool old_installed = mouse_hard.installed;
    Bool old_event = mouse_hard.event, old_hard_wheel = mouse_hard.has_wheel;
    Bool ok;

    gr.screen_zoom = 2;
    gr.sx = gr.sy = 0;
    mouse.pos.x = 796;
    mouse.pos.y = 300;
    mouse.speed = 1.0;
    mouse_hard.installed = TRUE;
    mouse_hard.event = FALSE;
    mouse_hard.has_wheel = TRUE;
    ok = ZcWinMouseUpdate() && gr.sx == 400 &&
         mouse.speed < 1.0 && mouse.speed > 0.9 && mouse.has_wheel;

    gr.screen_zoom = old_zoom;
    gr.sx = old_sx;
    gr.sy = old_sy;
    mouse.offset.x = old_ox;
    mouse.offset.y = old_oy;
    mouse.offset.z = old_oz;
    mouse.scale.x = old_scale_x;
    mouse.scale.y = old_scale_y;
    mouse.scale.z = old_scale_z;
    mouse.speed = old_speed;
    mouse.has_wheel = old_has_wheel;
    mouse_hard.installed = old_installed;
    mouse_hard.event = old_event;
    mouse_hard.has_wheel = old_hard_wheel;
    if (ok)
        return 0x2a;
    return 0;
}

I64 WinMgrTimingSourceChecks()
{//Run the unchanged idle calculator against seeded source timing state.
    CWinMgrGlobals *active_winmgr = ZcActiveWinMgrGlobals();
    CWinMgrTimingGlobals *timing;
    I64 old_last_total, old_last_idle, old_count;
    F64 old_last_calc, old_delta, old_idle_factor;
    Bool ok;
    if (!active_winmgr || !active_winmgr->t || !cpu_structs || mp_count != 1)
        return 0;
    timing = active_winmgr->t;
    old_last_total = timing->last_total_jiffies;
    old_last_idle = timing->last_idle_pt_hits[0];
    old_count = timing->calc_idle_count;
    old_last_calc = timing->last_calc_idle_time;
    old_delta = timing->calc_idle_delta_time;
    old_idle_factor = cpu_structs[0].idle_factor;

    timing->last_total_jiffies = cpu_structs[0].total_jiffies - 1;
    timing->last_idle_pt_hits[0] = cpu_structs[0].idle_pt_hits - 1;
    timing->last_calc_idle_time = tS - 10.0;
    WinCalcIdles();
    ok = timing->calc_idle_count == old_count + 1 &&
         timing->calc_idle_delta_time > 0.25 &&
         timing->last_total_jiffies == cpu_structs[0].total_jiffies &&
         timing->last_idle_pt_hits[0] == cpu_structs[0].idle_pt_hits &&
         cpu_structs[0].idle_factor > 0.9;

    timing->last_total_jiffies = old_last_total;
    timing->last_idle_pt_hits[0] = old_last_idle;
    timing->calc_idle_count = old_count;
    timing->last_calc_idle_time = old_last_calc;
    timing->calc_idle_delta_time = old_delta;
    cpu_structs[0].idle_factor = old_idle_factor;
    if (ok)
        return 0x2a;
    return 0;
}

I64 WinMgrSleepSourcePassChecks()
{
    CWinMgrGlobals *active_winmgr;
    CWinMgrTimingGlobals *timing;
    CTask *old_focus, *root_task;
    I64 old_jiffies, old_last_total, old_last_idle, old_count;
    U32 old_root_task_flags;
    F64 old_last_calc, old_delta, old_idle_factor;
    F64 old_fps, old_refresh, old_ideal, old_mouse_speed, old_zoom;
    Bool old_pump, old_refreshing;
    Bool ok;

    active_winmgr = ZcActiveWinMgrGlobals();
    if (!active_winmgr || !active_winmgr->t || !cpu_structs || mp_count != 1)
        return 0;
    timing = active_winmgr->t;
    old_jiffies = counts.jiffies;
    old_last_total = timing->last_total_jiffies;
    old_last_idle = timing->last_idle_pt_hits[0];
    old_count = timing->calc_idle_count;
    old_last_calc = timing->last_calc_idle_time;
    old_delta = timing->calc_idle_delta_time;
    old_idle_factor = cpu_structs[0].idle_factor;
    old_fps = active_winmgr->fps;
    old_refresh = active_winmgr->last_refresh_tS;
    old_ideal = active_winmgr->ideal_refresh_tS;
    old_mouse_speed = mouse.speed;
    old_zoom = gr.screen_zoom;
    old_pump = Bt(&sys_semas[SEMA_JUST_PUMP_MESSAGES], 0);
    old_refreshing = Bt(&sys_semas[SEMA_REFRESH_IN_PROGRESS], 0);
    old_focus = sys_focus_task;
    root_task = Fs;
    old_root_task_flags = root_task->task_flags;

    // Keep this pre-init source WinMgrSleep pass bounded: the flush path
    // exercises time, idle, FIFO flush, and source WinMouseUpdate without
    // entering the keyboard queue or full graphics refresh before those
    // subsystems have completed ZealOS initialization.
    gr.screen_zoom = 1;
    sys_focus_task = root_task;
    LBts(&sys_semas[SEMA_JUST_PUMP_MESSAGES], 0);
    WinMgrSleep(TRUE);
    ok = active_winmgr->fps >= 1 && timing->calc_idle_count >= old_count;

    root_task->task_flags = old_root_task_flags;
    sys_focus_task = old_focus;
    if (old_pump)
        LBts(&sys_semas[SEMA_JUST_PUMP_MESSAGES], 0);
    else
        LBtr(&sys_semas[SEMA_JUST_PUMP_MESSAGES], 0);
    if (old_refreshing)
        LBts(&sys_semas[SEMA_REFRESH_IN_PROGRESS], 0);
    else
        LBtr(&sys_semas[SEMA_REFRESH_IN_PROGRESS], 0);
    counts.jiffies = old_jiffies;
    timing->last_total_jiffies = old_last_total;
    timing->last_idle_pt_hits[0] = old_last_idle;
    timing->calc_idle_count = old_count;
    timing->last_calc_idle_time = old_last_calc;
    timing->calc_idle_delta_time = old_delta;
    cpu_structs[0].idle_factor = old_idle_factor;
    active_winmgr->fps = old_fps;
    active_winmgr->last_refresh_tS = old_refresh;
    active_winmgr->ideal_refresh_tS = old_ideal;
    mouse.speed = old_mouse_speed;
    gr.screen_zoom = old_zoom;
    if (ok)
        return 0x2a;
    return 0;
}

I64 GrSetUpTablesSourceChecks()
{
    CGrGlobals *active_gr = ZcActiveGrGlobals();
    Bool ok;

    if (!active_gr)
        return 0;
    bootstrap_win_z_buf[0] = 0x5a5a;
    bootstrap_win_z_buf[TEXT_COLS * TEXT_ROWS - 1] = 0x5a5a;
    bootstrap_win_uncovered[0] = 0xffff;
    bootstrap_win_uncovered_cells[0] = 1;
    active_gr->highest_uncovered = 1;
    GrSetUpTables();
    ok = active_gr->win_z_buf == bootstrap_win_z_buf &&
         active_gr->win_uncovered_bitmap == bootstrap_win_uncovered &&
         active_gr->highest_uncovered == 0 &&
         bootstrap_win_z_buf[0] == 0 &&
         bootstrap_win_z_buf[TEXT_COLS * TEXT_ROWS - 1] == 0 &&
         bootstrap_win_uncovered[0] == 0 &&
         bootstrap_win_uncovered_cells[0] == 0;
    // Rebuild the state from the current task ring as WinMgrTask does after
    // GrSetUpTables, so later compositor checks see normal window visibility.
    WinZBufUpdate();
    if (ok)
        return 0x2a;
    return 0;
}

I64 BootstrapGrContextInitChecks()
{//A source manager must see its full bounded display context before first draw.
    CGrGlobals *active_gr = ZcActiveGrGlobals();

    if (!active_gr)
        return 1;
    active_gr->screen_image = active_gr->dc = active_gr->dc1 = NULL;
    active_gr->dc2 = active_gr->dc_cache = active_gr->zoomed_dc = NULL;
    active_gr->text_base = NULL;
    active_gr->screen_cache = NULL;
    active_gr->to_8_bits = active_gr->to_8_colors = NULL;
    active_gr->win_z_buf = NULL;
    active_gr->win_uncovered_bitmap = NULL;
    active_gr->screen_zoom = 0;
    bootstrap_present_cache[0] = 0;
    bootstrap_present_cache_ready = FALSE;
    bootstrap_present_ready = FALSE;
    BootstrapGrContextInit();
    if (active_gr->screen_image != &bootstrap_graphics_dc ||
        active_gr->dc != &bootstrap_graphics_dc ||
        active_gr->dc1 != &bootstrap_planar_dc ||
        active_gr->dc2 != &bootstrap_graphics_dc ||
        active_gr->dc_cache != &bootstrap_planar_cache_dc ||
        active_gr->zoomed_dc != &bootstrap_zoom_dc ||
        active_gr->text_base != bootstrap_text_base ||
        active_gr->screen_cache != bootstrap_present_cache ||
        active_gr->to_8_bits != bootstrap_text_bits ||
        active_gr->to_8_colors != bootstrap_text_colors ||
        active_gr->win_z_buf != bootstrap_win_z_buf ||
        active_gr->win_uncovered_bitmap != bootstrap_win_uncovered ||
        active_gr->screen_zoom != 1 ||
        !bootstrap_present_cache_ready || !bootstrap_present_ready ||
        bootstrap_present_cache[0] != 0xFF ||
        !active_gr->dc->body ||
        active_gr->dc->dc_signature != DCS_SIGNATURE_VAL ||
        active_gr->dc1->dc_signature != DCS_SIGNATURE_VAL ||
        active_gr->dc_cache->dc_signature != DCS_SIGNATURE_VAL ||
        active_gr->zoomed_dc->dc_signature != DCS_SIGNATURE_VAL)
        return 0;
    return 0x2a;
}

I64 WinInsideBridgeChecks()
{//Match the unchanged Kernel/Display.ZC boundary and border rules.
    CTask *task = Fs;
    I64 old_flags, old_left, old_right, old_top, old_bottom, result = 0;

    if (!TaskValidate(task))
        return 1;
    old_flags = task->display_flags;
    old_left = task->pix_left;
    old_right = task->pix_right;
    old_top = task->pix_top;
    old_bottom = task->pix_bottom;
    task->display_flags |= 1 << DISPLAYf_SHOW;
    task->display_flags &= ~(1 << DISPLAYf_NO_BORDER);
    task->pix_left = 100;
    task->pix_right = 199;
    task->pix_top = 200;
    task->pix_bottom = 299;
    if (!WinInside(100, 200, task) || !WinInside(199, 299, task))
        result = 2;
    else if (WinInside(99, 200, task) ||
             !WinInside(99, 200, task, FONT_WIDTH))
        result = 3;
    task->display_flags |= 1 << DISPLAYf_NO_BORDER;
    if (!result && WinInside(99, 200, task, FONT_WIDTH))
        result = 4;
    task->display_flags &= ~(1 << DISPLAYf_SHOW);
    if (!result && WinInside(100, 200, task))
        result = 5;
    task->display_flags = old_flags;
    task->pix_left = old_left;
    task->pix_right = old_right;
    task->pix_top = old_top;
    task->pix_bottom = old_bottom;
    if (result)
        return result;
    return 0x2a;
}

I64 TaskDerivedValsUpdateChecks()
{//The graphics bridge exposes the unchanged kernel derived-window contract.
    CTask *task = Fs;
    I64 old_win_width = task->win_width, old_win_height = task->win_height;
    I64 old_pix_left = task->pix_left, old_pix_right = task->pix_right;
    I64 old_pix_top = task->pix_top, old_pix_bottom = task->pix_bottom;
    I64 old_pix_width = task->pix_width, old_pix_height = task->pix_height;
    Bool ok;

    task->win_width = task->win_height = -1;
    task->pix_left = task->pix_right = task->pix_top = task->pix_bottom = -1;
    task->pix_width = task->pix_height = -1;
    TaskDerivedValsUpdate(task, FALSE);
    ok = task->win_width == task->win_right - task->win_left + 1 &&
         task->win_height == task->win_bottom - task->win_top + 1 &&
         task->pix_left == FONT_WIDTH * task->win_left &&
         task->pix_right == FONT_WIDTH * (task->win_right + 1) - 1 &&
         task->pix_top == FONT_HEIGHT * task->win_top &&
         task->pix_bottom == FONT_HEIGHT * (task->win_bottom + 1) - 1 &&
         task->pix_width == task->pix_right - task->pix_left + 1 &&
         task->pix_height == task->pix_bottom - task->pix_top + 1;

    task->win_width = old_win_width;
    task->win_height = old_win_height;
    task->pix_left = old_pix_left;
    task->pix_right = old_pix_right;
    task->pix_top = old_pix_top;
    task->pix_bottom = old_pix_bottom;
    task->pix_width = old_pix_width;
    task->pix_height = old_pix_height;
    if (ok)
        return 0x2a;
    return 0;
}

I64 GrScreenFinalUpdateChecks()
{
    U0 (*old_final_update)(CDC *dc);
    CTask *paint_task;
    CGrGlobals *frame_gr;
    CWinMgrGlobals *frame_winmgr;
    I64 old_coord, old_mouse_x, old_mouse_y, old_draw_calls;
    I64 old_text_updates, old_screen_updates, old_planar_updates;
    I64 old_window_updates, old_ode_updates;
    I64 old_source_task_updates;
    I64 old_source_screen_updates;
    I64 sleep_source_result;
    Bool source_task_frame_ready;
    I64 old_window_display_flags;
    I64 old_screen_zoom, old_screen_sx, old_screen_sy;
    I64 x, y, i, overlay_x, overlay_y, changed;
    U32 *screen;
    I64 pitch;
    Bool old_mouse_show, old_mouse_installed;

    if (!TaskValidate(sys_winmgr_task) && !TaskValidate(sys_task))
        return 3;
    old_final_update = gr.fp_final_screen_update;
    if (!old_final_update)
        return 8;
    // Check the source WinMgr sleep/refresh path before the zoom transform.
    if (WinMgrSleepSourcePassChecks() != 0x2a)
        return 33;
    if (BootstrapGrContextInitChecks() != 0x2a)
        return 36;
    if (WinInsideBridgeChecks() != 0x2a)
        return 37;
    if (TaskDerivedValsUpdateChecks() != 0x2a)
        return 35;
    sleep_source_result = GrScreenZoomTransformChecks();
    if (sleep_source_result != 0x2a)
        return 30 + sleep_source_result;
    if (GrScreenMouseEdgeChecks() != 0x2a)
        return 31;
    // Win.ZC's file-scope initializer installs WinFinalUpdate in the later
    // graphics global. Exercise that real callback once before substituting
    // the pixel probe below. This also checks that its current no-menu,
    // no-progress, no-cursor state can run against the bridge CDC.
    BootstrapWinMgrTick();
    if (WinMgrTimingSourceChecks() != 0x2a)
        return 32;
    if (GrSetUpTablesSourceChecks() != 0x2a)
        return 34;
    gr_screen_final_update_old_pixel = bootstrap_graphics_pixels[599 * 800 + 799];
    gr_screen_final_update_calls = 0;
    gr.fp_final_screen_update = &GrScreenFinalUpdateProbe;
    if (gr.fp_final_screen_update != &GrScreenFinalUpdateProbe)
        return 4;
    BootstrapWinMgrTick();
    gr.fp_final_screen_update = old_final_update;

    if (gr_screen_final_update_calls != 1)
        return 1;
    if (bootstrap_graphics_pixels[599 * 800 + 799] != 15)
        return 2;
    bootstrap_graphics_pixels[599 * 800 + 799] = gr_screen_final_update_old_pixel;

    // Direct zcall has no staged framebuffer transaction. Render both states
    // through the idle compositor's frame wrapper and verify the actual
    // WinFinalUpdate coordinate text changes the composed pixels.
    old_coord = mouse_grid.coord;
    old_mouse_x = mouse.pos.x;
    old_mouse_y = mouse.pos.y;
    screen = sys_framebuffer_addr;
    pitch = sys_framebuffer_pitch / 4;
    if (!screen || sys_framebuffer_bpp != 32 || pitch < 800)
        return 13;
    overlay_x = GR_WIDTH - FONT_WIDTH * 10;
    overlay_y = FONT_HEIGHT * 3;
    mouse.pos.x = 123;
    mouse.pos.y = 234;
    mouse_grid.coord = FALSE;
    paint_task = sys_winmgr_task;
    if (!TaskValidate(paint_task))
        paint_task = sys_task;
    if (!TaskValidate(paint_task))
        return 17;
    old_window_display_flags = paint_task->display_flags;
    paint_task->display_flags |= 1 << DISPLAYf_SHOW;
    old_text_updates = bootstrap_gr_text_updates;
    old_screen_updates = bootstrap_gr_screen_updates;
    old_planar_updates = bootstrap_gr_planar_updates;
    old_window_updates = bootstrap_upstream_window_updates;
    old_ode_updates = bootstrap_upstream_ode_updates;
    old_source_task_updates = bootstrap_upstream_gr_update_tasks;
    old_source_screen_updates = bootstrap_upstream_gr_update_screen;
    source_task_frame_ready = BootstrapCanUseUpstreamGrUpdateTasks();
    if (!ZcTaskFrameRun())
    {
        paint_task->display_flags = old_window_display_flags;
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 5;
    }
    paint_task->display_flags = old_window_display_flags;
    if (bootstrap_upstream_window_updates <= old_window_updates)
    {
        // This graphics-only probe may run with no user windows in the task
        // ring. The shell and manager are intentionally excluded from the
        // compositor's application-window count; require an increment only
        // when a visible application window is actually present.
        if (GrScreenVisibleWindowCount())
        {
            mouse_grid.coord = old_coord;
            mouse.pos.x = old_mouse_x;
            mouse.pos.y = old_mouse_y;
            return 18;
        }
    }
    if (bootstrap_upstream_ode_updates <= old_ode_updates)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 19;
    }
    if (source_task_frame_ready &&
        bootstrap_upstream_gr_update_tasks <= old_source_task_updates)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 25;
    }
    if (source_task_frame_ready &&
        bootstrap_upstream_gr_update_screen <= old_source_screen_updates)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 26;
    }
    if (!gr_screen_ode_update_calls || !gr_screen_ode_root_seen)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 20;
    }
    if (bootstrap_gr_text_updates != old_text_updates + 1)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 15;
    }
    if (bootstrap_gr_screen_updates != old_screen_updates + 1)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 16;
    }
    if (bootstrap_gr_planar_updates != old_planar_updates + 1)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 21;
    }
    frame_gr = ZcActiveGrGlobals();
    frame_winmgr = ZcActiveWinMgrGlobals();
    if (!frame_gr || !frame_gr->dc1 || !frame_gr->dc1->body ||
        !frame_gr->dc_cache || !frame_gr->dc_cache->body ||
        !frame_winmgr || !frame_winmgr->t || frame_winmgr->fps <= 0 ||
        frame_gr->win_z_buf != bootstrap_win_z_buf ||
        frame_gr->win_uncovered_bitmap != bootstrap_win_uncovered ||
        frame_gr->dc_cache->body(I64 *)[0] !=
            *(frame_gr->dc2->body(I64 *)))
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 22;
    }
    for (y = 0, i = 0; y < FONT_HEIGHT; y++)
        for (x = 0; x < FONT_WIDTH * 10; x++, i++)
            gr_screen_final_update_overlay_off[i] =
                bootstrap_graphics_pixels[(overlay_y + y) * 800 + overlay_x + x];
    mouse_grid.coord = TRUE;
    if (!ZcTaskFrameRun())
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 6;
    }
    for (y = 0, i = 0; y < FONT_HEIGHT; y++)
        for (x = 0; x < FONT_WIDTH * 10; x++, i++)
            if (gr_screen_final_update_overlay_off[i] !=
                bootstrap_graphics_pixels[(overlay_y + y) * 800 + overlay_x + x])
            {
                mouse_grid.coord = old_coord;
                mouse.pos.x = old_mouse_x;
                mouse.pos.y = old_mouse_y;
                return 7;
            }

    // Exercise the entire source compositor/presenter with upstream zoom
    // enabled, then compare visible Limine pixels with its zoom CDC plane.
    frame_gr = ZcActiveGrGlobals();
    if (!frame_gr || !frame_gr->zoomed_dc || !frame_gr->zoomed_dc->body)
    {
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 27;
    }
    old_screen_zoom = frame_gr->screen_zoom;
    old_screen_sx = frame_gr->sx;
    old_screen_sy = frame_gr->sy;
    frame_gr->screen_zoom = 2;
    frame_gr->sx = frame_gr->sy = 0;
    if (!ZcTaskFrameRun())
    {
        frame_gr->screen_zoom = old_screen_zoom;
        frame_gr->sx = old_screen_sx;
        frame_gr->sy = old_screen_sy;
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 28;
    }
    if (screen[0] != gr_palette[frame_gr->zoomed_dc->body[0]] ||
        screen[1] != gr_palette[frame_gr->zoomed_dc->body[1]] ||
        screen[800] != gr_palette[frame_gr->zoomed_dc->body[800]] ||
        screen[801] != gr_palette[frame_gr->zoomed_dc->body[801]])
    {
        frame_gr->screen_zoom = old_screen_zoom;
        frame_gr->sx = old_screen_sx;
        frame_gr->sy = old_screen_sy;
        mouse_grid.coord = old_coord;
        mouse.pos.x = old_mouse_x;
        mouse.pos.y = old_mouse_y;
        return 29;
    }
    frame_gr->screen_zoom = old_screen_zoom;
    frame_gr->sx = old_screen_sx;
    frame_gr->sy = old_screen_sy;
    mouse_grid.coord = old_coord;
    mouse.pos.x = old_mouse_x;
    mouse.pos.y = old_mouse_y;

    // Check the unchanged Win callback invokes our virtual mouse renderer.
    old_mouse_show = mouse.show;
    old_mouse_installed = mouse_hard.installed;
    mouse_hard.installed = TRUE;
    mouse.show = TRUE;
    old_draw_calls = bootstrap_mouse_draw_calls;
    if (!ZcTaskFrameRun())
    {
        mouse.show = old_mouse_show;
        mouse_hard.installed = old_mouse_installed;
        return 8;
    }
    if (bootstrap_mouse_draw_calls == old_draw_calls)
    {
        mouse.show = old_mouse_show;
        mouse_hard.installed = old_mouse_installed;
        return 14;
    }
    mouse.show = old_mouse_show;
    mouse_hard.installed = old_mouse_installed;

    // Isolate this fixed-position draw from live tablet polling and verify
    // pixels on the Limine framebuffer after the staged frame is presented.
    gr.fp_final_screen_update = &GrScreenNoCursorProbe;
    if (!ZcTaskFrameRun())
    {
        gr.fp_final_screen_update = old_final_update;
        return 8;
    }
    for (y = 0, i = 0; y < 13; y++)
        for (x = 0; x < 13; x++, i++)
            gr_screen_cursor_off[i] =
                screen[(234 + y) * pitch + 123 + x];
    gr.fp_final_screen_update = &GrScreenCursorProbe;
    if (!ZcTaskFrameRun())
    {
        gr.fp_final_screen_update = old_final_update;
        return 9;
    }
    changed = 0;
    for (y = 0, i = 0; y < 13; y++)
        for (x = 0; x < 13; x++, i++)
            if (gr_screen_cursor_off[i] !=
                screen[(234 + y) * pitch + 123 + x])
                changed++;
    gr.fp_final_screen_update = old_final_update;
    if (changed < 20)
    {
        return 100 + changed;
    }
    // Exercise the actual task-frame presenter at 2x. The previous smoke
    // checks the source zoom routine in isolation; this confirms the live
    // graphics globals retain zoom state and point at the bootstrap surface.
    frame_gr = ZcActiveGrGlobals();
    old_screen_zoom = frame_gr->screen_zoom;
    old_screen_sx = frame_gr->sx;
    old_screen_sy = frame_gr->sy;
    frame_gr->screen_zoom = 2;
    frame_gr->sx = frame_gr->sy = 0;
    if (!ZcTaskFrameRun())
    {
        frame_gr->screen_zoom = old_screen_zoom;
        frame_gr->sx = old_screen_sx;
        frame_gr->sy = old_screen_sy;
        return 23;
    }
    for (y = 0; y < 8; y++)
        for (x = 0; x < 8; x++)
            if (frame_gr->zoomed_dc->body[y * 800 + x] !=
                frame_gr->dc2->body[(y / 2) * 800 + x / 2])
            {
                frame_gr->screen_zoom = old_screen_zoom;
                frame_gr->sx = old_screen_sx;
                frame_gr->sy = old_screen_sy;
                return 24;
            }
    frame_gr->screen_zoom = old_screen_zoom;
    frame_gr->sx = old_screen_sx;
    frame_gr->sy = old_screen_sy;
    ZcTaskFrameRun();
    return 42;
}
