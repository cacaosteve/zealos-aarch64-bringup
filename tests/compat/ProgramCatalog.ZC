I64 StockCatalogCompileWithModules(U8 *path, U8 *module1, U8 *module2=NULL,
                                   U8 *module3=NULL)
{//Compile a stock source with the modules it normally imports.
    CTask *task = Spawn(&StockCatalogServer);
    CJob *job;
    U8 *source;
    I64 result;

    if (!task)
        return -1;
    if (module3)
        source = MStrPrint("ExeFile2(\"%Q\",CCF_JUST_LOAD);"
                           "ExeFile2(\"%Q\",CCF_JUST_LOAD);"
                           "ExeFile2(\"%Q\",CCF_JUST_LOAD);"
                           "StockCatalogExeDocFile(\"%Q\",CCF_JUST_LOAD);42;",
                           module1, module2, module3, path);
    else if (module2)
        source = MStrPrint("ExeFile2(\"%Q\",CCF_JUST_LOAD);"
                           "ExeFile2(\"%Q\",CCF_JUST_LOAD);"
                           "StockCatalogExeDocFile(\"%Q\",CCF_JUST_LOAD);42;",
                           module1, module2, path);
    else
        source = MStrPrint("ExeFile2(\"%Q\",CCF_JUST_LOAD);"
                           "StockCatalogExeDocFile(\"%Q\",CCF_JUST_LOAD);42;",
                           module1, path);
    job = TaskExe(task, Fs, source, 0);
    Free(source);
    if (!job)
    {
        Kill(task);
        return -2;
    }
    result = JobResGet(job);
    Kill(task);
    return result == 42;
}

I64 StockCatalogCompileDoDistro()
{//The original utility's BootDVDIns implementation is 16-bit BIOS assembly.
 //Compile the distro builder's ARM64-relevant body with that legacy-only
 //installer entry stubbed; this is compile evidence, not install acceptance.
    CTask *task = Spawn(&StockCatalogServer);
    CJob *job;
    U8 *source;
    I64 result;

    if (!task)
        return -1;
    source = StrNew(
        "ExeFile2(\"/System/Utils/LineRep.ZC\",CCF_JUST_LOAD);\n"
        "ExeFile2(\"/System/BlkDev/ZDiskB.ZC\",CCF_JUST_LOAD);\n"
        "#define KERNEL_ZXE \"Kernel.ZXE\"\n"
        "#define BOOT_DIR \"/Boot\"\n"
        "#define BOOT_DIR_KERNEL_ZXE BOOT_DIR \"/\" KERNEL_ZXE\n"
        "#define BOOT_DIR_DVD_KERNEL_ZXE BOOT_DIR \"/DVD\" KERNEL_ZXE\n"
        "U0 BootDVDIns(U8 drv_let=0){};\n"
        "StockCatalogExeDocFile(\"/Home/DoDistro.ZC\",CCF_JUST_LOAD);42;");
    job = TaskExe(task, Fs, source, 0);
    Free(source);
    if (!job)
    {
        Kill(task);
        return -2;
    }
    result = JobResGet(job);
    Kill(task);
    return result == 42;
}

