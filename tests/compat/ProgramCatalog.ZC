I64 StockCatalogCompileWithProgramModulesAfterLoad(U8 *module, U8 *path,
        Bool load_tos_config=FALSE)
{//Compile a Demo source after the common modules and one source dependency.
    CTask *task = Spawn(&StockCatalogServer);
    CJob *job;
    U8 *source;
    U8 *module_load = "";
    U8 *common_modules = "";
    U8 *tos_config_modules = "";
    U8 *tos_init = "";
    U8 *tos_boot_externs = "";
    I64 result;

    if (!task)
        return -1;
    if (!load_tos_config || StrCompare(module, path))
        module_load = MStrPrint("ExeFile2(\"%Q\",CCF_JUST_LOAD);", module);
    else
        module_load = StrNew("");
    if (!load_tos_config)
        common_modules =
            "ExeFile2(\"/System/Math/Math.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Sound.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Memory.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Utils/TaskRep.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Gr/GrDC.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Gr/GrMath.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Gr/GrPrimatives.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Gr/GrComposites.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Gr/ScreenCast.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/Apps/Psalmody/JukePuppet.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Utils/LineRep.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/BlkDev/ZDiskB.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/BlkDev/DiskCheck.ZC\",CCF_JUST_LOAD);";
    if (load_tos_config)
        tos_config_modules =
            "ExeFile2(\"/System/Utils/Find.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/Demo/AcctExample/TOS/TOSExtern.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/Demo/AcctExample/TOS/TOSConfig.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/Kernel/KGlobals.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Memory.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/StringUtilities.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/Compiler/CompilerA.HH\",CCF_JUST_LOAD);"
            "ExeFile2(\"/Compiler/CompilerB.HH\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Hash.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/God/GodBible.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Utils/LineRep.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/BlkDev/ZDiskB.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/BlkDev/ZDiskA.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/BlkDev/DiskCheck.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Utils/StrUtils.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/System/Utils/DocUtils.ZC\",CCF_JUST_LOAD);"
            "ExeFile2(\"/Apps/Psalmody/JukePuppet.ZC\",CCF_JUST_LOAD);"
            "Cd(\"/Demo/AcctExample/TOS\");";
    if (load_tos_config)
        tos_init = "TOSInit;TOSDebugDistro1;TOSDebugDistro2;";
    if (load_tos_config)
        tos_boot_externs =
            "#define KERNEL_ZXE \"Kernel.ZXE\"\n"
            "#define BOOT_DIR \"/Boot\"\n"
            "#define BOOT_DIR_KERNEL_ZXE BOOT_DIR \"/\" KERNEL_ZXE\n"
            "#define INS_REG_PERSONAL_INITIALS \"TAD\"\n"
            "class CSoundData { CSoundData *next,*last; F64 tS; I8 ona; };"
            "class CScreenCastGlobals { CSoundData sound_head; CDate t0_now; F64 t0_tS; U8 *print_format; CDC *dc,*dc2_alias; Bool record,just_audio; I8 ona; };"
            "extern CScreenCastGlobals screencast;"
            "extern U0 SoundShift(CSoundData *head, F64 dt=0);"
            "extern I64 AUWrite(U8 *filename, CSoundData *head, CDate *t0_now, F64 t0_tS);"
            "extern I64 GR2MV(U8 *print_format, U8 *files_find_mask, U8 *fu_flags=NULL);"
            "extern U0 BootHDIns(U8 drv_let);"
            "extern Bool BootMHDIns(U8 drv_let, U8 *drv_list=NULL);"
            "extern U0 BootDVDIns(U8 drv_let);"
            "extern U0 BootRAM(U8 *filename=NULL);"
            "extern U0 DiskCheckAll();"
            "extern I64 F2(U8 *needle_str, U8 *fu_flags=NULL);";
    source = MStrPrint(
        "%s"
        "%s"
        "%s"
        "DefinePrint(\"TOS_HDS\",\"\\\"CD\\\"\");"
        "%s"
        "%s"
        "StockCatalogExeDocFile(\"%Q\",CCF_JUST_LOAD);42;",
        common_modules, tos_config_modules, tos_boot_externs, tos_init,
        module_load, path);
    job = TaskExe(task, Fs, source, 0);
    Free(source);
    Free(module_load);
    if (!job)
    {
        Kill(task);
        return -2;
    }
    result = JobResGet(job);
    Kill(task);
    return result == 42;
}

I64 StockCatalogMathChecks()
{//Exercise the ARM64 Math.ZC overlay in an isolated namespace.
    CTask *task = Spawn(&StockCatalogServer);
    CJob *job;
    U8 *source;
    I64 result;

    if (!task)
        return -1;
    source = MStrPrint(
        "ExeFile2(\"/System/Math/Math.ZC\");"
        "if (Abs(ASin(0.5)-0.52359877559829887308)>0.00001) 11;"
        "if (Abs(Cosh(0.0)-1.0)>0.00001) 12;"
        "if (Abs(ACos(1.0))>0.00001) 13;"
        "if (Abs(Saw(0.5,2.0)-0.25)>0.00001) 14;"
        "if (Abs(Saw(-0.5,2.0)-0.75)>0.00001) 15;"
        "if (Saw(2.0,0.0)!=0.0) 16;"
        "if (Abs(Saw(0.5,1.0)-0.5)>0.00001 || "
        "Abs(Saw(-0.5,1.0)-0.5)>0.00001) 30;"
        "if (Abs(FullSaw(0.5,1.0))>0.00001) 31;"
        "if (Abs(Caw(0.5,1.0)-0.5)>0.00001) 32;"
        "if (Abs(FullCaw(0.5,1.0))>0.00001) 33;"
        "if (Abs(Tri(0.25,1.0)-0.5)>0.00001 || "
        "Abs(Tri(0.75,1.0)-0.5)>0.00001 || Tri(0.5,0.0)!=0.0) 34;"
        "if (Abs(FullTri(0.125,1.0)-0.5)>0.00001 || "
        "Abs(FullTri(0.625,1.0)+0.5)>0.00001) 35;"
        "if (Abs(Arm64Tri(0.25,1.0)-0.5)>0.00001 || "
        "Abs(Arm64Tri(0.75,1.0)-0.5)>0.00001) 19;"
        "if (Abs(Arm64FullTri(0.125,1.0)-0.5)>0.00001 || "
        "Abs(Arm64FullTri(0.625,1.0)+0.5)>0.00001) 20;"
        "if (Abs(Arm64Log2(8.0)-3.0)>0.00001 || "
        "Abs(Arm64Log2(0.5)+1.0)>0.00001) 21;"
        "if (MinI64(-9,4)!=-9 || MinI64(4,-9)!=-9 || "
        "MinI64(4,9)!=4 || MinI64(-4,-9)!=-9) 23;"
        "if (MaxI64(-9,4)!=4 || MaxI64(4,-9)!=4 || "
        "MaxI64(4,9)!=9 || MaxI64(-4,-9)!=-4) 24;"
        "if (MinU64(0,9)!=0 || MinU64(9,0)!=0 || "
        "MinU64(4,9)!=4) 25;"
        "if (MaxU64(0,9)!=9 || MaxU64(9,0)!=9 || "
        "MaxU64(4,9)!=9) 26;"
        "if (Arm64Sign(4.0)!=1.0 || Arm64Sign(-4.0)!=-1.0 || "
        "Arm64Sign(0.0)!=0.0) 22;"
        "if (Arm64Blink(0.0)) 18;"
        "42;");
    job = TaskExe(task, Fs, source, 0);
    Free(source);
    if (!job)
    {
        Kill(task);
        return -2;
    }
    result = JobResGet(job);
    Kill(task);
    return result;
}

// Some stock entry files rely on top-level setup (RegDefault/DefinePrint).
// Exercise their normal Load.ZC path in a disposable task because CCF_JUST_LOAD
// deliberately suppresses that setup and can report false unknown symbols.
I64 StockCatalogNormalLoad(U8 *path)
{
    CTask *task = Spawn(&StockCatalogServer);
    CJob *job;
    U8 *source;
    I64 result;

    if (!task)
        return -1;
    source = MStrPrint("ExeFile2(\"%Q\");42;", path);
    job = TaskExe(task, Fs, source, 0);
    Free(source);
    if (!job)
    {
        Kill(task);
        return -2;
    }
    result = JobResGet(job);
    Kill(task);
    return result == 42;
}

I64 StockCatalogCompileAfterLoad(U8 *load_path, U8 *app_path)
{//Compile entry points that depend on globals declared by their normal loader.
    CTask *task = Spawn(&StockCatalogServer);
    CJob *job;
    U8 *source;
    I64 result;

    if (!task)
        return -1;
    source = MStrPrint("ExeFile2(\"%Q\");ExeFile2(\"%Q\",CCF_JUST_LOAD);42;",
                       load_path, app_path);
    job = TaskExe(task, Fs, source, 0);
    Free(source);
    if (!job)
    {
        Kill(task);
        return -2;
    }
    result = JobResGet(job);
    Kill(task);
    return result == 42;
}

I64 StockCatalogCompilePaletteEditor()
{//Load the same God services and initializer used by MakeSystem, then compile.
    CTask *task = Spawn(&StockCatalogServer);
    CJob *job;
    U8 *source;
    I64 result;

    if (!task)
        return -1;
    source = StrNew("ExeFile2(\"/Kernel/KGlobals.ZC\",CCF_JUST_LOAD);"
                    "ExeFile2(\"/System/StringUtilities.ZC\",CCF_JUST_LOAD);"
                    "ExeFile2(\"/System/God/GodBible.ZC\");"
                    "ExeFile2(\"/System/God/HolySpirit.ZC\",CCF_JUST_LOAD);"
                    "ExeFile2(\"/Home/PaletteEditor/Load.ZC\");"
                    "ExeFile2(\"/Home/PaletteEditor/Run.ZC\",CCF_JUST_LOAD);42;");
    job = TaskExe(task, Fs, source, 0);
    Free(source);
    if (!job)
    {
        Kill(task);
        return -2;
    }
    result = JobResGet(job);
    Kill(task);
    return result == 42;
}

