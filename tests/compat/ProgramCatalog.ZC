}

I64 StockCatalogPsalmodyNoteMathChecks()
{//The editor depends on the pure pitch/octave helpers from the sound module.
    CTask *task = Spawn(&StockCatalogServer);
    CJob *job;
    U8 *source;
    I64 result;

    if (!task)
        return -1;
    source = MStrPrint(
        "ExeFile2(\"/Apps/Psalmody/Load.ZC\");"
        "if (!(Ona2Note(51)==3 && Ona2Octave(51)==4 && "
        "Note2Ona(3,4)==51 && Note2Ona(2,4)==62 && "
        "Ona2Octave(60)==4 && Ona2Note(60)==0)) 11;"
        "if (music.octave!=4 || music.note_len!=1.0 || "
        "music.note_map[0]!=0 || music.note_map[6]!=10 || "
        "music.meter_top!=4 || music.meter_bottom!=4) 12;"
        "42;");
    job = TaskExe(task, Fs, source, 0);
    Free(source);
    if (!job)
    {
        Kill(task);
        return -2;
    }
    result = JobResGet(job);
    Kill(task);
    return result;
}

I64 StockCatalogPsalmodySpriteSizeChecks()
{//Every embedded duration sprite must have a complete bounded record stream.
    CTask *task = Spawn(&StockCatalogServer);
    CJob *job;
    U8 *source;
    I64 result;

    if (!task)
        return -1;
    source = MStrPrint(
        "Cd(\"/Apps/Psalmody\");;\n"
        "#include \"Load.ZC\"\n"
        "I64 PsalmodyDurationSpriteSizes(){I64 i,size=0,caught;"
        "if(sprite_elem_base_sizes[SPT_LINE]!=17 || "
        "sprite_elem_base_sizes[SPT_POLYLINE]!=5) return 10;"
        "if(SpriteElemSize(psm_duration_imgs[4],SPT_LINE)!=17) return 11;"
        "for(i=0;i<PSM_DURATIONS_NUM;i++){caught=0;"
        "try{size=SpriteSize(psm_duration_imgs[i]);}"
        "catch{caught=Fs->except_ch;Fs->catch_except=TRUE;}"
        "if(caught)return 100+i;if(size<1)return 200+i;}return 42;}"
        "PsalmodyDurationSpriteSizes();");
    job = TaskExe(task, Fs, source, 0);
    Free(source);
    if (!job)
    {
        Kill(task);
        return -2;
    }
    result = JobResGet(job);
    Kill(task);
    return result;
}

I64 StockBudgetFormChildCheck()
{//Budget's popup form must reflect classes loaded by its normal app source.
    CTask *task;
    CJob *job;
    I64 result;

    ExeFile2("/Apps/Budget/Load.ZC");
    task = Spawn(&StockCatalogServer, NULL, "FormProbe", -1, Fs);
    if (!task)
        return -1;
    job = TaskExe(task, Fs,
                  "ZcDocFormField(\"CBgtEntryForm\",0,NULL);", 0);
    result = -2;
    if (job)
        result = JobResGet(job);
    Kill(task);
    return result;
}
