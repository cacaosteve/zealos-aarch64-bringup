// Compile original source files in disposable compiler namespaces.
// CCF_JUST_LOAD suppresses top-level execution; success is not runtime
// acceptance.
U0 StockCatalogServer(U8 *)
{
    while (TRUE)
    {
        JobsHandler(0);
        LBts(&Fs->task_flags, TASKf_IDLE);
        LBts(&Fs->task_flags, TASKf_AWAITING_MESSAGE);
        Yield;
    }
}

I64 StockCatalogBFieldChecks()
{
    U8 bits[5] = {0xAC, 0x35, 0, 0, 0};
    U8 set_bits[5] = {0, 0, 0, 0, 0};

    if (BFieldExtU32(bits, 2, 9) != 0x16B)
        return 0;
    BFieldOrU32(set_bits, 3, 0x89ABCDEF);
    if (BFieldExtU32(set_bits, 3, 32) == 0x89ABCDEF)
        return 42;
    return 0;
}

I64 StockCatalogExtStrTarget(I64 a, I64 b)
{
    return a + b;
}

I64 StockCatalogExtStrChecks()
{//The ARM64 CallExtStr bridge must resolve names and forward ordinary arguments.
    if (CallExtStr("StockCatalogExtStrTarget", 40, 2) != 42)
        return 1;
    return 42;
}

I64 StockCatalogMemoryPoolChecks()
{//System pool statistics must track the bridge's real data/code arenas.
    I64 before, during, after;
    U8 *allocation;

    if (!sys_data_bp || !sys_code_bp ||
        sys_data_bp->alloced_u8s < 0x7000000 ||
        sys_code_bp->alloced_u8s < 0x5000000 ||
        sys_code_bp->used_u8s <= 0)
        return 11;
    before = sys_data_bp->used_u8s;
    allocation = MAlloc(73);
    during = sys_data_bp->used_u8s;
    if (during <= before)
        return 12;
    Free(allocation);
    after = sys_data_bp->used_u8s;
    if (after != before)
        return 13;
    return 42;
}

I64 StockCatalogStaticArraySizeChecks()
{//An inferred static-local array must publish its size after initialization.
    class StockCatalogArrayItem
    {
        I32 value;
        U8 name[8];
    };
    static StockCatalogArrayItem items[] =
    {
        {40, "Local1"},
        {42, "Local2"},
    };
    if (sizeof(items) != 2 * sizeof(StockCatalogArrayItem) ||
        items[0].value != 40 || items[1].value != 42 ||
        items[1].name[5] != '2')
        return 1;
    return 42;
}

I64 StockCatalogExeDocFile(U8 *filename, I64 ccf_flags=0)
{//Compile a source document with its inline DolDoc payloads intact.
    CDoc *doc = DocRead(filename);
    I64 result = 0;

    if (!doc)
        return 0;
    try
    {
        result = ExeDoc(doc, ccf_flags);
    }
    catch
    {
        Fs->catch_except = TRUE;
    }
    DocDel(doc);
    return result;
}

I64 StockCatalogCompile(U8 *path)
{
    CTask *task = Spawn(&StockCatalogServer);
    CJob *job;
    U8 *source;
    I64 result;

    if (!task)
        return -1;
    source = MStrPrint("ExeFile2(\"%Q\",CCF_JUST_LOAD);42;", path);
    job = TaskExe(task, Fs, source, 0);
    Free(source);
    if (!job)
    {
        Kill(task);
        return -2;
    }
    result = JobResGet(job);
    Kill(task);
    return result == 42;
}

I64 StockCatalogNullCaseChecks()
{//The original /Demo/NullCase.ZC relies on sequential implicit switch cases.
    I64 i, seen = 0;
    for (i = 0; i < 12; i++)
        switch (i)
        {
            case: seen |= 1 << i; break;
            case: seen |= 1 << i; break;
            case: seen |= 1 << i; break;
            case: seen |= 1 << i; break;
            case 10: seen |= 1 << i; break;
            case: seen |= 1 << i; break;
        }
    if (seen == 0xC0F)
        return 42;
    return seen;
}

