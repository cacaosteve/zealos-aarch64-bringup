I64 WinMgrStartChecks()
{
    CTask *root = Fs, *manager;
    CWinMgrGlobals *active_winmgr = ZcActiveWinMgrGlobals();
    I64 updates_before, old_width;

    BootstrapGrContextInit();
    if (!TaskValidate(root) || sys_task != root || !gr.dc || !active_winmgr)
        return 1;
    if (!cpu_structs || mp_count != 1 || !cpu_structs[0].addr)
        return 5;
    if (root->next_ctrl != &root->next_ctrl ||
        root->last_ctrl != &root->next_ctrl)
        return 6;
    updates_before = active_winmgr->updates;
    sys_winmgr_task = root;
    manager = Spawn(&WinMgrTask, NULL, "Window Manager", -1, root);
    if (!TaskValidate(manager))
        return 2;
    sys_winmgr_task = manager;
    Yield;
    // One cooperative start must reach the real first refresh and sleep point.
    if (active_winmgr->updates <= updates_before)
        return 3;
    if (!Bt(&sys_run_level, RLf_WINMGR))
        return 4;
    // The manager's post-sleep task scan recalculates derived window geometry.
    // Poison one cached field, then park the shell through a timer wake.
    old_width = root->win_width;
    root->win_width = -999;
    Sleep(50);
    if (root->win_width != root->win_right - root->win_left + 1)
    {
        root->win_width = old_width;
        return 7;
    }
    if (active_winmgr->updates <= updates_before + 1)
        return 8;
    return 0x2a;
}

I64 WinMgrMousePipelineChecks()
{//A timer-woken source manager must consume the real hard-mouse event record.
    I64 old_hard_x = mouse_hard.pos.x, old_hard_y = mouse_hard.pos.y;
    I64 old_hard_z = mouse_hard.pos.z, old_hard_timestamp = mouse_hard.timestamp;
    F64 old_hard_speed = mouse_hard.speed;
    Bool old_hard_left = mouse_hard.bttns[0], old_hard_right = mouse_hard.bttns[1];
    Bool old_hard_event = mouse_hard.event;
    Bool old_hard_installed = mouse_hard.installed;
    Bool old_hard_wheel = mouse_hard.has_wheel;
    I64 old_x = mouse.pos.x, old_y = mouse.pos.y, old_z = mouse.pos.z;
    I64 old_px = mouse.presnap.x, old_py = mouse.presnap.y;
    I64 old_pz = mouse.presnap.z, old_timestamp = mouse.timestamp;
    I64 old_scan_code = kbd.scan_code;
    I64 old_ox = mouse.offset.x, old_oy = mouse.offset.y, old_oz = mouse.offset.z;
    F64 old_sx = mouse.scale.x, old_sy = mouse.scale.y, old_sz = mouse.scale.z;
    Bool old_left = mouse.lb, old_right = mouse.rb;
    Bool old_mouse_wheel = mouse.has_wheel, old_snap = mouse_grid.snap;
    I64 result = 0;

    mouse.scale.x = 2.0;
    mouse.scale.y = 1.5;
    mouse.scale.z = 1.0;
    mouse.offset.x = 7;
    mouse.offset.y = -4;
    mouse.offset.z = 0;
    mouse_grid.snap = FALSE;
    mouse_hard.pos.z = 0;
    BootstrapMouseHardSample(100 | (200 << 16) | (1 << 32) | (2 << 40),
                             ZcMonotonicNs());
    Sleep(50);
    if (mouse_hard.event)
        result = 2;
    else if (mouse.pos.x != 207 || mouse.pos.y != 296 || mouse.pos.z != 2)
        result = 3;
    else if (!mouse.lb || mouse.rb || !mouse.has_wheel)
        result = 4;

    mouse_hard.pos.x = old_hard_x;
    mouse_hard.pos.y = old_hard_y;
    mouse_hard.pos.z = old_hard_z;
    mouse_hard.timestamp = old_hard_timestamp;
    mouse_hard.speed = old_hard_speed;
    mouse_hard.bttns[0] = old_hard_left;
    mouse_hard.bttns[1] = old_hard_right;
    mouse_hard.event = old_hard_event;
    mouse_hard.installed = old_hard_installed;
    mouse_hard.has_wheel = old_hard_wheel;
    mouse.pos.x = old_x;
    mouse.pos.y = old_y;
    mouse.pos.z = old_z;
    mouse.presnap.x = old_px;
    mouse.presnap.y = old_py;
    mouse.presnap.z = old_pz;
    mouse.timestamp = old_timestamp;
    mouse.offset.x = old_ox;
    mouse.offset.y = old_oy;
    mouse.offset.z = old_oz;
    mouse.scale.x = old_sx;
    mouse.scale.y = old_sy;
    mouse.scale.z = old_sz;
    mouse.lb = old_left;
    mouse.rb = old_right;
    mouse.has_wheel = old_mouse_wheel;
    mouse_grid.snap = old_snap;
    kbd.scan_code = old_scan_code;
    if (result)
        return result;
    return 0x2a;
}

I64 winmgr_live_ctrl_down_count, winmgr_live_ctrl_up_count;

U0 WinMgrLiveCtrlClick(CCtrl *ctrl, I64 x, I64 y, Bool down)
{
    if (!ctrl)
        return;
    if (x || y) {}
    if (down)
    {
        if (!(ctrl->flags & CTRLF_CLICKED))
            winmgr_live_ctrl_down_count++;
        ctrl->flags |= CTRLF_CLICKED;
    }
    else
    {
        winmgr_live_ctrl_up_count++;
        ctrl->flags &= ~CTRLF_CLICKED;
    }
}

U0 WinMgrDragPark(U8 *data)
{
    while (TRUE)
        ZcTaskYield;
}

I64 WinMgrSourceDragChecks()
{//Drive an actual title-bar drag through unchanged WinMgrTask and WinMouseUpdate.
    CTask *drag_task, *cover_task, *old_focus = sys_focus_task;
    I64 old_x = mouse.pos.x, old_y = mouse.pos.y, old_z = mouse.pos.z;
    I64 old_text_x = mouse.pos_text.x, old_text_y = mouse.pos_text.y;
    I64 old_px = mouse.presnap.x, old_py = mouse.presnap.y;
    I64 old_pz = mouse.presnap.z, old_mouse_timestamp = mouse.timestamp;
    I64 old_scan_code = kbd.scan_code;
    I64 old_ox = mouse.offset.x, old_oy = mouse.offset.y;
    F64 old_sx = mouse.scale.x, old_sy = mouse.scale.y;
    Bool old_snap = mouse_grid.snap, old_left = mouse.lb, old_right = mouse.rb;
    Bool old_mouse_wheel = mouse.has_wheel;
    I64 old_hard_x = mouse_hard.pos.x, old_hard_y = mouse_hard.pos.y;
    I64 old_hard_z = mouse_hard.pos.z, old_hard_timestamp = mouse_hard.timestamp;
    F64 old_hard_speed = mouse_hard.speed;
    Bool old_hard_left = mouse_hard.bttns[0], old_hard_right = mouse_hard.bttns[1];
    Bool old_hard_event = mouse_hard.event, old_hard_installed = mouse_hard.installed;
    Bool old_hard_wheel = mouse_hard.has_wheel;
    CCtrl live_ctrl;
    I64 old_left, old_top, old_right, old_bottom, x, y, result = 0;

    drag_task = Spawn(&WinMgrDragPark, NULL, "WinMgrDragProbe");
    cover_task = Spawn(&WinMgrDragPark, NULL, "WinMgrDragCover");
    if (!TaskValidate(drag_task) || !TaskValidate(cover_task))
    {
        if (TaskValidate(drag_task))
            Kill(drag_task);
        if (TaskValidate(cover_task))
            Kill(cover_task);
        return 1;
    }
    if (!cpu_structs || !cpu_structs[0].addr)
    {
        Kill(drag_task);
        Kill(cover_task);
        return 2;
    }
    if (drag_task->gs != cpu_structs[0].addr ||
        cover_task->gs != cpu_structs[0].addr)
    {
        Kill(drag_task);
        Kill(cover_task);
        return 8;
    }
    drag_task->display_flags = 1 << DISPLAYf_SHOW;
    cover_task->display_flags = 1 << DISPLAYf_SHOW;
    drag_task->win_inhibit |= 1 << WIf_SELF_DOC;
    cover_task->win_inhibit |= 1 << WIf_SELF_DOC;
    drag_task->win_inhibit &= ~(1 << WIf_SELF_BORDER);
    cover_task->win_inhibit &= ~(1 << WIf_SELF_BORDER);
    drag_task->win_inhibit &= ~(1 << WIf_FOCUS_TASK_BORDER);
    cover_task->win_inhibit &= ~(1 << WIf_FOCUS_TASK_BORDER);
    if (!WinHorz(15, 34, drag_task) || !WinVert(10, 24, drag_task))
    {
        result = 3;
        goto done;
    }
    if (!WinHorz(25, 44, cover_task) || !WinVert(10, 24, cover_task))
    {
        result = 4;
        goto done;
    }
    if (Fs->last_task != cover_task)
    {
        result = 7;
        goto done;
    }
    old_left = drag_task->win_left;
    old_top = drag_task->win_top;
    // Use exact cell coordinates so input conversion and the source manager's
    // title-bar hit test agree without depending on host pointer state.
    mouse.scale.x = mouse.scale.y = 1.0;
    mouse.offset.x = mouse.offset.y = 0;
    mouse_grid.snap = FALSE;
    mouse_hard.pos.z = 0;
    // Leave the source manager in an unpressed state before beginning the
    // drag; this also drains a press left by an earlier probe.
    BootstrapMouseHardSample(mouse.pos.x | (mouse.pos.y << 16),
                             ZcMonotonicNs());
    Sleep(50);
    // The cover overlaps the right half of this title. Clicking the exposed
    // left portion must make the source manager raise and focus drag_task.
    x = (old_left + 5) * FONT_WIDTH;
    y = (old_top - 1) * FONT_HEIGHT;
    BootstrapMouseHardSample(x | (y << 16) | (1 << 32), ZcMonotonicNs());
    Sleep(50);
    if (sys_focus_task != drag_task || sys_winmgr_task->last_task != drag_task)
        result = 5;
    // Move the still-held pointer by two text cells in each direction.
    BootstrapMouseHardSample((x + 2 * FONT_WIDTH) |
                             ((y + 2 * FONT_HEIGHT) << 16) | (1 << 32),
                             ZcMonotonicNs());
    Sleep(50);
    BootstrapMouseHardSample((x + 2 * FONT_WIDTH) |
                             ((y + 2 * FONT_HEIGHT) << 16),
                             ZcMonotonicNs());
    Sleep(50);
    if (!result && (drag_task->win_left != old_left + 2 ||
                    drag_task->win_top != old_top + 2))
        result = 6;
    if (!result)
    {
        // The unchanged WinMgr has a dedicated lower-right resize branch.
        old_right = drag_task->win_right;
        old_bottom = drag_task->win_bottom;
        x = (old_right + 1) * FONT_WIDTH;
        y = (old_bottom + 1) * FONT_HEIGHT;
        BootstrapMouseHardSample(x | (y << 16) | (1 << 32), ZcMonotonicNs());
        Sleep(50);
        BootstrapMouseHardSample((x + 3 * FONT_WIDTH) |
                                 ((y + 2 * FONT_HEIGHT) << 16) | (1 << 32),
                                 ZcMonotonicNs());
        Sleep(50);
        BootstrapMouseHardSample((x + 3 * FONT_WIDTH) |
                                 ((y + 2 * FONT_HEIGHT) << 16),
                                 ZcMonotonicNs());
        Sleep(50);
        if (drag_task->win_right != old_right + 3 ||
            drag_task->win_bottom != old_bottom + 2)
            result = 9;
    }
    if (!result)
    {
        MemSet(&live_ctrl, 0, sizeof(CCtrl));
        live_ctrl.next = live_ctrl.last = &drag_task->next_ctrl;
        live_ctrl.win_task = drag_task;
        live_ctrl.flags = CTRLF_SHOW | CTRLF_CAPTURE_LEFT_MS;
        live_ctrl.left = 2 * FONT_WIDTH;
        live_ctrl.right = 8 * FONT_WIDTH;
        live_ctrl.top = 3 * FONT_HEIGHT;
        live_ctrl.bottom = 6 * FONT_HEIGHT;
        live_ctrl.left_click = &WinMgrLiveCtrlClick;
        live_ctrl.screen_left = gr.pan_text_x + drag_task->pix_left + live_ctrl.left;
        live_ctrl.screen_right = gr.pan_text_x + drag_task->pix_left + live_ctrl.right;
        live_ctrl.screen_top = gr.pan_text_y + drag_task->pix_top + live_ctrl.top;
        live_ctrl.screen_bottom = gr.pan_text_y + drag_task->pix_top + live_ctrl.bottom;
        drag_task->next_ctrl = drag_task->last_ctrl = &live_ctrl;
        winmgr_live_ctrl_down_count = winmgr_live_ctrl_up_count = 0;
        x = (live_ctrl.screen_left + live_ctrl.screen_right) / 2;
        y = (live_ctrl.screen_top + live_ctrl.screen_bottom) / 2;
        BootstrapMouseHardSample(x | (y << 16) | (1 << 32), ZcMonotonicNs());
        Sleep(50);
        if (winmgr_live_ctrl_down_count != 1)
            result = 10;
        // Captured controls must keep receiving the held-button path after
        // the pointer leaves their original hit rectangle.
        BootstrapMouseHardSample((x + 12 * FONT_WIDTH) |
                                 ((y + 10 * FONT_HEIGHT) << 16) | (1 << 32),
                                 ZcMonotonicNs());
        Sleep(50);
        BootstrapMouseHardSample((x + 12 * FONT_WIDTH) |
                                 ((y + 10 * FONT_HEIGHT) << 16),
                                 ZcMonotonicNs());
        Sleep(50);
        if (!result && (winmgr_live_ctrl_down_count != 1 ||
                        winmgr_live_ctrl_up_count != 1))
            result = 11;
        drag_task->next_ctrl = drag_task->last_ctrl = &drag_task->next_ctrl;
        live_ctrl.next = live_ctrl.last = NULL;
    }

done:
    // Always release the source manager's drag loop before destroying its task.
    BootstrapMouseHardSample(mouse.pos.x | (mouse.pos.y << 16),
                             ZcMonotonicNs());
    Sleep(50);
    sys_focus_task = old_focus;
    if (TaskValidate(drag_task))
        Kill(drag_task);
    if (TaskValidate(cover_task))
        Kill(cover_task);
    mouse.pos.x = old_x;
    mouse.pos.y = old_y;
    mouse.pos.z = old_z;
    mouse.pos_text.x = old_text_x;
    mouse.pos_text.y = old_text_y;
    mouse.presnap.x = old_px;
    mouse.presnap.y = old_py;
    mouse.presnap.z = old_pz;
    mouse.timestamp = old_mouse_timestamp;
    mouse.offset.x = old_ox;
    mouse.offset.y = old_oy;
    mouse.scale.x = old_sx;
    mouse.scale.y = old_sy;
    mouse_grid.snap = old_snap;
    mouse.lb = old_left;
    mouse.rb = old_right;
    mouse.has_wheel = old_mouse_wheel;
    mouse_hard.pos.x = old_hard_x;
    mouse_hard.pos.y = old_hard_y;
    mouse_hard.pos.z = old_hard_z;
    mouse_hard.timestamp = old_hard_timestamp;
    mouse_hard.speed = old_hard_speed;
    mouse_hard.bttns[0] = old_hard_left;
    mouse_hard.bttns[1] = old_hard_right;
    mouse_hard.event = old_hard_event;
    mouse_hard.installed = old_hard_installed;
    mouse_hard.has_wheel = old_hard_wheel;
    kbd.scan_code = old_scan_code;
    if (result)
        return result;
    return 0x2a;
}

I64 WinMgrTimingStateChecks()
{
    CWinMgrGlobals *active_winmgr = ZcActiveWinMgrGlobals();
    if (!active_winmgr || !active_winmgr->t)
        return 1;
    if (!cpu_structs || !cpu_structs[0].addr)
        return 2;
    return 0x2a;
}

U0 WinMgrCalcIdleChild(I64 unused)
{
    WinCalcIdles;
}

I64 WinMgrCalcIdleChildChecks()
{
    CTask *child = Spawn(&WinMgrCalcIdleChild, NULL, "CalcIdleProbe", -1, Fs);
    if (!TaskValidate(child))
        return 1;
    Yield;
    return 0x2a;
}

I64 WinMgrKeyboardStateChecks()
{
    if (kbd.scan_code_fifo)
        return 1;
    return 0x2a;
}
