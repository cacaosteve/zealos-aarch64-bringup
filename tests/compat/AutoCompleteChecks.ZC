I64 AutoCompleteBootChecks()
{
    CHashGeneric *entry;
    CFile *file;
    U8 *block;
    U8 *definition;

    // Home startup is queued to the graphical shell; drain that text before
    // observing its globally shared index and popup task.
    TaskWait(bootstrap_gui_terminal_task);
    if (!ac.hash_table)
        return 25;
    // The boot mask's text corpus is optional on the live image. Vocabulary
    // requires the separate dictionary word list and definitions below.
    // The dedicated completion fixture is added by AutoCompleteFixtureInit.
    entry = HashFind("COMPUTER", ac.hash_table, HTT_DICT_WORD);
    if (!entry)
        return 22;
    if (!TaskValidate(ac.task))
        return 23;
    if (!Bt(&sys_run_level, RLf_AUTOCOMPLETE))
        return 24;
    if (!acd.word_list || !acd.num_words || !acd.word_list_size)
        return 26;
    if (!acd.has_defs || !FileFind(ACD_DEF_FILENAME))
        return 27;
    if (!acd.has_words || !FileFind(ACD_WORD_FILENAME))
        return 28;
    file = FOpen(ACD_DEF_FILENAME, "r");
    if (!file || FSize(file) <= 2 * BLK_SIZE)
        return 29;
    block = MAlloc(2 * BLK_SIZE);
    if (!block)
    {
        FClose(file);
        return 30;
    }
    if (!FBlkRead(file, block) || file->fblk_num != 1)
    {
        Free(block);
        FClose(file);
        return 31;
    }
    if (!FBlkRead(file, block, 1, 2) || file->fblk_num != 3)
    {
        Free(block);
        FClose(file);
        return 32;
    }
    Free(block);
    FClose(file);
    definition = ACDDefGet("Computer");
    if (!definition || StrLen(definition) < 8)
        return 33;
    Free(definition);
    return 42;
}

I64 AutoCompleteFixtureInit()
{
    CHashAC *entry;

    ACInit("/Tests/AutoCompleteCorpus.txt");
    entry = HashFind("ZealAutoFixtureWord7Z", ac.hash_table, HTT_WORD);
    if (!entry || !entry->hits || !TaskValidate(ac.task))
        return 34;
    return 42;
}

I64 AutoCompleteWindowDiag()
{
    CTask *task = ac.task;

    if (!TaskValidate(task))
        return 0;
    return (task->win_left & 127) |
           ((task->win_right & 127) << 7) |
           ((task->win_top & 127) << 14) |
           ((task->win_bottom & 127) << 21) |
           ((task->win_z_num & 63) << 28) |
           (Bt(&task->display_flags, DISPLAYf_SHOW) << 34);
}

I64 AutoCompleteDocumentDiag()
{
    CDoc *doc;
    I64 width, height;

    if (!TaskValidate(ac.task) || !(doc = ac.task->display_doc))
        return 0;
    width = doc->max_x - doc->min_x;
    height = doc->max_y - doc->min_y;
    return (width & 65535) | ((height & 65535) << 16);
}

I64 AutoCompleteChecks()
{
    CHashAC *entry;

    ACInit("/Tests/AutoCompleteCorpus.txt");
    entry = HashFind("ZealAutoFixtureWord7Z", ac.hash_table, HTT_WORD);
    if (!entry)
    {
        AutoComplete(OFF);
        return 11;
    }
    if (!entry->hits)
    {
        AutoComplete(OFF);
        return 12;
    }
    if (!TaskValidate(ac.task))
    {
        AutoComplete(OFF);
        return 13;
    }
    if (!AutoComplete(OFF))
        return 2;
    return 42;
}
