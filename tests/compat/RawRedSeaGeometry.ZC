extern I64 ZcRawRedSeaGeometry(U64 *base, U64 *sectors);
extern Bool ZcMountLegacyRedSea();
extern U0 DiskCheckAll();
extern I64 DiskCheck(U8 drv_let, Bool fix=FALSE, Bool confirm=TRUE);

// The focused checker probe doesn't load the full StrPrint stack. The clean
// fixture should never warn; this stub only supplies DiskCheck's log symbol.
U0 PrintWarn(U8 *format, ...) {}

I64 RawRedSeaAbsentChecks()
{
    U64 base = 123, sectors = 456;
    if (ZcRawRedSeaGeometry(&base, &sectors) || base != 123 || sectors != 456)
        return 1;
    if (ZcRawRedSeaGeometry(NULL, &sectors) ||
        ZcRawRedSeaGeometry(&base, NULL))
        return 2;
    if (ZcMountLegacyRedSea() || Letter2Drive('D', FALSE))
        return 3;
    if (RedSeaValidate('D'))
        return 4;
    return 42;
}

I64 RawRedSeaPresentChecks()
{
    U64 base = 0, sectors = 0;
    CDrive *drive;
    CBlkDev *bd;
    U8 *buf, *saved, *pattern;
    I64 caught = 0, i;
    Bool write_ok, readback_ok, restore_ok;
    if (!ZcRawRedSeaGeometry(&base, &sectors))
        return 1;
    if (base != 130911 || sectors != 128)
        return 2;
    if (!ZcMountLegacyRedSea() || !(drive = Letter2Drive('D')) ||
        !(bd = Letter2BlkDev('D')) || drive->bd != bd ||
        Drive2Letter(drive) != 'D' || drive->drv_offset != base ||
        drive->size != sectors || drive->root_clus != base + 2 ||
        drive->fs_type != FSt_REDSEA || drive->fat1 != base + 1 ||
        drive->fat2 != base + 1 || drive->data_area != base + 1 ||
        drive->cur_fat_blk_num != -1 || !RedSeaValidate('D') ||
        (bd->flags & BDF_READ_ONLY) || DriveIsWritable('D', FALSE) != bd)
        return 3;
    // Exercise the stock, read-only consistency scan against a clean mounted
    // RedSea fixture before changing the drive bounds for the raw-sector test.
    if (DiskCheck('D', FALSE, FALSE))
        return 10;
    // Run the actual TOSMisc dispatcher too: it must skip source-only C and
    // invoke the stock checker on the mounted RedSea D drive.
    DiskCheckAll();
    DriveRep;
    buf = CAlloc(512);
    saved = CAlloc(512);
    pattern = CAlloc(512);
    if (!buf || !saved || !pattern || !BlkRead(drive, buf, base, 1) ||
        buf[3] != 0x88 || buf[510] != 0x55 || buf[511] != 0xAA)
    {
        Free(buf);
        Free(saved);
        Free(pattern);
        return 4;
    }
    // Write only the final sector in the disposable 128-sector RedSea
    // fixture, verify it, then restore and verify the original bytes.
    if (!BlkRead(drive, saved, base + sectors - 1, 1))
    {
        Free(buf);
        Free(saved);
        Free(pattern);
        return 5;
    }
    for (i = 0; i < BLK_SIZE; i++)
        pattern[i] = i ^ 0xA5;
    write_ok = BlkWrite(drive, pattern, base + sectors - 1, 1);
    readback_ok = write_ok && BlkRead(drive, buf, base + sectors - 1, 1);
    if (readback_ok)
        for (i = 0; i < BLK_SIZE; i++)
            if (buf[i] != pattern[i])
            {
                readback_ok = FALSE;
                break;
            }
    restore_ok = BlkWrite(drive, saved, base + sectors - 1, 1) &&
                 BlkRead(drive, buf, base + sectors - 1, 1);
    if (restore_ok)
        for (i = 0; i < BLK_SIZE; i++)
            if (buf[i] != saved[i])
            {
                restore_ok = FALSE;
                break;
            }
    if (!write_ok || !readback_ok || !restore_ok)
    {
        Free(buf);
        Free(saved);
        Free(pattern);
        return 6;
    }
    try { BlkRead(drive, buf, base - 1, 1); }
    catch { caught = Fs->except_ch; Fs->catch_except = TRUE; }
    if (caught != 'Drive')
    {
        Free(buf);
        Free(saved);
        Free(pattern);
        return 7;
    }
    caught = 0;
    try { BlkWrite(drive, pattern, base - 1, 1); }
    catch { caught = Fs->except_ch; Fs->catch_except = TRUE; }
    if (caught != 'Drive')
    {
        Free(buf);
        Free(saved);
        Free(pattern);
        return 8;
    }
    caught = 0;
    try { BlkWrite(drive, pattern, base + sectors, 1); }
    catch { caught = Fs->except_ch; Fs->catch_except = TRUE; }
    if (caught != 'Drive')
    {
        Free(buf);
        Free(saved);
        Free(pattern);
        return 9;
    }
    // DiskRaw deliberately broadens its drive range to inspect sector 1.
    drive->drv_offset = 0;
    drive->size = bd->max_blk + 1;
    if (!BlkRead(drive, buf, 1, 1) || buf[0] != 'E' || buf[1] != 'F' ||
        buf[2] != 'I' || buf[3] != ' ')
    {
        Free(buf);
        Free(saved);
        Free(pattern);
        return 7;
    }
    Free(buf);
    Free(saved);
    Free(pattern);
    Unmount('D');
    if (Letter2Drive('D', FALSE) || RedSeaValidate('D'))
        return 8;
    return 42;
}

I64 RawRedSeaRepairChecks()
{
    U64 base = 0, sectors = 0;
    CDrive *drive;
    U8 *bitmap;
    I64 errs;
    if (!ZcRawRedSeaGeometry(&base, &sectors) || base != 130911 || sectors != 128)
        return 1;
    if (!ZcMountLegacyRedSea() || !(drive = Letter2Drive('D')) ||
        drive->drv_offset != base || drive->fs_type != FSt_REDSEA ||
        !DriveIsWritable('D', FALSE))
        return 2;
    bitmap = CAlloc(BLK_SIZE);
    if (!bitmap)
        return 3;
    if (!BlkRead(drive, bitmap, drive->fat1, 1))
    {
        Free(bitmap);
        return 4;
    }
    {
        CDirEntry *entry, *next;
        I64 count = 0;
        entry = FilesFind("D:/*", FUF_RECURSE);
        while (entry)
        {
            next = entry->next;
            count++;
            if (!entry->full_name || StrCompare(entry->full_name, "/KEEP.ZC") ||
                entry->clus != base + 10 || entry->size != 512 ||
                !(entry->attr & RS_ATTR_ARCHIVE))
            {
                DirEntryDel(entry);
                while (next)
                {
                    entry = next;
                    next = entry->next;
                    DirEntryDel(entry);
                }
                Free(bitmap);
                return 4;
            }
            DirEntryDel(entry);
            entry = next;
        }
        if (count != 1)
        {
            Free(bitmap);
            return 4;
        }
    }
    if (!BlkRead(drive, bitmap, drive->fat1, 1) || !Bt(bitmap, 2))
    {
        Free(bitmap);
        return 4;
    }
    // The fixture contains a referenced file cluster and one separate
    // allocated but unreferenced cluster. Repair must retain the file and
    // reclaim only the orphan.
    errs = DiskCheck('D', TRUE, FALSE);
    if (errs != 1 || !BlkRead(drive, bitmap, drive->fat1, 1) ||
        Bt(bitmap, 2) || !Bt(bitmap, 9))
    {
        Free(bitmap);
        return 5;
    }
    Free(bitmap);
    if (DiskCheck('D', FALSE, FALSE))
        return 6;
    return 42;
}
