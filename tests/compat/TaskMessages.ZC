// Pinned Job.ZC and SerialDev/Message.ZC signatures, cooperative bridge.
I64 msg_stage, msg_code1, msg_code2, msg_arg1, msg_arg2;
I64 msg_scan_peer_stage, msg_scan_peer_scans, msg_scan_started;
I64 msg_scan_yield_stage, msg_scan_early_peer, msg_scan_peer_bad_order;
I64 msg_scan_after_yield, msg_scan_finished, msg_scan_peer_finished;
CTask *msg_get_waiter;
I64 msg_get_started, msg_get_peer_ran, msg_get_result;

U0 MessageGetSchedulerWaiter()
{
    I64 arg = 0;
    msg_get_started = 1;
    if (MessageGet(&arg, NULL, 1 << MESSAGE_CMD) == MESSAGE_CMD)
        msg_get_result = arg;
}

U0 MessageGetSchedulerPeer()
{
    while (!msg_get_started)
        Yield;
    msg_get_peer_ran = 1;
    MessagePost(msg_get_waiter, MESSAGE_CMD, 42, 0);
}

U0 MessageReceiver(U8 *data)
{
    I64 a = 0, b = 0;
    msg_stage = 1;
    msg_code1 = MessageGet(&a, &b, 1 << MESSAGE_KEY_DOWN);
    msg_arg1 = a;
    msg_arg2 = b;
    msg_stage = 2;
    msg_code2 = MessageGet(&a, &b, 1 << MESSAGE_KEY_UP);
    msg_stage = 3;
}

U0 MessageIdleReceiver(U8 *data)
{
    MessageGet;
    LBts(&Fs->task_flags, TASKf_IDLE);
    Yield;
}

U0 MessageScanPoller()
{
    I64 a, b, i;
    msg_scan_started = 1;
    for (i = 0; i < 5; i++)
    {
        MessageScan(&a, &b, 1 << MESSAGE_CMD);
        msg_scan_peer_scans++;
        if (msg_scan_peer_stage)
            msg_scan_early_peer = 1;
    }
    msg_scan_yield_stage = 1;
    Yield;
    msg_scan_after_yield = msg_scan_peer_stage;
    msg_scan_finished = 1;
}

U0 MessageScanPeer()
{
    while (!msg_scan_started)
        Yield;
    if (msg_scan_yield_stage != 1 || msg_scan_peer_scans != 5)
        msg_scan_peer_bad_order = 1;
    msg_scan_peer_stage = 1;
    msg_scan_peer_finished = 1;
}

I64 TaskMessageSchedulingChecks()
{//Polling does not switch tasks; explicit Yield selects the next ready task.
    I64 scanner, peer, i;
    msg_scan_peer_stage = msg_scan_peer_scans = msg_scan_started = 0;
    msg_scan_yield_stage = msg_scan_early_peer = msg_scan_peer_bad_order = 0;
    msg_scan_after_yield = msg_scan_finished = msg_scan_peer_finished = 0;
    scanner = ZcTaskSpawn(&MessageScanPoller);
    peer = ZcTaskSpawn(&MessageScanPeer);
    // The GUI/session may already own earlier guest-fiber slots. Scheduling
    // order must not depend on which numeric slots Spawn reuses.
    if (scanner <= 0 || peer <= 0 || scanner == peer)
        return 1;
    // Step the cooperative scheduler from the root with a strict bound. A
    // regression must report failure instead of waiting forever if a task
    // stops yielding or cannot be resumed.
    for (i = 0; i < 16 && (!msg_scan_finished || !msg_scan_peer_finished); i++)
        ZcTaskYield;
    if (!msg_scan_finished || !msg_scan_peer_finished)
        return 12;
    // This task's first five operations are only MessageScan polls. The peer
    // must remain pending until the explicit Yield below.
    if (msg_scan_peer_scans != 5)
        return 2;
    if (msg_scan_yield_stage != 1)
        return 3;
    if (msg_scan_early_peer)
        return 4;
    if (msg_scan_after_yield != 1)
        return 5;
    if (!msg_scan_finished)
        return 6;
    if (msg_scan_peer_bad_order)
        return 7;
    // MessageGet is a wait operation: it yields so the next ready task can
    // post the event, then resumes and consumes it. MessageScan above remains
    // a pure poll and must not cause this handoff itself.
    msg_get_started = msg_get_peer_ran = msg_get_result = 0;
    msg_get_waiter = Spawn(&MessageGetSchedulerWaiter);
    peer = Spawn(&MessageGetSchedulerPeer);
    if (!msg_get_waiter || !peer)
        return 9;
    for (i = 0; i < 16 &&
            (TaskValidate(msg_get_waiter) || TaskValidate(peer)); i++)
        Yield;
    if (TaskValidate(msg_get_waiter) || TaskValidate(peer))
        return 11;
    msg_get_waiter = NULL;
    if (!msg_get_peer_ran || msg_get_result != 42)
        return 10;
    return 42;
}

I64 TaskMessageChecks()
{
    CTask *receiver, *idle;
    CJob *job;
    I64 a = 9, b = 9;
    if (MessageScan(&a, &b) || a || b)
        return 1;
    receiver = Spawn(&MessageReceiver);
    if (!receiver || ZcTaskRun != -2 || msg_stage != 1 ||
        !Bt(&receiver->task_flags, TASKf_IDLE))
        return 2;
    MessagePost(receiver, MESSAGE_MS_MOVE, 11, 12);
    MessagePost(receiver, MESSAGE_KEY_DOWN, 42, 7);
    MessagePost(receiver, MESSAGE_KEY_UP, 42, 7);
    if (Bt(&receiver->task_flags, TASKf_IDLE) ||
        receiver->server_ctrl.next_waiting == &receiver->server_ctrl ||
        ZcTaskRun != 1 || msg_stage != 3 ||
        msg_code1 != MESSAGE_KEY_DOWN || msg_code2 != MESSAGE_KEY_UP ||
        msg_arg1 != 42 || msg_arg2 != 7)
        return 3;
    job = TaskMessage(Fs, NULL, MESSAGE_KEY_DOWN_UP, 53, 8, 0);
    if (!job || job->job_code != JOBT_MESSAGE ||
        job->message_code != MESSAGE_KEY_DOWN ||
        job->aux1 != 53 || job->aux2 != 8 ||
        job->master_task || FlushMessages != 2)
        return 4;
    Message(MESSAGE_KEY_DOWN, 17, 19);
    if (MessageScan(&a, &b) != MESSAGE_KEY_DOWN || a != 17 || b != 19 ||
        MessageScan)
        return 5;
    idle = Spawn(&MessageIdleReceiver);
    if (!idle || ZcTaskRun != -2 || !Bt(&idle->task_flags, TASKf_IDLE))
        return 6;
    MessagePostWait(idle, MESSAGE_CMD, 1, 2);
    if (!TaskValidate(idle) || !Bt(&idle->task_flags, TASKf_IDLE) ||
        idle->server_ctrl.next_waiting != &idle->server_ctrl || ZcTaskRun != 1)
        return 7;
    receiver = Spawn(&MessageReceiver);
    Suspend(receiver, TRUE);
    MessagePost(receiver, MESSAGE_KEY_DOWN, 1, 2);
    if (!Kill(receiver))
        return 8;
    receiver = Spawn(&MessageReceiver);
    if (!receiver || receiver->server_ctrl.next_waiting != &receiver->server_ctrl ||
        MessageScan(NULL, NULL, ~1, receiver))
        return 9;
    Kill(receiver);
    return 42;
}

I64 TaskMessageMoveCoalesceChecks()
{//Consecutive pending pointer moves collapse without crossing key/button events.
    CJob *move, *again, *first, *key, *last;
    I64 i;
    move = TaskMessage(Fs, NULL, MESSAGE_MS_MOVE, 0, 1, 0);
    if (!move)
        return 1;
    for (i = 1; i < 512; i++)
    {
        again = TaskMessage(Fs, NULL, MESSAGE_MS_MOVE, i, i + 1, 0);
        if (again != move)
            return 2;
    }
    if (move->aux1 != 511 || move->aux2 != 512 ||
        Fs->server_ctrl.next_waiting != move ||
        Fs->server_ctrl.last_waiting != move)
        return 3;
    key = TaskMessage(Fs, NULL, MESSAGE_KEY_DOWN, 65, 30, 0);
    last = TaskMessage(Fs, NULL, MESSAGE_MS_MOVE, 700, 701, 0);
    first = Fs->server_ctrl.next_waiting;
    if (!key || !last || first != move || first->next != key ||
        key->next != last || Fs->server_ctrl.last_waiting != last ||
        move->aux1 != 511 || move->aux2 != 512 ||
        last->aux1 != 700 || last->aux2 != 701)
        return 4;
    FlushMessages(Fs);
    // Saturation may discard replaceable motion, but must retain transitions.
    // The host bridge's shared job pool has 1024 slots (not the 128-entry
    // guest-side queue size used by older message tests).
    move = TaskMessage(Fs, NULL, MESSAGE_MS_MOVE, 1, 2, 0);
    if (!move)
        return 5;
    for (i = 0; i < 1023; i++)
        if (!TaskMessage(Fs, NULL, MESSAGE_KEY_DOWN, i, 0, 0))
            return 6;
    if (TaskMessage(Fs, NULL, MESSAGE_MS_MOVE, 9, 10, 0))
        return 7;
    if (FlushMessages(Fs) != 1024)
        return 8;
    return 42;
}

I64 TaskMessageDeadlockChecks()
{
    // No task can produce a command; keyboard input cannot satisfy this mask.
    MessageGet(NULL, NULL, 1 << MESSAGE_CMD);
    return 0;
}

I64 popup_stage, popup_code, popup_arg;

U0 PopupMessageReceiver(U8 *data)
{
    I64 arg = 0;
    popup_stage = 1;
    popup_code = MessageGet(&arg, NULL, 1 << MESSAGE_CMD);
    popup_arg = arg;
    popup_stage = 2;
}

I64 PopupMessageChecks()
{
    CTask *child = Spawn(&PopupMessageReceiver);
    I64 arg = 0;
    if (!child)
        return 1;
    if (Bt(&Fs->task_flags, TASKf_FILTER_INPUT))
        return 6;
    // An ordinary child must not consume its parent's queue.
    MessagePost(Fs, MESSAGE_CMD, 7, 0);
    if (MessageScan(NULL, NULL, 1 << MESSAGE_CMD, child) ||
        MessageScan(&arg, NULL, 1 << MESSAGE_CMD) != MESSAGE_CMD || arg != 7)
        return 2;

    Fs->popup_task = child;
    if (ZcTaskRun != -2 || popup_stage != 1 ||
        !Bt(&child->task_flags, TASKf_IDLE))
        return 3;
    // Pinned Job.ZC rejects direct jobs while the parent's popup is active.
    if (TaskMessage(Fs, NULL, MESSAGE_CMD, 9, 0, 0) ||
        TaskExe(Fs, NULL, "1;", 0) || TaskText(Fs, NULL, "1;", 0) ||
        MessageScan(NULL, NULL, 1 << MESSAGE_CMD, child))
        return 7;
    LBts(&child->task_flags, TASKf_AWAITING_MESSAGE);
    // A filtering parent can still receive a bypassed message for its popup.
    LBts(&Fs->task_flags, TASKf_FILTER_INPUT);
    MessagePost(Fs, MESSAGE_CMD, 42, 0, 1 << JOBf_DONT_FILTER);
    LBtr(&Fs->task_flags, TASKf_FILTER_INPUT);
    if (Bt(&child->task_flags, TASKf_AWAITING_MESSAGE) ||
        ZcTaskRun != 1 || popup_stage != 2 ||
        popup_code != MESSAGE_CMD || popup_arg != 42)
        return 4;
    if (Fs->popup_task || MessageScan(NULL, NULL, 1 << MESSAGE_CMD) ||
        TaskValidate(child))
        return 5;
    return 42;
}

I64 TaskKeyDescriptionChecks()
{
    U32 original = Fs->win_inhibit;
    I64 ch = 9, scan = 9, result = 42;

    // Pinned MessageScan discards descriptive key events when inhibited.
    Fs->win_inhibit = original | WIF_SELF_KEY_DESC;
    MessagePost(Fs, MESSAGE_KEY_DOWN, 'D', SCF_KEY_DESC | 0x20);
    if (MessageScan(&ch, &scan, 1 << MESSAGE_KEY_DOWN) || ch || scan)
        result = 1;
    MessagePost(Fs, MESSAGE_KEY_DOWN, 'E', 0x21);
    if (!KeyScan(&ch, &scan) || ch != 'E' || scan != 0x21)
        result = 2;

    Fs->win_inhibit = original & ~WIF_SELF_KEY_DESC;
    MessagePost(Fs, MESSAGE_KEY_DOWN, 'F', SCF_KEY_DESC | 0x21);
    if (!KeyScan(&ch, &scan) || ch != 'F' || scan != (SCF_KEY_DESC | 0x21))
        result = 3;
    Fs->win_inhibit = original;
    FlushMessages;
    return result;
}
