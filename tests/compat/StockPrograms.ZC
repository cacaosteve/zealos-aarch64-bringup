I64 StockClockChecks()
{
    F64 start = tS, elapsed;
    U64 ticks = TSCGet;

    Sleep(25);
    elapsed = tS - start;
    if (TSCGet <= ticks || elapsed < 0.020 || elapsed > 10.0)
        return 1;
    return 42;
}

I64 stock_mouse_down, stock_mouse_up;
Bool stock_mouse_ready, stock_mouse_finish, stock_mouse_done;

U0 StockMouseReceiver()
{//Run inside the actual terminal task while the test injects one USB click.
    I64 code, a, b, old_inhibit = Fs->win_inhibit;

    stock_mouse_down = stock_mouse_up = 0;
    stock_mouse_finish = stock_mouse_done = FALSE;
    Fs->win_inhibit |= WIG_DBL_CLICK;
    stock_mouse_ready = TRUE;
    while (!stock_mouse_finish)
    {
        while (code = MessageScan(&a, &b))
        {
            if (code == MESSAGE_MS_L_DOWN)
                stock_mouse_down++;
            if (code == MESSAGE_MS_L_UP)
                stock_mouse_up++;
        }
        Sleep(1);
    }
    Fs->win_inhibit = old_inhibit;
    stock_mouse_done = TRUE;
}

I64 StockMouseEdgeChecks()
{
    Print("mouse_edges=%d/%d done=%d\n", stock_mouse_down, stock_mouse_up, stock_mouse_done);
    if (!stock_mouse_done || stock_mouse_down != 1 || stock_mouse_up != 1)
        return 1;
    return 42;
}

I64 StockQueueChecks()
{
    CQueue head, *node;
    I64 i;

    QueueInit(&head);
    for (i = 0; i < 3; i++)
    {
        node = CAlloc(sizeof(CQueue));
        QueueInsert(node, head.last);
    }
    if (QueueCount(&head) != 3)
        return 1;
    QueueDel(&head, TRUE);
    if (head.next != &head || head.last != &head || QueueCount(&head))
        return 2;
    QueueDel(&head, TRUE);
    return 42;
}

// SignI64 is used unchanged by Demo/Graphics/Lines.ZC. Include extreme signed
// values and indirect calls, where arithmetic-negation implementations fail.
I64 StockProgramIntrinsicChecks()
{
    I64 i, value[7] = {I64_MIN, -123456789, -1, 0, 1, 123456789, I64_MAX};
    I64 expected[7] = {-1, -1, -1, 0, 1, 1, 1};
    I64 (*sign)(I64) = &SignI64;

    for (i = 0; i < 7; i++)
        if (SignI64(value[i]) != expected[i] || (*sign)(value[i]) != expected[i])
            return 0;
    return 42;
}

I64 StockCircleIntrinsicChecks()
{//Original Circle uses Ceil; exercise floating ABI and IEEE boundary cases.
    I64 i;
    F64 value[8] = {-2.5, -2.0, -0.5, 0.0, 0.5, 2.0, 2.5, 4503599627370496.0};
    F64 expected[8] = {-2.0, -2.0, 0.0, 0.0, 1.0, 2.0, 3.0, 4503599627370496.0};
    F64 (*ceil)(F64) = &Ceil;
    F64 (*square)(F64) = &Sqr;
    U64 bits, result;

    // Test the result bits: decimal-literal conversion is not correctly
    // rounded for every input (the literal 1.5625 can be one ULP high).
    if (Sqr(-1.25)(U64) != 0x3ff9000000000000 ||
        (*square)(-1.25)(U64) != 0x3ff9000000000000 ||
        Sqr(0.0) != 0.0 || SqrU64(0xffffffffffffffff) != 1 ||
        SqrU64(0x8000000000000001) != 1 || SqrI64(I64_MIN) != 0)
        return 3;
    for (i = 0; i < 8; i++)
        if (Ceil(value[i]) != expected[i] || (*ceil)(value[i]) != expected[i])
            return 0;
    bits = 0x8000000000000001; //negative subnormal rounds to negative zero
    result = Ceil(*(&bits)(F64 *))(U64);
    if (result != 0x8000000000000000)
        return 0;
    bits = 0x7ff0000000000000; //positive infinity
    result = Ceil(*(&bits)(F64 *))(U64);
    if (result != bits)
        return 0;
    return 42;
}

I64 StockPolarCircleChecks()
{
    F64 mag, angle;
    F64 (*sin)(F64) = &Sin, (*cos)(F64) = &Cos;
    CDC *dc = DCNew(40, 40);
    I64 x, y, red = 0;

    if (!dc || Abs((*sin)(0.5) - Sin(0.5)) > 1e-12 ||
        Abs((*cos)(0.5) - Cos(0.5)) > 1e-12)
        return 1;
    R2P(&mag, &angle, 3.0, 4.0);
    if (Abs(mag - 5.0) > 1e-10 || Abs(angle - 0.927295218) > 1e-7)
        return 2;
    R2P(&mag, &angle, -3.0, 4.0);
    if (Abs(mag - 5.0) > 1e-10 || Abs(angle - 2.214297436) > 1e-7)
        return 5;
    R2P(&mag, &angle, -3.0, -4.0);
    if (Abs(angle + 2.214297436) > 1e-7)
        return 6;
    R2P(&mag, &angle, 3.0, -4.0);
    if (Abs(angle + 0.927295218) > 1e-7)
        return 7;
    DCFill(dc);
    dc->color = RED;
    GrCircle(dc, 20, 20, 10);
    for (y = 0; y < 40; y++)
        for (x = 0; x < 40; x++)
            if (GrPeek(dc, x, y) == RED)
            {
                if (x < 9 || x > 31 || y < 9 || y > 31)
                    return 3;
                red++;
            }
    DCDel(dc);
    if (red < 40 || red > 80)
        return 4;
    return 42;
}

I64 StockBrushChecks()
{//Original fat lines use the two-dimensional brush bounds in CGrGlobals.
    CDC *dc = DCNew(64, 48);
    I64 x, y, red = 0;

    DCFill(dc);
    dc->color = RED;
    dc->thick = 7;
    GrLine3(dc, 10, 10, 0, 50, 35, 0);
    for (y = 0; y < 48; y++)
        for (x = 0; x < 64; x++)
            if (GrPeek(dc, x, y) == RED)
            {
                if (x < 6 || x > 54 || y < 6 || y > 39)
                    return 1;
                red++;
            }
    DCDel(dc);
    if (red < 200 || red > 500)
        return 2;
    return 42;
}
