CBlkPool *sys_data_bp;
CBlkDevGlobals blkdev;
CTask *sys_task;
I64 sys_ctrl_alt_flags[1];

// The compatibility runtime owns the shell compiler rather than loading the
// upstream interactive lexer module. KTask.ZC's command loop is compiled but
// never called by this module-load probe.
U8 *LexStatement2Bin(CCompCtrl *cc, I64 *type)
{
    return NULL;
}

CHeapCtrl *HeapCtrlInit(CHeapCtrl *hc=NULL, CTask *task=NULL,
                        CBlkPool *bp=NULL)
{
    return hc;
}


