class CPostfixArgumentFields
{
    I64 first, second;
};

I64 PostfixArgumentIdentity(I64 value)
{
    return value;
}

I64 PostfixArgumentThird(I64 a, I64 b, I64 value, I64 d)
{
    return value;
}

I64 PostfixArgumentChecks()
{
    I64 n, result;
    CArmDocFormField field;
    n = 0;
    result = PostfixArgumentIdentity(n++);
    if (result != 0 || n != 1) return 1;
    n = 0;
    result = PostfixArgumentThird(10, 20, n++, 40);
    if (result != 0 || n != 1) return 2;
    n = 3;
    result = PostfixArgumentThird(10, 20, n--, 40);
    if (result != 3 || n != 2) return 5;
    n = 7;
    result = PostfixArgumentThird(10, 20, (n++), 40);
    if (result != 7 || n != 8) return 6;
    n = 9;
    I64 *p = &n;
    result = PostfixArgumentThird(10, 20, (*p)++, 40);
    if (result != 9 || n != 10) return 7;
    n = 0;
    result = ZcDocFormField("CPostfixArgumentFields", n++, &field);
    if (!result || n != 1 || field.offset != 0) return 3;
    result = ZcDocFormField("CPostfixArgumentFields", n++, &field);
    if (!result || n != 2 || field.offset != 8) return 4;
    return 42;
}
