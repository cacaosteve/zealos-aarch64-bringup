I64 GrSpriteSymmetryPixel(CDC *dc, I64 x, I64 y)
{
	return dc->body[y * dc->width_internal + x];
}
extern I64 ZcFbTextPixel(I64 x, I64 y);
extern I64 ZcFbGraphColor(I64 color);
extern Bool ZcFbGraphRect(I64 x, I64 y, I64 width, I64 height, U32 color,
        I64 left, I64 top, I64 right, I64 bottom, I64 task_z);
extern I64 SpritePerspectiveRect0(CDC *dc, I64 left, I64 top, I64 right,
        I64 bottom, I64 z, I64 pixel_limit, Bool symmetry_enabled,
        I64 axis_x1, I64 axis_y1, I64 axis_x2, I64 axis_y2);
extern U0 SpriteFillTriangle0(CDC *dc, I64 *px, I64 *py, I64 *pz);
extern U0 SpriteVLine0(CDC *dc, I64 x, I64 top, I64 bottom,
        I64 z_top, I64 z_bottom);

I64 GrSpriteSymmetryScanoutPixel(I64 x, I64 y)
{
	return ZcFbTextPixel(x, y);
}

I64 GrSpriteSymmetryChecks()
{
    CDC *dc;
    U8 *records;
    U8 type, pixel;
    I32 x1, y1, x2, y2, sides, z1, z2, z3;
    U8 move_code;
    I64 i, color, scan_x, scan_y, source_pixel, mirror_pixel, spline_pixels;
    I64 direct_work;
    I64 arrow_pixels;
    I64 rotated_body_pixels, rotated_scanout_pixels, rotated_work;
    I64 rotated_ellipse_scanout_pixels;
    I64 projective_bitmap_pixels, projective_polypt_pixels;
    I64 projective_text_pixels;
    I64 projective_diamond_pixels;
    I64 polygon_found, polygon_line_result;
    I64 screen_color;
    I64 projected_x, projected_y, projected_z, clip_poly_count;
    I64 line_x1, line_y1, line_x2, line_y2;
    U64 ellipse_angle_bits;
    F64 clip[4];
    F64 mesh_clip[12];
    I64 mesh_x[8], mesh_y[8], mesh_z[8];
    I32 mesh_indices[3];
    CD3I32 mesh_projected[8];

    dc = DCNew(800, 600);
    records = CAlloc(246);
    if (!dc || !records)
        return 1;
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;
    dc->color.c0 = 12;
    // Sprite3 writes indexed pixels into the CDC bitmap; keep these assertions
    // independent of the live scanout and the shell window's position.
    GrPlot(dc, 700, 550);
    if (GrSpriteSymmetryPixel(dc, 700, 550) != 12)
        return 98;
    dc->body[550 * dc->width_internal + 700] = 0;

    // Keep the packed-point-with-symmetry smoke independent of the larger
    // variable-length record stream below.
    type = SPT_PLANAR_SYMMETRY;
    MemCopy(records, &type, sizeof(U8));
    x1 = 100; y1 = 0; x2 = 100; y2 = 200;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    MemCopy(records + 16, &y2, sizeof(I32));
    type = SPT_POLYPT;
    MemCopy(records + 20, &type, sizeof(U8));
    sides = 1;
    MemCopy(records + 24, &sides, sizeof(I32));
    x1 = 20; y1 = 200;
    MemCopy(records + 28, &x1, sizeof(I32));
    MemCopy(records + 32, &y1, sizeof(I32));
    move_code = 4;
    MemCopy(records + 36, &move_code, sizeof(U8));
    Sprite3(dc, 400, 300, 0, records);
    if (GrSpriteSymmetryPixel(dc, 420, 500) != 12 ||
            GrSpriteSymmetryPixel(dc, 421, 500) != 12 ||
            GrSpriteSymmetryPixel(dc, 580, 500) != 12 ||
            GrSpriteSymmetryPixel(dc, 579, 500) != 12)
        return 99;
    MemSet(records, 0, 246);

    // A vertical symmetry axis at x=500 in screen coordinates.
    type = SPT_PLANAR_SYMMETRY;
    MemCopy(records, &type, sizeof(U8));
    x1 = 100; y1 = 0; x2 = 100; y2 = 200;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    MemCopy(records + 16, &y2, sizeof(I32));

    type = SPT_PT;
    MemCopy(records + 20, &type, sizeof(U8));
    x1 = 20; y1 = 30;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));

    type = SPT_LINE;
    MemCopy(records + 32, &type, sizeof(U8));
    x1 = 10; y1 = 50; x2 = 40; y2 = 50;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    MemCopy(records + 44, &x2, sizeof(I32));
    MemCopy(records + 48, &y2, sizeof(I32));

    type = SPT_RECT;
    MemCopy(records + 52, &type, sizeof(U8));
    x1 = 20; y1 = 60; x2 = 40; y2 = 80;
    MemCopy(records + 56, &x1, sizeof(I32));
    MemCopy(records + 60, &y1, sizeof(I32));
    MemCopy(records + 64, &x2, sizeof(I32));
    MemCopy(records + 68, &y2, sizeof(I32));

    // A circle is rasterized once on the source side and once reflected
    // across the same vertical axis.
    type = SPT_CIRCLE;
    MemCopy(records + 72, &type, sizeof(U8));
    x1 = 30; y1 = 100; x2 = 10;
    MemCopy(records + 76, &x1, sizeof(I32));
    MemCopy(records + 80, &y1, sizeof(I32));
    MemCopy(records + 84, &x2, sizeof(I32));

    type = SPT_ELLIPSE;
    MemCopy(records + 88, &type, sizeof(U8));
    x1 = 30; y1 = 140; x2 = 8; y2 = 4;
    MemCopy(records + 92, &x1, sizeof(I32));
    MemCopy(records + 96, &y1, sizeof(I32));
    MemCopy(records + 100, &x2, sizeof(I32));
    MemCopy(records + 104, &y2, sizeof(I32));

    type = SPT_POLYGON;
    MemCopy(records + 120, &type, sizeof(U8));
    x1 = 30; y1 = 180; x2 = 12; y2 = 8; sides = 4;
    MemCopy(records + 124, &x1, sizeof(I32));
    MemCopy(records + 128, &y1, sizeof(I32));
    MemCopy(records + 132, &x2, sizeof(I32));
    MemCopy(records + 136, &y2, sizeof(I32));
    MemCopy(records + 152, &sides, sizeof(I32));

    type = SPT_POLYLINE;
    MemCopy(records + 160, &type, sizeof(U8));
    sides = 2;
    MemCopy(records + 164, &sides, sizeof(I32));
    x1 = 20; y1 = 220; x2 = 40; y2 = 220;
    MemCopy(records + 168, &x1, sizeof(I32));
    MemCopy(records + 172, &y1, sizeof(I32));
    MemCopy(records + 176, &x2, sizeof(I32));
    MemCopy(records + 180, &y2, sizeof(I32));

    type = SPT_POLYPT;
    MemCopy(records + 184, &type, sizeof(U8));
    sides = 1;
    MemCopy(records + 188, &sides, sizeof(I32));
    x1 = 20; y1 = 200;
    MemCopy(records + 192, &x1, sizeof(I32));
    MemCopy(records + 196, &y1, sizeof(I32));
    move_code = 4; // one eastward 3-bit move
    MemCopy(records + 200, &move_code, sizeof(U8));

    type = SPT_BSPLINE2;
    MemCopy(records + 201, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 205, &sides, sizeof(I32));
    x1 = 20; y1 = 230; x2 = 0;
    MemCopy(records + 209, &x1, sizeof(I32));
    MemCopy(records + 213, &y1, sizeof(I32));
    MemCopy(records + 217, &x2, sizeof(I32));
    x1 = 30; y1 = 240;
    MemCopy(records + 221, &x1, sizeof(I32));
    MemCopy(records + 225, &y1, sizeof(I32));
    MemCopy(records + 229, &x2, sizeof(I32));
    x1 = 40; y1 = 230;
    MemCopy(records + 233, &x1, sizeof(I32));
    MemCopy(records + 237, &y1, sizeof(I32));
    MemCopy(records + 241, &x2, sizeof(I32));

    color = 12;
    screen_color = ZcFbGraphColor(color) & 0x00FFFFFF;
    Sprite3(dc, 400, 300, 0, records);
    if (GrSpriteSymmetryPixel(dc, 420, 330) != color ||
            GrSpriteSymmetryPixel(dc, 580, 330) != color)
        return 2;
    if (GrSpriteSymmetryScanoutPixel(410, 350) != screen_color ||
            GrSpriteSymmetryScanoutPixel(440, 350) != screen_color ||
            GrSpriteSymmetryScanoutPixel(590, 350) != screen_color ||
            GrSpriteSymmetryScanoutPixel(560, 350) != screen_color)
        return 3;
    if (GrSpriteSymmetryPixel(dc, 420, 360) != color)
        return 4;
    if (GrSpriteSymmetryScanoutPixel(580, 360) != screen_color)
        return 4;
    if (GrSpriteSymmetryScanoutPixel(570, 370) != screen_color)
        return 4;
    if (GrSpriteSymmetryPixel(dc, 439, 379) != color)
        return 4;
    if (GrSpriteSymmetryScanoutPixel(561, 379) != screen_color)
        return 4;
    if (GrSpriteSymmetryPixel(dc, 440, 400) != color ||
            GrSpriteSymmetryPixel(dc, 560, 400) != color)
        return 5;
    if (GrSpriteSymmetryPixel(dc, 438, 440) != color ||
            GrSpriteSymmetryPixel(dc, 562, 440) != color)
        return 6;
    if (GrSpriteSymmetryPixel(dc, 442, 480) != color ||
            GrSpriteSymmetryPixel(dc, 558, 480) != color)
        return 7;
    if (GrSpriteSymmetryPixel(dc, 420, 500) != color ||
            GrSpriteSymmetryPixel(dc, 580, 500) != color ||
            GrSpriteSymmetryPixel(dc, 421, 500) != color ||
            GrSpriteSymmetryPixel(dc, 579, 500) != color)
        return 9;
    spline_pixels = 0;
    for (scan_y = 520; scan_y <= 550; scan_y++)
        for (scan_x = 410; scan_x <= 490; scan_x++)
        {
            source_pixel = GrSpriteSymmetryPixel(dc, scan_x, scan_y);
            mirror_pixel = GrSpriteSymmetryPixel(dc, 1000 - scan_x, scan_y);
            if (source_pixel != mirror_pixel)
                return 10;
            if (source_pixel == color)
                spline_pixels++;
        }
    if (!spline_pixels)
        return 11;

    // Mesh records share the symmetry and transform path, but store indexed
    // 3D vertices followed by 16-byte color/index triangles.
    MemSet(records, 0, 246);
    type = SPT_MESH;
    MemCopy(records, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 4, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 8, &sides, sizeof(I32));
    x1 = 10; y1 = 10; x2 = 300;
    MemCopy(records + 12, &x1, sizeof(I32));
    MemCopy(records + 16, &y1, sizeof(I32));
    MemCopy(records + 20, &x2, sizeof(I32));
    x1 = 40; y1 = 10;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));
    MemCopy(records + 32, &x2, sizeof(I32));
    x1 = 10; y1 = 40;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    MemCopy(records + 44, &x2, sizeof(I32));
    sides = 12;
    MemCopy(records + 48, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 52, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 56, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 60, &sides, sizeof(I32));
    // Mesh checks inspect the CDC's private bitmap and depth buffer, so leave
    // screen-framebuffer mode after the screen-space symmetry probes above.
    dc->flags &= ~(DCF_SCREEN_BITMAP | DCF_ON_TOP);
    source_pixel = dc->body[320 * dc->width_internal + 420];
    mirror_pixel = dc->body[320 * dc->width_internal + 580];
    dc->color.c0 = 12;
    GrRect(dc, 420, 320, 1, 1);
    if (dc->body[320 * dc->width_internal + 420] == source_pixel)
        return 13;
    dc->color.c0 = 0;
    GrRect(dc, 420, 320, 1, 1);
    dc->color.c0 = 12;
    dc->lighting = NULL;
    Sprite3(dc, 400, 300, 0, records);
    dc->lighting = &DCLighting;
    if (dc->body[320 * dc->width_internal + 420] == source_pixel ||
            dc->body[320 * dc->width_internal + 580] != mirror_pixel)
        return 13;
    if (!DCDepthBufAlloc(dc))
        return 12;
    Sprite3(dc, 400, 300, 0, records);
    if (dc->depth_buf[320 * dc->width_internal + 420] != 300)
        return 14;
    x2 = 100;
    MemCopy(records + 20, &x2, sizeof(I32));
    x2 = 200;
    MemCopy(records + 32, &x2, sizeof(I32));
    x2 = 300;
    MemCopy(records + 44, &x2, sizeof(I32));
    Sprite3(dc, 400, 300, 0, records);
    source_pixel = dc->depth_buf[320 * dc->width_internal + 420];
    if (source_pixel < 190 || source_pixel > 210)
        return 15;
    x2 = 50;
    MemCopy(records + 20, &x2, sizeof(I32));
    MemCopy(records + 32, &x2, sizeof(I32));
    MemCopy(records + 44, &x2, sizeof(I32));
    Sprite3(dc, 400, 300, 0, records);
    if (dc->depth_buf[320 * dc->width_internal + 420] != 50)
        return 16;
    x2 = 200;
    MemCopy(records + 20, &x2, sizeof(I32));
    MemCopy(records + 32, &x2, sizeof(I32));
    MemCopy(records + 44, &x2, sizeof(I32));
    Sprite3(dc, 400, 300, 0, records);
    if (dc->depth_buf[320 * dc->width_internal + 420] != 50)
        return 17;

    // Mesh z coordinates must follow the CDC's active 3D transform too.
    for (i = 0; i < 16; i++)
        dc->r[i] = 0;
    dc->r[0] = 0x100000000;
    dc->r[5] = 0x100000000;
    dc->r[10] = 2 * 0x100000000;
    dc->r[15] = 0x100000000;
    dc->depth_buf[320 * dc->width_internal + 420] = I32_MAX;
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_MESH;
    MemCopy(records + 1, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 5, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 9, &sides, sizeof(I32));
    x1 = 10; y1 = 10; x2 = 10;
    MemCopy(records + 13, &x1, sizeof(I32));
    MemCopy(records + 17, &y1, sizeof(I32));
    MemCopy(records + 21, &x2, sizeof(I32));
    x1 = 40; y1 = 10;
    MemCopy(records + 25, &x1, sizeof(I32));
    MemCopy(records + 29, &y1, sizeof(I32));
    MemCopy(records + 33, &x2, sizeof(I32));
    x1 = 10; y1 = 40;
    MemCopy(records + 37, &x1, sizeof(I32));
    MemCopy(records + 41, &y1, sizeof(I32));
    MemCopy(records + 45, &x2, sizeof(I32));
    sides = 12;
    MemCopy(records + 49, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 53, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 57, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 61, &sides, sizeof(I32));
    Sprite3(dc, 400, 300, 5, records);
    if (dc->depth_buf[320 * dc->width_internal + 420] != 30)
        return 18;

    // Adjacent triangles must cover the shared diagonal without leaving
    // depth-buffer holes in the interior of their combined rectangle.
    MemSet(records, 0, 246);
    type = SPT_MESH;
    MemCopy(records, &type, sizeof(U8));
    sides = 4;
    MemCopy(records + 4, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 8, &sides, sizeof(I32));
    x1 = 200; y1 = 200; z1 = 60;
    MemCopy(records + 12, &x1, sizeof(I32));
    MemCopy(records + 16, &y1, sizeof(I32));
    MemCopy(records + 20, &z1, sizeof(I32));
    x1 = 230; y1 = 200;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));
    MemCopy(records + 32, &z1, sizeof(I32));
    x1 = 230; y1 = 230;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    MemCopy(records + 44, &z1, sizeof(I32));
    x1 = 200; y1 = 230;
    MemCopy(records + 48, &x1, sizeof(I32));
    MemCopy(records + 52, &y1, sizeof(I32));
    MemCopy(records + 56, &z1, sizeof(I32));
    sides = 12;
    MemCopy(records + 60, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 64, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 68, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 72, &sides, sizeof(I32));
    sides = 12;
    MemCopy(records + 76, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 80, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 84, &sides, sizeof(I32));
    sides = 3;
    MemCopy(records + 88, &sides, sizeof(I32));
    for (scan_y = 501; scan_y < 530; scan_y++)
        for (scan_x = 601; scan_x < 630; scan_x++)
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
    Sprite3(dc, 400, 300, 0, records);
    for (scan_y = 501; scan_y < 530; scan_y++)
        for (scan_x = 601; scan_x < 630; scan_x++)
            if (dc->depth_buf[scan_y * dc->width_internal + scan_x] != 60)
                return 20;

    // Horizontal clipping must advance the interpolated depth at x=0.
    MemSet(records, 0, 246);
    type = SPT_MESH;
    MemCopy(records, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 4, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 8, &sides, sizeof(I32));
    x1 = -20; y1 = 0; z1 = 100;
    MemCopy(records + 12, &x1, sizeof(I32));
    MemCopy(records + 16, &y1, sizeof(I32));
    MemCopy(records + 20, &z1, sizeof(I32));
    x1 = 20; y1 = 0; z2 = 200;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));
    MemCopy(records + 32, &z2, sizeof(I32));
    x1 = 20; y1 = 40; z3 = 300;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    MemCopy(records + 44, &z3, sizeof(I32));
    sides = 12;
    MemCopy(records + 48, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 52, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 56, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 60, &sides, sizeof(I32));
    dc->depth_buf[110 * dc->width_internal] = I32_MAX;
    Sprite3(dc, 0, 100, 0, records);
    source_pixel = dc->depth_buf[110 * dc->width_internal];
    if (source_pixel < 173 || source_pixel > 177)
        return 21;

    // A triangle crossing the top edge must retain the original edge depth
    // slopes when its visible scanlines begin at y=0.
    MemSet(records, 0, 246);
    type = SPT_MESH;
    MemCopy(records, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 4, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 8, &sides, sizeof(I32));
    x1 = 100; y1 = -20; z1 = 100;
    MemCopy(records + 12, &x1, sizeof(I32));
    MemCopy(records + 16, &y1, sizeof(I32));
    MemCopy(records + 20, &z1, sizeof(I32));
    x1 = 140; y1 = -20; z2 = 200;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));
    MemCopy(records + 32, &z2, sizeof(I32));
    x1 = 100; y1 = 20; z3 = 300;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    MemCopy(records + 44, &z3, sizeof(I32));
    sides = 12;
    MemCopy(records + 48, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 52, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 56, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 60, &sides, sizeof(I32));
    dc->depth_buf[0 * dc->width_internal + 110] = I32_MAX;
    Sprite3(dc, 0, 0, 0, records);
    source_pixel = dc->depth_buf[110];
    if (source_pixel < 223 || source_pixel > 227)
        return 22;

    // Shiftable meshes add their own xyz origin before the CDC transform.
    MemSet(records, 0, 246);
    type = SPT_SHIFTABLE_MESH;
    MemCopy(records, &type, sizeof(U8));
    x1 = 30; y1 = 40; x2 = 0;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    sides = 3;
    MemCopy(records + 16, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 20, &sides, sizeof(I32));
    x1 = 5; y1 = 5;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));
    x1 = 35; y1 = 5;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    x1 = 5; y1 = 35;
    MemCopy(records + 48, &x1, sizeof(I32));
    MemCopy(records + 52, &y1, sizeof(I32));
    sides = 12;
    MemCopy(records + 60, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 64, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 68, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 72, &sides, sizeof(I32));
    dc->body[350 * dc->width_internal + 440] = 0;
    dc->body[350 * dc->width_internal + 560] = 0;
    source_pixel = dc->body[350 * dc->width_internal + 440];
    mirror_pixel = dc->body[350 * dc->width_internal + 560];
    DCDepthBufReset(dc);
    dc->color.c0 = 12;
    dc->lighting = NULL;
    Sprite3(dc, 400, 300, 0, records);
    if (dc->body[350 * dc->width_internal + 440] == source_pixel ||
            dc->body[350 * dc->width_internal + 560] != mirror_pixel)
        return 19;

    // A non-cardinal affine Z turn must carry all indexed mesh vertices
    // through Sprite3 and fill an interior pixel of the transformed triangle.
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_MESH;
    MemCopy(records + 1, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 5, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 9, &sides, sizeof(I32));
    x1 = 300; y1 = 0; z1 = 10;
    MemCopy(records + 13, &x1, sizeof(I32));
    MemCopy(records + 17, &y1, sizeof(I32));
    MemCopy(records + 21, &z1, sizeof(I32));
    x1 = 340;
    MemCopy(records + 25, &x1, sizeof(I32));
    MemCopy(records + 29, &y1, sizeof(I32));
    MemCopy(records + 33, &z1, sizeof(I32));
    x1 = 300; y1 = 40;
    MemCopy(records + 37, &x1, sizeof(I32));
    MemCopy(records + 41, &y1, sizeof(I32));
    MemCopy(records + 45, &z1, sizeof(I32));
    sides = 12;
    MemCopy(records + 49, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 53, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 57, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 61, &sides, sizeof(I32));
    Mat4x4IdentEqu(dc->r);
    Mat4x4RotZ(dc->r, 1.0);
    for (scan_y = 245; scan_y <= 295; scan_y++)
        for (scan_x = 120; scan_x <= 190; scan_x++)
        {
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
        }
    Sprite3(dc, 0, 0, 0, records);
    if (!dc->body[275 * dc->width_internal + 158])
        return 23;

    // Projective line clipping below is asserted against the live scanout;
    // the preceding mesh probes deliberately used the private CDC bitmap.
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;

    // Indexed meshes share point sprites' homogeneous projection. With
    // w=1+z/10, this triangle's x/y coordinates halve and its z becomes 5.
    dc->x = dc->y = dc->z = 0;
    Mat4x4IdentEqu(dc->r);
    dc->r[14] = 0x1999999A;
    if (!SpriteMatrixTransformDefault0(dc))
        return 27;
    if (!SpritePerspectiveClip0(dc, 200, 120, 10, clip) ||
            !SpritePerspectiveProject0(dc, clip, &projected_x,
            &projected_y, &projected_z) || projected_x != 100 ||
            projected_y != 60 || projected_z != 5)
        return 28;
    if (!SpritePerspectiveClip0(dc, 280, 120, 10, mesh_clip) ||
            !SpritePerspectiveClip0(dc, 200, 200, 10, mesh_clip + 4))
        return 29;
    if (!SpritePerspectiveProject0(dc, mesh_clip, &projected_x,
            &projected_y, &projected_z) || projected_z != 5 ||
            !SpritePerspectiveProject0(dc, mesh_clip + 4, &projected_x,
            &projected_y, &projected_z) || projected_z != 5)
        return 31;
    for (i = 0; i < 4; i++)
        mesh_clip[8 + i] = clip[i];
    mesh_indices[0] = 0;
    mesh_indices[1] = 1;
    mesh_indices[2] = 2;
    if (SpritePerspectiveClipTriangle0(dc, mesh_clip, mesh_indices,
            mesh_x, mesh_y, mesh_z, mesh_projected) != 3 ||
            mesh_z[0] != 5 || mesh_z[1] != 5 || mesh_z[2] != 5 ||
            mesh_projected[0].z != 5 || mesh_projected[1].z != 5 ||
            mesh_projected[2].z != 5)
        return 30;

    // Projective sprite lines must clip a huge source endpoint before the
    // bounded integer projection. The visible half of this segment crosses
    // the left CDC edge at x=0 and remains drawable through x=100.
    Mat4x4IdentEqu(dc->r);
    dc->r[14] = 0x1999999A;
    dc->x = dc->y = dc->z = 0;
    if (SpriteTransformLine0(dc, TRUE, -5000000, 200, 10,
            200, 200, 10, &line_x1, &line_y1, &line_x2, &line_y2) != 1)
        return 33;
    if (line_x1 != 0 || line_y1 != 100 || line_x2 != 100 ||
            line_y2 != 100)
        return 34;
    ZcFbGraphRect(0, 100, 150, 1, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    screen_color = ZcFbGraphColor(12);
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_LINE;
    MemCopy(records + 1, &type, sizeof(U8));
    x1 = -5000000; y1 = 200; x2 = 200; y2 = 200;
    MemCopy(records + 5, &x1, sizeof(I32));
    MemCopy(records + 9, &y1, sizeof(I32));
    MemCopy(records + 13, &x2, sizeof(I32));
    MemCopy(records + 17, &y2, sizeof(I32));
    Sprite3(dc, 0, 0, 10, records);
    if (GrSpriteSymmetryScanoutPixel(50, 100) != screen_color ||
            GrSpriteSymmetryScanoutPixel(120, 100) != ZcFbGraphColor(0))
        return 32;

    // Projective polylines must keep later visible segments when an earlier
    // segment begins outside the viewport. Each edge is clipped before its
    // raster work is charged and before it reaches the framebuffer.
    ZcFbGraphRect(0, 100, 150, 101, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_POLYLINE;
    MemCopy(records + 1, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 5, &sides, sizeof(I32));
    x1 = -5000000; y1 = 200; x2 = 200; y2 = 200;
    MemCopy(records + 9, &x1, sizeof(I32));
    MemCopy(records + 13, &y1, sizeof(I32));
    MemCopy(records + 17, &x2, sizeof(I32));
    MemCopy(records + 21, &y2, sizeof(I32));
    x2 = 200; y2 = 400;
    MemCopy(records + 25, &x2, sizeof(I32));
    MemCopy(records + 29, &y2, sizeof(I32));
    Sprite3(dc, 0, 0, 10, records);
    if (GrSpriteSymmetryScanoutPixel(50, 100) != screen_color ||
            GrSpriteSymmetryScanoutPixel(100, 150) != screen_color ||
            GrSpriteSymmetryScanoutPixel(120, 100) != ZcFbGraphColor(0))
        return 35;

    // A projective rectangle crossing the left CDC edge must clip its fill
    // and outline instead of dropping the shape when one corner is remote.
    ZcFbGraphRect(0, 200, 150, 201, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    for (scan_y = 200; scan_y <= 450; scan_y++)
        for (scan_x = 0; scan_x <= 150; scan_x++)
        {
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
        }
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_RECT;
    MemCopy(records + 1, &type, sizeof(U8));
    x1 = -5000000; y1 = 400; x2 = 200; y2 = 800;
    dc->color.c0 = 12;
    SpriteVLine0(dc, 50, 200, 300, 10, 10);
    if (dc->body[250 * dc->width_internal + 50] != 12)
        return 0x400;
    for (scan_y = 200; scan_y <= 450; scan_y++)
        for (scan_x = 0; scan_x <= 150; scan_x++)
        {
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
        }
    mesh_x[0] = 0; mesh_y[0] = 400; mesh_z[0] = 10;
    mesh_x[1] = 0; mesh_y[1] = 200; mesh_z[1] = 10;
    mesh_x[2] = 100; mesh_y[2] = 200; mesh_z[2] = 10;
    SpriteFillTriangle0(dc, mesh_x, mesh_y, mesh_z);
    if (dc->body[250 * dc->width_internal + 50] != 12)
        return 0x300;
    for (scan_y = 200; scan_y <= 450; scan_y++)
        for (scan_x = 0; scan_x <= 150; scan_x++)
        {
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
        }
    direct_work = SpritePerspectiveRect0(dc, x1, y1, x2, y2, 10,
            480000, FALSE, 0, 0, 0, 0);
    if (direct_work < 0)
        return 0x100 + direct_work;
    if (dc->body[250 * dc->width_internal + 50] != 12)
        return 0x200;
    for (scan_y = 200; scan_y <= 450; scan_y++)
        for (scan_x = 0; scan_x <= 150; scan_x++)
        {
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
        }
    MemCopy(records + 5, &x1, sizeof(I32));
    MemCopy(records + 9, &y1, sizeof(I32));
    MemCopy(records + 13, &x2, sizeof(I32));
    MemCopy(records + 17, &y2, sizeof(I32));
    Sprite3(dc, 0, 0, 10, records);
    if (dc->body[250 * dc->width_internal + 50] != 12)
        return 36;
    if (GrSpriteSymmetryScanoutPixel(50, 200) != screen_color)
        return 37;
    if (dc->body[250 * dc->width_internal + 120])
        return 38;
    if (dc->body[450 * dc->width_internal + 50])
        return 39;

    // A regular polygon whose left vertices cross w=0 must retain the visible
    // part of its right edge after near-plane and viewport clipping.
    ZcFbGraphRect(0, 0, 800, 600, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    Mat4x4IdentEqu(dc->r);
    dc->r[3] = 3000 * 0x100000000;
    dc->r[7] = -400 * 0x100000000;
    dc->r[12] = 0x00100000; // w = 1 + x / 4096
    dc->x = dc->y = dc->z = 0;
    dc->width = 800;
    dc->height = 600;
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;
    screen_color = ZcFbGraphColor(12);
    for (scan_y = 0; scan_y < 600; scan_y++)
        for (scan_x = 0; scan_x < 800; scan_x++)
        {
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
        }
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_POLYGON;
    MemCopy(records + 1, &type, sizeof(U8));
    x1 = -4096; y1 = 300; x2 = 4096; y2 = 180;
    MemCopy(records + 5, &x1, sizeof(I32));
    MemCopy(records + 9, &y1, sizeof(I32));
    MemCopy(records + 13, &x2, sizeof(I32));
    MemCopy(records + 17, &y2, sizeof(I32));
    sides = 4;
    MemCopy(records + 33, &sides, sizeof(I32));
    polygon_line_result = SpriteTransformLine0(dc, TRUE,
            -4096, 480, 0, 0, 300, 0,
            &line_x1, &line_y1, &line_x2, &line_y2);
    if (polygon_line_result != 1 || line_x1 != 0 || line_x2 != 799)
        return 41;
    Sprite3(dc, 0, 0, 0, records);
    polygon_found = FALSE;
    for (scan_y = 0; scan_y < 600 && !polygon_found; scan_y++)
        if (GrSpriteSymmetryPixel(dc, 400, scan_y) == 12)
            polygon_found = TRUE;
    if (!polygon_found)
        return 40;
    if (GrSpriteSymmetryPixel(dc, 400, 200) != 0)
        return 43;

    // A projective quadratic spline begins behind the near plane and crosses
    // the viewport after perspective division. Sampling source-space control
    // points and clipping each projected segment must preserve that arc.
    ZcFbGraphRect(0, 0, 800, 600, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    Mat4x4IdentEqu(dc->r);
    dc->r[3] = 3000 * 0x100000000;
    dc->r[12] = 0x00100000; // w = 1 + x / 4096
    dc->x = dc->y = dc->z = 0;
    dc->width = 800;
    dc->height = 600;
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;
    screen_color = ZcFbGraphColor(12);
    for (scan_y = 0; scan_y < 600; scan_y++)
        for (scan_x = 0; scan_x < 800; scan_x++)
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_BSPLINE2;
    MemCopy(records + 1, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 5, &sides, sizeof(I32));
    x1 = -4096; y1 = 60; z1 = 0;
    MemCopy(records + 9, &x1, sizeof(I32));
    MemCopy(records + 13, &y1, sizeof(I32));
    MemCopy(records + 17, &z1, sizeof(I32));
    x1 = 0;
    MemCopy(records + 21, &x1, sizeof(I32));
    MemCopy(records + 25, &y1, sizeof(I32));
    MemCopy(records + 29, &z1, sizeof(I32));
    x1 = 4096;
    MemCopy(records + 33, &x1, sizeof(I32));
    MemCopy(records + 37, &y1, sizeof(I32));
    MemCopy(records + 41, &z1, sizeof(I32));
    polygon_line_result = SpriteTransformLine0(dc, TRUE,
            -3000, 60, 0, -2800, 60, 0,
            &line_x1, &line_y1, &line_x2, &line_y2);
    if (polygon_line_result != 1 || line_x1 < 0 || line_x1 > 1 ||
            line_x2 < 632 || line_x2 > 634 || line_y1 < 220 ||
            line_y1 > 226 || line_y2 < 188 || line_y2 > 193)
        return 46;
    dc->color.c0 = 12;
    spline_pixels = SpriteBSpline0(dc, 0, 0, records + 1,
            SPT_BSPLINE2, TRUE, 0, 480000, FALSE,
            0, 0, 0, 0);
    if (spline_pixels <= 0)
        return 47;
    polygon_found = FALSE;
    for (scan_y = 150; scan_y <= 260 && !polygon_found; scan_y++)
        for (scan_x = 380; scan_x <= 420 && !polygon_found; scan_x++)
            if (GrSpriteSymmetryScanoutPixel(scan_x, scan_y) == screen_color)
                polygon_found = TRUE;
    if (!polygon_found)
        return 49;
    ZcFbGraphRect(0, 0, 800, 600, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    for (scan_y = 0; scan_y < 600; scan_y++)
        for (scan_x = 0; scan_x < 800; scan_x++)
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;
    dc->color.c0 = 12;
    Sprite3(dc, 0, 0, 0, records);
    polygon_found = FALSE;
    for (scan_y = 150; scan_y <= 260 && !polygon_found; scan_y++)
        for (scan_x = 380; scan_x <= 420 && !polygon_found; scan_x++)
            if (GrSpriteSymmetryScanoutPixel(scan_x, scan_y) == screen_color)
                polygon_found = TRUE;
    if (!polygon_found)
        return 44;
    if (GrSpriteSymmetryPixel(dc, 700, 500) != 0)
        return 45;

    // Projective ellipses retain visible arcs when their source-space outline
    // crosses w=0 and the CDC viewport. Test the public ellipse record rather
    // than projecting each midpoint sample independently.
    ZcFbGraphRect(0, 0, 800, 600, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    Mat4x4IdentEqu(dc->r);
    dc->r[3] = 3000 * 0x100000000;
    dc->r[12] = 0x00100000;
    dc->x = dc->y = dc->z = 0;
    dc->width = 800;
    dc->height = 600;
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;
    dc->color.c0 = 12;
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_ELLIPSE;
    MemCopy(records + 1, &type, sizeof(U8));
    x1 = -4096; y1 = 60; x2 = 4096; y2 = 60;
    MemCopy(records + 5, &x1, sizeof(I32));
    MemCopy(records + 9, &y1, sizeof(I32));
    MemCopy(records + 13, &x2, sizeof(I32));
    MemCopy(records + 17, &y2, sizeof(I32));
    ellipse_angle_bits = 0;
    MemCopy(records + 25, &ellipse_angle_bits, sizeof(U64));
    Sprite3(dc, 0, 0, 0, records);
    polygon_found = FALSE;
    for (scan_y = 280; scan_y <= 500 && !polygon_found; scan_y++)
        for (scan_x = 250; scan_x <= 550 && !polygon_found; scan_x++)
            if (GrSpriteSymmetryScanoutPixel(scan_x, scan_y) == screen_color)
                polygon_found = TRUE;
    if (!polygon_found)
        return 50;

    // A rotated source ellipse must retain a clipped projective arc too.
    // This catches regressions where the dispatcher drops the angle when it
    // selects the homogeneous near-plane path.
    ZcFbGraphRect(0, 0, 800, 600, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    for (scan_y = 0; scan_y < 600; scan_y++)
        for (scan_x = 0; scan_x < 800; scan_x++)
        {
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
        }
    Mat4x4IdentEqu(dc->r);
    dc->r[3] = 3000 * 0x100000000;
    dc->r[7] = 1100 * 0x100000000;
    dc->r[12] = 0x00100000;
    dc->x = dc->y = dc->z = 0;
    dc->width = 800;
    dc->height = 600;
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;
    dc->color.c0 = 12;
    ellipse_angle_bits = 0x3FE921FB54442D18; // pi/4
    MemCopy(records + 25, &ellipse_angle_bits, sizeof(U64));
    Sprite3(dc, 0, 0, 0, records);
    rotated_ellipse_scanout_pixels = 0;
    for (scan_y = 0; scan_y < 600; scan_y++)
        for (scan_x = 0; scan_x < 800; scan_x++)
            if (GrSpriteSymmetryScanoutPixel(scan_x, scan_y) == screen_color)
                rotated_ellipse_scanout_pixels++;
    if (rotated_ellipse_scanout_pixels < 20 ||
            rotated_ellipse_scanout_pixels > 20000)
        return 64;
    if (GrSpriteSymmetryScanoutPixel(700, 550) == screen_color)
        return 65;

    // The circle opcode uses the same projective outline path and must keep a
    // small visible arc instead of dropping samples behind the near plane.
    ZcFbGraphRect(0, 0, 800, 600, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    Mat4x4IdentEqu(dc->r);
    dc->r[3] = 4000 * 0x100000000;
    dc->r[7] = -399 * 0x100000000;
    dc->r[12] = 0x00100000;
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_CIRCLE;
    MemCopy(records + 1, &type, sizeof(U8));
    x1 = -4096; y1 = 400; x2 = 100;
    MemCopy(records + 5, &x1, sizeof(I32));
    MemCopy(records + 9, &y1, sizeof(I32));
    MemCopy(records + 13, &x2, sizeof(I32));
    Sprite3(dc, 0, 0, 0, records);
    polygon_found = FALSE;
    for (scan_y = 100; scan_y <= 400 && !polygon_found; scan_y++)
        for (scan_x = 80; scan_x <= 240 && !polygon_found; scan_x++)
            if (GrSpriteSymmetryScanoutPixel(scan_x, scan_y) == screen_color)
                polygon_found = TRUE;
    if (!polygon_found)
        return 51;

    // Projective arrows clip a source endpoint behind the near plane and keep
    // the visible body and arrowhead in scanout when the tip remains visible.
    ZcFbGraphRect(0, 0, 800, 600, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    Mat4x4IdentEqu(dc->r);
    dc->r[3] = 3000 * 0x100000000;
    dc->r[12] = 0x00100000; // x'=x+3000, w=1+x/4096
    dc->x = dc->y = dc->z = 0;
    dc->width = 800;
    dc->height = 600;
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;
    dc->color.c0 = 12;
    for (scan_y = 0; scan_y < 600; scan_y++)
        for (scan_x = 0; scan_x < 800; scan_x++)
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = 26; // SPT_ARROW
    MemCopy(records + 1, &type, sizeof(U8));
    x1 = -5000; y1 = 60; x2 = -2800;
    MemCopy(records + 5, &x1, sizeof(I32));
    MemCopy(records + 9, &y1, sizeof(I32));
    MemCopy(records + 13, &x2, sizeof(I32));
    MemCopy(records + 17, &y1, sizeof(I32));
    polygon_line_result = SpriteTransformLine0(dc, TRUE,
            x1, y1, 0, x2, y1, 0,
            &line_x1, &line_y1, &line_x2, &line_y2);
    if (polygon_line_result != 1 || line_x1 != 0 || line_x2 < 632 ||
            line_x2 > 634 || line_y2 < 188 || line_y2 > 193)
        return 52;
    Sprite3(dc, 0, 0, 0, records);
    arrow_pixels = 0;
    for (scan_y = 150; scan_y <= 250; scan_y++)
        for (scan_x = 0; scan_x <= 650; scan_x++)
            if (GrSpriteSymmetryScanoutPixel(scan_x, scan_y) == screen_color)
                arrow_pixels++;
    if (arrow_pixels < 500 || arrow_pixels > 900)
        return 53;

    // A non-cardinal rotated rectangle stays in source space through the
    // perspective transform, then clips to the left CDC viewport edge.
    ZcFbGraphRect(0, 0, 800, 600, ZcFbGraphColor(0),
            0, 0, 799, 599, 0);
    for (scan_y = 0; scan_y < 600; scan_y++)
        for (scan_x = 0; scan_x < 800; scan_x++)
        {
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
        }
    Mat4x4IdentEqu(dc->r);
    dc->r[3] = 0;
    dc->r[12] = 0x00100000;
    dc->x = dc->y = dc->z = 0;
    dc->width = 800;
    dc->height = 600;
    dc->color.c0 = 12;
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = 13; // SPT_ROTATED_RECT
    MemCopy(records + 1, &type, sizeof(U8));
    x1 = -1000; y1 = 1000; x2 = 500; y2 = 1200;
    MemCopy(records + 5, &x1, sizeof(I32));
    MemCopy(records + 9, &y1, sizeof(I32));
    MemCopy(records + 13, &x2, sizeof(I32));
    MemCopy(records + 17, &y2, sizeof(I32));
    ellipse_angle_bits = 0x3FE921FB54442D18; // pi/4
    MemCopy(records + 25, &ellipse_angle_bits, sizeof(U64));
    // Exercise the source-space rotated helper before checking the public
    // Sprite3 record path below.
    rotated_work = SpriteRotatedRect0(dc, 0, 0, x1, y1, x2, y2,
            ellipse_angle_bits, TRUE, 0, 480000);
    if (rotated_work < 0)
        return 59;
    if (rotated_work < 100)
        return 60;
    rotated_body_pixels = 0;
    for (scan_y = 0; scan_y < 600; scan_y++)
        for (scan_x = 0; scan_x < 800; scan_x++)
            if (dc->body[scan_y * dc->width_internal + scan_x] == 12)
                rotated_body_pixels++;
    if (rotated_body_pixels < 100)
        return 61;
    for (scan_y = 0; scan_y < 600; scan_y++)
        for (scan_x = 0; scan_x < 800; scan_x++)
        {
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
        }
    Sprite3(dc, 0, 0, 0, records);
    rotated_body_pixels = 0;
    rotated_scanout_pixels = 0;
    for (scan_y = 0; scan_y < 600; scan_y++)
        for (scan_x = 0; scan_x < 800; scan_x++)
        {
            if (dc->body[scan_y * dc->width_internal + scan_x] == 12)
                rotated_body_pixels++;
            if (GrSpriteSymmetryScanoutPixel(scan_x, scan_y) == screen_color)
                rotated_scanout_pixels++;
        }
