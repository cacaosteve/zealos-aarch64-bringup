    for (scan_y = 140; scan_y <= 240; scan_y++)
        for (scan_x = 280; scan_x <= 450; scan_x++)
            if (GrSpriteSymmetryScanoutPixel(scan_x, scan_y) ==
                    ZcFbGraphColor(14))
                projective_diamond_pixels++;
    if (projective_diamond_pixels < 8)
        return 267;

    DCDel(dc);
    Free(records);
    return 0x2a;
}
