extern I64 ZcFbTextPixel(I64 x, I64 y);
extern Bool ZcFbGraphPlot(I64 x, I64 y, U32 color, I64 left, I64 top,
        I64 right, I64 bottom, I64 task_z);

I64 GrSpriteSymmetryChecks()
{
    CDC *dc;
    U8 *records;
    U8 type;
    I32 x1, y1, x2, y2, sides, z1, z2, z3;
    U8 move_code;
    I64 i, color, scan_x, scan_y, source_pixel, mirror_pixel, spline_pixels;

    dc = DCNew(800, 600);
    records = CAlloc(246);
    if (!dc || !records)
        return 1;
    dc->flags |= DCF_SCREEN_BITMAP | DCF_ON_TOP;
    dc->color.c0 = 12;
    // Prime the graphics bridge before checking streamed Sprite3 output.
    GrPlot(dc, 420, 500);
    if (ZcFbTextPixel(420, 500) != 0x00FF5555)
        return 98;
    ZcFbGraphPlot(420, 500, 0, 0, 0, 799, 599, 0);

    // Keep the packed-point-with-symmetry smoke independent of the larger
    // variable-length record stream below.
    type = SPT_PLANAR_SYMMETRY;
    MemCopy(records, &type, sizeof(U8));
    x1 = 100; y1 = 0; x2 = 100; y2 = 200;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    MemCopy(records + 16, &y2, sizeof(I32));
    type = SPT_POLYPT;
    MemCopy(records + 20, &type, sizeof(U8));
    sides = 1;
    MemCopy(records + 24, &sides, sizeof(I32));
    x1 = 20; y1 = 200;
    MemCopy(records + 28, &x1, sizeof(I32));
    MemCopy(records + 32, &y1, sizeof(I32));
    move_code = 4;
    MemCopy(records + 36, &move_code, sizeof(U8));
    Sprite3(dc, 400, 300, 0, records);
    if (ZcFbTextPixel(420, 500) != 0x00FF5555 ||
            ZcFbTextPixel(421, 500) != 0x00FF5555 ||
            ZcFbTextPixel(580, 500) != 0x00FF5555 ||
            ZcFbTextPixel(579, 500) != 0x00FF5555)
        return 99;
    ZcFbGraphPlot(420, 500, 0, 0, 0, 799, 599, 0);
    ZcFbGraphPlot(421, 500, 0, 0, 0, 799, 599, 0);
    ZcFbGraphPlot(580, 500, 0, 0, 0, 799, 599, 0);
    ZcFbGraphPlot(579, 500, 0, 0, 0, 799, 599, 0);
    MemSet(records, 0, 246);

    // A vertical symmetry axis at x=500 in screen coordinates.
    type = SPT_PLANAR_SYMMETRY;
    MemCopy(records, &type, sizeof(U8));
    x1 = 100; y1 = 0; x2 = 100; y2 = 200;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    MemCopy(records + 16, &y2, sizeof(I32));

    type = SPT_PT;
    MemCopy(records + 20, &type, sizeof(U8));
    x1 = 20; y1 = 30;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));

    type = SPT_LINE;
    MemCopy(records + 32, &type, sizeof(U8));
    x1 = 10; y1 = 50; x2 = 40; y2 = 50;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    MemCopy(records + 44, &x2, sizeof(I32));
    MemCopy(records + 48, &y2, sizeof(I32));

    type = SPT_RECT;
    MemCopy(records + 52, &type, sizeof(U8));
    x1 = 20; y1 = 60; x2 = 40; y2 = 80;
    MemCopy(records + 56, &x1, sizeof(I32));
    MemCopy(records + 60, &y1, sizeof(I32));
    MemCopy(records + 64, &x2, sizeof(I32));
    MemCopy(records + 68, &y2, sizeof(I32));

    // A circle is rasterized once on the source side and once reflected
    // across the same vertical axis.
    type = SPT_CIRCLE;
    MemCopy(records + 72, &type, sizeof(U8));
    x1 = 30; y1 = 100; x2 = 10;
    MemCopy(records + 76, &x1, sizeof(I32));
    MemCopy(records + 80, &y1, sizeof(I32));
    MemCopy(records + 84, &x2, sizeof(I32));

    type = SPT_ELLIPSE;
    MemCopy(records + 88, &type, sizeof(U8));
    x1 = 30; y1 = 140; x2 = 8; y2 = 4;
    MemCopy(records + 92, &x1, sizeof(I32));
    MemCopy(records + 96, &y1, sizeof(I32));
    MemCopy(records + 100, &x2, sizeof(I32));
    MemCopy(records + 104, &y2, sizeof(I32));

    type = SPT_POLYGON;
    MemCopy(records + 120, &type, sizeof(U8));
    x1 = 30; y1 = 180; x2 = 12; y2 = 8; sides = 4;
    MemCopy(records + 124, &x1, sizeof(I32));
    MemCopy(records + 128, &y1, sizeof(I32));
    MemCopy(records + 132, &x2, sizeof(I32));
    MemCopy(records + 136, &y2, sizeof(I32));
    MemCopy(records + 152, &sides, sizeof(I32));

    type = SPT_POLYLINE;
    MemCopy(records + 160, &type, sizeof(U8));
    sides = 2;
    MemCopy(records + 164, &sides, sizeof(I32));
    x1 = 20; y1 = 220; x2 = 40; y2 = 220;
    MemCopy(records + 168, &x1, sizeof(I32));
    MemCopy(records + 172, &y1, sizeof(I32));
    MemCopy(records + 176, &x2, sizeof(I32));
    MemCopy(records + 180, &y2, sizeof(I32));

    type = SPT_POLYPT;
    MemCopy(records + 184, &type, sizeof(U8));
    sides = 1;
    MemCopy(records + 188, &sides, sizeof(I32));
    x1 = 20; y1 = 200;
    MemCopy(records + 192, &x1, sizeof(I32));
    MemCopy(records + 196, &y1, sizeof(I32));
    move_code = 4; // one eastward 3-bit move
    MemCopy(records + 200, &move_code, sizeof(U8));

    type = SPT_BSPLINE2;
    MemCopy(records + 201, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 205, &sides, sizeof(I32));
    x1 = 20; y1 = 230; x2 = 0;
    MemCopy(records + 209, &x1, sizeof(I32));
    MemCopy(records + 213, &y1, sizeof(I32));
    MemCopy(records + 217, &x2, sizeof(I32));
    x1 = 30; y1 = 240;
    MemCopy(records + 221, &x1, sizeof(I32));
    MemCopy(records + 225, &y1, sizeof(I32));
    MemCopy(records + 229, &x2, sizeof(I32));
    x1 = 40; y1 = 230;
    MemCopy(records + 233, &x1, sizeof(I32));
    MemCopy(records + 237, &y1, sizeof(I32));
    MemCopy(records + 241, &x2, sizeof(I32));

    color = 0x00FF5555;
    Sprite3(dc, 400, 300, 0, records);
    if (ZcFbTextPixel(420, 330) != color ||
            ZcFbTextPixel(580, 330) != color)
        return 2;
    if (ZcFbTextPixel(410, 350) != color ||
            ZcFbTextPixel(440, 350) != color ||
            ZcFbTextPixel(590, 350) != color ||
            ZcFbTextPixel(560, 350) != color)
        return 3;
    if (ZcFbTextPixel(420, 360) != color)
        return 4;
    if (ZcFbTextPixel(580, 360) != color)
        return 4;
    if (ZcFbTextPixel(570, 370) != color)
        return 4;
    if (ZcFbTextPixel(439, 379) != color)
        return 4;
    if (ZcFbTextPixel(561, 379) != color)
        return 4;
    if (ZcFbTextPixel(440, 400) != color ||
            ZcFbTextPixel(560, 400) != color)
        return 5;
    if (ZcFbTextPixel(438, 440) != color ||
            ZcFbTextPixel(562, 440) != color)
        return 6;
    if (ZcFbTextPixel(442, 480) != color ||
            ZcFbTextPixel(558, 480) != color)
        return 7;
    if (ZcFbTextPixel(420, 500) != color ||
            ZcFbTextPixel(580, 500) != color ||
            ZcFbTextPixel(421, 500) != color ||
            ZcFbTextPixel(579, 500) != color)
        return 9;
    spline_pixels = 0;
    for (scan_y = 520; scan_y <= 550; scan_y++)
        for (scan_x = 410; scan_x <= 490; scan_x++)
        {
            source_pixel = ZcFbTextPixel(scan_x, scan_y);
            mirror_pixel = ZcFbTextPixel(1000 - scan_x, scan_y);
            if (source_pixel != mirror_pixel)
                return 10;
            if (source_pixel == color)
                spline_pixels++;
        }
    if (!spline_pixels)
        return 11;

    // Mesh records share the symmetry and transform path, but store indexed
    // 3D vertices followed by 16-byte color/index triangles.
    MemSet(records, 0, 246);
    type = SPT_MESH;
    MemCopy(records, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 4, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 8, &sides, sizeof(I32));
    x1 = 10; y1 = 10; x2 = 300;
    MemCopy(records + 12, &x1, sizeof(I32));
    MemCopy(records + 16, &y1, sizeof(I32));
    MemCopy(records + 20, &x2, sizeof(I32));
    x1 = 40; y1 = 10;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));
    MemCopy(records + 32, &x2, sizeof(I32));
    x1 = 10; y1 = 40;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    MemCopy(records + 44, &x2, sizeof(I32));
    sides = 12;
    MemCopy(records + 48, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 52, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 56, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 60, &sides, sizeof(I32));
    // Mesh checks inspect the CDC's private bitmap and depth buffer, so leave
    // screen-framebuffer mode after the screen-space symmetry probes above.
    dc->flags &= ~(DCF_SCREEN_BITMAP | DCF_ON_TOP);
    source_pixel = dc->body[320 * dc->width_internal + 420];
    mirror_pixel = dc->body[320 * dc->width_internal + 580];
    dc->color.c0 = 12;
    GrRect(dc, 420, 320, 1, 1);
    if (dc->body[320 * dc->width_internal + 420] == source_pixel)
        return 13;
    dc->color.c0 = 0;
    GrRect(dc, 420, 320, 1, 1);
    dc->color.c0 = 12;
    dc->lighting = NULL;
    Sprite3(dc, 400, 300, 0, records);
    dc->lighting = &DCLighting;
    if (dc->body[320 * dc->width_internal + 420] == source_pixel ||
            dc->body[320 * dc->width_internal + 580] != mirror_pixel)
        return 13;
    if (!DCDepthBufAlloc(dc))
        return 12;
    Sprite3(dc, 400, 300, 0, records);
    if (dc->depth_buf[320 * dc->width_internal + 420] != 300)
        return 14;
    x2 = 100;
    MemCopy(records + 20, &x2, sizeof(I32));
    x2 = 200;
    MemCopy(records + 32, &x2, sizeof(I32));
    x2 = 300;
    MemCopy(records + 44, &x2, sizeof(I32));
    Sprite3(dc, 400, 300, 0, records);
    source_pixel = dc->depth_buf[320 * dc->width_internal + 420];
    if (source_pixel < 190 || source_pixel > 210)
        return 15;
    x2 = 50;
    MemCopy(records + 20, &x2, sizeof(I32));
    MemCopy(records + 32, &x2, sizeof(I32));
    MemCopy(records + 44, &x2, sizeof(I32));
    Sprite3(dc, 400, 300, 0, records);
    if (dc->depth_buf[320 * dc->width_internal + 420] != 50)
        return 16;
    x2 = 200;
    MemCopy(records + 20, &x2, sizeof(I32));
    MemCopy(records + 32, &x2, sizeof(I32));
    MemCopy(records + 44, &x2, sizeof(I32));
    Sprite3(dc, 400, 300, 0, records);
    if (dc->depth_buf[320 * dc->width_internal + 420] != 50)
        return 17;

    // Mesh z coordinates must follow the CDC's active 3D transform too.
    for (i = 0; i < 16; i++)
        dc->r[i] = 0;
    dc->r[0] = 0x100000000;
    dc->r[5] = 0x100000000;
    dc->r[10] = 2 * 0x100000000;
    dc->r[15] = 0x100000000;
    dc->depth_buf[320 * dc->width_internal + 420] = I32_MAX;
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_MESH;
    MemCopy(records + 1, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 5, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 9, &sides, sizeof(I32));
    x1 = 10; y1 = 10; x2 = 10;
    MemCopy(records + 13, &x1, sizeof(I32));
    MemCopy(records + 17, &y1, sizeof(I32));
    MemCopy(records + 21, &x2, sizeof(I32));
    x1 = 40; y1 = 10;
    MemCopy(records + 25, &x1, sizeof(I32));
    MemCopy(records + 29, &y1, sizeof(I32));
    MemCopy(records + 33, &x2, sizeof(I32));
    x1 = 10; y1 = 40;
    MemCopy(records + 37, &x1, sizeof(I32));
    MemCopy(records + 41, &y1, sizeof(I32));
    MemCopy(records + 45, &x2, sizeof(I32));
    sides = 12;
    MemCopy(records + 49, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 53, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 57, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 61, &sides, sizeof(I32));
    Sprite3(dc, 400, 300, 5, records);
    if (dc->depth_buf[320 * dc->width_internal + 420] != 30)
        return 18;

    // Adjacent triangles must cover the shared diagonal without leaving
    // depth-buffer holes in the interior of their combined rectangle.
    MemSet(records, 0, 246);
    type = SPT_MESH;
    MemCopy(records, &type, sizeof(U8));
    sides = 4;
    MemCopy(records + 4, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 8, &sides, sizeof(I32));
    x1 = 200; y1 = 200; z1 = 60;
    MemCopy(records + 12, &x1, sizeof(I32));
    MemCopy(records + 16, &y1, sizeof(I32));
    MemCopy(records + 20, &z1, sizeof(I32));
    x1 = 230; y1 = 200;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));
    MemCopy(records + 32, &z1, sizeof(I32));
    x1 = 230; y1 = 230;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    MemCopy(records + 44, &z1, sizeof(I32));
    x1 = 200; y1 = 230;
    MemCopy(records + 48, &x1, sizeof(I32));
    MemCopy(records + 52, &y1, sizeof(I32));
    MemCopy(records + 56, &z1, sizeof(I32));
    sides = 12;
    MemCopy(records + 60, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 64, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 68, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 72, &sides, sizeof(I32));
    sides = 12;
    MemCopy(records + 76, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 80, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 84, &sides, sizeof(I32));
    sides = 3;
    MemCopy(records + 88, &sides, sizeof(I32));
    for (scan_y = 501; scan_y < 530; scan_y++)
        for (scan_x = 601; scan_x < 630; scan_x++)
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
    Sprite3(dc, 400, 300, 0, records);
    for (scan_y = 501; scan_y < 530; scan_y++)
        for (scan_x = 601; scan_x < 630; scan_x++)
            if (dc->depth_buf[scan_y * dc->width_internal + scan_x] != 60)
                return 20;

    // Horizontal clipping must advance the interpolated depth at x=0.
    MemSet(records, 0, 246);
    type = SPT_MESH;
    MemCopy(records, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 4, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 8, &sides, sizeof(I32));
    x1 = -20; y1 = 0; z1 = 100;
    MemCopy(records + 12, &x1, sizeof(I32));
    MemCopy(records + 16, &y1, sizeof(I32));
    MemCopy(records + 20, &z1, sizeof(I32));
    x1 = 20; y1 = 0; z2 = 200;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));
    MemCopy(records + 32, &z2, sizeof(I32));
    x1 = 20; y1 = 40; z3 = 300;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    MemCopy(records + 44, &z3, sizeof(I32));
    sides = 12;
    MemCopy(records + 48, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 52, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 56, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 60, &sides, sizeof(I32));
    dc->depth_buf[110 * dc->width_internal] = I32_MAX;
    Sprite3(dc, 0, 100, 0, records);
    source_pixel = dc->depth_buf[110 * dc->width_internal];
    if (source_pixel < 173 || source_pixel > 177)
        return 21;

    // A triangle crossing the top edge must retain the original edge depth
    // slopes when its visible scanlines begin at y=0.
    MemSet(records, 0, 246);
    type = SPT_MESH;
    MemCopy(records, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 4, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 8, &sides, sizeof(I32));
    x1 = 100; y1 = -20; z1 = 100;
    MemCopy(records + 12, &x1, sizeof(I32));
    MemCopy(records + 16, &y1, sizeof(I32));
    MemCopy(records + 20, &z1, sizeof(I32));
    x1 = 140; y1 = -20; z2 = 200;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));
    MemCopy(records + 32, &z2, sizeof(I32));
    x1 = 100; y1 = 20; z3 = 300;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    MemCopy(records + 44, &z3, sizeof(I32));
    sides = 12;
    MemCopy(records + 48, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 52, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 56, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 60, &sides, sizeof(I32));
    dc->depth_buf[0 * dc->width_internal + 110] = I32_MAX;
    Sprite3(dc, 0, 0, 0, records);
    source_pixel = dc->depth_buf[110];
    if (source_pixel < 223 || source_pixel > 227)
        return 22;

    // Shiftable meshes add their own xyz origin before the CDC transform.
    MemSet(records, 0, 246);
    type = SPT_SHIFTABLE_MESH;
    MemCopy(records, &type, sizeof(U8));
    x1 = 30; y1 = 40; x2 = 0;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    sides = 3;
    MemCopy(records + 16, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 20, &sides, sizeof(I32));
    x1 = 5; y1 = 5;
    MemCopy(records + 24, &x1, sizeof(I32));
    MemCopy(records + 28, &y1, sizeof(I32));
    x1 = 35; y1 = 5;
    MemCopy(records + 36, &x1, sizeof(I32));
    MemCopy(records + 40, &y1, sizeof(I32));
    x1 = 5; y1 = 35;
    MemCopy(records + 48, &x1, sizeof(I32));
    MemCopy(records + 52, &y1, sizeof(I32));
    sides = 12;
    MemCopy(records + 60, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 64, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 68, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 72, &sides, sizeof(I32));
    dc->body[350 * dc->width_internal + 440] = 0;
    dc->body[350 * dc->width_internal + 560] = 0;
    source_pixel = dc->body[350 * dc->width_internal + 440];
    mirror_pixel = dc->body[350 * dc->width_internal + 560];
    DCDepthBufReset(dc);
    dc->color.c0 = 12;
    dc->lighting = NULL;
    Sprite3(dc, 400, 300, 0, records);
    if (dc->body[350 * dc->width_internal + 440] == source_pixel ||
            dc->body[350 * dc->width_internal + 560] != mirror_pixel)
        return 19;

    // A non-cardinal affine Z turn must carry all indexed mesh vertices
    // through Sprite3 and fill an interior pixel of the transformed triangle.
    MemSet(records, 0, 246);
    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_MESH;
    MemCopy(records + 1, &type, sizeof(U8));
    sides = 3;
    MemCopy(records + 5, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 9, &sides, sizeof(I32));
    x1 = 300; y1 = 0; z1 = 10;
    MemCopy(records + 13, &x1, sizeof(I32));
    MemCopy(records + 17, &y1, sizeof(I32));
    MemCopy(records + 21, &z1, sizeof(I32));
    x1 = 340;
    MemCopy(records + 25, &x1, sizeof(I32));
    MemCopy(records + 29, &y1, sizeof(I32));
    MemCopy(records + 33, &z1, sizeof(I32));
    x1 = 300; y1 = 40;
    MemCopy(records + 37, &x1, sizeof(I32));
    MemCopy(records + 41, &y1, sizeof(I32));
    MemCopy(records + 45, &z1, sizeof(I32));
    sides = 12;
    MemCopy(records + 49, &sides, sizeof(I32));
    sides = 0;
    MemCopy(records + 53, &sides, sizeof(I32));
    sides = 1;
    MemCopy(records + 57, &sides, sizeof(I32));
    sides = 2;
    MemCopy(records + 61, &sides, sizeof(I32));
    Mat4x4IdentEqu(dc->r);
    Mat4x4RotZ(dc->r, 1.0);
    for (scan_y = 245; scan_y <= 295; scan_y++)
        for (scan_x = 120; scan_x <= 190; scan_x++)
        {
            dc->body[scan_y * dc->width_internal + scan_x] = 0;
            dc->depth_buf[scan_y * dc->width_internal + scan_x] = I32_MAX;
        }
    Sprite3(dc, 0, 0, 0, records);
    if (!dc->body[275 * dc->width_internal + 158])
        return 23;

    DCDel(dc);
    Free(records);
    return 0x2a;
}
