// Verify HomeSys boot time, first-terminal Once and the two-window layout.
U64 *ctrl_alt_font_standard, *ctrl_alt_font_auxiliary;

I64 HomeAutoStartChecks()
{
    CTask *term = bootstrap_gui_terminal_task;
    CTask *second = bootstrap_gui_terminal_home_second;
    I64 i;
    U8 *saved;

    if (!Bt(&sys_run_level, RLf_HOME) ||
        !TaskValidate(term) || !TaskValidate(second)) return 1;
    if (term->win_top != second->win_top || term->win_bottom != second->win_bottom ||
        term->win_left != 1 || term->win_right >= TEXT_COLS / 2 ||
        second->win_left <= term->win_right || second->win_right >= TEXT_COLS ||
        (term->win_left <= second->win_right && second->win_left <= term->win_right))
        return 3;
    for (i = 0; i < 500; i++)
    {
        saved = DocSave(term->put_doc);
        if (saved && StrMatch("Boot Time:", saved) &&
            StrMatch("HOME_AUTO_ONCE_42", saved))
        {
            Free(saved);
            return 42;
        }
        Free(saved);
        Yield;
    }
    return 2;
}

// The root startup path calls KeyDevInit and registers Ctrl-Alt-F. Verify
// queued key messages dispatch that callback and restore the standard font.
I64 CtrlAltFontDispatchChecks()
{
    U64 *standard = text.font(U64 *);
    U64 *auxiliary = text.aux_font(U64 *);
    I64 ch, scan;

    if (!standard || !auxiliary || standard == auxiliary)
        return 1;
    if (!keydev.fp_ctrl_alt_cbs)
        return 10;
    if (!keydev.fp_ctrl_alt_cbs['F' - 'A'])
        return 11;
    ctrl_alt_font_standard = standard;
    ctrl_alt_font_auxiliary = auxiliary;
    Message(MESSAGE_KEY_DOWN, 'f', SCF_CTRL | SCF_ALT);
    if (MessageScan(&ch, &scan, 1 << MESSAGE_KEY_DOWN))
        return 4;
    if (text.font != auxiliary || text.aux_font != standard)
        return 2;
    Message(MESSAGE_KEY_DOWN, 'f', SCF_CTRL | SCF_ALT);
    if (MessageScan(&ch, &scan, 1 << MESSAGE_KEY_DOWN))
        return 5;
    if (text.font != standard || text.aux_font != auxiliary)
        return 3;
    return 42;
}

I64 CtrlAltFontStateAux()
{
    if (text.font == ctrl_alt_font_auxiliary &&
        text.aux_font == ctrl_alt_font_standard)
        return 42;
    return 0;
}

I64 CtrlAltFontStateStandard()
{
    if (text.font == ctrl_alt_font_standard &&
        text.aux_font == ctrl_alt_font_auxiliary)
        return 42;
    return 0;
}

I64 CtrlAltFontMapChecks()
{
    KeyMapCtrlAltFamily(TRUE, FALSE);
    return 42;
}

I64 KeyMapFamilyChecks()
{
    KeyMapFamily(Fs, 0, TRUE, TRUE);
    KeyMapFamily(Fs, SCF_CTRL, TRUE, TRUE);
    KeyMapFamily(Fs, SCF_ALT, TRUE, TRUE);
    return 42;
}
