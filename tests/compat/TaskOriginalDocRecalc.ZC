// Smoke coordinate math and a plain-text layout pass from unchanged DocRecalc.ZC.
extern I64 ZcFbTextCellsDrawn();
extern I64 ZcFbTextPixel(I64 x, I64 y);

U0 WindowRedrawPark(U8 *data)
{
    Puts("K");
    Print("P");
    while (TRUE)
        ZcTaskYield;
}

I64 window_draw_calls = 0;
I64 window_control_draw_calls = 0;
CCtrl window_test_control;

U0 WindowControlDraw(CDC *dc, CCtrl *ctrl)
{
    window_control_draw_calls++;
    dc->color.c0.color = RED;
    dc->color.c0.rop = ROPB_MONO;
    GrPlot(dc, ctrl->left, ctrl->top);
}

U0 WindowDrawSmoke(CTask *task, CDC *dc)
{
    window_draw_calls++;
    if (task)
    {
        dc->color.c0.color = RED;
        dc->color.c0.rop = ROPB_MONO;
        GrPlot(dc, 10, 10);
        GrRect(dc, 20, 10, 3, 2);
        GrLine(dc, 12, 10, 17, 10, 1, 0);
        GrPrint(dc, 40, 10, "%s", "A");
    }
}

U0 WindowParentUnderlay(CTask *task, CDC *dc)
{
    if (task)
    {
        dc->color.c0.color = RED;
        dc->color.c0.rop = ROPB_MONO;
        GrPlot(dc, 90, 100);
    }
}

I64 TaskOriginalDocRecalcChecks()
{
    CDoc *doc;
    CDocEntry *entry;
    CTask *overlap;
    CCtrl *old_ctrl_head, *old_ctrl_tail;
    U0 (*old_root_draw)(CTask *task, CDC *dc);
    I64 x, y, old_left, old_right, old_top, old_bottom;
    I64 old_width, old_height, old_scroll_x, old_scroll_y;
    I64 old_display_flags, old_win_inhibit, old_text_attr;
    I64 old_text_cells, outside_pixel;
    U32 attr_cells[2];

    DocInit;
    doc = DocNew;
    if (!doc || doc->doc_signature != DOC_SIGNATURE_VAL)
        return 1;
    Fs->put_doc = Fs->display_doc = doc;
    DocPrint(doc, "x");
    entry = doc->head.next;
    if (entry == doc)
        return 2;
    if (entry->type_u8 != DOCT_TEXT || !entry->tag || entry->tag[0] != 'x')
        return 8;
    if (!(entry->de_flags & DOCEF_TAG))
        return 9;

    entry->de_flags = DOCEF_MARGIN_REL_X | DOCEF_LEFT_X | DOCEF_TOP_Y;
    x = 0;
    y = 5;
    DocRecalcXY(doc, entry, 3, 0, 40, 20, 2, 38, 7, 5, &x, &y);
    if (x != 2 || y != 5)
        return 3;

    entry->de_flags = DOCEF_RIGHT_X;
    x = 0;
    y = 5;
    DocRecalcXY(doc, entry, 3, 0, 40, 20, 2, 38, 7, 5, &x, &y);
    if (x != 44 || y != 5)
        return 4;
    if (!(doc->flags & DOCF_BWD_MOVEMENT))
        return 5;

    // Run unchanged DocRecalc through a plain-text layout pass. NORMAL
    // exercises layout without invoking framebuffer or cursor APIs.
    old_left = Fs->win_left; old_right = Fs->win_right;
    old_top = Fs->win_top; old_bottom = Fs->win_bottom;
    old_width = Fs->win_width; old_height = Fs->win_height;
    old_scroll_x = Fs->scroll_x; old_scroll_y = Fs->scroll_y;
    old_display_flags = Fs->display_flags;
    Fs->win_left = 0; Fs->win_right = 79;
    Fs->win_top = 0; Fs->win_bottom = 24;
    Fs->win_width = 80; Fs->win_height = 25;
    Fs->scroll_x = Fs->scroll_y = 0;
    TextRect(0, 79, 0, 24, 0x0800);
    entry->de_flags = DOCEF_TAG;
    doc->flags |= DOCF_PLAIN_TEXT;
    if (!DocRecalc(doc, RECALCt_NORMAL))
        return 6;
    if (entry->x != 0)
        return 71;
    if (entry->y != 0)
        return 72;
    if (doc->min_x != 0)
        return 73;
    if (doc->min_y != 0)
        return 74;
    if (doc->max_x < 1)
        return 75;
    // TO_SCREEN must reach the real bootstrap framebuffer text primitive.
    // Suppress border/cursor work so this isolates plain DolDoc text output.
    old_text_cells = ZcFbTextCellsDrawn();
    Fs->display_flags |= 1 << DISPLAYf_NO_BORDER;
    TextLenStr(Fs, 1, 2, 1, WHITE << 8, "T");
    if (ZcFbTextCellsDrawn() <= old_text_cells)
    {
        Fs->display_flags = old_display_flags;
        return 78;
    }
    if (ZcFbTextPixel(9, 16) != 0x00ffffff || ZcFbTextPixel(8, 16) != 0)
    {
        Fs->display_flags = old_display_flags;
        return 80;
    }
    if (!TextLenStr(Fs, -1, 4, 2, WHITE << 8, "AB") ||
        TextLenStr(Fs, -3, 4, 2, WHITE << 8, "AB") ||
        ZcFbTextPixel(1, 32) != 0x00ffffff || ZcFbTextPixel(0, 32) != 0)
    {
        Fs->display_flags = old_display_flags;
        return 103;
    }
    old_text_cells = ZcFbTextCellsDrawn();
    attr_cells[0] = 0x0e00 | 'A';
    attr_cells[1] = 0x0400 | 'B';
    TextLenAttrStr(Fs, 4, 2, 2, attr_cells);
    if (ZcFbTextCellsDrawn() < old_text_cells + 2)
    {
        Fs->display_flags = old_display_flags;
        return 79;
    }
    if (!TextLenAttrStr(Fs, -1, 5, 2, attr_cells) ||
        TextLenAttrStr(Fs, -3, 5, 2, attr_cells) ||
        ZcFbTextPixel(1, 40) != 0x00aa0000)
    {
        Fs->display_flags = old_display_flags;
        return 104;
    }
    if (ZcFbTextPixel(33, 18) != 0x00ffff55)
    {
        Fs->display_flags = old_display_flags;
        return 81;
    }
    if (!TextChar(Fs, FALSE, 3, 3, 0x0f00 | 'T'))
    {
        Fs->display_flags = old_display_flags;
        return 82;
    }
    if (ZcFbTextPixel(25, 24) != 0x00ffffff)
    {
        Fs->display_flags = old_display_flags;
        return 83;
    }
    old_text_cells = ZcFbTextCellsDrawn();
    if (!TextLenAttr(Fs, 3, 3, 1, 0x4e00) ||
        ZcFbTextCellsDrawn() != old_text_cells ||
        ZcFbTextPixel(25, 24) != 0x00ffffff)
    {
        Fs->display_flags = old_display_flags;
        return 95;
    }
    if (TextChar(Fs, FALSE, 80, 3, 0x0e00 | 'B'))
    {
        Fs->display_flags = old_display_flags;
        return 84;
    }
    if (!TextChar(Fs, TRUE, 80, 3, 0x0e00 | 'B') ||
        ZcFbTextPixel(641, 24) != 0x00ffff55)
    {
        Fs->display_flags = old_display_flags;
        return 85;
    }
    old_text_cells = ZcFbTextCellsDrawn();
    if (!TextLenAttr(Fs, 10, 3, 3, 0x4e00) ||
        ZcFbTextCellsDrawn() != old_text_cells + 3 ||
        ZcFbTextPixel(80, 24) != 0x00aa0000)
    {
        Fs->display_flags = old_display_flags;
        return 86;
    }
    old_text_cells = ZcFbTextCellsDrawn();
    outside_pixel = ZcFbTextPixel(648, 24);
    if (!TextLenAttr(Fs, 79, 3, 3, 0x4e00))
    {
        Fs->display_flags = old_display_flags;
        return 87;
    }
    if (ZcFbTextCellsDrawn() != old_text_cells + 1)
    {
        Fs->display_flags = old_display_flags;
        return 88;
    }
    if (ZcFbTextPixel(632, 24) != 0x00aa0000)
    {
        Fs->display_flags = old_display_flags;
        return 89;
    }
    if (ZcFbTextPixel(648, 24) != outside_pixel)
    {
        Fs->display_flags = old_display_flags;
        return 90;
    }
    old_text_cells = ZcFbTextCellsDrawn();
    TextBorder(Fs, 5, 7, 5, 6, 0x0e, FALSE);
    if (ZcFbTextCellsDrawn() != old_text_cells + 14)
    {
        Fs->display_flags = old_display_flags;
        return 91;
    }
    old_text_cells = ZcFbTextCellsDrawn();
    TextBorder(Fs, 5, 7, 5, 6, 0x0e, TRUE);
    if (ZcFbTextCellsDrawn() != old_text_cells + 14)
    {
        Fs->display_flags = old_display_flags;
        return 92;
    }
    TextRect(3, 3, 3, 3, 0x4000);
    if (ZcFbTextPixel(25, 24) != 0x00aa0000)
    {
        Fs->display_flags = old_display_flags;
        return 93;
    }
    if (ZcFbTextFlush(gr.text_base, 100, 75) <= 0 ||
        ZcFbTextPixel(25, 24) != 0x00aa0000)
    {
        Fs->display_flags = old_display_flags;
        return 94;
    }
    // Upstream GrTextBase assembly writes packed cells directly through
    // gr.text_base. Verify the guest-owned plane is what the framebuffer flush
    // presents, independent of the TextChar/TextRect host entry points.
    gr.text_base[60 * 100 + 90] = 0x4f20;
    if (ZcFbTextFlush(gr.text_base, 100, 75) <= 0 ||
        ZcFbTextPixel(720, 480) != 0x00aa0000)
    {
        Fs->display_flags = old_display_flags;
        return 103;
    }
    gr.text_base[60 * 100 + 90] = 0x0800;
    ZcFbTextFlush(gr.text_base, 100, 75);
    old_text_cells = ZcFbTextCellsDrawn();
    if (!DocRecalc(doc, RECALCt_TO_SCREEN))
    {
        Fs->display_flags = old_display_flags;
        return 76;
    }
    if (ZcFbTextCellsDrawn() <= old_text_cells)
    {
        Fs->display_flags = old_display_flags;
        return 77;
    }
    old_text_cells = ZcFbTextCellsDrawn();
    GrUpdateTaskWin(Fs);
    if (ZcFbTextCellsDrawn() < old_text_cells + 80 * 25)
    {
        Fs->display_flags = old_display_flags;
        return 96;
    }

    // The generic control pass draws visible callbacks without applying the
    // document scroll, and ignores hidden controls.
    old_ctrl_head = Fs->next_ctrl;
    old_ctrl_tail = Fs->last_ctrl;
    window_test_control.next = &Fs->next_ctrl;
    window_test_control.last = &Fs->next_ctrl;
    window_test_control.win_task = Fs;
    window_test_control.flags = CTRLF_SHOW;
    window_test_control.left = 32;
    window_test_control.top = 32;
    window_test_control.draw_it = &WindowControlDraw;
    Fs->next_ctrl = Fs->last_ctrl = &window_test_control;
    Fs->scroll_x = 5;
    Fs->scroll_y = 6;
    window_control_draw_calls = 0;
    DrawCtrls(Fs);
    if (window_control_draw_calls != 1 ||
        ZcFbTextPixel(32, 32) != 0x00aa0000 ||
        Fs->scroll_x != 5 || Fs->scroll_y != 6)
    {
        Fs->next_ctrl = old_ctrl_head;
        Fs->last_ctrl = old_ctrl_tail;
        Fs->scroll_x = Fs->scroll_y = 0;
        Fs->display_flags = old_display_flags;
        return 114;
    }
    window_test_control.flags = 0;
    DrawCtrls(Fs);
    Fs->next_ctrl = old_ctrl_head;
    Fs->last_ctrl = old_ctrl_tail;
    Fs->scroll_x = Fs->scroll_y = 0;
    if (window_control_draw_calls != 1)
    {
        Fs->display_flags = old_display_flags;
        return 115;
    }

    // GrUpdateTasks must redraw a complete visible task ring in z order.
    // Give a queued child an overlapping rectangle and a different
    // blank-cell background; check both the child and exposed parent area.
    old_win_inhibit = Fs->win_inhibit;
    old_text_attr = Fs->text_attr;
    overlap = Spawn(&WindowRedrawPark, NULL, "RedrawOverlap");
    if (!overlap)
    {
        Fs->display_flags = old_display_flags;
        return 97;
    }
    Fs->display_flags = (1 << DISPLAYf_SHOW) | (1 << DISPLAYf_NO_BORDER);
    Fs->win_inhibit |= 1 << WIF_SELF_DOC;
    Fs->text_attr = 0x40;
    if (!WinHorz(10, 29, overlap) || !WinVert(10, 19, overlap) ||
        overlap->win_width != 20 || overlap->win_height != 10 ||
        overlap->pix_left != 80 || overlap->pix_right != 239 ||
        overlap->pix_top != 80 || overlap->pix_bottom != 159)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 105;
    }
    overlap->display_flags = (1 << DISPLAYf_SHOW) | (1 << DISPLAYf_NO_BORDER);
    overlap->win_inhibit |= 1 << WIF_SELF_DOC;
    overlap->text_attr = 0x20;
    overlap->draw_it = &WindowDrawSmoke;
    old_root_draw = Fs->draw_it;
    Fs->draw_it = &WindowParentUnderlay;
    window_draw_calls = 0;
    old_text_cells = ZcFbTextCellsDrawn();
    ZcTaskYield;
    GrUpdateTasks;
    Fs->draw_it = old_root_draw;
    if (!window_draw_calls)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 109;
    }
    if (ZcFbTextCellsDrawn() < old_text_cells + 80 * 25 + 20 * 10 + 4)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 98;
    }
    if (ZcFbTextPixel(1, 1) != 0x00aa0000)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 100;
    }
    if (ZcFbTextPixel(81, 80) != 0)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 101;
    }
    if (ZcFbTextPixel(90, 90) != 0x00aa0000)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 106;
    }
    if (ZcFbTextPixel(96, 90) != 0x00aa0000)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 107;
    }
    if (ZcFbTextPixel(94, 90) != 0x00aa0000)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 108;
    }
    if (ZcFbTextPixel(101, 90) != 0x00aa0000)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 110;
    }
    if (ZcFbTextPixel(123, 90) != 0x00aa0000)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 111;
    }
    // The child's green blank-cell background must cover a graphic pixel
    // drawn earlier by the parent in their overlapping area.
    if (ZcFbTextPixel(90, 100) != 0x0000aa00)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 112;
    }
    x = WinProgressBarsChecks(overlap);
    if (x != 42)
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return x;
    }
    if (!ZcFbShellTextCompose(gr.text_base, 100))
    {
        Kill(overlap);
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 102;
    }
    if (!Kill(overlap))
    {
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 99;
    }
    Fs->draw_it = &WindowParentUnderlay;
    GrUpdateTasks;
    Fs->draw_it = old_root_draw;
    if (ZcFbTextPixel(90, 100) != 0x00aa0000)
    {
        Fs->display_flags = old_display_flags;
        Fs->win_inhibit = old_win_inhibit;
        Fs->text_attr = old_text_attr;
        return 113;
    }
    Fs->display_flags = old_display_flags;
    Fs->win_inhibit = old_win_inhibit;
    Fs->text_attr = old_text_attr;
    Fs->win_left = old_left; Fs->win_right = old_right;
    Fs->win_top = old_top; Fs->win_bottom = old_bottom;
    Fs->win_width = old_width; Fs->win_height = old_height;
    Fs->scroll_x = old_scroll_x; Fs->scroll_y = old_scroll_y;
    return 42;
}
