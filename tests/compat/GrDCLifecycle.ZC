I64 GrDCLifecycleChecks()
{
	CDC *dc, *alias, *null_dc;
	dc = DCNew(13, 3);
	if (!dc || dc->dc_signature != DCS_SIGNATURE_VAL ||
			dc->width != 13 || dc->width_internal != 8 || dc->height != 3 ||
			!dc->body || dc->r[0 * 4 + 0].i32[1] != 1 ||
			dc->r[1 * 4 + 1].i32[1] != 1 ||
			dc->r[2 * 4 + 2].i32[1] != 1 ||
			dc->r[3 * 4 + 3].i32[1] != 1)
		return 1;
	if (dc->body[0] || dc->body[23] || DCSize(dc) <= 0)
		return 2;

	dc->body[0] = 0x5A;
	dc->body[23] = 0xA5;
	alias = DCAlias(dc);
	if (!alias || alias == dc || alias->dc_signature != DCS_SIGNATURE_VAL ||
			!(alias->flags & DCF_ALIAS) || alias->alias != dc ||
			alias->body != dc->body || alias->r == dc->r ||
			alias->mem_task != Fs || alias->win_task != Fs ||
			alias->body[0] != 0x5A || alias->body[23] != 0xA5)
		return 3;
	alias->body[7] = 0xC3;
	if (dc->body[7] != 0xC3)
		return 4;
	DCDel(alias);
	if (dc->dc_signature != DCS_SIGNATURE_VAL || dc->body[0] != 0x5A ||
			dc->body[7] != 0xC3 || dc->body[23] != 0xA5)
		return 5;

	null_dc = DCNew(8, 2, NULL, TRUE);
	if (!null_dc || null_dc->dc_signature != DCS_SIGNATURE_VAL ||
			null_dc->body || !(null_dc->flags & DCF_DONT_DRAW))
		return 6;
	DCDel(null_dc);
	if (dc->dc_signature != DCS_SIGNATURE_VAL || dc->body[7] != 0xC3)
		return 7;
	DCDel(dc);
	return 42;
}

I64 GrDCCopyChecks()
{
	CDC *dc, *copy;
	I32 *depth;

	dc = DCNew(16, 2);
	if (!dc || !dc->body || !dc->r)
		return 1;
	dc->body[3] = 0x44;
	dc->body[31] = 0x99;
	dc->r[1].i32[1] = 2;
	depth = DCDepthBufAlloc(dc);
	if (!depth || depth != dc->depth_buf || depth[0] != I32_MAX ||
			depth[31] != I32_MAX)
		return 2;
	depth[0] = 123;
	if (DCDepthBufReset(dc) != depth || depth[0] != I32_MAX ||
			depth[31] != I32_MAX)
		return 3;
	depth[0] = 0x12345678;
	depth[31] = 0x76543210;

	copy = DCCopy(dc);
	if (!copy || copy == dc || copy->dc_signature != DCS_SIGNATURE_VAL ||
			copy->body == dc->body || copy->r == dc->r ||
			copy->depth_buf == dc->depth_buf || copy->body[3] != 0x44 ||
			copy->body[31] != 0x99 || copy->r[1].i32[1] != 2 ||
			copy->depth_buf[0] != 0x12345678 ||
			copy->depth_buf[31] != 0x76543210 || DCSize(copy) <= 0)
		return 4;
	copy->body[3] = 0xAA;
	copy->r[1].i32[1] = 3;
	copy->depth_buf[0] = 0x55;
	if (dc->body[3] != 0x44 || dc->r[1].i32[1] != 2 ||
			dc->depth_buf[0] != 0x12345678)
		return 5;
	DCDel(copy);
	if (dc->dc_signature != DCS_SIGNATURE_VAL || dc->body[31] != 0x99 ||
			dc->depth_buf[31] != 0x76543210)
		return 6;
	DCDel(dc);
	return 42;
}

I64 GrDCRoundTripChecks()
{
	CDC *dc, *loaded;
	U8 *saved;
	I64 size, loaded_size;

	dc = DCNew(16, 2);
	if (!dc)
		return 1;
	dc->body[0] = 1;
	dc->body[7] = 7;
	dc->body[16] = 9;
	dc->body[31] = 15;
	saved = DCSave(dc, &size);
	if (!saved || size <= 32)
		return 2;
	loaded_size = 0;
	loaded = DCLoad(saved, &loaded_size);
	if (!loaded || loaded->dc_signature != DCS_SIGNATURE_VAL ||
			loaded->width != 16 || loaded->width_internal != 16 ||
			loaded->height != 2 || !loaded->body || !loaded->r ||
			loaded->body[0] != 1 || loaded->body[7] != 7 ||
			loaded->body[16] != 9 || loaded->body[31] != 15 ||
			loaded_size != size || loaded->r[0].i32[1] != 1 ||
			loaded->r[5].i32[1] != 1 || loaded->r[10].i32[1] != 1 ||
			loaded->r[15].i32[1] != 1)
		return 3;
	loaded->body[7] = 0xCC;
	if (dc->body[7] != 7)
		return 4;
	DCDel(loaded);
	Free(saved);
	if (dc->dc_signature != DCS_SIGNATURE_VAL || dc->body[7] != 7)
		return 5;
	DCDel(dc);
	return 42;
}

I64 GrDCPixelOpsChecks()
{
	CDC *dc;
	I64 i, changed;

	dc = DCNew(16, 2);
	if (!dc)
		return 1;
	DCFill(dc, 5);
	for (i = 0; i < 32; i++)
		if (dc->body[i] != 5)
			return 2;
	changed = DCColorChange(dc, 5, 2);
	if (changed != 32)
		return 3;
	for (i = 0; i < 32; i++)
		if (dc->body[i] != 2)
			return 4;
	DCClear(dc);
	for (i = 0; i < 32; i++)
		if (dc->body[i])
			return 5;
	for (i = 0; i < 32; i++)
		if (i & 1)
			dc->body[i] = 4;
		else
			dc->body[i] = 6;
	DCMono(dc, 4, 1, 3);
	for (i = 0; i < 32; i++)
		if (i & 1)
		{
			if (dc->body[i] != 1)
				return 6;
		}
		else if (dc->body[i] != 3)
			return 6;
	DCDel(dc);
	return 42;
}
