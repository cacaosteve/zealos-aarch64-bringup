extern I64 ZcFbTextPixel(I64 x, I64 y);

I64 GrDC2SpriteChecks()
{
    CDC *dc;
    CDC *odd_dc;
    U8 *bytes;
    U8 *records;
    CDC *plot_dc;
    I64 i, circle_color;
    U8 actual, bitmap_type;
    U8 invalid_type;
    U8 record_type;
    U8 text_char;
    I32 record_count;
    I32 x, y, width, height;
    I64 row;

    dc = DCNew(16, 2);
    if (!dc || !dc->body)
        return 1;
    for (i = 0; i < 32; i++)
        dc->body[i] = i ^ 0x5A;
    bytes = DC2Sprite(dc);
    if (!bytes)
        return 2;
    MemCopy(&bitmap_type, bytes, sizeof(U8));
    MemCopy(&x, bytes + 4, sizeof(I32));
    MemCopy(&y, bytes + 8, sizeof(I32));
    MemCopy(&width, bytes + 12, sizeof(I32));
    MemCopy(&height, bytes + 16, sizeof(I32));
    if (bitmap_type != 23 || x || y || width != 16 || height != 2)
        return 2;
    if (SpriteTypeMask(bytes) != (1 << SPT_BITMAP))
        return 2;
    for (i = 0; i < 32; i++) {
        MemCopy(&actual, bytes + 20 + i, sizeof(U8));
        if (actual != (i ^ 0x5A))
            return 3;
    }
    MemCopy(&actual, bytes + 20 + 32, sizeof(U8));
    if (actual != SPT_END)
        return 4;
    plot_dc = DCNew(16, 2);
    if (!plot_dc)
        return 4;
    plot_dc->color.c0 = 7;
    Sprite3(plot_dc, 0, 0, 0, bytes);
    if (plot_dc->color.c0 != 7)
        return 4;
    DCDel(plot_dc);
    // Common fixed-size sprite operations can be streamed together. Exercise
    // foreground changes, point and line records, and caller-state restoration.
    records = CAlloc(107);
    record_type = SPT_COLOR;
    MemCopy(records, &record_type, sizeof(U8));
    actual = 12;
    MemCopy(records + 1, &actual, sizeof(U8));
    record_type = SPT_SHIFT;
    MemCopy(records + 2, &record_type, sizeof(U8));
    x = 1;
    y = 0;
    MemCopy(records + 6, &x, sizeof(I32));
    MemCopy(records + 10, &y, sizeof(I32));
    record_type = SPT_PT;
    MemCopy(records + 14, &record_type, sizeof(U8));
    x = 2;
    y = 1;
    MemCopy(records + 18, &x, sizeof(I32));
    MemCopy(records + 22, &y, sizeof(I32));
    record_type = SPT_LINE;
    MemCopy(records + 26, &record_type, sizeof(U8));
    x = 1;
    y = 0;
    width = 8;
    height = 1;
    MemCopy(records + 30, &x, sizeof(I32));
    MemCopy(records + 34, &y, sizeof(I32));
    MemCopy(records + 38, &width, sizeof(I32));
    MemCopy(records + 42, &height, sizeof(I32));
    record_type = SPT_RECT;
    MemCopy(records + 46, &record_type, sizeof(U8));
    x = 3;
    y = 0;
    width = 6;
    height = 2;
    MemCopy(records + 50, &x, sizeof(I32));
    MemCopy(records + 54, &y, sizeof(I32));
    MemCopy(records + 58, &width, sizeof(I32));
    MemCopy(records + 62, &height, sizeof(I32));
    record_type = SPT_CIRCLE;
    MemCopy(records + 66, &record_type, sizeof(U8));
    // Keep the circle clear of the point, line, and rectangle above so the
    // framebuffer assertions below isolate this record's four cardinal pixels.
    x = 13;
    y = 1;
    width = 1;
    MemCopy(records + 70, &x, sizeof(I32));
    MemCopy(records + 74, &y, sizeof(I32));
    MemCopy(records + 78, &width, sizeof(I32));
    record_type = SPT_POLYLINE;
    MemCopy(records + 82, &record_type, sizeof(U8));
    record_count = 2;
    MemCopy(records + 86, &record_count, sizeof(I32));
    x = 20;
    y = 0;
    MemCopy(records + 90, &x, sizeof(I32));
    MemCopy(records + 94, &y, sizeof(I32));
    x = 24;
    MemCopy(records + 98, &x, sizeof(I32));
    MemCopy(records + 102, &y, sizeof(I32));
    if (SpriteTypeMask(records) !=
            ((1 << SPT_COLOR) + (1 << SPT_SHIFT) + (1 << SPT_PT) +
             (1 << SPT_LINE) + (1 << SPT_RECT) + (1 << SPT_CIRCLE) +
             (1 << SPT_POLYLINE)))
        return 40;
    plot_dc = DCNew(800, 600);
    if (!plot_dc)
        return 41;
    plot_dc->color.c0 = 7;
    Sprite3(plot_dc, 400, 300, 0, records);
    circle_color = gr_palette[12] & 0x00FFFFFF;
    if (plot_dc->color.c0 != 7)
        return 42;
    if (ZcFbTextPixel(413, 301) != circle_color ||
            ZcFbTextPixel(415, 301) != circle_color ||
            ZcFbTextPixel(414, 301) == circle_color)
        return 43;
    if (ZcFbTextPixel(421, 300) != circle_color) return 44;
    if (ZcFbTextPixel(423, 300) != circle_color) return 45;
    if (ZcFbTextPixel(425, 300) != circle_color) return 46;
    Free(records);
    // Keep the packed PolyPt smoke in its own variable-length stream so its
    // end-marker/size check is independent of the preceding polyline record.
    records = CAlloc(20);
    record_type = SPT_COLOR;
    MemCopy(records, &record_type, sizeof(U8));
    actual = 12;
    MemCopy(records + 1, &actual, sizeof(U8));
    record_type = SPT_POLYPT;
    MemCopy(records + 2, &record_type, sizeof(U8));
    record_count = 2;
    MemCopy(records + 6, &record_count, sizeof(I32));
    x = 30;
    y = 0;
    MemCopy(records + 10, &x, sizeof(I32));
    MemCopy(records + 14, &y, sizeof(I32));
    actual = 0x24; // Packed 3-bit E, E moves from (30,0).
    MemCopy(records + 18, &actual, sizeof(U8));
    if (SpriteTypeMask(records) !=
            ((1 << SPT_COLOR) + (1 << SPT_POLYPT)))
        return 47;
    Sprite3(plot_dc, 400, 300, 0, records);
    if (ZcFbTextPixel(430, 300) != circle_color ||
            ZcFbTextPixel(431, 300) != circle_color ||
            ZcFbTextPixel(432, 300) != circle_color)
        return 48;
    DCDel(plot_dc);
    Free(records);
    invalid_type = SPT_TYPES_NUM;
    MemCopy(bytes, &invalid_type, sizeof(U8));
    if (SpriteTypeMask(bytes) != (1 << SPT_TYPES_NUM))
        return 4;
    MemCopy(bytes, &bitmap_type, sizeof(U8));
    Free(bytes);
    DCDel(dc);
    odd_dc = DCNew(13, 2);
    if (!odd_dc || !odd_dc->body || odd_dc->width_internal != 8)
        return 5;
    for (i = 0; i < 16; i++)
        odd_dc->body[i] = i + 1;
    bytes = DC2Sprite(odd_dc);
    if (!bytes)
        return 6;
    for (row = 0; row < 2; row++) {
        for (i = 0; i < 8; i++) {
            MemCopy(&actual, bytes + 20 + row * 16 + i, sizeof(U8));
            if (actual != (row * 8 + i + 1))
                return 7;
        }
        for (i = 8; i < 16; i++) {
            MemCopy(&actual, bytes + 20 + row * 16 + i, sizeof(U8));
            if (actual)
                return 8;
        }
    }
    MemCopy(&actual, bytes + 20 + 32, sizeof(U8));
    if (actual != SPT_END)
        return 9;
    Free(bytes);
    DCDel(odd_dc);

    // Fixed-size flood-fill record followed by the end marker.
    records = CAlloc(13);
    record_type = SPT_FLOOD_FILL;
    MemCopy(records, &record_type, sizeof(U8));
    if (SpriteTypeMask(records) != (1 << SPT_FLOOD_FILL))
        return 10;
    Free(records);

    // The scanner must continue across multiple short fixed-size records.
    records = CAlloc(5);
    record_type = SPT_COLOR;
    MemCopy(records, &record_type, sizeof(U8));
    MemCopy(records + 2, &record_type, sizeof(U8));
    if (SpriteTypeMask(records) != (1 << SPT_COLOR))
        return 11;
    Free(records);

    // POLYLINE has an I32 point count and an eight-byte point payload.
    records = CAlloc(17);
    record_type = SPT_POLYLINE;
    record_count = 1;
    MemCopy(records, &record_type, sizeof(U8));
    MemCopy(records + 4, &record_count, sizeof(I32));
    if (SpriteTypeMask(records) != (1 << SPT_POLYLINE))
        return 12;
    Free(records);

    // POLYPT packs three-bit point codes; one point occupies one payload byte.
    records = CAlloc(18);
    record_type = SPT_POLYPT;
    MemCopy(records, &record_type, sizeof(U8));
    MemCopy(records + 4, &record_count, sizeof(I32));
    if (SpriteTypeMask(records) != (1 << SPT_POLYPT))
        return 13;
    Free(records);

    // Spline point payloads are three I32 values per point.
    records = CAlloc(21);
    record_type = SPT_BSPLINE2;
    MemCopy(records, &record_type, sizeof(U8));
    MemCopy(records + 4, &record_count, sizeof(I32));
    if (SpriteTypeMask(records) != (1 << SPT_BSPLINE2))
        return 14;
    Free(records);

    // Text records end at their null-terminated string, then resume scanning.
    records = CAlloc(17);
    record_type = SPT_TEXT;
    MemCopy(records, &record_type, sizeof(U8));
    text_char = 'x';
    MemCopy(records + 12, &text_char, sizeof(U8));
    record_type = SPT_COLOR;
    MemCopy(records + 14, &record_type, sizeof(U8));
    if (SpriteTypeMask(records) != ((1 << SPT_TEXT) + (1 << SPT_COLOR)))
        return 15;
    Free(records);

    // Both mesh encodings carry 12-byte vertices and 16-byte triangle records.
    records = CAlloc(41);
    record_type = SPT_MESH;
    MemCopy(records, &record_type, sizeof(U8));
    MemCopy(records + 4, &record_count, sizeof(I32));
    MemCopy(records + 8, &record_count, sizeof(I32));
    if (SpriteTypeMask(records) != (1 << SPT_MESH))
        return 16;
    Free(records);
    records = CAlloc(53);
    record_type = SPT_SHIFTABLE_MESH;
    MemCopy(records, &record_type, sizeof(U8));
    MemCopy(records + 16, &record_count, sizeof(I32));
    MemCopy(records + 20, &record_count, sizeof(I32));
    if (SpriteTypeMask(records) != (1 << SPT_SHIFTABLE_MESH))
        return 17;
    Free(records);
    if (DC2Sprite(NULL))
        return 18;
    return 42;
}

// Keep the larger ellipse probe in its own frame: the older sprite smoke
// already exercises a wide mix of locals and records on the bootstrap ABI.
I64 GrSpriteEllipseChecks()
{
    CDC *plot_dc;
    U8 *records;
    U8 record_type;
    I32 x, y, width, height;
    U64 angle_bits;
    I64 ellipse_color;

    plot_dc = DCNew(800, 600);
    if (!plot_dc)
        return 1;
    plot_dc->color.c0 = 12;
    records = CAlloc(33);
    if (!records)
        return 2;
    record_type = SPT_ELLIPSE;
    MemCopy(records, &record_type, sizeof(U8));
    x = 40;
    y = 20;
    width = 4;
    height = 2;
    MemCopy(records + 4, &x, sizeof(I32));
    MemCopy(records + 8, &y, sizeof(I32));
    MemCopy(records + 12, &width, sizeof(I32));
    MemCopy(records + 16, &height, sizeof(I32));
    angle_bits = 0;
    MemCopy(records + 24, &angle_bits, sizeof(U64));
    if (SpriteTypeMask(records) != (1 << SPT_ELLIPSE))
        return 3;
    Sprite3(plot_dc, 400, 300, 0, records);
    ellipse_color = gr_palette[12] & 0x00FFFFFF;
    if (ZcFbTextPixel(436, 320) != ellipse_color ||
            ZcFbTextPixel(444, 320) != ellipse_color ||
            ZcFbTextPixel(440, 318) != ellipse_color ||
            ZcFbTextPixel(440, 322) != ellipse_color ||
            ZcFbTextPixel(440, 320) == ellipse_color)
        return 4;

    // A quarter-turn swaps the radii around the unchanged center.
    x = 80;
    MemCopy(records + 4, &x, sizeof(I32));
    angle_bits = 0x3FF921FB54442D18;
    MemCopy(records + 24, &angle_bits, sizeof(U64));
    Sprite3(plot_dc, 400, 300, 0, records);
    if (ZcFbTextPixel(478, 320) != ellipse_color ||
            ZcFbTextPixel(482, 320) != ellipse_color ||
            ZcFbTextPixel(480, 316) != ellipse_color ||
            ZcFbTextPixel(480, 324) != ellipse_color ||
            ZcFbTextPixel(480, 320) == ellipse_color)
        return 5;

    // Preserve fail-closed behavior for angles between cardinal directions.
    x = 100;
    MemCopy(records + 4, &x, sizeof(I32));
    angle_bits = 0x3FF0000000000000;
    MemCopy(records + 24, &angle_bits, sizeof(U64));
    Sprite3(plot_dc, 400, 300, 0, records);
    if (ZcFbTextPixel(504, 320) == ellipse_color)
        return 6;
    Free(records);
    DCDel(plot_dc);
    return 42;
}

I64 GrSpriteDitherChecks()
{
    CDC *plot_dc;
    U8 *records;
    U8 dither_type, point_type, color_type, solid_color;
    U16 dither_colors;
    I32 x, y;
    I64 color0, color1, old_color;

    plot_dc = DCNew(800, 600);
    if (!plot_dc)
        return 1;
    plot_dc->color.c0 = 12;
    records = CAlloc(43);
    if (!records)
        return 2;
    dither_type = SPT_DITHER_COLOR;
    point_type = SPT_PT;
    color_type = SPT_COLOR;
    solid_color = 7;
    dither_colors = 0x0905; // first color 5, second color 9
    MemCopy(records, &dither_type, sizeof(U8));
    MemCopy(records + 2, &dither_colors, sizeof(U16));
    MemCopy(records + 4, &point_type, sizeof(U8));
    x = 1;
    y = 1;
    MemCopy(records + 8, &x, sizeof(I32));
    MemCopy(records + 12, &y, sizeof(I32));
    MemCopy(records + 16, &point_type, sizeof(U8));
    x = 2;
    MemCopy(records + 20, &x, sizeof(I32));
    MemCopy(records + 24, &y, sizeof(I32));
    MemCopy(records + 28, &color_type, sizeof(U8));
    MemCopy(records + 29, &solid_color, sizeof(U8));
    MemCopy(records + 30, &point_type, sizeof(U8));
    x = 3;
    MemCopy(records + 34, &x, sizeof(I32));
    MemCopy(records + 38, &y, sizeof(I32));
    if (SpriteTypeMask(records) !=
            ((1 << SPT_DITHER_COLOR) + (1 << SPT_PT) + (1 << SPT_COLOR)))
        return 3;
    old_color = plot_dc->color;
    Sprite3(plot_dc, 400, 300, 0, records);
    color0 = gr_palette[5] & 0x00FFFFFF;
    color1 = gr_palette[9] & 0x00FFFFFF;
    if (ZcFbTextPixel(401, 301) != color0 ||
            ZcFbTextPixel(402, 301) != color1 ||
            ZcFbTextPixel(403, 301) != (gr_palette[7] & 0x00FFFFFF) ||
            plot_dc->color != old_color)
        return 4;
    Free(records);
    DCDel(plot_dc);
    return 42;
}


I64 GrSpriteArrowChecks()
{
    CDC *plot_dc;
    U8 *records;
    U8 arrow_type;
    I32 x1, y1, x2, y2;
    I64 arrow_color;

    plot_dc = DCNew(800, 600);
    if (!plot_dc)
        return 1;
    plot_dc->color.c0 = 14;
    records = CAlloc(21);
    if (!records)
        return 2;
    arrow_type = SPT_ARROW;
    MemCopy(records, &arrow_type, sizeof(U8));
    x1 = 0;
    y1 = 0;
    x2 = 16;
    y2 = 0;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    MemCopy(records + 16, &y2, sizeof(I32));
    if (SpriteTypeMask(records) != (1 << SPT_ARROW))
        return 3;
    Sprite3(plot_dc, 400, 300, 0, records);
    arrow_color = gr_palette[14] & 0x00FFFFFF;
    if (ZcFbTextPixel(408, 300) != arrow_color ||
            ZcFbTextPixel(416, 300) != arrow_color ||
            ZcFbTextPixel(413, 298) != arrow_color ||
            ZcFbTextPixel(413, 303) != arrow_color)
        return 4;
    Free(records);
    DCDel(plot_dc);
    return 42;
}

I64 GrSpriteThickChecks()
{
    CDC *plot_dc;
    U8 *records;
    U8 thick_type, line_type;
    I32 thickness, x1, y1, x2, y2;
    I64 line_color;

    plot_dc = DCNew(800, 600);
    if (!plot_dc)
        return 1;
    plot_dc->color.c0 = 14;
    records = CAlloc(29);
    if (!records)
        return 2;
    thick_type = SPT_THICK;
    line_type = SPT_LINE;
    thickness = 3;
    MemCopy(records, &thick_type, sizeof(U8));
    MemCopy(records + 4, &thickness, sizeof(I32));
    MemCopy(records + 8, &line_type, sizeof(U8));
    x1 = 1;
    y1 = 1;
    x2 = 5;
    y2 = 1;
    MemCopy(records + 12, &x1, sizeof(I32));
    MemCopy(records + 16, &y1, sizeof(I32));
    MemCopy(records + 20, &x2, sizeof(I32));
    MemCopy(records + 24, &y2, sizeof(I32));
    if (SpriteTypeMask(records) !=
            ((1 << SPT_THICK) + (1 << SPT_LINE)))
        return 3;
    Sprite3(plot_dc, 400, 300, 0, records);
    line_color = gr_palette[14] & 0x00FFFFFF;
    if (ZcFbTextPixel(403, 300) != line_color ||
            ZcFbTextPixel(403, 301) != line_color ||
            ZcFbTextPixel(403, 302) != line_color ||
            ZcFbTextPixel(403, 299) == line_color ||
            ZcFbTextPixel(403, 303) == line_color ||
            plot_dc->thick != 1)
        return 4;
    Free(records);
    DCDel(plot_dc);
    return 42;
}

// Keep the fixed-size rotated rectangle record isolated from the broader
// sprite smoke so cardinal rotations and filled-area bounds are diagnosable.
I64 GrSpriteRotatedRectChecks()
{
    CDC *plot_dc;
    U8 *records;
    U8 record_type;
    I32 x1, y1, x2, y2;
    U64 angle_bits;
    I64 rect_color;

    plot_dc = DCNew(800, 600);
    if (!plot_dc)
        return 1;
    plot_dc->color.c0 = 12;
    records = CAlloc(33);
    if (!records)
        return 2;
    record_type = SPT_ROTATED_RECT;
    MemCopy(records, &record_type, sizeof(U8));
    x1 = 20;
    y1 = 30;
    x2 = 25;
    y2 = 34;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    MemCopy(records + 16, &y2, sizeof(I32));
    angle_bits = 0;
    MemCopy(records + 24, &angle_bits, sizeof(U64));
    if (SpriteTypeMask(records) != (1 << SPT_ROTATED_RECT))
        return 3;
    Sprite3(plot_dc, 400, 300, 0, records);
    rect_color = gr_palette[12] & 0x00FFFFFF;
    if (plot_dc->color.c0 != 12 ||
            ZcFbTextPixel(420, 330) != rect_color ||
            ZcFbTextPixel(424, 333) != rect_color ||
            ZcFbTextPixel(425, 333) == rect_color)
        return 4;

    // Exact quarter-turn angles rotate the rectangle around its first point.
    x1 = 60;
    y1 = 60;
    x2 = 65;
    y2 = 63;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    MemCopy(records + 16, &y2, sizeof(I32));
    angle_bits = 0x3FF921FB54442D18; // +pi/2
    MemCopy(records + 24, &angle_bits, sizeof(U64));
    Sprite3(plot_dc, 400, 300, 0, records);
    if (ZcFbTextPixel(460, 357) != rect_color ||
            ZcFbTextPixel(462, 359) != rect_color ||
            ZcFbTextPixel(463, 361) == rect_color)
        return 5;

    x1 = 80;
    y1 = 60;
    x2 = 85;
    y2 = 63;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    MemCopy(records + 16, &y2, sizeof(I32));
    angle_bits = 0xBFF921FB54442D18; // -pi/2
    MemCopy(records + 24, &angle_bits, sizeof(U64));
    Sprite3(plot_dc, 400, 300, 0, records);
    if (ZcFbTextPixel(477, 360) != rect_color ||
            ZcFbTextPixel(479, 364) != rect_color)
        return 6;

    x1 = 100;
    y1 = 60;
    x2 = 105;
    y2 = 63;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    MemCopy(records + 16, &y2, sizeof(I32));
    angle_bits = 0x400921FB54442D18; // +pi
    MemCopy(records + 24, &angle_bits, sizeof(U64));
    Sprite3(plot_dc, 400, 300, 0, records);
    if (ZcFbTextPixel(495, 357) != rect_color ||
            ZcFbTextPixel(499, 359) != rect_color)
        return 7;

    // Arbitrary angles remain rejected before they can alter the frame.
    x1 = 40;
    y1 = 50;
    x2 = 45;
    y2 = 54;
    MemCopy(records + 4, &x1, sizeof(I32));
    MemCopy(records + 8, &y1, sizeof(I32));
    MemCopy(records + 12, &x2, sizeof(I32));
    MemCopy(records + 16, &y2, sizeof(I32));
    angle_bits = 0x3FF0000000000000;
    MemCopy(records + 24, &angle_bits, sizeof(U64));
    Sprite3(plot_dc, 400, 300, 0, records);
    if (ZcFbTextPixel(440, 350) == rect_color)
        return 8;

    Free(records);
    DCDel(plot_dc);
    return 42;
}

// The existing CDC-to-sprite check validated bitmap bytes, not their plotted
// result. Keep playback isolated to assert padded-row handling and state.
I64 GrSpriteBitmapChecks()
{
    CDC *plot_dc;
    U8 *records;
    U8 record_type;
    I32 x, y, width, height;
    I64 expected12, expected4, expected7, expected2, expected14, expected9;
    I64 expected0;

    plot_dc = DCNew(800, 600);
    if (!plot_dc)
        return 1;
    plot_dc->color.c0 = 6;
    records = CAlloc(37); // 20-byte header + two 8-byte rows + SPT_END
    if (!records)
        return 2;
    record_type = SPT_BITMAP;
    MemCopy(records, &record_type, sizeof(U8));
    x = 10;
    y = 20;
    width = 3;
    height = 2;
    MemCopy(records + 4, &x, sizeof(I32));
    MemCopy(records + 8, &y, sizeof(I32));
    MemCopy(records + 12, &width, sizeof(I32));
    MemCopy(records + 16, &height, sizeof(I32));
    // Make padding conspicuous: only the first three bytes in each row are
    // pixels; the remaining five bytes belong to the eight-byte row stride.
    records[20] = 12;
    records[21] = 4;
    records[22] = 7;
    records[23] = records[24] = records[25] = records[26] = records[27] = 15;
    records[28] = 2;
    records[29] = 14;
    records[30] = 9;
    records[31] = records[32] = records[33] = records[34] = records[35] = 15;
    if (SpriteTypeMask(records) != (1 << SPT_BITMAP))
        return 3;
    Sprite3(plot_dc, 400, 300, 0, records);
    expected12 = gr_palette[12] & 0x00FFFFFF;
    expected4 = gr_palette[4] & 0x00FFFFFF;
    expected7 = gr_palette[7] & 0x00FFFFFF;
    expected2 = gr_palette[2] & 0x00FFFFFF;
    expected14 = gr_palette[14] & 0x00FFFFFF;
    expected9 = gr_palette[9] & 0x00FFFFFF;
    expected0 = gr_palette[0] & 0x00FFFFFF;
    if (plot_dc->color.c0 != 6 ||
            ZcFbTextPixel(410, 320) != expected12 ||
            ZcFbTextPixel(411, 320) != expected4 ||
            ZcFbTextPixel(412, 320) != expected7 ||
            ZcFbTextPixel(410, 321) != expected2 ||
            ZcFbTextPixel(411, 321) != expected14 ||
            ZcFbTextPixel(412, 321) != expected9 ||
            ZcFbTextPixel(413, 320) != expected0 ||
            ZcFbTextPixel(413, 321) != expected0)
        return 4;

    Free(records);
    DCDel(plot_dc);
    return 42;
}
