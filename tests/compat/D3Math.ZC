I64 D3EquCheck()
{
	CD3 a;
	D3Equ(&a, 3.0, 4.0, 0.0);
	return a.x == 3.0 && a.y == 4.0 && a.z == 0.0;
}

I64 D3NormCheck()
{
	CD3 a;
	D3Equ(&a, 3.0, 4.0, 0.0);
	return D3Norm(&a) == 5.0;
}

I64 D3ArithmeticCheck()
{
	CD3 a, b, c;
	D3Equ(&a, 3.0, 4.0, 0.0);
	D3Zero(&b);
	D3Sub(&c, &a, &b);
	D3MulEqu(&c, 2.0);
	return c.x == 6.0 && c.y == 8.0 && c.z == 0.0;
}

I64 D3OperationsCheck()
{
	CD3 a, b, c, d;
	D3Equ(&a, 3.0, 4.0, 0.0);
	D3Equ(&b, 1.0, 2.0, 2.0);
	D3Copy(&c, &a);
	if (c.x != 3.0 || c.y != 4.0 || c.z != 0.0) return 2;
	D3Add(&c, &a, &b);
	D3SubEqu(&c, &b);
	D3AddEqu(&c, &b);
	if (c.x != 4.0 || c.y != 6.0 || c.z != 2.0) return 3;
	D3Div(&d, &c, 2.0);
	D3DivEqu(&d, 2.0);
	if (d.x != 1.0 || d.y != 1.5 || d.z != 0.5) return 4;
	D3Cross(&d, &a, &b);
	if (d.x != 8.0 || d.y != -6.0 || d.z != 2.0) return 5;
	if (D3Dot(&a, &b) != 11.0 || D3NormSqr(&a) != 25.0 ||
		D3DistSqr(&a, &b) != 12.0) return 6;
	if (D3Dist(&a, &b) < 3.46 || D3Dist(&a, &b) > 3.47) return 10;
	D3Copy(&c, &a);
	D3Unit(&c);
	if (Abs(c.x - 0.6) > 0.00001 || Abs(c.y - 0.8) > 0.00001 ||
		c.z != 0.0) return 7;
	D3Mul(&d, 0.5, &a);
	D3MulEqu(&d, 2.0);
	if (d.x != 3.0 || d.y != 4.0 || d.z != 0.0) return 8;
	D3Zero(&d);
	if (d.x == 0.0 && d.y == 0.0 && d.z == 0.0) return 1;
	return 9;
}

I64 F64AbsCheck()
{
	return Abs(-2.5) == 2.5;
}

I64 MathODECreateCheck()
{
	CMathODE *ode = ODENew(3);
	I64 ok = ode && ode->n == 3 && ode->n_internal == 3 &&
		ode->t_scale == 1.0 && ode->h == 1e-6 &&
		ode->max_tolerance == 1e-6 && ode->min_tolerance == 1e-6 &&
		ode->state && ode->array_base;
	ODEDel(ode);
	return ok;
}

U0 MathODEExponential(CMathODE *ode, F64 t, F64 *state, F64 *derivative)
{
	derivative[0] = state[0];
}

I64 MathODERK5Check()
{
	CMathODE *ode = ODENew(1);
	ode->derive = &MathODEExponential;
	ode->state_internal[0] = 1.0;
	ode->state_scale[0] = 1.0;
	ode->DstateDt[0] = 1.0;
	ode->h = ode->h_min = ode->h_max = 0.01;
	ODERK5OneStep(ode);
	I64 result = 1;
	if (Abs(ode->state_internal[0] - 1.010050167084168) >= 1e-8) result = 2;
	if (result == 1 && Abs(ode->t - 0.01) >= 1e-12) result = 3;
	ODEDel(ode);
	return result;
}

I64 MathODEUpdateLoopCheck()
{
	CTask *task = Fs;
	CMathODE *head = task->next_ode, *ode = ODENew(1);
	I64 result = 1;
	ode->derive = &MathODEExponential;
	ode->state[0] = 1.0;
	ode->base_t = tS - 0.02;
	ode->flags |= ODEF_STARTED;
	ode->next = head;
	ode->last = head;
	head->next = ode;
	head->last = ode;
	task->last_ode_time = 0;
	winmgr.fps = 60.0;
	winmgr.last_ode_time = 0;
	ODEsUpdate(task);
	if (ode->t < 0.019) result = 2;
	if (Abs(ode->state[0] - 1.02020134) > 0.0001) result = 3;
	head->next = head;
	head->last = head;
	ODEDel(ode);
	return result;
}

CMathODE *mathode_frame_ode;
CTask *mathode_frame_task;

I64 MathODEUpdateFramePrepare()
{//Attach an ODE before the source Window Manager starts its normal refresh loop.
	CMathODE *head;
	mathode_frame_task = Fs;
	head = mathode_frame_task->next_ode;
	mathode_frame_ode = ODENew(1);
	if (!mathode_frame_ode) return 2;
	mathode_frame_ode->derive = &MathODEExponential;
	mathode_frame_ode->state[0] = 1.0;
	mathode_frame_ode->base_t = tS - 0.1;
	mathode_frame_ode->flags |= ODEF_STARTED;
	mathode_frame_ode->next = head;
	mathode_frame_ode->last = head;
	head->next = mathode_frame_ode;
	head->last = mathode_frame_ode;
	return 1;
}

I64 MathODEUpdateFrameCheck()
{//The live GrUpdateTasks loop should have advanced the root task's ODE.
	I64 result = 1;
	Sleep(100);
	if (mathode_frame_ode->t < 0.02) result = 2;
	if (Abs(mathode_frame_ode->state[0] - Exp(mathode_frame_ode->t)) > 0.001)
		result = 3;
	return result;
}

I64 MathODEUpdateFrameCleanup()
{//Stop the manager before unlinking its root task's live ODE.
	if (!mathode_frame_ode) return 2;
	mathode_frame_ode->last->next = mathode_frame_ode->next;
	mathode_frame_ode->next->last = mathode_frame_ode->last;
	ODEDel(mathode_frame_ode);
	mathode_frame_ode = NULL;
	return 1;
}
