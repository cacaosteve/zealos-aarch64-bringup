extern U0 DCBlotColor4(U8 *dst, I64 *img, I64 *img_cache, I64 count);

I64 GrAsmColor4Checks()
{
	U8 output[12];
	I64 image[3], cache[3];
	I64 i;
	image[0] = 0x4020100804020100;
	cache[0] = 0;
	for (i = 0; i < 4; i++)
		output[i] = 0xA5;
	DCBlotColor4(output, image, cache, 1);
	if (output[0] != 0x02 || output[1] != 0x04 ||
			output[2] != 0x08 || output[3] != 0x10)
		return 1;
	if (cache[0] != image[0])
		return 2;
	for (i = 0; i < 4; i++)
		output[i] = 0xA5;
	DCBlotColor4(output, image, cache, 1);
	for (i = 0; i < 4; i++)
		if (output[i] != 0xA5)
			return 3;
	image[0] = 0x0F;
	DCBlotColor4(output, image, cache, 1);
	if (output[0] != 1 || output[1] != 1 ||
			output[2] != 1 || output[3] != 1 || cache[0] != image[0])
		return 4;
	// Three groups are laid out as three bytes per plane. A cache hit must
	// leave that group's four destination bytes alone while a neighboring miss
	// updates only its own group.
	image[0] = 0x0000000000000001;
	image[1] = 0x0000000000000200;
	image[2] = 0x0000000000000004;
	cache[0] = image[0];
	cache[1] = 0;
	cache[2] = image[2];
	for (i = 0; i < 12; i++)
		output[i] = 0xA5;
	DCBlotColor4(output, image, cache, 3);
	if (output[0] != 0xA5 || output[1] != 0 ||
			output[2] != 0xA5 || output[3] != 0xA5 ||
			output[4] != 0x02 || output[5] != 0xA5 ||
			output[6] != 0xA5 || output[7] != 0 ||
			output[8] != 0xA5 || output[9] != 0xA5 ||
			output[10] != 0 || output[11] != 0xA5 ||
			cache[1] != image[1])
		return 5;
	for (i = 0; i < 3; i++)
		cache[i] = 0;
	for (i = 0; i < 12; i++)
		output[i] = 0xA5;
	DCBlotColor4(output, image, cache, 3);
	if (output[0] != 1 || output[1] != 0 || output[2] != 0 ||
			output[3] != 0 || output[4] != 2 || output[5] != 0 ||
			output[6] != 0 || output[7] != 0 || output[8] != 1 ||
			output[9] != 0 || output[10] != 0 || output[11] != 0)
		return 6;
	return 42;
}
