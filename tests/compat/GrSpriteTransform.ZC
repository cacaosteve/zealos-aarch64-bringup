extern I64 ZcFbTextPixel(I64 x, I64 y);

I64 GrSpriteTransformChecks()
{
    CDC *dc;
    U8 *records;
    U8 type, pixel;
    I32 x, y;
    U64 angle;
    I64 i, color;

    dc = DCNew(800, 600);
    records = CAlloc(401);
    if (!dc || !records || !dc->r || !dc->transform)
        return 1;
    dc->color.c0 = 12;
    dc->x = 610;
    dc->y = 430;
    dc->z = 0;
    for (i = 0; i < 16; i++)
        dc->r[i] = 0;
    dc->r[1] = -0x100000000; // 90-degree turn about Z.
    dc->r[4] = 0x100000000;
    dc->r[10] = 0x100000000;
    dc->r[15] = 0x100000000;

    type = SPT_TRANSFORM_ON;
    MemCopy(records, &type, sizeof(U8));
    type = SPT_PT;
    MemCopy(records + 1, &type, sizeof(U8));
    x = 23; y = 17;
    MemCopy(records + 5, &x, sizeof(I32));
    MemCopy(records + 9, &y, sizeof(I32));

    type = SPT_RECT;
    MemCopy(records + 13, &type, sizeof(U8));
    x = 10; y = 30;
    MemCopy(records + 17, &x, sizeof(I32));
    MemCopy(records + 21, &y, sizeof(I32));
    x = 20; y = 40;
    MemCopy(records + 25, &x, sizeof(I32));
    MemCopy(records + 29, &y, sizeof(I32));

    type = SPT_TRANSFORM_OFF;
    MemCopy(records + 33, &type, sizeof(U8));
    type = SPT_PT;
    MemCopy(records + 34, &type, sizeof(U8));
    x = 23; y = 17;
    MemCopy(records + 38, &x, sizeof(I32));
    MemCopy(records + 42, &y, sizeof(I32));

    type = SPT_RECT;
    MemCopy(records + 46, &type, sizeof(U8));
    x = 10; y = 30;
    MemCopy(records + 50, &x, sizeof(I32));
    MemCopy(records + 54, &y, sizeof(I32));
    x = 20; y = 40;
    MemCopy(records + 58, &x, sizeof(I32));
    MemCopy(records + 62, &y, sizeof(I32));

    type = SPT_TRANSFORM_ON;
    MemCopy(records + 66, &type, sizeof(U8));
    type = SPT_CIRCLE;
    MemCopy(records + 67, &type, sizeof(U8));
    x = 30; y = 30;
    MemCopy(records + 71, &x, sizeof(I32));
    MemCopy(records + 75, &y, sizeof(I32));
    x = 5;
    MemCopy(records + 79, &x, sizeof(I32));

    type = SPT_TRANSFORM_OFF;
    MemCopy(records + 83, &type, sizeof(U8));
    type = SPT_CIRCLE;
    MemCopy(records + 84, &type, sizeof(U8));
    x = 30; y = 30;
    MemCopy(records + 88, &x, sizeof(I32));
    MemCopy(records + 92, &y, sizeof(I32));
    x = 5;
    MemCopy(records + 96, &x, sizeof(I32));

    type = SPT_TRANSFORM_ON;
    MemCopy(records + 100, &type, sizeof(U8));
    type = SPT_POLYLINE;
    MemCopy(records + 101, &type, sizeof(U8));
    x = 2;
    MemCopy(records + 105, &x, sizeof(I32));
    x = 10; y = 10;
    MemCopy(records + 109, &x, sizeof(I32));
    MemCopy(records + 113, &y, sizeof(I32));
    x = 30; y = 10;
    MemCopy(records + 117, &x, sizeof(I32));
    MemCopy(records + 121, &y, sizeof(I32));

    type = SPT_TRANSFORM_OFF;
    MemCopy(records + 125, &type, sizeof(U8));
    type = SPT_POLYLINE;
    MemCopy(records + 126, &type, sizeof(U8));
    x = 2;
    MemCopy(records + 130, &x, sizeof(I32));
    x = 10; y = 10;
    MemCopy(records + 134, &x, sizeof(I32));
    MemCopy(records + 138, &y, sizeof(I32));
    x = 30; y = 10;
    MemCopy(records + 142, &x, sizeof(I32));
    MemCopy(records + 146, &y, sizeof(I32));

    type = SPT_TRANSFORM_ON;
    MemCopy(records + 150, &type, sizeof(U8));
    type = SPT_ELLIPSE;
    MemCopy(records + 151, &type, sizeof(U8));
    x = 35; y = 30;
    MemCopy(records + 155, &x, sizeof(I32));
    MemCopy(records + 159, &y, sizeof(I32));
    x = 8; y = 4;
    MemCopy(records + 163, &x, sizeof(I32));
    MemCopy(records + 167, &y, sizeof(I32));
    angle = 0;
    MemCopy(records + 175, &angle, sizeof(U64));

    type = SPT_TRANSFORM_OFF;
    MemCopy(records + 183, &type, sizeof(U8));
    type = SPT_ELLIPSE;
    MemCopy(records + 184, &type, sizeof(U8));
    x = 40; y = 70;
    MemCopy(records + 188, &x, sizeof(I32));
    MemCopy(records + 192, &y, sizeof(I32));
    x = 8; y = 4;
    MemCopy(records + 196, &x, sizeof(I32));
    MemCopy(records + 200, &y, sizeof(I32));
    MemCopy(records + 208, &angle, sizeof(U64));

    type = SPT_TRANSFORM_ON;
    MemCopy(records + 216, &type, sizeof(U8));
    type = SPT_POLYGON;
    MemCopy(records + 217, &type, sizeof(U8));
    x = 40; y = 40;
    MemCopy(records + 221, &x, sizeof(I32));
    MemCopy(records + 225, &y, sizeof(I32));
    x = 10; y = 10;
    MemCopy(records + 229, &x, sizeof(I32));
    MemCopy(records + 233, &y, sizeof(I32));
    MemCopy(records + 241, &angle, sizeof(U64));
    x = 3;
    MemCopy(records + 249, &x, sizeof(I32));

    type = SPT_TRANSFORM_OFF;
    MemCopy(records + 257, &type, sizeof(U8));
    type = SPT_POLYGON;
    MemCopy(records + 258, &type, sizeof(U8));
    x = 40; y = 70;
    MemCopy(records + 262, &x, sizeof(I32));
    MemCopy(records + 266, &y, sizeof(I32));
    x = 10; y = 10;
    MemCopy(records + 270, &x, sizeof(I32));
    MemCopy(records + 274, &y, sizeof(I32));
    MemCopy(records + 282, &angle, sizeof(U64));
    x = 3;
    MemCopy(records + 290, &x, sizeof(I32));

    type = SPT_TRANSFORM_ON;
    MemCopy(records + 298, &type, sizeof(U8));
    type = SPT_ROTATED_RECT;
    MemCopy(records + 299, &type, sizeof(U8));
    x = 10; y = 10;
    MemCopy(records + 303, &x, sizeof(I32));
    MemCopy(records + 307, &y, sizeof(I32));
    x = 20; y = 20;
    MemCopy(records + 311, &x, sizeof(I32));
    MemCopy(records + 315, &y, sizeof(I32));
    angle = 0;
    MemCopy(records + 323, &angle, sizeof(U64));

    type = SPT_TRANSFORM_OFF;
    MemCopy(records + 331, &type, sizeof(U8));
    type = SPT_ROTATED_RECT;
    MemCopy(records + 332, &type, sizeof(U8));
    x = 10; y = 10;
    MemCopy(records + 336, &x, sizeof(I32));
    MemCopy(records + 340, &y, sizeof(I32));
    x = 20; y = 20;
    MemCopy(records + 344, &x, sizeof(I32));
    MemCopy(records + 348, &y, sizeof(I32));
    MemCopy(records + 356, &angle, sizeof(U64));

    type = SPT_TRANSFORM_ON;
    MemCopy(records + 364, &type, sizeof(U8));
    type = SPT_POLYPT;
    MemCopy(records + 365, &type, sizeof(U8));
    x = 2;
    MemCopy(records + 369, &x, sizeof(I32));
    x = 10; y = 10;
    MemCopy(records + 373, &x, sizeof(I32));
    MemCopy(records + 377, &y, sizeof(I32));
    pixel = 4 | (6 << 3); // East, then south.
    MemCopy(records + 381, &pixel, sizeof(U8));

    type = SPT_TRANSFORM_OFF;
    MemCopy(records + 382, &type, sizeof(U8));
    type = SPT_POLYPT;
    MemCopy(records + 383, &type, sizeof(U8));
    x = 2;
    MemCopy(records + 387, &x, sizeof(I32));
    x = 10; y = 10;
    MemCopy(records + 391, &x, sizeof(I32));
    MemCopy(records + 395, &y, sizeof(I32));
    MemCopy(records + 399, &pixel, sizeof(U8));

    color = gr_palette[12] & 0x00FFFFFF;
    Sprite3(dc, dc->x, dc->y, dc->z, records);
    if (ZcFbTextPixel(593, 453) != color ||
            ZcFbTextPixel(633, 447) != color ||
            ZcFbTextPixel(575, 445) != color ||
            ZcFbTextPixel(625, 465) != color ||
            ZcFbTextPixel(575, 460) != color ||
            ZcFbTextPixel(645, 460) != color ||
            ZcFbTextPixel(600, 450) != color ||
            ZcFbTextPixel(630, 440) != color ||
            ZcFbTextPixel(580, 473) != color ||
            ZcFbTextPixel(658, 500) != color ||
            ZcFbTextPixel(570, 480) != color ||
            ZcFbTextPixel(660, 500) != color ||
            ZcFbTextPixel(595, 445) != color ||
            ZcFbTextPixel(625, 445) != color ||
            ZcFbTextPixel(600, 440) != color ||
            ZcFbTextPixel(600, 441) != color ||
            ZcFbTextPixel(599, 441) != color ||
            ZcFbTextPixel(620, 440) != color ||
            ZcFbTextPixel(621, 441) != color)
        return 2;
    if (ZcFbTextPixel(585, 445) == color)
        return 3;
    if (dc->flags & DCF_TRANSFORMATION)
        return 4;

    DCDel(dc);
    Free(records);
    return 0x2a;
}
