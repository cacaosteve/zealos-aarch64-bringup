class CLastClassProbe
{
    I64 value;
};

class CLastClassInner
{
    I64 number;
};
class CLastClassOuter
{
    CLastClassInner inner;
    U8 text[8];
};
class CLastClassBase
{
    I64 base_value;
};
class CLastClassDerived:CLastClassBase
{
    I64 own_value;
    U8 *label;
    CLastClassInner *nested;
};

I64 LastClassInheritedReportChecks()
{
    CLastClassDerived value;
    CLastClassInner child;
    CArmClassRepField field;
    CDoc *doc = DocNew;
    U8 *saved;
    I64 result = 42;
    I64 saved_flags, masked_flags;
    MemSet(&value, 0, sizeof(value));
    child.number = 0x789A;
    if (!CheckPtr(&child) || CheckPtr(NULL) ||
        CheckPtr(0xD00002619114AC68))
        result = 4;
    saved_flags = RFlagsGet;
    RFlagsSet(saved_flags & ~(1 << 9));
    CheckPtr(&child);
    masked_flags = RFlagsGet;
    RFlagsSet(saved_flags);
    if (masked_flags & (1 << 9) || RFlagsGet != saved_flags)
        result = 5;
    value.base_value = 0x1234;
    value.own_value = 0x5678;
    value.label = "pointer-text";
    value.nested = &child;
    if (!ZcClassRepField("CLastClassDerived", HTT_CLASS, 0, &field) ||
        StrCompare(field.name, "base_value") || field.offset != 0)
        result = 1;
    if (!ClassRep2(doc, &value, "CLastClassDerived", TRUE, TRUE, 0, 3, FALSE))
        result = 2;
    saved = DocSave(doc);
    Print("classrep-inherited=[%s]\n", saved);
    if (!saved || !StrMatch("base_value", saved) ||
        !StrMatch("0000000000001234", saved) || !StrMatch("own_value", saved) ||
        !StrMatch("0000000000005678", saved) || !StrMatch("pointer-text", saved) ||
        !StrMatch("nested", saved) || !StrMatch("000000000000789A", saved) ||
        StrMatch("$ER$", saved))
        result = 3;
    Free(saved);
    DocDel(doc);
    return result;
}

I64 LastClassReportFieldChecks()
{
    CLastClassOuter value;
    CDoc *doc = DocNew;
    U8 *saved;
    I64 result = 42;
    CArmClassRepField f0, f1;
    I64 r0 = ZcClassRepField("CLastClassOuter", HTT_CLASS, 0, &f0);
    I64 r1 = ZcClassRepField("CLastClassOuter", HTT_CLASS, 1, &f1);
    if (!r0 || !r1 || StrCompare(f0.name, "inner") ||
        StrCompare(f1.name, "text"))
        result = 3;
    MemSet(&value, 0, sizeof(value));
    value.inner.number = 42;
    StrCopy(value.text, "TEST");
    if (!ClassRep2(doc, &value, "CLastClassOuter", TRUE, TRUE, 0, 3, FALSE))
        result = 1;
    saved = DocSave(doc);
    Print("classrep-fields=[%s]\n", saved);
    if (!saved || !StrMatch("inner", saved) || !StrMatch("CLastClassInner", saved) || !StrMatch("number", saved) ||
        !StrMatch("000000000000002A", saved) || !StrMatch("text", saved) ||
        !StrMatch("TEST", saved) || StrMatch("$ER$", saved))
        result = 2;
    Free(saved);
    DocDel(doc);
    return result;
}

I64 LastClassU8(U8 *value, U8 *name=lastclass)
{
    // The KernelA bootstrap macro expands U8 to the compiler's U8i class.
    if (name[0] == 'U' && name[1] == '8' && name[2] == 'i' && !name[3])
        return 42;
    return 0;
}

I64 LastClassStruct(CLastClassProbe *value, U8 *name=lastclass)
{
    if (name[0] == 'C' && name[1] == 'L' && name[2] == 'a' &&
        name[3] == 's' && name[4] == 't' && name[5] == 'C' &&
        name[6] == 'l' && name[7] == 'a' && name[8] == 's' &&
        name[9] == 's' && name[10] == 'P' && name[11] == 'r' &&
        name[12] == 'o' && name[13] == 'b' && name[14] == 'e' &&
        !name[15])
        return 42;
    return 0;
}

I64 LastClassExplicit(U8 *value, U8 *name=lastclass)
{
    if (name[0] == 'e' && name[1] == 'x' && name[2] == 'p' &&
        name[3] == 'l' && name[4] == 'i' && name[5] == 'c' &&
        name[6] == 'i' && name[7] == 't' && !name[8])
        return 42;
    return 0;
}

I64 LastClassGeneric(U8 *value, U8 *name=lastclass)
{
    return !StrCompare(name, "CLastClassProbe");
}

I64 LastClassHashShadowChecks()
{
    // Exercise the current task's ZealOS table in front of its separate
    // compiler table, then restore the original bucket before returning.
    CHash *compiler_entry = HashFind("CTask", Fs->hash_table, HTT_CLASS);
    I64 bucket;
    CHashGeneric *shadow;
    I64 result = 42;

    if (!compiler_entry)
        return 1;
    shadow = HashGenericAdd("CTask", HTT_CLASS);
    if (!shadow)
        return 1;
    for (bucket = 0; bucket <= Fs->hash_table->mask; bucket++)
        if (Fs->hash_table->body[bucket] == shadow)
            break;
    if (bucket > Fs->hash_table->mask)
        return 5;
    if (HashFind("CTask", Fs->hash_table, HTT_CLASS, 1) != shadow)
        result = 2;
    else if (shadow->use_count != 1)
        result = 7;
    else if (HashFind("CTask", Fs->hash_table, HTT_CLASS, 2) != compiler_entry)
        result = 3;
    else if (shadow->use_count != 1)
        result = 8; // Skipped instances do not count as successful lookups.
    else if (HashSingleTableFind("CTask", Fs->hash_table, HTT_CLASS, 1) != shadow)
        result = 6;
    else if (shadow->use_count != 2)
        result = 9;
    Fs->hash_table->body[bucket] = shadow->next;
    Free(shadow->str);
    Free(shadow);
    if (HashFind("CTask", Fs->hash_table, HTT_CLASS) != compiler_entry)
        result = 4;
    return result;
}

I64 LastClassHashStrChecks()
{
    // SYS_HASH_STR returns zero for NULL/empty and folds its 64-bit state.
    if (HashStr(NULL) || HashStr(""))
        return 1;
    if (HashStr("abc") != 0x2AB || HashStr("CTask") != 0x9A5)
        return 2;
    if (HashStr("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz") != 0x1E5FA4)
        return 3;
    return 42;
}

I64 LastClassFramePtrChecks()
{
    CHashGeneric *first, *second, *other;
    CHashTable *child;
    CTask *child_task;
    I64 bucket;
    U8 *name = "ZcFramePtrRemovalFixture";
    I64 result = 42;

    if (FramePtr(name))
        return 1;
    first = FramePtrAdd(name, 11);
    second = FramePtrAdd(name, 22);
    if (!first || !second)
        return 2;
    // Removing an older instance using instance 1 must leave both intact.
    if (ZcGuestFramePtrRemove(first, Fs->hash_table))
        result = 3;
    if (FramePtr(name) != 22)
        result = 4;
    // HashRemDel matches all of the target entry's non-flag type bits before
    // checking its identity. A newer same-name matching type blocks removal.
    second->type |= HTT_FILE;
    other = HashGenericAdd(name, HTT_FILE);
    if (!other)
        return 8;
    for (bucket = 0; bucket <= Fs->hash_table->mask; bucket++)
        if (Fs->hash_table->body[bucket] == other)
            break;
    if (bucket > Fs->hash_table->mask)
        return 9;
    if (FramePtrDel(name) != 22 || FramePtr(name) != 22)
        result = 10;
    Fs->hash_table->body[bucket] = other->next;
    Free(other->str);
    Free(other);
    second->type &= ~HTT_FILE;
    child = HashTableNew(16);
    child->next = Fs->hash_table;
    child_task = CAlloc(sizeof(CTask));
    child_task->hash_table = child;
    // A match inherited through the table chain belongs to the parent.
    if (ZcGuestFramePtrRemove(second, child) ||
        FramePtrDel(name, child_task) != 22 || FramePtr(name) != 22)
        result = 5;
    Free(child_task);
    child->next = NULL;
    HashTableDel(child);
    if (FramePtrDel(name) != 22 || FramePtr(name) != 11)
        result = 6;
    if (FramePtrDel(name) != 11 || FramePtr(name))
        result = 7;
    return result;
}

I64 LastClassChecks()
{
    CLastClassProbe value;
    if (LastClassU8(NULL) != 42)
        return 1;
    if (LastClassStruct(NULL) != 42)
        return 2;
    if (LastClassExplicit(NULL, "explicit") != 42)
        return 3;
    if (!LastClassGeneric(&value) || !LastClassGeneric(&value,))
        return 4;
    return 42;
}
